{
    "$schema": "./node_modules/wrangler/config-schema.json",
    // Production Worker (default). Deploy with: wrangler deploy
    "name": "jehmarp",
    "main": "@astrojs/cloudflare/entrypoints/server",
    "compatibility_date": "2026-07-18",
    "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
    ],
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
    },
    "kv_namespaces": [
        {
            "binding": "SESSION",
            "id": "661b6b65c2e34b6e84351040e6a6721a"
        }
    ],
    "observability": {
        "enabled": true
    },
    // Staging Worker — separate from production. Deploy with:
    //   wrangler deploy --env staging --env-file .env.staging
    // Operators: create a dedicated Cloudflare KV namespace for staging SESSION
    // storage, set STAGING_SESSION_KV_ID in the GitHub staging Environment, and
    // set STAGING_BASE_URL after the first deploy (workers.dev or custom route).
    // Do NOT attach production custom domains to staging.
    "env": {
        "staging": {
            "name": "jehmarp-staging",
            "workers_dev": true,
            "kv_namespaces": [
                {
                    "binding": "SESSION",
                    "id": "REPLACE_WITH_STAGING_SESSION_KV_ID"
                }
            ]
        }
    }
}
