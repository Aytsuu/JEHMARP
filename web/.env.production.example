# GitHub production Environment — copy to .env.production and upload:
#   gh secret set --env production -f web/.env.production
#
# This file is the single source for ALL production Environment secrets. CI reads
# these values from GitHub; render-production-env.sh writes only the Worker
# runtime subset into .env.production during deploy. The other keys stay in
# GitHub for migrations, canary deploy, smoke tests, backups, and PR validation.
#
# Use the managed Supabase PRODUCTION project only.
#
# After uploading secrets, also set production Environment variables (not secrets):
#   gh variable set CANARY_OBSERVE_SECONDS --env production --body "90"
#   gh variable set CANARY_MAX_ERROR_RATE --env production --body "0.05"
#   gh variable set VERSION_AFFINITY_REQUIRED --env production --body "false"
#   gh variable set REQUIRE_BACKUP_EVIDENCE_FOR_HIGHRISK --env production --body "false"
#   gh variable set CONTRACT_LOCK_PREFLIGHT --env production --body "true"
#   gh variable set STAGING_EVIDENCE_OPTIONAL --env production --body "false"
#
# Setup order:
#   1. Fill all sections below
#   2. gh secret set --env production -f web/.env.production
#   3. Set production Environment variables (see above)
#   4. Configure production Environment required reviewers in GitHub
#   5. Create dedicated smoke users in production Auth
#   6. Configure Cloudflare version-affinity Transform Rule on your zone

# =============================================================================
# Application / Worker runtime (also written to Worker .env.production by CI)
# =============================================================================

PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_production_key
SUPABASE_SECRET_KEY=sb_secret_your_production_server_only_key

PUBLIC_TURNSTILE_SITE_KEY=your_production_turnstile_site_key
TURNSTILE_SECRET_KEY=your_production_turnstile_secret_key

RESEND_API_KEY=re_your_production_resend_api_key
RESELLER_PRICE_LIST_FROM="JEHMARP <orders@your-domain.com>"
RESELLER_ADMIN_EMAIL=admin@your-domain.com

UPSTASH_REDIS_REST_URL=https://your-production-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_production_upstash_redis_rest_token

# Dashboard page availability — ready | maintenance | not ready
PAGE_STATUS_ADMIN_DASHBOARD=ready
PAGE_STATUS_ADMIN_PRODUCTS=ready
PAGE_STATUS_ADMIN_CUSTOMERS=ready
PAGE_STATUS_ADMIN_AGENTS=ready
PAGE_STATUS_ADMIN_ORDERS=ready
PAGE_STATUS_ADMIN_INVOICES=ready
PAGE_STATUS_ADMIN_INQUIRIES=ready
PAGE_STATUS_ADMIN_RESELLER_APPLICATIONS=ready
PAGE_STATUS_ADMIN_ACTIVITY=ready
PAGE_STATUS_ADMIN_NOTIFICATIONS=ready
PAGE_STATUS_ADMIN_CONTENT=ready
PAGE_STATUS_ADMIN_SETTINGS=ready
PAGE_STATUS_AGENT_DASHBOARD=ready
PAGE_STATUS_AGENT_EARNINGS=ready
PAGE_STATUS_AGENT_CUSTOMERS=ready
PAGE_STATUS_AGENT_ORDERS=ready
PAGE_STATUS_AGENT_PAYMENTS=ready
PAGE_STATUS_AGENT_NOTIFICATIONS=ready
PAGE_STATUS_AGENT_SETTINGS=ready

# =============================================================================
# Supabase CLI (migrations, dry-run, contract release, scheduled health, backup)
# =============================================================================

SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
SUPABASE_PROJECT_REF=your_production_project_ref
SUPABASE_DB_PASSWORD=your_production_database_password
# Optional — fallback when supabase link fails:
# SUPABASE_DB_POOLER_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# =============================================================================
# Cloudflare (deploy jehmarp Worker, canary, smoke URL resolution)
# =============================================================================

CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
PRODUCTION_BASE_URL=https://your-production-domain.com

# =============================================================================
# Authenticated smoke tests (required — production deploy fails without these)
# =============================================================================

SMOKE_ADMIN_EMAIL=smoke-admin@your-domain.com
SMOKE_ADMIN_PASSWORD=your_production_smoke_admin_password
SMOKE_AGENT_EMAIL=smoke-agent@your-domain.com
SMOKE_AGENT_PASSWORD=your_production_smoke_agent_password
# Required when using live Turnstile keys (not Cloudflare test keys):
# SMOKE_TURNSTILE_RESPONSE=your_solved_turnstile_token
