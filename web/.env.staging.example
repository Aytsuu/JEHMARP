# GitHub staging Environment — copy to .env.staging and upload:
#   gh secret set --env staging -f web/.env.staging
#
# This file is the single source for ALL staging Environment secrets. CI reads
# these values from GitHub; render-staging-env.sh writes only the Worker runtime
# subset into .env.staging during deploy (Supabase, Turnstile, email, Redis,
# PAGE_STATUS_*). The other keys stay in GitHub for migrations, Cloudflare,
# smoke tests, and KV injection.
#
# Use the managed Supabase STAGING project only. Do not reuse production Auth
# redirects, Storage buckets, email recipients, Turnstile keys, Redis, or
# third-party webhooks.
#
# Setup order:
#   1. Fill Supabase + Cloudflare sections below
#   2. Create staging KV namespace → set STAGING_SESSION_KV_ID
#   3. gh secret set --env staging -f web/.env.staging
#   4. Push to dev → first Deploy Staging run creates jehmarp-staging
#   5. Set STAGING_BASE_URL to the workers.dev URL → re-upload secrets
#   6. Create dedicated smoke users in staging Auth → set SMOKE_* passwords

# =============================================================================
# Application / Worker runtime (also written to Worker .env.staging by CI)
# =============================================================================

PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_staging_key
SUPABASE_SECRET_KEY=sb_secret_your_staging_server_only_key

PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

RESEND_API_KEY=re_your_staging_resend_api_key
RESELLER_PRICE_LIST_FROM="JEHMARP Staging <staging-onboarding@resend.dev>"
RESELLER_ADMIN_EMAIL=staging-admin@example.com

UPSTASH_REDIS_REST_URL=https://your-staging-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_staging_upstash_redis_rest_token

# Dashboard page availability — ready | maintenance | not ready
PAGE_STATUS_ADMIN_DASHBOARD=ready
PAGE_STATUS_ADMIN_PRODUCTS=ready
PAGE_STATUS_ADMIN_CUSTOMERS=ready
PAGE_STATUS_ADMIN_AGENTS=ready
PAGE_STATUS_ADMIN_ORDERS=ready
PAGE_STATUS_ADMIN_INVOICES=ready
PAGE_STATUS_ADMIN_INQUIRIES=ready
PAGE_STATUS_ADMIN_RESELLER_APPLICATIONS=ready
PAGE_STATUS_ADMIN_ACTIVITY=ready
PAGE_STATUS_ADMIN_NOTIFICATIONS=ready
PAGE_STATUS_ADMIN_CONTENT=ready
PAGE_STATUS_ADMIN_SETTINGS=ready
PAGE_STATUS_AGENT_DASHBOARD=ready
PAGE_STATUS_AGENT_EARNINGS=ready
PAGE_STATUS_AGENT_CUSTOMERS=ready
PAGE_STATUS_AGENT_ORDERS=ready
PAGE_STATUS_AGENT_PAYMENTS=ready
PAGE_STATUS_AGENT_NOTIFICATIONS=ready
PAGE_STATUS_AGENT_SETTINGS=ready

# =============================================================================
# Supabase CLI (migrations, advisors, staging evidence)
# =============================================================================

SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
SUPABASE_PROJECT_REF=your_staging_project_ref
SUPABASE_DB_PASSWORD=your_staging_database_password
# Optional — fallback when supabase link fails:
# SUPABASE_DB_POOLER_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# =============================================================================
# Cloudflare (deploy jehmarp-staging Worker + KV SESSION binding)
# =============================================================================

CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
STAGING_SESSION_KV_ID=your_staging_kv_namespace_id_32_hex_chars
# Set after first successful deploy (workers.dev URL):
STAGING_BASE_URL=https://jehmarp-staging.your-subdomain.workers.dev

# =============================================================================
# Authenticated smoke tests (optional until users exist; staging warns if missing)
# =============================================================================

SMOKE_ADMIN_EMAIL=staging-smoke-admin@example.com
SMOKE_ADMIN_PASSWORD=your_staging_smoke_admin_password
SMOKE_AGENT_EMAIL=staging-smoke-agent@example.com
SMOKE_AGENT_PASSWORD=your_staging_smoke_agent_password
# Required when staging is behind Cloudflare Access (Zero Trust) — create in
# Cloudflare One → Access → Service Auth, authorize for the staging hostname:
# CF_ACCESS_CLIENT_ID=your_service_token_client_id
# CF_ACCESS_CLIENT_SECRET=your_service_token_client_secret
