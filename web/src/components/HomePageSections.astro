const bestSellersList = defaultBestSellers.map((defaultItem, index) => {
  const dbProduct = featuredProducts[index];
  if (dbProduct) {
    return {
      id: dbProduct.id,
      name: dbProduct.name,
      price: defaultItem.price,
      image: getFeaturedProductImage(dbProduct),
      description: dbProduct.description ?? defaultItem.description,
      badge: defaultItem.badge,
      availability: defaultItem.availability,
    };
  }
  return defaultItem;
});

const featuredProductsList =
  featuredProducts.length > 0
    ? featuredProducts.map((prod, i) => ({
        id: prod.id,
        name: prod.name,
        price: defaultBestSellers[i]?.price ?? "₱250.00",
        image: getFeaturedProductImage(prod),
        description:
          prod.description ??
          defaultBestSellers[i]?.description ??
          "Fresh local cut prepared daily.",
        category_name: "Fresh Cut",
      }))
    : defaultBestSellers.map((item) => ({
        ...item,
        category_name: "Fresh Cut",
      }));

function formatTagline(tagline: string): string {
  let formatted = tagline;
  if (formatted.includes("for everyday")) {
    formatted = formatted.replace("for everyday", "<em>for everyday</em>");
  } else if (formatted.includes("practical")) {
    formatted = formatted.replace("practical", "<em>practical</em>");
  } else if (formatted.includes("dependable")) {
    formatted = formatted.replace("dependable", "<em>dependable</em>");
  } else {
    const words = formatted.split(" ");
    if (words.length > 3) {
      const midStart = Math.floor(words.length / 2) - 1;
      const midEnd = midStart + 2;
      words[midStart] = "<em>" + words[midStart];
      words[midEnd - 1] = words[midEnd - 1] + "</em>";
      formatted = words.join(" ");
    }
  }
  return formatted;
}
