                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="stepper-step__icon"
                    >
                      <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                      <path d="m3.3 7 8.7 5 8.7-5" />
                      <path d="M12 22V12" />
                    </svg>
                  </div>
                  <div class="stepper-step__content">
                    <h3 class="stepper-step__title">Enjoy Fresh Meat</h3>
                    <p class="stepper-step__text">
                      Receive fresh meat packed and ready for cooking.
                    </p>
                  </div>
                </div>
              </div>

              <div class="ordering-works__video-wrapper">
                <div
                  class="ordering-works__video-placeholder"
                  role="img"
                  aria-label="Video placeholder showing how ordering works"
                >
                  <div class="ordering-works__video-backdrop">
                    <img
                      src="/images/hero_carousel_2.jpg"
                      alt="JEHMARP ordering process video thumbnail preview"
                      class="ordering-works__video-bg-image"
                      loading="lazy"
                    />
                    <div class="ordering-works__video-overlay" />
                  </div>
                  <div class="ordering-works__video-content">
                    <button
                      type="button"
                      class="ordering-works__play-button"
                      aria-label="Play video walkthrough"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="28"
                        height="28"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="ordering-works__play-icon"
                      >
                        <polygon points="6 3 20 12 6 21 6 3" />
                      </svg>
                    </button>
                    <span class="ordering-works__video-title">
                      Watch How Ordering & Delivery Works
                    </span>
                    <span class="ordering-works__video-duration">
                      01:30 Quick Overview
                    </span>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </div>

        <div class="faq-section">
          <div class="home-container">
            <section aria-labelledby="home-faq">
              <div class="faq-section__grid">
                <div class="faq-section__intro">
                  <h2 id="home-faq" class="faq-section__title">
                    FREQUENTLY ASKED QUESTIONS
                  </h2>
                  <p class="faq-section__desc">
                    Find quick answers to common questions about our fresh meat
                    cuts, ordering process, and pickup/delivery options.
                  </p>
                </div>
                <div class="faq-accordion">
                  {faqItems.map((item) => (
                    <article class="faq-item">
                      <button class="faq-item__trigger" type="button">
                        {item.question}
                        <span class="faq-item__icon">+</span>
                      </button>
                      <div class="faq-item__content">
                        <p>{item.answer}</p>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            </section>
          </div>
        </div>
      </>
    )
  }
</div>

<script>
  // Dynamic FAQ Accordion toggle behavior
  const faqItems = document.querySelectorAll(".faq-item");
  faqItems.forEach((item) => {
    const trigger = item.querySelector(".faq-item__trigger");
    trigger?.addEventListener("click", () => {
      const isActive = item.classList.contains("faq-item--active");
      // Collapse all FAQ items first
      faqItems.forEach((i) => i.classList.remove("faq-item--active"));
      if (!isActive) {
        // Expand clicked FAQ item
        item.classList.add("faq-item--active");
      }
    });
  });

  function initMissionTextExpand() {
    document.querySelectorAll("[data-mission-text-expand]").forEach((wrap) => {
      const text = wrap.querySelector(".mission-card__text");
      const button = wrap.querySelector("[data-mission-text-toggle]");
      if (
        !(text instanceof HTMLElement) ||
        !(button instanceof HTMLButtonElement)
      ) {
        return;
      }

      const isOverflowing = () => text.scrollHeight > text.clientHeight + 1;

      const syncToggleVisibility = () => {
        if (wrap.classList.contains("is-expanded")) {
          button.hidden = false;
          return;
        }

        button.hidden = !isOverflowing();
      };

      syncToggleVisibility();
      window.addEventListener("resize", syncToggleVisibility);

      button.addEventListener("click", () => {
        const expanded = wrap.classList.toggle("is-expanded");
        button.textContent = expanded ? "View less" : "View more";
        button.setAttribute("aria-expanded", String(expanded));
        syncToggleVisibility();
      });
    });
  }

  initMissionTextExpand();
</script>
