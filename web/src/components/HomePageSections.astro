---
import type {
  PublicFeaturedProduct,
  PublicPageSectionRecord,
} from "@/lib/public-website/content";
import MissionExpandableText from "@/components/MissionExpandableText.astro";
import { toAdminContentPreviewHref } from "@/lib/public-website/admin-content-preview";
import { resolvePublicStorageUrl } from "@/lib/supabase/storage";

type Props = {
  sections: PublicPageSectionRecord[];
  featuredProducts: PublicFeaturedProduct[];
  previewRoot?: string;
};

const { sections, featuredProducts, previewRoot } = Astro.props;

function linkHref(href: string) {
  return previewRoot ? toAdminContentPreviewHref(href) : href;
}

const about = sections.find((section) => section.type === "about");
const missionVisionCoreValues = sections.find(
  (section) => section.type === "mission_vision_core_values",
);
const taglines = sections.find((section) => section.type === "taglines");
const shopInfoSource = sections.find(
  (section) => section.type === "images_gallery",
);

const coreValuesText = coreValuesContent(
  missionVisionCoreValues?.content.coreValues,
);
const taglineItems = asStringArray(taglines?.content.items);
const storefrontBenefits = [
  {
    title: "Direct from Local Farmers",
