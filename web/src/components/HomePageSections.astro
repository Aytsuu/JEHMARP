---
import type {
  PublicFeaturedProduct,
  PublicPageSectionRecord,
} from "@/lib/public-website/content";
import { toAdminContentPreviewHref } from "@/lib/public-website/admin-content-preview";
import { resolvePublicStorageUrl } from "@/lib/supabase/storage";

type Props = {
  sections: PublicPageSectionRecord[];
  featuredProducts: PublicFeaturedProduct[];
  previewRoot?: string;
};

const { sections, featuredProducts, previewRoot } = Astro.props;

function linkHref(href: string) {
  return previewRoot ? toAdminContentPreviewHref(href) : href;
}

const about = sections.find((section) => section.type === "about");
const missionVisionCoreValues = sections.find(
  (section) => section.type === "mission_vision_core_values",
);
const taglines = sections.find((section) => section.type === "taglines");
const shopInfoSource = sections.find(
  (section) => section.type === "images_gallery",
);

const coreValues = asStringArray(missionVisionCoreValues?.content.coreValues);
const taglineItems = asStringArray(taglines?.content.items);
const storefrontBenefits = [
  {
    title: "Direct from Local Farmers",
    desc: "Partnering with trusted local farmers ensures the delivery of the best quality meat while supporting local agriculture.",
    class: "why-buy-card--0",
  },
  {
    title: "Guaranteed Freshness",
    desc: "Every product is freshly delivered and carefully handled daily to meet strict standards of top-notch freshness.",
    class: "why-buy-card--1",
  },
  {
    title: "Affordable & Fair Pricing",
    desc: "Premium quality meat is offered at fair, budget-friendly prices accessible to every family.",
    class: "why-buy-card--2",
  },
  {
    title: "Trusted Family Experience",
    desc: "A multi-generational, family-run business built on a foundation of honesty, dedication, and genuine care for its customers.",
    class: "why-buy-card--3",
  },
  {
    title: "Community-Centered Business",
    desc: "Dedicated to giving back, supporting community livelihoods, and uplifting the local neighborhood that has supported the business throughout the years.",
    class: "why-buy-card--4",
  },
];
const orderingSteps = [
  "Choose your cuts and preferred quantities.",
  "Confirm pickup or delivery details with the shop.",
  "Receive fresh meat packed and ready for cooking.",
];
const storeDetails = [
  { label: "Store hours", value: "Open Daily (3:00AM - 8:00PM)" },
  { label: "Phone", value: "09322159289 / 09177770118" },
  { label: "Location", value: "Compostela Public Market / Consolacion Public Market" },
  {
    label: "Email",
    value: "jehmarp2020@gmail.com",
  },
];
const faqItems = [
  {
    question: "Is the meat fresh or frozen?",
    answer:
      "Fresh cuts are prepared daily and packed on-site for the day’s orders.",
  },
  {
    question: "Do you accept custom cuts?",
    answer:
      "Yes. You can request preferred thickness, portioning, and preparation when ordering.",
  },
  {
    question: "Can I order in bulk?",
    answer:
      "Yes. Family packs, party orders, and business quantities can be arranged ahead of time.",
  },
  {
    question: "Do you offer pickup and delivery?",
    answer:
      "Pickup is supported directly, and delivery can be coordinated based on your area.",
  },
];

function stringValue(value: unknown): string | undefined {
  return typeof value === "string" && value.trim().length > 0
    ? value.trim()
    : undefined;
}

function asStringArray(value: unknown): string[] {
  if (!Array.isArray(value)) {
    return [];
  }

  return value.flatMap((item) =>
    typeof item === "string" && item.trim().length > 0 ? [item.trim()] : [],
  );
}

function getProductImage(name: string): string {
  const normalized = name.toLowerCase();
  if (normalized.includes("pork belly")) return "/images/pork_belly.png";
  if (normalized.includes("chicken breast"))
    return "/images/chicken_breast.png";
  if (normalized.includes("short ribs") || normalized.includes("beef"))
    return "/images/beef_short_ribs.png";
  if (normalized.includes("ground pork")) return "/images/ground_pork.png";
  return "/images/meat_cluster.svg";
}

function getFeaturedProductImage(product: PublicFeaturedProduct): string {
  return resolvePublicStorageUrl(product.image_path) ?? getProductImage(product.name);
}

function formatTagline(tagline: string): string {
  let formatted = tagline;
  if (formatted.includes("for everyday")) {
    formatted = formatted.replace("for everyday", "<em>for everyday</em>");
  } else if (formatted.includes("practical")) {
    formatted = formatted.replace("practical", "<em>practical</em>");
  } else if (formatted.includes("dependable")) {
    formatted = formatted.replace("dependable", "<em>dependable</em>");
  } else {
    const words = formatted.split(" ");
    if (words.length > 3) {
      const midStart = Math.floor(words.length / 2) - 1;
      const midEnd = midStart + 2;
      words[midStart] = "<em>" + words[midStart];
      words[midEnd - 1] = words[midEnd - 1] + "</em>";
      formatted = words.join(" ");
    }
  }
  return formatted;
}
---

<div class="home-sections">
  {
    about && (
      <div class="home-container">
        <section class="about-section" aria-labelledby="home-about">
          <div class="about-section__grid">
            <div class="about-section__image-container">
              <img
                src="/images/about_photo.png"
                alt="JEHMARP fresh local cuts and shop photo"
                class="about-section__image"
              />
            </div>
            <div class="about-section__content">
              <h2 id="home-about" class="about-section__title">
                THE MEATSHOP
              </h2>
              {stringValue(about.content.summary) && (
                <p class="about-section__summary">
                  {stringValue(about.content.summary)}
                </p>
              )}
              {stringValue(about.content.body) && (
                <p class="about-section__body">
                  {stringValue(about.content.body)}
                </p>
              )}
            </div>
          </div>
        </section>
      </div>
    )
  }

  {
    missionVisionCoreValues && (
      <div class="mission-section-outer">
        <div class="home-container">
          <section
            class="mission-section"
            aria-label="Mission, Vision, and Core Values"
          >
            <div class="mission-section__grid">
              <article class="mission-card mission-card--mission">
                <h3 class="mission-card__heading">
                  Mission
                </h3>
                <p class="mission-card__text">
                  {stringValue(missionVisionCoreValues.content.mission) ??
                    "Mission content is not available yet."}
                </p>
              </article>
              <article class="mission-card mission-card--vision">
                <h3 class="mission-card__heading">
                  Vision
                </h3>
                <p class="mission-card__text">
                  {stringValue(missionVisionCoreValues.content.vision) ??
                    "Vision content is not available yet."}
                </p>
              </article>
              <article class="mission-card mission-card--values">
                <h3 class="mission-card__heading">
                  Core Values
                </h3>
                {coreValues.length > 0 ? (
                  <ul class="mission-card__list">
                    {coreValues.map((value) => (
                      <li class="mission-card__list-item">{value}</li>
                    ))}
                  </ul>
                ) : (
                  <p class="mission-card__text">
                    Core values have not been added yet.
                  </p>
                )}
              </article>
            </div>
          </section>
        </div>
      </div>
    )
  }

  {
    taglines && (
      <div class="tagline-section">
        <div class="home-container">
          <div class="tagline-container">
            <div class="tagline-display-stack">
              {taglineItems.length > 0 ? (
                taglineItems.map((tagline) => (
                  <p class="tagline-headline">
                    <span set:html={formatTagline(tagline)} />
                  </p>
                ))
              ) : (
                <p class="tagline-headline">
                  Taglines have not been added yet.
                </p>
              )}
            </div>
            <a href={linkHref("/our-story")} class="tagline-button">
              Our Story
            </a>
          </div>
        </div>
      </div>
    )
  }

  {
    shopInfoSource && (
      <>
        <div class="why-buy-section">
          <div class="home-container">
            <section aria-labelledby="home-why-buy">
              <h2
                id="home-why-buy"
                class="why-buy-section__title"
              >
                Why Choose JEHMARP
              </h2>
              <div class="why-buy-section__grid">
                {storefrontBenefits.map((benefit) => {
                  return (
                    <div class={`why-buy-card ${benefit.class}`}>
                      <div class="why-buy-card__content">
                        <h3 class="why-buy-card__title">{benefit.title}</h3>
                        <p class="why-buy-card__desc">{benefit.desc}</p>
                      </div>
                    </div>
                  );
                })}
              </div>
            </section>
          </div>
        </div>

        <div class="featured-products-section">
          <div class="home-container">
            <section aria-labelledby="home-featured-products">
              <div class="featured-products__header">
                <h2
                  id="home-featured-products"
                  class="featured-products__title"
                >
                  Featured products
                </h2>
                <a href={linkHref("/shop")} class="featured-products__link">
                  Browse all products
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </>
                  </svg>
                </a>
              </div>
              <div class="products-grid">
                {featuredProducts.length > 0 ? (
                  featuredProducts.map((product) => (
                    <article class="product-card">
                      <div class="product-card__image-container">
                        <img
                          src={getFeaturedProductImage(product)}
                          alt={product.name}
                          class="product-card__image"
                        />
                      </div>
                      <div class="product-card__content">
                        <h3 class="product-card__title">{product.name}</h3>
                        <p class="product-card__description">
                          {product.description ?? "Fresh, carefully prepared cuts available from the JEHMARP product catalog."}
                        </p>
                      </div>
                    </article>
                  ))
                ) : (
                  <p class="empty-state">No active products are available yet.</p>
                )}
              </div>
            </section>
          </div>
        </div>

        <div class="ordering-works-section">
          <div class="home-container">
            <section aria-labelledby="home-ordering-process">
              <h2
                id="home-ordering-process"
                class="ordering-section__title"
              >
                How ordering works
              </h2>
              <div class="ordering-stepper">
                {orderingSteps.map((step, index) => (
                  <div class="stepper-step">
                    <div class="stepper-step__number">0{index + 1}</div>
                    <p class="stepper-step__text">{step}</p>
                  </div>
                ))}
              </div>
            </section>
          </div>
        </div>

        <div class="store-details-section">
          <div class="home-container">
            <section aria-labelledby="home-store-details">
              <h2
                id="home-store-details"
                class="store-details__title"
              >
                Store details
              </h2>
              <div class="store-details__grid">
                {storeDetails.map((detail, index) => (
                  <div class="detail-card">
                    <div class="detail-card__icon">
                      {index === 0 && (
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <circle cx="12" cy="12" r="10" />
                          <polyline points="12 6 12 12 16 14" />
                        </svg>
                      )}
                      {index === 1 && (
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                        </svg>
                      )}
                      {index === 2 && (
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                          <circle cx="12" cy="10" r="3" />
                        </svg>
                      )}
                      {index === 3 && (
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                        </svg>
                      )}
                    </div>
                    <h3 class="detail-card__label">{detail.label}</h3>
                    <p class="detail-card__value">{detail.value}</p>
                  </div>
                ))}
              </div>
            </section>
          </div>
        </div>

        <div class="faq-section">
          <div class="home-container">
            <section aria-labelledby="home-faq">
              <div class="faq-section__grid">
                <div class="faq-section__intro">
                  <h2 id="home-faq" class="faq-section__title">
                    FREQUENTLY ASKED QUESTIONS
                  </h2>
                  <p class="faq-section__desc">
                    Find quick answers to common questions about our fresh meat
                    cuts, ordering process, and pickup/delivery options.
                  </p>
                </div>
                <div class="faq-accordion">
                  {faqItems.map((item) => (
                    <article class="faq-item">
                      <button class="faq-item__trigger" type="button">
                        {item.question}
                        <span class="faq-item__icon">+</span>
                      </button>
                      <div class="faq-item__content">
                        <p>{item.answer}</p>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            </section>
          </div>
        </div>
      </>
    )
  }
</div>

<script>
  // Dynamic FAQ Accordion toggle behavior
  const faqItems = document.querySelectorAll(".faq-item");
  faqItems.forEach((item) => {
    const trigger = item.querySelector(".faq-item__trigger");
    trigger?.addEventListener("click", () => {
      const isActive = item.classList.contains("faq-item--active");
      // Collapse all FAQ items first
      faqItems.forEach((i) => i.classList.remove("faq-item--active"));
      if (!isActive) {
        // Expand clicked FAQ item
        item.classList.add("faq-item--active");
      }
    });
  });
</script>
