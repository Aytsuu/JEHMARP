---
import { formatDateTime } from "@/lib/admin-dashboard/view";
import type { OrderDetailNavEntry } from "@/lib/order-detail-nav";

type Props = {
  currentCode: string;
  entries: OrderDetailNavEntry[];
  menuLabel?: string;
  titleClass?: string;
};

const {
  currentCode,
  entries,
  menuLabel = "Other orders",
  titleClass = "",
} = Astro.props;
---

<div class="order-detail-nav" data-order-detail-nav>
  <button
    type="button"
    class="order-detail-nav__trigger"
    data-order-detail-nav-trigger
    aria-haspopup="listbox"
    aria-expanded="false"
  >
    <h1 class:list={["order-detail-nav__title", titleClass]}>{currentCode}</h1>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>
  <div class="order-detail-nav__menu" data-order-detail-nav-menu hidden>
    <ul role="listbox" aria-label={menuLabel}>
      {
        entries.map((entry) => (
          <li>
            <a
              href={entry.href}
              class:list={[
                "order-detail-nav__option",
                entry.isCurrent && "is-current",
              ]}
              aria-current={entry.isCurrent ? "page" : undefined}
            >
              <span>{entry.code}</span>
              <time datetime={entry.createdAt}>{formatDateTime(entry.createdAt)}</time>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  import "@/lib/client/order-detail-nav";
</script>

<style>
  .order-detail-nav {
    position: relative;
    min-width: 0;
  }

  .order-detail-nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: none;
    background: transparent;
    padding: 0;
    cursor: pointer;
    color: inherit;
    text-align: left;
    text-transform: none;
    letter-spacing: normal;
  }

  .order-detail-nav__title {
    margin: 0;
    font-size: inherit;
    line-height: 1.15;
    text-transform: none;
    letter-spacing: normal;
  }

  .order-detail-nav__trigger svg {
    width: 1rem;
    height: 1rem;
    color: rgba(17, 24, 39, 0.55);
    flex-shrink: 0;
  }

  .order-detail-nav__menu {
    position: absolute;
    top: calc(100% + 0.45rem);
    left: 0;
    z-index: 20;
    width: min(22rem, calc(100vw - 2rem));
    max-height: 16rem;
    overflow: auto;
    border: 1px solid rgba(17, 24, 39, 0.1);
    border-radius: 0.85rem;
    background: #fff;
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
  }

  .order-detail-nav__menu ul {
    list-style: none;
    margin: 0;
    padding: 0.35rem;
  }

  .order-detail-nav__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.65rem;
    color: #111827;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .order-detail-nav__option time {
    color: rgba(17, 24, 39, 0.55);
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .order-detail-nav__option:hover,
  .order-detail-nav__option:focus-visible {
    background: rgba(102, 24, 24, 0.06);
    outline: none;
  }

  .order-detail-nav__option.is-current {
    background: rgba(102, 24, 24, 0.08);
    color: #661818;
  }
</style>
