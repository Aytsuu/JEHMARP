---
import { adminPaginationPageSizes, formatRecordCount, type AdminPagination } from "@/lib/admin-dashboard/pagination";

type Props = {
  pagination?: AdminPagination;
  variant?: "full" | "summary" | "controls";
};

const { pagination, variant = "full" } = Astro.props;
const showSummary = variant === "full" || variant === "summary";
const showControls = variant === "full" || variant === "controls";
const hasRecords = !pagination || pagination.totalRows > 0;
---

<footer
  class:list={[
    "dashboard-interactive-table__footer",
    variant === "controls" && "dashboard-interactive-table__footer--controls",
    variant === "summary" && "dashboard-interactive-table__footer--summary",
  ]}
  data-server-pagination-footer={pagination ? "true" : undefined}
  data-current-page={pagination?.page}
  data-total-pages={pagination?.totalPages}
  data-total-rows={pagination?.totalRows}
  data-page-size={pagination?.pageSize}
>
  <div
    class:list={[
      "table-pagination",
      variant === "controls" && "table-pagination--controls-only",
      variant === "summary" && "table-pagination--summary-only",
    ]}
  >
    {
      !hasRecords && pagination ? (
        <div class="table-pagination__empty" data-page-info>
          No records found
        </div>
      ) : (
        <div class="table-pagination__controls table-pagination__controls--merged">
          {
            showControls && (
              <button
                type="button"
                data-pagination-prev
                data-page={pagination ? Math.max(pagination.page - 1, 1) : undefined}
                class="btn-secondary table-pagination__arrow"
                aria-label="Previous page"
                disabled={pagination ? pagination.page <= 1 : undefined}
              >
                <svg class="table-pagination__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m15 18-6-6 6-6"></path>
                </svg>
              </button>
            )
          }

          {
            showControls && (
              <div class="table-pagination__page-editor" data-page-info>
                <span class="table-pagination__page-label">Page</span>
                <input
                  type="text"
                  inputmode="numeric"
                  pattern="[0-9]*"
                  data-pagination-page-input
                  data-digits-only
                  class="table-pagination__page-input"
                  value={pagination?.page ?? "1"}
                  aria-label="Current page"
                />
                <span class="table-pagination__page-total">
                  of <span data-total-pages>{pagination?.totalPages ?? "1"}</span>
                </span>
              </div>
            )
          }

          {
            showControls && (
              <button
                type="button"
                data-pagination-next
                data-page={pagination ? Math.min(pagination.page + 1, pagination.totalPages) : undefined}
                class="btn-secondary table-pagination__arrow"
                aria-label="Next page"
                disabled={pagination ? pagination.page >= pagination.totalPages : undefined}
              >
                <svg class="table-pagination__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"></path>
                </svg>
              </button>
            )
          }

          {
            showSummary && (
              <label class="table-pagination__limit">
                <select data-limit-select>
                  {adminPaginationPageSizes.map((pageSize) => (
                    <option value={pageSize} selected={pagination?.pageSize === pageSize}>
                      {pageSize} rows
                    </option>
                  ))}
                </select>
              </label>
            )
          }

          {
            showSummary && (
              <span class="table-pagination__record-count" data-total-records>
                {pagination ? formatRecordCount(pagination.totalRows) : ""}
              </span>
            )
          }
        </div>
      )
    }
  </div>
</footer>
