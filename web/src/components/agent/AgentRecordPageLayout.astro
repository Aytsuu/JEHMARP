---
import type { AgentDashboardData } from "@/lib/agent-dashboard/data";
import AgentPageBrand from "@/components/agent/AgentPageBrand.astro";
import PageAvailabilityNotice from "@/components/dashboard/PageAvailabilityNotice.astro";
import RouteBackButton from "@/components/dashboard/RouteBackButton.astro";
import { getAgentUnreadNotificationIds } from "@/lib/agent-dashboard/notifications";
import { agentDashboardRoutes } from "@/config/navigation";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getDashboardPageAvailability } from "@/lib/page-availability";
import { isAgentMobilePrimaryRoute } from "@/lib/dashboard/agent-navigation";

type Props = {
  title: string;
  description: string;
  heading: string;
  intro?: string;
  backUrl?: string;
  backLabel?: string;
  feedback?: {
    status?: string;
    error?: string;
    cleanPath?: string;
  };
  dashboardData?: AgentDashboardData;
  contentMaxWidth?: string;
};

const {
  title,
  description,
  heading,
  intro,
  backUrl,
  backLabel,
  feedback,
  dashboardData,
  contentMaxWidth = "48rem",
} = Astro.props;
const headingId = `${heading
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "")}-title`;
const notificationIds = dashboardData ? getAgentUnreadNotificationIds(dashboardData) : [];
const pageAvailability = getDashboardPageAvailability(Astro.url.pathname);
const isPageReady = pageAvailability.status === "ready";
const hasHeadingMeta = Astro.slots.has("heading-meta");
const hasHeadingAside = Astro.slots.has("heading-aside");
const hasHeadingTitle = Astro.slots.has("heading-title");
const isAgentPrimaryPage = isAgentMobilePrimaryRoute(Astro.url.pathname);
const isAgentProfilePage = Astro.url.pathname === "/agent/profile";
const resolvedContentMaxWidth = isAgentProfilePage ? "40rem" : contentMaxWidth;
---

<DashboardLayout
  title={title}
  description={description}
  navLabel="Agent operations"
  navItems={agentDashboardRoutes}
  sidebarUnreadBadges={{
    "/agent/notifications": {
      ids: notificationIds,
      storageKey: "agent-read-notifications",
    },
  }}
>
  <div
    class="admin-notifications-page"
    data-dashboard-record-page
    data-admin-record-page
    data-agent-record-page
    data-agent-notifications-page
    data-agent-primary-page={isAgentPrimaryPage || undefined}
    data-agent-profile-page={isAgentProfilePage || undefined}
  >
    <div
      class="admin-notifications-page__inner"
      style={`--notifications-page-max-width: ${resolvedContentMaxWidth};`}
    >
      <header class="admin-notifications-page__header">
        {
          isAgentPrimaryPage && (
            <AgentPageBrand />
          )
        }
        <div class="admin-notifications-page__heading-row">
          {backUrl && (
            <RouteBackButton href={backUrl} label={backLabel ?? `Back from ${heading}`} />
          )}
          <div
            class:list={[
              "admin-notifications-page__heading-main",
              hasHeadingAside && "admin-notifications-page__heading-main--with-aside",
            ]}
          >
            <div class="admin-notifications-page__heading-copy">
              {
                hasHeadingTitle ? (
                  <div class="admin-notifications-page__title-slot">
                    <slot name="heading-title" />
                  </div>
                ) : (
                  <h1 id={headingId} class="admin-notifications-page__title">{heading}</h1>
                )
              }
              {
                hasHeadingMeta ? (
                  <div class="admin-notifications-page__heading-meta">
                    <slot name="heading-meta" />
                  </div>
                ) : (
                  intro && (
                    <p class="admin-notifications-page__intro">{intro}</p>
                  )
                )
              }
            </div>
            {
              hasHeadingAside && (
                <div class="admin-notifications-page__heading-aside">
                  <slot name="heading-aside" />
                </div>
              )
            }
          </div>
        </div>
      </header>

      {
        feedback?.status && (
          <p class="status-message" role="status">
            {feedback.status}
          </p>
        )
      }
      {
        feedback?.error && (
          <p class="error-message" role="alert">
            {feedback.error}
          </p>
        )
      }

      <div class="admin-notifications-page__content">
        {isPageReady ? <slot /> : <PageAvailabilityNotice availability={pageAvailability} />}
      </div>
    </div>
  </div>
</DashboardLayout>

{
  feedback?.cleanPath && (
    <script is:inline define:vars={{ agentFeedbackCleanPath: feedback.cleanPath }}>
      if (typeof agentFeedbackCleanPath === "string" && window.history.replaceState) {
        window.history.replaceState(window.history.state, "", agentFeedbackCleanPath);
      }
    </script>
  )
}

<style>
  .admin-notifications-page__heading-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .admin-notifications-page__heading-row:has(.admin-notifications-page__heading-meta) {
    align-items: flex-start;
  }

  .admin-notifications-page__heading-row:has(.admin-notifications-page__heading-meta) .route-back-button {
    margin-top: 0.15rem;
  }

  .admin-notifications-page__heading-row:not(:has(.admin-notifications-page__heading-meta))
    .admin-notifications-page__title {
    line-height: 2.5rem;
  }

  .admin-notifications-page__heading-row:not(:has(.admin-notifications-page__heading-meta))
    .admin-notifications-page__heading-aside {
    align-self: center;
    padding-top: 0;
  }

  [data-agent-primary-page] .admin-notifications-page__heading-main--with-aside {
    align-items: center;
  }

  .admin-notifications-page__heading-main--with-aside {
    align-items: center;
  }

  .admin-notifications-page__heading-main {
    min-width: 0;
    flex: 1;
  }

  .admin-notifications-page__heading-main--with-aside {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .admin-notifications-page__heading-copy {
    min-width: 0;
    flex: 1;
  }

  .admin-notifications-page__heading-aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.45rem;
    flex-shrink: 0;
    padding-top: 0.15rem;
  }

  .admin-notifications-page__title {
    margin: 0;
    font-size: clamp(1.4rem, 1.9vw, 1.85rem);
    line-height: 1;
    font-weight: 700;
    color: #000000;
    letter-spacing: -0.025em;
  }

  .admin-notifications-page__intro {
    margin: 0.4rem 0 0;
    max-width: none;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-brand-muted-black);
  }

  .admin-notifications-page__heading-meta {
    margin-top: 0.65rem;
  }

  .admin-notifications-page__heading-meta :global(.record-meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .admin-notifications-page__heading-meta :global(.record-meta__item) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--color-brand-muted-black);
  }

  .admin-notifications-page__heading-meta :global(.record-meta__icon) {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
    color: #6b7280;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .admin-notifications-page__heading-meta :global(.record-meta__text) {
    min-width: 0;
    white-space: pre-line;
  }
</style>
