---
import Sheet from "@/components/ui/Sheet.astro";
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import type { AgentDashboardData } from "@/lib/agent-dashboard/data";
import ViewButton from "@/components/ViewButton.astro";
import {
  formatCurrency,
  formatDate,
  fullName,
  orderTotal,
} from "@/lib/agent-dashboard/view";
import { formatOrderSource } from "@/lib/formatters";

type Props = {
  data: AgentDashboardData;
};

const { data } = Astro.props;
const canSubmitOrder = data.products.length > 0;
const hasAssignedCustomers = data.customers.length > 0;
---

<section class="admin-panel" aria-labelledby="agent-orders-title">
  <Sheet id="agent-create-order-sheet" width="42rem">
    <div slot="header" class="order-create-sheet__header-copy">
      <h3 class="drawer-sheet__title" data-sheet-title>Submit Order</h3>
      <p class="order-create-sheet__header-description">
        Select an assigned customer or enter customer details, then add products for admin review.
      </p>
    </div>
    <form
      id="agent-create-order-form"
      method="post"
      class="order-create-form"
      aria-labelledby="agent-order-form-title"
      data-agent-order-form
      data-can-submit-order={String(canSubmitOrder)}
    >
      <input type="hidden" name="action" value="create-agent-order" />
      <h3 id="agent-order-form-title" class="sr-only">New agent order</h3>

      {!canSubmitOrder && (
        <p class="empty-state">
          No active products are available for order submission.
        </p>
      )}

      <section class="order-create-section">
        <h3 class="order-create-section__title">Customer</h3>
        <div class="order-create-section__body">
        <div class="admin-form-grid">
          <label class="field-row" data-existing-customer-field>
            <span>Customer</span>
            <select name="customerId" disabled={!canSubmitOrder || !hasAssignedCustomers}>
              <option value="">Select customer</option>
              {data.customers.map((customer) => (
                <option
                  value={customer.id}
                  data-customer-first-name={customer.first_name}
                  data-customer-last-name={customer.last_name}
                  data-customer-phone-number={customer.phone_number}
                  data-customer-email={customer.email ?? ""}
                  data-customer-address={customer.address}
                >
                  {fullName(customer)} - {customer.phone_number}
                </option>
              ))}
            </select>
          </label>
        </div>
        </div>
      </section>

        <fieldset
          class="order-create-section fieldset-block"
          data-customer-details-fields
          disabled={!canSubmitOrder}
        >
          <legend class="order-create-section__title">Customer details</legend>
          <div class="order-create-section__body">
          <div class="admin-form-grid">
            <label class="field-row"><span>First name</span><input name="firstName" required data-customer-first-name /></label>
            <label class="field-row"><span>Last name</span><input name="lastName" required data-customer-last-name /></label>
            <label class="field-row"><span>Phone number</span><input name="phoneNumber" required data-customer-phone-number /></label>
            <label class="field-row"><span>Email</span><input name="email" type="email" data-customer-email /></label>
          </div>
          <label class="field-row"><span>Address</span><textarea name="address" required data-customer-address></textarea></label>
          </div>
        </fieldset>

        <section class="order-create-section">
          <div class="order-create-section__header">
            <h3 class="order-create-section__title">Order items</h3>
          </div>
          <div class="order-create-section__body">
        <div class="table-wrap order-create-form__items-table">
          <table>
            <caption>Order items</caption>
            <thead>
              <tr>
                <th scope="col">Product</th>
                <th scope="col">Quantity</th>
                <th scope="col">Details</th>
                <th scope="col">Manage</th>
              </tr>
            </thead>
            <tbody data-agent-order-items>
              <tr data-agent-order-item-row>
                <td>
                  <label class="field-row">
                    <span>Product <span data-row-number>1</span></span>
                    <select name="productId" required disabled={!canSubmitOrder}>
                      <option value="">Select product</option>
                      {data.products.map((product) => (
                        <option value={product.id}>
                          {product.name} - {formatCurrency(product.default_price)} per {product.unit_label}
                        </option>
                      ))}
                    </select>
                  </label>
                </td>
                <td>
                  <label class="field-row">
                    <span>Quantity <span data-row-number>1</span></span>
                    <input name="quantity" type="number" min="0.001" step="0.001" required disabled={!canSubmitOrder} />
                  </label>
                </td>
                <td>
                  <label class="field-row">
                    <span>Details <span data-row-number>1</span></span>
                    <textarea name="addDetails" placeholder="Cut, packing, or delivery notes" disabled={!canSubmitOrder}></textarea>
                  </label>
                </td>
                <td>
                  <span class="empty-state">Required</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <template data-agent-order-item-template>
          <tr data-agent-order-item-row>
            <td>
              <label class="field-row">
                <span>Product <span data-row-number></span></span>
                <select name="productId" required disabled={!canSubmitOrder}>
                  <option value="">Select product</option>
                  {data.products.map((product) => (
                    <option value={product.id}>
                      {product.name} - {formatCurrency(product.default_price)} per {product.unit_label}
                    </option>
                  ))}
                </select>
              </label>
            </td>
            <td>
              <label class="field-row">
                <span>Quantity <span data-row-number></span></span>
                <input name="quantity" type="number" min="0.001" step="0.001" required disabled={!canSubmitOrder} />
              </label>
            </td>
            <td>
              <label class="field-row">
                <span>Details <span data-row-number></span></span>
                <textarea name="addDetails" placeholder="Cut, packing, or delivery notes" disabled={!canSubmitOrder}></textarea>
              </label>
            </td>
            <td>
              <button type="button" data-remove-agent-order-item>Remove</button>
            </td>
          </tr>
        </template>

        <button
          type="button"
          class="order-create-form__add-item"
          data-add-agent-order-item
          disabled={!canSubmitOrder}
        >
          <span>Add item</span>
        </button>
          </div>
        </section>
    </form>
    <div slot="footer" class="order-create-sheet__footer">
      <button
        type="submit"
        form="agent-create-order-form"
        disabled={!canSubmitOrder}
      >
        Submit for review
      </button>
    </div>
  </Sheet>
</section>

<section class="admin-panel" aria-labelledby="agent-order-list-title">

  {data.orders.length === 0 ? (
    <p class="empty-state">No accessible orders yet.</p>
  ) : (
    <div data-interactive-table class="dashboard-interactive-table">
      <div class="table-filters order-management-toolbar">
        <div class="table-filters__search order-filter-form__field order-filter-form__field--search">
          <input
            type="text"
            placeholder="Search orders..."
            data-search-input
            aria-label="Search orders"
          />
        </div>
        <div class="order-management-toolbar__actions">
          <button
            type="button"
            class="btn-table-manage order-management-toolbar__create"
            data-open-create-sheet
            data-sheet-target="#agent-create-order-sheet"
            disabled={!canSubmitOrder}
          >
            Submit Order
          </button>
        </div>
      </div>

      <div class="dashboard-interactive-table__surface">
        <DashboardTableBoard>
          <table class="dashboard-table">
            <thead>
              <tr>
                <th scope="col">Customer</th>
                <th scope="col">Date</th>
                <th scope="col">Source</th>
                <th scope="col">Order Status</th>
                <th scope="col">Payment Status</th>
                <th scope="col">Order Total</th>
                <th scope="col">Action</th>
              </tr>
            </thead>
            <tbody>
              {data.orders.map((order) => {
                const invoice = order.invoice.length > 0;
                const total = orderTotal(order, invoice ? "final_quantity" : "partial_quantity");

                return (
                  <tr data-status={order.order_status}>
                    <td class="dashboard-table__cell--truncate">
                      {order.customer ? fullName(order.customer) : "Guest"}
                    </td>
                    <td>{formatDate(order.created_at)}</td>
                    <td>{formatOrderSource(order.source)}</td>
                    <td><StatusBadge kind="order" status={order.order_status} /></td>
                    <td><StatusBadge kind="payment" status={order.payment_status} /></td>
                    <td>{formatCurrency(total)}</td>
                    <td>
                      <ViewButton href={`/agent/orders/${order.id}`} />
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </DashboardTableBoard>
      </div>

      <DashboardTablePagination />
    </div>
  )}
</section>

<script>
  function initAgentOrderForm() {
    const orderForm = document.querySelector<HTMLElement>("[data-agent-order-form]");
    if (!orderForm || orderForm.dataset.agentOrderFormInitialized === "true") return;
    orderForm.dataset.agentOrderFormInitialized = "true";

    const orderItems = document.querySelector("[data-agent-order-items]");
    const orderItemTemplate = document.querySelector<HTMLTemplateElement>("[data-agent-order-item-template]");
    const addOrderItemButton = document.querySelector<HTMLButtonElement>("[data-add-agent-order-item]");
    const existingCustomerField = document.querySelector<HTMLElement>("[data-existing-customer-field]");
    const existingCustomerSelect = existingCustomerField?.querySelector<HTMLSelectElement>("select[name='customerId']");
    const customerDetailsFields = document.querySelector<HTMLFieldSetElement>("[data-customer-details-fields]");
    const firstNameInput = document.querySelector<HTMLInputElement>("input[data-customer-first-name]");
    const lastNameInput = document.querySelector<HTMLInputElement>("input[data-customer-last-name]");
    const phoneNumberInput = document.querySelector<HTMLInputElement>("input[data-customer-phone-number]");
    const emailInput = document.querySelector<HTMLInputElement>("input[data-customer-email]");
    const addressTextarea = document.querySelector<HTMLTextAreaElement>("textarea[data-customer-address]");
    const canSubmitOrder = orderForm.dataset.canSubmitOrder === "true";

    function refreshOrderItemRowNumbers() {
      if (!orderItems) return;

      orderItems.querySelectorAll("[data-agent-order-item-row]").forEach((row, index) => {
        row.querySelectorAll("[data-row-number]").forEach((label) => {
          label.textContent = String(index + 1);
        });
      });
    }

    addOrderItemButton?.addEventListener("click", () => {
      const templateRow = orderItemTemplate?.content.firstElementChild;

      if (!orderItems || !templateRow) return;

      orderItems.append(templateRow.cloneNode(true));
      refreshOrderItemRowNumbers();
    });

    orderItems?.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof HTMLElement) || !target.matches("[data-remove-agent-order-item]")) return;

      target.closest("[data-agent-order-item-row]")?.remove();
      refreshOrderItemRowNumbers();
    });

    function getSelectedCustomerOption() {
      if (!existingCustomerSelect?.value) return undefined;

      return existingCustomerSelect.selectedOptions[0];
    }

    function fillCustomerFields(customer: HTMLOptionElement | undefined) {
      if (firstNameInput) firstNameInput.value = customer?.dataset.customerFirstName ?? "";
      if (lastNameInput) lastNameInput.value = customer?.dataset.customerLastName ?? "";
      if (phoneNumberInput) phoneNumberInput.value = customer?.dataset.customerPhoneNumber ?? "";
      if (emailInput) emailInput.value = customer?.dataset.customerEmail ?? "";
      if (addressTextarea) addressTextarea.value = customer?.dataset.customerAddress ?? "";
    }

    function refreshCustomerFields() {
      const selectedCustomer = getSelectedCustomerOption();

      if (selectedCustomer) {
        fillCustomerFields(selectedCustomer);
      } else if (document.activeElement === existingCustomerSelect) {
        fillCustomerFields(undefined);
      }

      if (customerDetailsFields) {
        customerDetailsFields.disabled = Boolean(selectedCustomer) || !canSubmitOrder;
      }
    }

    existingCustomerSelect?.addEventListener("change", refreshCustomerFields);
    refreshCustomerFields();
    refreshOrderItemRowNumbers();
  }

  document.addEventListener("DOMContentLoaded", initAgentOrderForm);
  document.addEventListener("astro:after-swap", initAgentOrderForm);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAgentOrderForm();
  }
</script>
