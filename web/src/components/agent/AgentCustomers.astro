---
import AgentRecordCard from "@/components/agent/AgentRecordCard.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import type { AgentDashboardData } from "@/lib/agent-dashboard/data";
import { fullName } from "@/lib/agent-dashboard/view";

type Props = {
  data: AgentDashboardData;
};

const { data } = Astro.props;
---

<section class="admin-panel agent-customers" aria-labelledby="agent-customers-title">
  {data.customers.length === 0 ? (
    <p class="empty-state">No customers yet.</p>
  ) : (
    <div data-interactive-table class="dashboard-interactive-table agent-customers__table">
      <div class="table-filters order-management-toolbar agent-customers__toolbar">
        <div class="table-filters__search order-filter-form__field order-filter-form__field--search">
          <input
            type="text"
            placeholder="Search customers..."
            data-search-input
            aria-label="Search customers"
          />
        </div>
      </div>

      <div class="agent-customers__pagination-summary">
        <DashboardTablePagination variant="summary" />
      </div>

      <div class="agent-record-list agent-customers__list" data-interactive-cards>
        {data.customers.map((customer) => (
          <AgentRecordCard href={`/agent/customers/${customer.id}`}>
            <div class="agent-customers-card">
              <div class="agent-customers-card__header">
                <h3 class="agent-customers-card__name">
                  {fullName(customer)}
                  {customer.is_reseller && (
                    <span class="agent-record-card__tag">Reseller</span>
                  )}
                </h3>
              </div>

              <ul class="agent-customers-card__details">
                <li class="agent-customers-card__detail">
                  <span class="agent-customers-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                  </span>
                  <span class="agent-customers-card__value">{customer.address}</span>
                </li>
                <li class="agent-customers-card__detail">
                  <span class="agent-customers-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                  </span>
                  <span class="agent-customers-card__value">{customer.phone_number}</span>
                </li>
                <li class="agent-customers-card__detail">
                  <span class="agent-customers-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                  </span>
                  <span class="agent-customers-card__value">{customer.email ?? "No email"}</span>
                </li>
              </ul>
            </div>
          </AgentRecordCard>
        ))}
      </div>

      <div class="agent-customers__pagination-controls">
        <DashboardTablePagination variant="controls" />
      </div>
    </div>
  )}
</section>

<style>
  .agent-customers__table > .agent-customers__toolbar {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .agent-customers__list {
    margin-top: 0.85rem;
  }

  .agent-customers__pagination-summary {
    margin-top: 0.85rem;
  }

  .agent-customers__pagination-controls {
    margin-top: 1rem;
  }

  .agent-customers__pagination-summary :global(.dashboard-interactive-table__footer),
  .agent-customers__pagination-controls :global(.dashboard-interactive-table__footer) {
    position: static;
    border-top: 0;
    background: transparent;
    min-height: 0;
  }

  .agent-customers__pagination-summary :global(.table-pagination),
  .agent-customers__pagination-controls :global(.table-pagination) {
    padding-inline: 0;
  }

  .agent-customers__pagination-summary :global(.table-pagination) {
    justify-content: space-between;
    margin-top: 0;
  }

  .agent-customers__pagination-controls :global(.table-pagination) {
    justify-content: center;
    margin-top: 0;
  }

  .agent-customers-card {
    display: grid;
    gap: 0.85rem;
  }

  .agent-customers-card__header {
    min-width: 0;
  }

  .agent-customers-card__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.25;
    font-weight: 700;
    color: #111827;
    letter-spacing: -0.02em;
  }

  .agent-customers-card__details {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .agent-customers-card__detail {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.65rem;
    min-width: 0;
  }

  .agent-customers-card__icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    margin-top: 0.1rem;
    flex-shrink: 0;
    color: var(--color-brand-red);
  }

  .agent-customers-card__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .agent-customers-card__value {
    min-width: 0;
    color: #4b5563;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  @media (min-width: 48rem) {
    .agent-customers-card__name {
      font-size: 1.05rem;
    }
  }
</style>
