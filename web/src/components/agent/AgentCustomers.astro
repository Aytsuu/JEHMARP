---
import type { AgentDashboardData } from "@/lib/agent-dashboard/data";
import ViewButton from "@/components/ViewButton.astro";
import { fullName } from "@/lib/agent-dashboard/view";

type Props = {
  data: AgentDashboardData;
};

const { data } = Astro.props;
---

<section class="admin-panel" aria-labelledby="agent-customers-title">
  {data.customers.length === 0 ? (
    <p class="empty-state">No customers yet.</p>
  ) : (
    <div data-interactive-table>
      <div class="table-filters">
        <div style="flex: 1; min-width: 15rem;">
          <input type="text" placeholder="Search customers..." data-search-input style="width: 100%;" />
        </div>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Customer</th>
              <th scope="col">Contact</th>
              <th scope="col">Address</th>
              <th scope="col">Action</th>
            </tr>
          </thead>
          <tbody>
            {data.customers.map((customer) => (
              <tr>
                <td>{fullName(customer)}{customer.is_reseller ? " - reseller" : ""}</td>
                <td>{customer.phone_number}<br />{customer.email ?? "No email"}</td>
                <td>{customer.address}</td>
                <td>
                  <ViewButton href={`/agent/customers/${customer.id}`} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="table-pagination">
        <div class="table-pagination__summary">
          <span data-page-info></span>
          <label class="table-pagination__limit">
            <select data-limit-select>
              <option value="10">10 rows</option>
              <option value="50">50 rows</option>
              <option value="100">100 rows</option>
            </select>
          </label>
        </div>
        <div class="table-pagination__controls">
          <button type="button" data-pagination-prev class="btn-secondary"><svg class="table-pagination__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button>
          <div data-pagination-numbers class="table-pagination__numbers"></div>
          <button type="button" data-pagination-next class="btn-secondary"><svg class="table-pagination__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button>
        </div>
      </div>
    </div>
  )}
</section>
