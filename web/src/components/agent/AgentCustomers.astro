---
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import type { AgentDashboardData } from "@/lib/agent-dashboard/data";
import ViewButton from "@/components/ViewButton.astro";
import { fullName } from "@/lib/agent-dashboard/view";

type Props = {
  data: AgentDashboardData;
};

const { data } = Astro.props;
---

<section class="admin-panel" aria-labelledby="agent-customers-title">
  {data.customers.length === 0 ? (
    <p class="empty-state">No customers yet.</p>
  ) : (
    <div data-interactive-table class="dashboard-interactive-table">
      <div class="table-filters order-management-toolbar">
        <div class="table-filters__search order-filter-form__field order-filter-form__field--search">
          <input
            type="text"
            placeholder="Search customers..."
            data-search-input
            aria-label="Search customers"
          />
        </div>
      </div>

      <div class="dashboard-interactive-table__surface">
        <DashboardTableBoard>
          <table class="dashboard-table">
            <thead>
              <tr>
                <th scope="col">Customer</th>
                <th scope="col">Contact</th>
                <th scope="col">Address</th>
                <th scope="col">Action</th>
              </tr>
            </thead>
            <tbody>
              {data.customers.map((customer) => (
                <tr>
                  <td class="dashboard-table__cell--truncate">
                    {fullName(customer)}{customer.is_reseller ? " - reseller" : ""}
                  </td>
                  <td>
                    {customer.phone_number}
                    <br />
                    {customer.email ?? "No email"}
                  </td>
                  <td class="dashboard-table__cell--truncate">{customer.address}</td>
                  <td>
                    <ViewButton href={`/agent/customers/${customer.id}`} />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </DashboardTableBoard>
      </div>

      <DashboardTablePagination />
    </div>
  )}
</section>
