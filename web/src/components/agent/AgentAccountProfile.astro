---
import Popover from "@/components/ui/Popover.astro";
import type { AgentProfile } from "@/lib/agent-dashboard/data";
import { fullName } from "@/lib/agent-dashboard/view";

type Props = {
  agent: AgentProfile;
};

const { agent } = Astro.props;
const agentName = agent.display_name.trim() || fullName(agent);
const contactValue = agent.contact ?? "";
const emailValue = agent.email ?? "";
const employeeIdValue = agent.employee_id ?? "";
const addressValue = agent.address ?? "";
---

<section class="agent-account-profile" aria-label="Account details">
  <article class="agent-account-profile__card">
    <div class="agent-account-profile__employee">
      <p class="agent-account-profile__employee-label">Employee Id</p>
      <p class="agent-account-profile__employee-value">
        {agent.employee_id ?? "Not assigned"}
      </p>
    </div>

    <hr class="agent-account-profile__divider" />

    <div class="agent-account-profile__personal">
      <div class="agent-account-profile__personal-header">
        <h3 class="agent-account-profile__section-title">Personal Information</h3>
        <button
          type="button"
          class="agent-account-profile__edit-btn"
          data-open-cell-popover
          aria-label="Edit personal information"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
          </svg>
        </button>
        <Popover
          title="Edit Personal Information"
          formDataAttributes={{ "data-astro-reload": "" }}
        >
          <input type="hidden" name="action" value="update-agent-profile" />
          <input type="hidden" name="employeeId" value={employeeIdValue} />
          <input type="hidden" name="status" value={agent.status} />
          <label>
            <span>First name</span>
            <input
              name="firstName"
              value={agent.first_name}
              required
              autocomplete="given-name"
            />
          </label>
          <label>
            <span>Last name</span>
            <input
              name="lastName"
              value={agent.last_name}
              required
              autocomplete="family-name"
            />
          </label>
          <label>
            <span>Email</span>
            <input
              name="email"
              type="email"
              value={emailValue}
              autocomplete="email"
            />
          </label>
          <label>
            <span>Contact number</span>
            <input
              name="contact"
              type="tel"
              value={contactValue}
              inputmode="numeric"
              pattern="[0-9]{11}"
              minlength="11"
              maxlength="11"
              required
              autocomplete="tel"
              data-digits-only
            />
          </label>
          <label>
            <span>Address</span>
            <textarea name="address" rows="3" autocomplete="street-address">{addressValue}</textarea>
          </label>
          <button slot="footer" type="submit" class="ui-popover__button-primary">
            Save changes
          </button>
        </Popover>
      </div>

      <dl class="agent-account-profile__details">
        <div class="agent-account-profile__detail">
          <dt class="agent-account-profile__detail-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span class="sr-only">Name</span>
          </dt>
          <dd>{agentName}</dd>
        </div>
        <div class="agent-account-profile__detail">
          <dt class="agent-account-profile__detail-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"></path>
              <path d="m22 6-10 7L2 6"></path>
            </svg>
            <span class="sr-only">Email</span>
          </dt>
          <dd>{agent.email ?? "No email"}</dd>
        </div>
        <div class="agent-account-profile__detail">
          <dt class="agent-account-profile__detail-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.86.3 1.7.54 2.5a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.58-1.11a2 2 0 0 1 2.11-.45c.8.24 1.64.42 2.5.54A2 2 0 0 1 22 16.92Z"
              ></path>
            </svg>
            <span class="sr-only">Contact number</span>
          </dt>
          <dd>{agent.contact ?? "No contact"}</dd>
        </div>
        <div class="agent-account-profile__detail">
          <dt class="agent-account-profile__detail-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12 21s-7-4.35-7-10a7 7 0 1 1 14 0c0 5.65-7 10-7 10Z"></path>
              <circle cx="12" cy="11" r="2.5"></circle>
            </svg>
            <span class="sr-only">Address</span>
          </dt>
          <dd>{addressValue || "No address"}</dd>
        </div>
      </dl>
    </div>
  </article>
</section>

<style>
  .agent-account-profile__card {
    border-radius: 1rem;
    background: var(--color-brand-red);
    padding: 1.15rem 1rem;
    color: #ffffff;
  }

  .agent-account-profile__employee-label {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.3;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.82);
    letter-spacing: 0.01em;
  }

  .agent-account-profile__employee-value {
    margin: 0.35rem 0 0;
    font-size: clamp(1.65rem, 4.8vw, 2.1rem);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.02em;
    word-break: break-word;
  }

  .agent-account-profile__divider {
    margin: 1rem 0;
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.28);
  }

  .agent-account-profile__personal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .agent-account-profile__section-title {
    margin: 0;
    min-width: 0;
    font-size: 1rem;
    line-height: 1.2;
    font-weight: 600;
    color: #ffffff;
  }

  .agent-account-profile__edit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    padding: 0;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: #ffffff;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .agent-account-profile__edit-btn:hover,
  .agent-account-profile__edit-btn:focus-visible {
    background: rgba(255, 255, 255, 0.12);
    outline: none;
  }

  .agent-account-profile__edit-btn svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .agent-account-profile__details {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .agent-account-profile__detail {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.65rem;
    margin: 0;
  }

  .agent-account-profile__detail dt,
  .agent-account-profile__detail dd {
    margin: 0;
  }

  .agent-account-profile__detail-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.1rem;
    color: rgba(255, 255, 255, 0.92);
  }

  .agent-account-profile__detail-icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .agent-account-profile__detail dd {
    min-width: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: #ffffff;
    word-break: break-word;
  }

  @media (min-width: 640px) {
    .agent-account-profile__card {
      padding: 1.25rem 1.15rem;
    }

    .agent-account-profile__divider {
      margin: 1.1rem 0;
    }

    .agent-account-profile__personal-header {
      margin-bottom: 1rem;
    }

    .agent-account-profile__details {
      gap: 0.85rem;
    }

    .agent-account-profile__detail dd {
      font-size: 0.95rem;
    }
  }

  @media (min-width: 768px) {
    .agent-account-profile__card {
      padding: 1.35rem 1.25rem;
    }

    .agent-account-profile__employee-label {
      font-size: 0.86rem;
    }

    .agent-account-profile__section-title {
      font-size: 1.05rem;
    }
  }

  @media (min-width: 1024px) {
    .agent-account-profile__card {
      padding: 1.5rem 1.35rem;
    }

    .agent-account-profile__details {
      gap: 1rem;
    }
  }
</style>
