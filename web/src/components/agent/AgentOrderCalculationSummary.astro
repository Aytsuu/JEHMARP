---
import { formatCurrency } from "@/lib/agent-dashboard/view";

type Props = {
  paid: number;
  commission: number;
  grossTotal: number;
  remittance?: number;
  primaryLabel?: string;
  primaryAmount?: number;
  summaryLabel?: string;
  pendingAcceptanceAmount?: number | null;
  awaitingAcceptance?: boolean;
  compact?: boolean;
  variant?: "summary" | "customer";
};

const {
  paid,
  commission,
  grossTotal,
  remittance = 0,
  primaryLabel,
  primaryAmount,
  summaryLabel = "Order calculation",
  pendingAcceptanceAmount = null,
  awaitingAcceptance = false,
  compact = false,
  variant = "summary",
} = Astro.props;

const showPendingAcceptanceAmount =
  variant === "summary" && (pendingAcceptanceAmount ?? 0) > 0;
const resolvedPrimaryLabel = primaryLabel ?? "Remittance";
const resolvedPrimaryAmount = primaryAmount ?? remittance;
---

<div
  class:list={["order-calculation-summary", { "order-calculation-summary--compact": compact }]}
  aria-label={summaryLabel}
>
  <div class="order-calculation-summary__row">
    <span>Paid</span>
    <strong>{formatCurrency(paid)}</strong>
  </div>
  <div class="order-calculation-summary__row">
    <span>Commission</span>
    <strong>{formatCurrency(commission)}</strong>
  </div>
  {
    variant === "summary" ? (
      <>
        <div class="order-calculation-summary__row order-calculation-summary__row--primary">
          <span>{resolvedPrimaryLabel}</span>
          <strong>{formatCurrency(resolvedPrimaryAmount)}</strong>
        </div>
        <div class="order-calculation-summary__row order-calculation-summary__row--muted">
          <span>Gross total</span>
          <span>{formatCurrency(grossTotal)}</span>
        </div>
        {
          showPendingAcceptanceAmount && (
            <div class="order-calculation-summary__row order-calculation-summary__row--pending">
              <span>Pending acceptance</span>
              <strong>{formatCurrency(pendingAcceptanceAmount ?? 0)}</strong>
            </div>
          )
        }
      </>
    ) : (
      <>
        <div class="order-calculation-summary__row order-calculation-summary__row--primary">
          <span>Receivable</span>
          <strong>{formatCurrency(grossTotal)}</strong>
        </div>
        {
          awaitingAcceptance && (
            <p class="order-calculation-summary__pending-note">
              Awaiting acceptance
            </p>
          )
        }
      </>
    )
  }
</div>

<style>
  .order-calculation-summary {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .order-calculation-summary__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    color: rgba(17, 24, 39, 0.62);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .order-calculation-summary__row strong {
    color: #111827;
    font-size: 0.95rem;
    font-weight: 700;
    text-align: right;
    white-space: nowrap;
  }

  .order-calculation-summary__row--primary {
    margin-top: 0.15rem;
    border-top: 1px solid rgba(17, 24, 39, 0.08);
    padding-top: 0.5rem;
    color: #111827;
    flex-wrap: wrap;
  }

  .order-calculation-summary__row--primary strong {
    font-size: 1.35rem;
    line-height: 1.1;
  }

  .order-calculation-summary__row--pending {
    color: #b45309;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .order-calculation-summary__row--pending strong {
    color: #b45309;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .order-calculation-summary__pending-note {
    margin: 0.15rem 0 0;
    color: #b45309;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.35;
    text-align: right;
  }

  .order-calculation-summary__row--muted {
    flex-wrap: wrap;
    color: #9ca3af;
    font-size: 0.78rem;
    font-weight: 500;
  }

  .order-calculation-summary--compact {
    gap: 0.3rem;
  }

  .order-calculation-summary--compact .order-calculation-summary__row {
    font-size: 0.72rem;
  }

  .order-calculation-summary--compact .order-calculation-summary__row strong {
    font-size: 0.78rem;
  }

  .order-calculation-summary--compact .order-calculation-summary__row--primary {
    margin-top: 0.1rem;
    padding-top: 0.35rem;
  }

  .order-calculation-summary--compact .order-calculation-summary__row--primary strong {
    font-size: 0.92rem;
  }

  .order-calculation-summary--compact .order-calculation-summary__row--muted {
    font-size: 0.68rem;
  }
</style>
