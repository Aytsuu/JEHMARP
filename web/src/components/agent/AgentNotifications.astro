---
import type { AgentDashboardData } from "@/lib/agent-dashboard/data";
import { buildAgentNotifications } from "@/lib/agent-dashboard/notifications";
import { formatDate } from "@/lib/agent-dashboard/view";

type Props = {
  data: AgentDashboardData;
};

const { data } = Astro.props;
const notifications = buildAgentNotifications(data);
---

<section id="agent-notifications" class="admin-panel agent-notifications" aria-labelledby="agent-notifications-title">
  <div data-interactive-table class="dashboard-interactive-table">
    <div class="table-filters order-management-toolbar agent-notifications__toolbar">
      <button type="button" class="btn-table-manage" data-mark-all-read>Mark All as Read</button>
      <button type="button" class="btn-table-manage btn-table-manage--muted" data-clear-notifications>Clear Stored Read</button>
    </div>

    <div class="agent-notifications__list" data-notifications-list>
      {notifications.map((notif) => (
        <article
          class="admin-card notification-item"
          data-notification-id={notif.id}
        >
          <div class="agent-notifications__item-header">
            <div class="agent-notifications__item-title-row">
              <span
                class={`notification-badge badge-${notif.severity}`}
              >
                {notif.type}
              </span>
              <strong>{notif.title}</strong>
              <span class="unread-dot"></span>
            </div>
            <span class="agent-notifications__date">{formatDate(notif.date)}</span>
          </div>

          <p class="agent-notifications__message">{notif.message}</p>

          <div class="agent-notifications__actions">
            {notif.registrationUrl ? (
              <button
                type="button"
                class="btn-table-manage"
                data-open-registration-link
                data-registration-url={notif.registrationUrl}
                data-registration-expires-at={notif.expiresAt ?? ""}
              >
                View Link
              </button>
            ) : (
              <a href={notif.link} class="btn-table-manage">View Details</a>
            )}
            <button type="button" class="btn-table-manage btn-table-manage--ghost" data-mark-read>Mark as read</button>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="agent-registration-link-modal" data-registration-link-modal hidden>
    <div class="agent-registration-link-modal__backdrop" data-close-registration-link></div>
    <section class="agent-registration-link-modal__panel" role="dialog" aria-modal="true" aria-labelledby="registration-link-modal-title">
      <button type="button" class="agent-registration-link-modal__close" data-close-registration-link aria-label="Close">×</button>
      <div class="agent-registration-link-modal__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M10 13a5 5 0 0 0 7.07 0l2.12-2.12a5 5 0 0 0-7.07-7.07L11 4.93"></path>
          <path d="M14 11a5 5 0 0 0-7.07 0L4.81 13.12a5 5 0 0 0 7.07 7.07L13 19.07"></path>
        </svg>
      </div>
      <h3 id="registration-link-modal-title">Customer Registration Link</h3>
      <p>
        Share this link with customers. They can submit basic information until the link expires.
        Customers may enter your employee ID so the record is assigned to you automatically.
      </p>
      <p class="agent-registration-link-modal__expiry" data-registration-link-expiry></p>
      <div class="agent-registration-link-modal__copy-row">
        <input data-registration-link-input readonly />
        <button type="button" class="btn-table-manage" data-copy-registration-link aria-label="Copy registration link">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
      <p class="agent-registration-link-modal__copied" data-registration-link-copied hidden>Copied.</p>
    </section>
  </div>
</section>

<style>
  .badge-warning {
    background-color: #fef3c7;
    color: #92400e;
  }
  .badge-info {
    background-color: #dbeafe;
    color: #1e40af;
  }
  .badge-success {
    background-color: #d1fae5;
    color: #065f46;
  }

  .agent-registration-link-modal[hidden] {
    display: none;
  }

  .agent-registration-link-modal {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    padding: 1rem;
  }

  .agent-registration-link-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
  }

  .agent-registration-link-modal__panel {
    position: relative;
    width: min(100%, 30rem);
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background: #fff;
    padding: 1.25rem;
  }

  .agent-registration-link-modal__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 1.4rem;
    line-height: 1;
  }

  .agent-registration-link-modal__icon {
    width: 2.5rem;
    height: 2.5rem;
    color: #991b1b;
  }

  .agent-registration-link-modal__icon svg,
  .agent-registration-link-modal__copy-row svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .agent-registration-link-modal__panel h3 {
    margin: 0.75rem 0 0.5rem;
    letter-spacing: 0;
  }

  .agent-registration-link-modal__panel p {
    color: #4b5563;
  }

  .agent-registration-link-modal__copy-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
  }

  .agent-registration-link-modal__copy-row input {
    min-width: 0;
    border: 1px solid #d1d5db;
    border-radius: 0.375rem;
    padding: 0.65rem 0.75rem;
  }

  .agent-registration-link-modal__copy-row button {
    width: 2.75rem;
    justify-content: center;
  }

  .agent-registration-link-modal__copied {
    margin: 0.5rem 0 0;
    color: #166534 !important;
    font-weight: 700;
  }
</style>

<script>
  function initNotifications() {
    const root = document.querySelector<HTMLElement>("#agent-notifications");
    if (!root || root.dataset.agentNotificationsInitialized === "true") return;
    root.dataset.agentNotificationsInitialized = "true";

    const list = document.querySelector("[data-notifications-list]");
    if (!list) return;
    const modal = root.querySelector<HTMLElement>("[data-registration-link-modal]");
    const linkInput = root.querySelector<HTMLInputElement>("[data-registration-link-input]");
    const expiryText = root.querySelector<HTMLElement>("[data-registration-link-expiry]");
    const copiedText = root.querySelector<HTMLElement>("[data-registration-link-copied]");

    const items = Array.from(list.querySelectorAll<HTMLElement>(".notification-item"));
    let readIds = JSON.parse(localStorage.getItem("agent-read-notifications") || "[]");

    // Apply initial read state styling
    items.forEach((item) => {
      const id = item.dataset.notificationId;
      if (id && readIds.includes(id)) {
        item.classList.add("read");
      }
    });

    // Set up click handlers on list
    list.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
        const markReadBtn = target.closest("[data-mark-read]");
        if (markReadBtn) {
          const item = target.closest(".notification-item") as HTMLElement;
          if (item) {
          const id = item.dataset.notificationId;
          if (id) {
            if (!readIds.includes(id)) {
              readIds.push(id);
              localStorage.setItem("agent-read-notifications", JSON.stringify(readIds));
            }
            item.classList.add("read");
            (
              window as Window & { updateSidebarUnreadBadges?: () => void }
            ).updateSidebarUnreadBadges?.();
          }
        }
      }

      const registrationLinkButton = target.closest<HTMLButtonElement>("[data-open-registration-link]");
      if (registrationLinkButton && modal && linkInput && expiryText) {
        const relativeUrl = registrationLinkButton.dataset.registrationUrl ?? "";
        const expiresAt = registrationLinkButton.dataset.registrationExpiresAt ?? "";
        const url = new URL(relativeUrl, window.location.origin).toString();
        linkInput.value = url;
        expiryText.textContent = expiresAt
          ? `Expires ${new Intl.DateTimeFormat("en-PH", {
              dateStyle: "medium",
              timeStyle: "short",
            }).format(new Date(expiresAt))}.`
          : "";
        if (copiedText) copiedText.hidden = true;
        modal.hidden = false;
      }
    });

    root.querySelectorAll("[data-close-registration-link]").forEach((closeTarget) => {
      closeTarget.addEventListener("click", () => {
        if (modal) modal.hidden = true;
      });
    });

    root.querySelector("[data-copy-registration-link]")?.addEventListener("click", async () => {
      if (!linkInput) return;
      await navigator.clipboard.writeText(linkInput.value);
      if (copiedText) copiedText.hidden = false;
    });

    const markAllReadBtn = document.querySelector("[data-mark-all-read]");
    if (markAllReadBtn) {
      markAllReadBtn.addEventListener("click", () => {
        items.forEach((item) => {
          const id = item.dataset.notificationId;
          if (id && !readIds.includes(id)) {
            readIds.push(id);
          }
          item.classList.add("read");
        });
        localStorage.setItem("agent-read-notifications", JSON.stringify(readIds));
        (
          window as Window & { updateSidebarUnreadBadges?: () => void }
        ).updateSidebarUnreadBadges?.();
      });
    }

    const clearBtn = document.querySelector("[data-clear-notifications]");
    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        localStorage.removeItem("agent-read-notifications");
        readIds = [];
        items.forEach((item) => {
          item.classList.remove("read");
        });
        (
          window as Window & { updateSidebarUnreadBadges?: () => void }
        ).updateSidebarUnreadBadges?.();
      });
    }
  }

  initNotifications();
  document.addEventListener("astro:after-swap", initNotifications);
</script>
