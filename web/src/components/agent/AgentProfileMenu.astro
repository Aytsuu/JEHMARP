---
import { agentProfileNavItems } from "@/lib/dashboard/agent-navigation";

const currentPath = Astro.url.pathname;

function isProfileSectionActive(href: string) {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<section class="agent-profile-menu" aria-label="Profile options">
  <div class="agent-profile-menu__list">
    {
      agentProfileNavItems.map((item) => {
        const isCurrent = !item.isAction && isProfileSectionActive(item.href);

        return item.isAction ? (
          <div class="agent-profile-menu__form">
            <button
              type="button"
              class="agent-profile-menu__item agent-profile-menu__item--action"
              data-open-alert-dialog="dashboard-logout-dialog"
              data-alert-dialog-form="dashboard-logout-form"
            >
              <span class="agent-profile-menu__icon" set:html={item.icon} />
              <span class="agent-profile-menu__copy">
                <strong>{item.label}</strong>
                <small>Sign out of your agent account</small>
              </span>
            </button>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={["agent-profile-menu__item", isCurrent && "agent-profile-menu__item--active"]}
            aria-current={isCurrent ? "page" : undefined}
          >
            <span class="agent-profile-menu__icon" set:html={item.icon} />
            <span class="agent-profile-menu__copy">
              <strong>{item.label}</strong>
              <small>
                {
                  item.href === "/agent/earnings"
                    ? "Track commissions and payout history"
                    : "Review recent orders, payments, and customer updates"
                }
              </small>
            </span>
            <span class="agent-profile-menu__chevron" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </span>
          </a>
        );
      })
    }
  </div>
</section>

<style>
  .agent-profile-menu {
    width: 100%;
    min-width: 0;
  }

  .agent-profile-menu__list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .agent-profile-menu__list > * + * {
    border-top: 1px solid #e5e7eb;
  }

  .agent-profile-menu__form {
    margin: 0;
  }

  .agent-profile-menu__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    padding: 1rem 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .agent-profile-menu__item:hover,
  .agent-profile-menu__item:focus-visible {
    outline: none;
  }

  .agent-profile-menu__item--active strong {
    color: var(--color-brand-red);
  }

  .agent-profile-menu__item--action {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    justify-content: initial;
    gap: 0.85rem;
    width: 100%;
    padding: 1rem 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: inherit;
    font-weight: inherit;
    text-transform: none;
    letter-spacing: normal;
  }

  .agent-profile-menu__item--action:hover:not(:disabled),
  .agent-profile-menu__item--action:focus-visible {
    background: transparent;
    color: inherit;
  }

  .agent-profile-menu__icon :global(svg) {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-brand-red);
  }

  .agent-profile-menu__copy {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .agent-profile-menu__copy strong {
    font-size: 0.95rem;
    font-weight: 700;
    color: #111827;
  }

  .agent-profile-menu__copy small {
    font-size: 0.82rem;
    line-height: 1.45;
    color: #6b7280;
  }

  .agent-profile-menu__chevron svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: #9ca3af;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 640px) {
    .agent-profile-menu__item,
    .agent-profile-menu__item--action {
      padding: 1.05rem 0;
    }
  }

  @media (min-width: 768px) {
    .agent-profile-menu__copy strong {
      font-size: 1rem;
    }

    .agent-profile-menu__copy small {
      font-size: 0.84rem;
    }
  }

  @media (min-width: 1024px) {
    .agent-profile-menu__item,
    .agent-profile-menu__item--action {
      padding: 1.1rem 0;
    }
  }
</style>
