---
import AgentRecordCard from "@/components/agent/AgentRecordCard.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import type { AgentDashboardData } from "@/lib/agent-dashboard/data";
import {
  formatCurrency,
  formatDate,
  fullName,
  orderEarnedCommission,
  orderExpectedCommission,
} from "@/lib/agent-dashboard/view";

type Props = {
  data: AgentDashboardData;
};

const { data } = Astro.props;
const agentOrders = data.orders.filter(
  (order) => order.agent_id === data.agent.id,
);
---

<section class="admin-summary-grid dashboard-page-summary" aria-label="Agent earnings summary">
  <article class="admin-summary-card">
    <h2>Monthly Earnings</h2>
    <p>{formatCurrency(data.summary.monthlyEarnings)}</p>
  </article>
  <article class="admin-summary-card">
    <h2>Earned Today</h2>
    <p>{formatCurrency(data.summary.earnedToday)}</p>
  </article>
  <article class="admin-summary-card">
    <h2>Expected Commission</h2>
    <p>{formatCurrency(data.summary.expectedCommission)}</p>
  </article>
</section>

<section class="admin-panel" aria-labelledby="agent-earnings-orders-title">
  {
    agentOrders.length === 0 ? (
      <p class="empty-state">
        No agent-submitted or assigned commission orders yet.
      </p>
    ) : (
      <div data-interactive-table class="dashboard-interactive-table">
        <div class="table-filters order-management-toolbar">
          <div class="table-filters__search order-filter-form__field order-filter-form__field--search">
            <input
              type="text"
              placeholder="Search commissions..."
              data-search-input
              aria-label="Search commissions"
            />
          </div>
        </div>

        <div class="agent-record-list" data-interactive-cards>
          {agentOrders.map((order) => (
            <AgentRecordCard status={order.payment_status}>
              <div class="agent-record-card__header">
                <div class="agent-record-card__title-group">
                  <h3 class="agent-record-card__title">{fullName(order.customer)}</h3>
                  <p class="agent-record-card__subtitle">{formatDate(order.created_at)}</p>
                </div>
                <StatusBadge kind="payment" status={order.payment_status} />
              </div>
              <dl class="agent-record-card__meta agent-record-card__meta--inline">
                <div class="agent-record-card__meta-item">
                  <dt>Expected</dt>
                  <dd>{formatCurrency(orderExpectedCommission(order))}</dd>
                </div>
                <div class="agent-record-card__meta-item">
                  <dt>Earned</dt>
                  <dd>{formatCurrency(orderEarnedCommission(order))}</dd>
                </div>
              </dl>
            </AgentRecordCard>
          ))}
        </div>

        <DashboardTablePagination />
      </div>
    )
  }
</section>
