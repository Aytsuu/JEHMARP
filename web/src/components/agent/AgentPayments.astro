---
import OrderPdfLinks from "@/components/OrderPdfLinks.astro";
import type { AgentDashboardData } from "@/lib/agent-dashboard/data";
import {
  formatCurrency,
  formatDate,
  formatPaymentStatus,
  fullName,
  orderBalance,
  orderPaymentTotal,
  orderTotal,
} from "@/lib/agent-dashboard/view";

type Props = {
  data: AgentDashboardData;
};

const { data } = Astro.props;
---

<section class="admin-panel" aria-labelledby="agent-payments-title">
  <div class="admin-summary-grid" aria-label="Payment status counts">
    {
      Object.entries(data.paymentSummary).map(([status, count]) => (
        <article class="admin-summary-card">
          <h2>{status}</h2>
          <p>{count}</p>
        </article>
      ))
    }
  </div>
</section>

<section class="admin-panel" aria-labelledby="agent-payment-balances-title">
  {
    data.orders.length === 0 ? (
      <p class="empty-state">No accessible order balances yet.</p>
    ) : (
      <div data-interactive-table>
        <div class="table-filters">
          <div style="flex: 1; min-width: 15rem;">
            <input type="text" placeholder="Search balances..." data-search-input style="width: 100%;" />
          </div>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Order</th>
                <th scope="col">Payment Status</th>
                <th scope="col">Invoice Total</th>
                <th scope="col">Paid</th>
                <th scope="col">Balance</th>
              </tr>
            </thead>
            <tbody>
              {data.orders.map((order) => (
                <tr data-status={order.payment_status}>
                  <td>
                    {fullName(order.customer)}
                    <br />
                    {formatDate(order.created_at)}
                  </td>
                  <td>{formatPaymentStatus(order.payment_status)}</td>
                  <td>
                    {formatCurrency(orderTotal(order, "final_quantity"))}
                    {order.invoice.length > 0 && (
                      <>
                        <br />
                        <OrderPdfLinks
                          orderId={order.id}
                          basePath="/agent/orders"
                          showOrderSlip={false}
                          showSalesInvoice
                        />
                      </>
                    )}
                  </td>
                  <td>{formatCurrency(orderPaymentTotal(order))}</td>
                  <td>{formatCurrency(orderBalance(order))}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="table-pagination">
          <div class="table-pagination__summary">
            <span data-page-info></span>
            <label class="table-pagination__limit">
              <select data-limit-select>
                <option value="10">10 rows</option>
                <option value="50">50 rows</option>
                <option value="100">100 rows</option>
              </select>
            </label>
          </div>
          <div class="table-pagination__controls">
            <button type="button" data-pagination-prev class="btn-secondary"><svg class="table-pagination__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button>
            <div data-pagination-numbers class="table-pagination__numbers"></div>
            <button type="button" data-pagination-next class="btn-secondary"><svg class="table-pagination__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button>
          </div>
        </div>
      </div>
    )
  }
</section>
