---
import OrderPdfLinks from "@/components/OrderPdfLinks.astro";
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import type { AgentDashboardData } from "@/lib/agent-dashboard/data";
import {
  formatCurrency,
  formatDate,
  formatPaymentStatus,
  fullName,
  orderBalance,
  orderPaymentTotal,
  orderTotal,
} from "@/lib/agent-dashboard/view";

type Props = {
  data: AgentDashboardData;
};

const { data } = Astro.props;
---

<section class="admin-panel" aria-labelledby="agent-payments-title">
  <div class="admin-summary-grid dashboard-page-summary" aria-label="Payment status counts">
    {
      Object.entries(data.paymentSummary).map(([status, count]) => (
        <article class="admin-summary-card">
          <h2>{status}</h2>
          <p>{count}</p>
        </article>
      ))
    }
  </div>
</section>

<section class="admin-panel" aria-labelledby="agent-payment-balances-title">
  {
    data.orders.length === 0 ? (
      <p class="empty-state">No accessible order balances yet.</p>
    ) : (
      <div data-interactive-table class="dashboard-interactive-table">
        <div class="table-filters order-management-toolbar">
          <div class="table-filters__search order-filter-form__field order-filter-form__field--search">
            <input
              type="text"
              placeholder="Search balances..."
              data-search-input
              aria-label="Search balances"
            />
          </div>
        </div>

        <div class="dashboard-interactive-table__surface">
          <DashboardTableBoard>
            <table class="dashboard-table">
              <thead>
                <tr>
                  <th scope="col">Order</th>
                  <th scope="col">Payment Status</th>
                  <th scope="col">Invoice Total</th>
                  <th scope="col">Paid</th>
                  <th scope="col">Balance</th>
                </tr>
              </thead>
              <tbody>
                {data.orders.map((order) => (
                  <tr data-status={order.payment_status}>
                    <td>
                      {fullName(order.customer)}
                      <br />
                      {formatDate(order.created_at)}
                    </td>
                    <td>
                      <StatusBadge
                        kind="payment"
                        status={order.payment_status}
                        label={formatPaymentStatus(order.payment_status)}
                      />
                    </td>
                    <td>
                      {formatCurrency(orderTotal(order, "final_quantity"))}
                      {order.invoice.length > 0 && (
                        <>
                          <br />
                          <OrderPdfLinks
                            orderId={order.id}
                            basePath="/agent/orders"
                            showOrderSlip={false}
                            showSalesInvoice
                          />
                        </>
                      )}
                    </td>
                    <td>{formatCurrency(orderPaymentTotal(order))}</td>
                    <td>{formatCurrency(orderBalance(order))}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </DashboardTableBoard>
        </div>

        <DashboardTablePagination />
      </div>
    )
  }
</section>
