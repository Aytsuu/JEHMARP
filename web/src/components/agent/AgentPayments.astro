---
import OrderPdfLinks from "@/components/OrderPdfLinks.astro";
import type { AgentDashboardData } from "@/lib/agent-dashboard/data";
import {
  formatCurrency,
  formatDate,
  formatPaymentStatus,
  fullName,
  orderBalance,
  orderPaymentTotal,
  orderTotal,
} from "@/lib/agent-dashboard/view";

type Props = {
  data: AgentDashboardData;
};

const { data } = Astro.props;
---

<section class="admin-panel" aria-labelledby="agent-payments-title">
  <div class="admin-summary-grid" aria-label="Payment status counts">
    {
      Object.entries(data.paymentSummary).map(([status, count]) => (
        <article class="admin-summary-card">
          <h2>{status}</h2>
          <p>{count}</p>
        </article>
      ))
    }
  </div>
</section>

<section class="admin-panel" aria-labelledby="agent-payment-balances-title">
  {
    data.orders.length === 0 ? (
      <p class="empty-state">No accessible order balances yet.</p>
    ) : (
      <div data-interactive-table>
        <div class="table-filters">
          <div style="flex: 1; min-width: 15rem;">
            <input type="text" placeholder="Search balances..." data-search-input style="width: 100%;" />
          </div>
          <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 0.35rem;">
              <span style="font-size: 0.9rem; color: var(--color-brand-muted-black);">Show</span>
              <select data-limit-select>
                <option value="10">10</option>
                <option value="50">50</option>
                <option value="100">100</option>
              </select>
            </div>
          </div>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Order</th>
                <th scope="col">Payment Status</th>
                <th scope="col">Invoice Total</th>
                <th scope="col">Paid</th>
                <th scope="col">Balance</th>
              </tr>
            </thead>
            <tbody>
              {data.orders.map((order) => (
                <tr data-status={order.payment_status}>
                  <td>
                    {fullName(order.customer)}
                    <br />
                    {formatDate(order.created_at)}
                  </td>
                  <td>{formatPaymentStatus(order.payment_status)}</td>
                  <td>
                    {formatCurrency(orderTotal(order, "final_quantity"))}
                    {order.invoice.length > 0 && (
                      <>
                        <br />
                        <OrderPdfLinks
                          orderId={order.id}
                          basePath="/agent/orders"
                          showOrderSlip={false}
                          showSalesInvoice
                        />
                      </>
                    )}
                  </td>
                  <td>{formatCurrency(orderPaymentTotal(order))}</td>
                  <td>{formatCurrency(orderBalance(order))}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="table-pagination">
          <span data-page-info style="font-size: 0.9rem; color: var(--color-brand-muted-black); font-weight: 500;"></span>
          <div style="display: flex; gap: 0.25rem; align-items: center;">
            <button type="button" data-pagination-prev class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&lt;</button>
            <div data-pagination-numbers style="display: flex; gap: 0.25rem;"></div>
            <button type="button" data-pagination-next class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&gt;</button>
          </div>
        </div>
      </div>
    )
  }
</section>
