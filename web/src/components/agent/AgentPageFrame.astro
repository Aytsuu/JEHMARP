---
import type { AgentDashboardData } from "@/lib/agent-dashboard/data";
import PageAvailabilityNotice from "@/components/dashboard/PageAvailabilityNotice.astro";
import { getAgentUnreadNotificationIds } from "@/lib/agent-dashboard/notifications";
import { agentDashboardRoutes } from "@/config/navigation";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getDashboardPageAvailability } from "@/lib/page-availability";

type Props = {
  title: string;
  description: string;
  heading: string;
  intro: string;
  backUrl?: string;
  feedback?: {
    status?: string;
    error?: string;
  };
  dashboardData?: AgentDashboardData;
};

const { title, description, heading, intro, backUrl, feedback, dashboardData } = Astro.props;
const headingId = `${heading
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "")}-title`;
const notificationIds = dashboardData ? getAgentUnreadNotificationIds(dashboardData) : [];
const pageAvailability = getDashboardPageAvailability(Astro.url.pathname);
const isPageReady = pageAvailability.status === "ready";
---

<DashboardLayout
  title={title}
  description={description}
  navLabel="Agent operations"
  navItems={agentDashboardRoutes}
  sidebarUnreadBadges={{
    "/agent/notifications": {
      ids: notificationIds,
      storageKey: "agent-read-notifications",
    },
  }}
>
  <section class="admin-shell" aria-labelledby={headingId}>
    <header class="admin-header">
      <h1 id={headingId} class="page-shell__title" style="display: flex; align-items: center; gap: 0.75rem;">
        {backUrl && (
          <a href={backUrl} class="btn-back" style="display: inline-flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; border-radius: 0.375rem; border: 1px solid #d1d5db; background-color: #f3f4f6; color: #374151; font-weight: bold; text-decoration: none; font-size: 1rem; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#e5e7eb'" onmouseout="this.style.backgroundColor='#f3f4f6'">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="m15 18-6-6 6-6"/></svg>
          </a>
        )}
        <span>{heading}</span>
      </h1>
      <p class="page-shell__description">{intro}</p>
    </header>

    {
      feedback?.status && (
        <p class="status-message" role="status">
          {feedback.status}
        </p>
      )
    }
    {
      feedback?.error && (
        <p class="error-message" role="alert">
          {feedback.error}
        </p>
      )
    }

    {isPageReady ? <slot /> : <PageAvailabilityNotice availability={pageAvailability} />}
  </section>
</DashboardLayout>
