---
type Props = {
  disabled?: boolean;
  showPaymentNotice?: boolean;
};

const { disabled = false, showPaymentNotice = false } = Astro.props;
---

<div class="order-customer-picker" data-customer-picker>
  <input
    autocomplete="off"
    placeholder="Type a customer name"
    aria-label="Search customer"
    data-customer-search
    data-customer-search-input
    disabled={disabled}
  />
  <button
    type="button"
    class="order-customer-picker__toggle"
    aria-label="Show customer options"
    aria-expanded="false"
    data-customer-picker-toggle
    disabled={disabled}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>
  <div class="order-customer-picker__menu" hidden data-customer-picker-menu>
    <div class="order-customer-picker__options" data-customer-options></div>
    <p class="order-customer-picker__empty" hidden data-customer-options-empty>
      No customers found.
    </p>
  </div>
</div>
{
  showPaymentNotice && (
    <p
      class="order-create-form__existing-customer-notice"
      hidden
      data-customer-order-notice
    ></p>
  )
}
<input type="hidden" data-customer-id />
