---
import { authRoutes, publicRoutes } from "@/config/navigation";
---

<footer class="site-footer">
  <div class="site-footer__inner footer-grid">
    <section aria-labelledby="footer-brand">
      <h2 id="footer-brand">JEHMARP</h2>
      <p class="site-footer__brand-copy">
        Public website footer for browsing products, reading public content, and reaching the business.
      </p>
    </section>

    <nav aria-labelledby="footer-public-links">
      <h2 id="footer-public-links">Public links</h2>
      <ul class="footer-link-list">
        {publicRoutes.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-access-links">
      <h2 id="footer-access-links">Access</h2>
      <ul class="footer-link-list">
        {authRoutes.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <section aria-labelledby="footer-contact">
      <h2 id="footer-contact">Contact</h2>
      <address>
        <p>Phone: 0917 000 0000</p>
        <p>Email: hello@example.test</p>
        <p>Address: Temporary JEHMARP public address</p>
      </address>
    </section>
  </div>
</footer>
