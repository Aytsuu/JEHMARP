---
import { authRoutes, publicRoutes } from "@/config/navigation";
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="footer-columns">
      <!-- Column 1: Brand & Socials -->
      <div class="footer-column" aria-labelledby="footer-brand">
        <h2 id="footer-brand" class="footer-column__brand-title">JEHMARP</h2>
        <p class="footer-column__brand-desc">
          Public website footer for browsing products, reading public content, and reaching the business.
        </p>
        <div class="footer-column__socials" aria-label="Social media links">
          <a href="#" class="footer-column__social-link" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
          <a href="#" class="footer-column__social-link" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="#" class="footer-column__social-link" aria-label="WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Public Links -->
      <nav class="footer-column" aria-labelledby="footer-public-links">
        <h2 id="footer-public-links" class="footer-column__heading">Public links</h2>
        <ul class="footer-column__links">
          {publicRoutes.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Column 3: Access Links -->
      <nav class="footer-column" aria-labelledby="footer-access-links">
        <h2 id="footer-access-links" class="footer-column__heading">Access</h2>
        <ul class="footer-column__links">
          {authRoutes.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Column 4: Contact -->
      <section class="footer-column" aria-labelledby="footer-contact">
        <h2 id="footer-contact" class="footer-column__heading">Contact</h2>
        <address class="footer-column__address">
          <div class="footer-column__address-item">
            <svg class="footer-column__address-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span>0917 000 0000</span>
          </div>
          <div class="footer-column__address-item">
            <svg class="footer-column__address-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <span>hello@example.test</span>
          </div>
          <div class="footer-column__address-item">
            <svg class="footer-column__address-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>Temporary JEHMARP public address</span>
          </div>
        </address>
      </section>
    </div>
  </div>

  <div class="site-footer__bottom">
    <div class="site-footer__bottom-inner">
      <p>Copyright &copy; {new Date().getFullYear()} JEHMARP PH. All rights reserved.</p>
      <div class="site-footer__bottom-links">
        <a href="#">Terms &amp; Conditions</a>
        <a href="#">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>
