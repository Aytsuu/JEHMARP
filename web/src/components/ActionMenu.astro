---
export type ActionMenuIcon = "external-pdf" | "details";

export type ActionMenuItem = {
  label: string;
  href?: string;
  target?: string;
  rel?: string;
  icon?: ActionMenuIcon;
  dataAction?: string;
  disabled?: boolean;
};

type Props = {
  menuLabel: string;
  items: ActionMenuItem[];
  triggerLabel?: string;
  triggerClass?: string;
  disabled?: boolean;
  id?: string;
};

const {
  menuLabel,
  items,
  triggerLabel,
  triggerClass = "",
  disabled = false,
  id,
} = Astro.props;

const isButtonTrigger = Boolean(triggerLabel);
const triggerClasses = [
  "table-action-menu__trigger",
  isButtonTrigger && "table-action-menu__trigger--button",
  triggerClass,
]
  .filter(Boolean)
  .join(" ");
---

<div class="table-action-menu" data-table-action-menu id={id}>
  <button
    type="button"
    class={triggerClasses}
    aria-label={menuLabel}
    aria-haspopup="menu"
    aria-expanded="false"
    data-table-action-menu-trigger
    disabled={disabled || undefined}
  >
    {
      isButtonTrigger ? (
        <span>{triggerLabel}</span>
      ) : (
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="5" cy="12" r="1.75"></circle>
          <circle cx="12" cy="12" r="1.75"></circle>
          <circle cx="19" cy="12" r="1.75"></circle>
        </svg>
      )
    }
  </button>
  <div
    class="table-action-menu__content"
    role="menu"
    aria-label={menuLabel}
    hidden
    data-table-action-menu-content
  >
    {
      items.map((item) => {
        const icon = item.icon ?? "none";

        if (item.href) {
          return (
            <a
              href={item.href}
              class="table-action-menu__item"
              target={item.target}
              rel={item.rel}
              role="menuitem"
              aria-disabled={item.disabled ? "true" : undefined}
              tabindex={item.disabled ? -1 : undefined}
              data-astro-prefetch={
                item.target === "_blank" || item.href?.endsWith(".pdf")
                  ? undefined
                  : "false"
              }
            >
              {icon === "external-pdf" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M15 3h6v6"></path>
                  <path d="M10 14 21 3"></path>
                  <path d="M21 14v4a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3h4"></path>
                </svg>
              )}
              {icon === "details" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9 6.75H19.5"></path>
                  <path d="M9 12H19.5"></path>
                  <path d="M9 17.25H19.5"></path>
                  <path d="M4.5 6.75h.01"></path>
                  <path d="M4.5 12h.01"></path>
                  <path d="M4.5 17.25h.01"></path>
                </svg>
              )}
              <span>{item.label}</span>
            </a>
          );
        }

        return (
          <button
            type="button"
            class="table-action-menu__item"
            role="menuitem"
            data-action-menu-item
            data-action={item.dataAction}
            disabled={item.disabled || undefined}
          >
            {icon === "external-pdf" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 3h6v6"></path>
                <path d="M10 14 21 3"></path>
                <path d="M21 14v4a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3h4"></path>
              </svg>
            )}
            {icon === "details" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 6.75H19.5"></path>
                <path d="M9 12H19.5"></path>
                <path d="M9 17.25H19.5"></path>
                <path d="M4.5 6.75h.01"></path>
                <path d="M4.5 12h.01"></path>
                <path d="M4.5 17.25h.01"></path>
              </svg>
            )}
            <span>{item.label}</span>
          </button>
        );
      })
    }
  </div>
</div>
