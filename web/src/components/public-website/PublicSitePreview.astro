---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteNav from "@/components/SiteNav.astro";

type Props = {
  activePath?: string;
  previewRoot?: string;
};

const { activePath = "/", previewRoot } = Astro.props;
---

<div class="public-site-preview public-body" data-public-site-preview>
  <div class="public-site-preview__nav-anchor">
    <SiteNav
      activePath={activePath}
      previewRoot={previewRoot}
    />
  </div>
  <main class="public-site-preview__main">
    <slot />
  </main>
  <SiteFooter previewRoot={previewRoot} />
</div>
