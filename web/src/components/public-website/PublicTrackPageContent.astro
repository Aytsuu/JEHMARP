---
import {
  formatTrackingCurrency,
  formatTrackingLookupDate,
  formatTrackingOrderStatus,
  lookupCustomerOrdersByTrackingNumber,
} from "@/lib/public-website/customer-tracking";
import { isAdminContentPreviewPath } from "@/lib/public-website/admin-content-preview";

type Props = {
  submittedTrackingNumber: string;
  lookupError?: string | null;
  rateLimitMessage?: string | null;
  lookupResult?: Awaited<
    ReturnType<typeof lookupCustomerOrdersByTrackingNumber>
  > | null;
  formAction?: string;
  inputId?: string;
};

const {
  submittedTrackingNumber,
  lookupError = null,
  rateLimitMessage = null,
  lookupResult = null,
  formAction = "/track",
  inputId = "tracking-number",
} = Astro.props;

const disableFormSubmission = isAdminContentPreviewPath(formAction);
const previewSubmissionTitle = "Submissions are disabled in content preview";

function getOrderStatusStep(status: string): number {
  const norm = status.toLowerCase();
  if (
    norm.includes("closed") ||
    norm.includes("delivered") ||
    norm.includes("completed")
  )
    return 3;
  if (norm.includes("processing") || norm.includes("preparing")) return 2;
  return 1;
}
---

<section class="track-page" aria-labelledby="track-page-title">
  <div class="track-page__header">
    <h1 id="track-page-title" class="track-page__title">Track Your Orders</h1>
    <p class="track-page__subtitle">
      Enter your customer tracking number to check real-time order status,
      payment updates, and item details.
    </p>
  </div>

  <div class="track-page__search-card">
    <form
      class="track-page__form"
      method="get"
      action={formAction}
      onsubmit={disableFormSubmission ? "return false;" : undefined}
    >
      <div class="track-page__form-row">
        <div class="track-page__input-container">
          <svg
            class="track-page__search-icon"
            width="18"
            height="18"
            style="width: 18px !important; height: 18px !important; min-width: 18px !important; min-height: 18px !important; max-width: 18px !important; max-height: 18px !important; flex-shrink: 0;"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            id={inputId}
            name="number"
            value={submittedTrackingNumber}
            placeholder="e.g. JHM-ABCD2345"
            autocomplete="off"
            spellcheck="false"
            autocapitalize="characters"
            required
            class="track-page__input"
          />
        </div>
        <button
          type="submit"
          class="track-page__submit-btn"
          disabled={disableFormSubmission}
          title={disableFormSubmission ? previewSubmissionTitle : undefined}
        >
          Track Orders
        </button>
      </div>
      <p class="track-page__hint">
        Format: JHM-XXXXXXXX • Included in your order confirmation email or SMS.
      </p>
    </form>
  </div>

  {
    (lookupError || rateLimitMessage) && (
      <div class="track-page__alert track-page__alert--error" role="alert">
        <svg
          width="20"
          height="20"
          style="width: 20px !important; height: 20px !important; min-width: 20px !important; min-height: 20px !important; max-width: 20px !important; max-height: 20px !important; flex-shrink: 0;"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="track-page__alert-icon"
        >
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="8" x2="12" y2="12" />
          <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        <span>{lookupError ?? rateLimitMessage}</span>
      </div>
    )
  }

  {
    lookupResult && (
      <section
        class="track-page__results"
        aria-labelledby="track-results-title"
      >
        <div class="track-page__results-summary">
          <div class="track-page__results-info">
            <span class="track-page__results-tag">
              RESULTS FOR {lookupResult.trackingNumber}
            </span>
            <h2 id="track-results-title" class="track-page__results-heading">
              {lookupResult.orders.length === 0
                ? "No active orders found"
                : `${lookupResult.orders.length} Order${lookupResult.orders.length === 1 ? "" : "s"} Found`}
            </h2>
          </div>
          {lookupResult.orders.length > 0 && (
            <div class="track-page__summary-due-card">
              <span class="track-page__summary-due-label">
                Total Amount Due
              </span>
              <strong class="track-page__summary-due-value">
                {formatTrackingCurrency(lookupResult.totalAmountDue)}
              </strong>
            </div>
          )}
        </div>

        {lookupResult.orders.map((order) => {
          const step = getOrderStatusStep(order.orderStatus);
          const isCancelled = order.orderStatus
            .toLowerCase()
            .includes("cancel");

          return (
            <article class="track-page__order-card">
              <header class="track-page__order-header">
                <div class="track-page__order-meta">
                  <span class="track-page__order-code">
                    Order #{order.id.slice(0, 8).toUpperCase()}
                  </span>
                  <span class="track-page__order-date">
                    Submitted {formatTrackingLookupDate(order.createdAt)}
                  </span>
                </div>
                <div class="track-page__status-group">
                  <span
                    class:list={[
                      "track-page__status-badge",
                      isCancelled
                        ? "track-page__status-badge--cancelled"
                        : step === 3
                          ? "track-page__status-badge--closed"
                          : "track-page__status-badge--active",
                    ]}
                  >
                    {formatTrackingOrderStatus(order.orderStatus)}
                  </span>
                  <span
                    class:list={[
                      "track-page__status-badge",
                      order.amountDue <= 0
                        ? "track-page__status-badge--paid"
                        : "track-page__status-badge--unpaid",
                    ]}
                  >
                    {formatTrackingOrderStatus(order.paymentStatus)}
                  </span>
                </div>
              </header>

              {!isCancelled && (
                <div class="track-page__stepper" aria-label="Order Timeline">
                  <div
                    class:list={[
                      "track-page__step",
                      { "is-active": step >= 1, "is-complete": step > 1 },
                    ]}
                  >
                    <div class="track-page__step-node">1</div>
                    <span class="track-page__step-label">Submitted</span>
                  </div>
                  <div
                    class:list={[
                      "track-page__step-line",
                      { "is-active": step >= 2 },
                    ]}
                  />
                  <div
                    class:list={[
                      "track-page__step",
                      { "is-active": step >= 2, "is-complete": step > 2 },
                    ]}
                  >
                    <div class="track-page__step-node">2</div>
                    <span class="track-page__step-label">Processing</span>
                  </div>
                  <div
                    class:list={[
                      "track-page__step-line",
                      { "is-active": step >= 3 },
                    ]}
                  />
                  <div
                    class:list={[
                      "track-page__step",
                      { "is-active": step >= 3, "is-complete": step >= 3 },
                    ]}
                  >
                    <div class="track-page__step-node">3</div>
                    <span class="track-page__step-label">
                      Delivered / Closed
                    </span>
                  </div>
                </div>
              )}

              <div class="track-page__amounts">
                <div class="track-page__amount-col">
                  <span class="track-page__amount-label">Order Total</span>
                  <strong class="track-page__amount-value">
                    {formatTrackingCurrency(order.orderTotal)}
                  </strong>
                </div>
                <div class="track-page__amount-col">
                  <span class="track-page__amount-label">Amount Due</span>
                  <strong
                    class:list={[
                      "track-page__amount-value",
                      order.amountDue <= 0
                        ? "track-page__amount-value--paid"
                        : "track-page__amount-value--due",
                    ]}
                  >
                    {order.amountDue <= 0
                      ? "Paid in full"
                      : formatTrackingCurrency(order.amountDue)}
                  </strong>
                </div>
              </div>

              {order.items.length > 0 && (
                <div class="track-page__items-section">
                  <span class="track-page__items-heading">
                    Itemized Products ({order.items.length})
                  </span>
                  <ul class="track-page__items-list">
                    {order.items.map((item) => (
                      <li class="track-page__item">
                        <div class="track-page__item-main">
                          <strong class="track-page__item-name">
                            {item.productName}
                          </strong>
                          <span class="track-page__item-qty">
                            {item.quantity} {item.unitLabel}
                          </span>
                        </div>
                        {item.addDetails && (
                          <p class="track-page__item-details">
                            {item.addDetails}
                          </p>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </article>
          );
        })}
      </section>
    )
  }

  {
    submittedTrackingNumber.trim() &&
      !lookupResult &&
      !lookupError &&
      !rateLimitMessage && (
        <div class="track-page__alert track-page__alert--error" role="alert">
          <svg
            width="20"
            height="20"
            style="width: 20px !important; height: 20px !important; min-width: 20px !important; min-height: 20px !important; max-width: 20px !important; max-height: 20px !important; flex-shrink: 0;"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="track-page__alert-icon"
          >
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
          <span>
            We could not find any customer record for that tracking number.
            Please check the number and try again.
          </span>
        </div>
      )
  }
</section>

<style>
  .track-page {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 1.75rem;
    width: 100%;
    max-width: 52rem;
    margin: 0;
    padding: 0;
    min-height: calc(100vh - 12rem);
    box-sizing: border-box;
  }

  .track-page__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 0.35rem;
  }

  .track-page__title {
    margin: 0;
    font-size: clamp(1.85rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: #111827;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-align: left;
  }

  .track-page__subtitle {
    margin: 0.25rem 0 0;
    font-size: 1rem;
    color: #4b5563;
    line-height: 1.5;
    text-align: left;
    max-width: 40rem;
  }

  .track-page__search-card {
    width: 100%;
    max-width: 44rem;
    background: transparent;
    border: none;
    padding: 0;
    box-shadow: none;
    box-sizing: border-box;
  }

  .track-page__form {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 100%;
  }

  .track-page__form-row {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 0.75rem;
    width: 100%;
  }

  .track-page__input-container {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
  }

  .track-page__search-icon {
    position: absolute;
    left: 0.85rem;
    width: 18px !important;
    height: 18px !important;
    min-width: 18px !important;
    min-height: 18px !important;
    max-width: 18px !important;
    max-height: 18px !important;
    color: #6b7280;
    pointer-events: none;
    flex-shrink: 0;
    z-index: 2;
  }

  .track-page__input {
    width: 100%;
    height: 2.85rem;
    padding: 0.5rem 1rem 0.5rem 2.6rem;
    font: inherit;
    font-size: 0.95rem;
    color: #111827;
    background: #f9fafb;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    box-sizing: border-box;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      background 0.15s ease;
  }

  .track-page__input:focus {
    outline: none;
    background: #ffffff;
    border-color: var(--color-brand-red, #661818);
    box-shadow: 0 0 0 3px rgba(102, 24, 24, 0.12);
  }

  .track-page__submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.85rem;
    padding: 0 1.5rem;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 700;
    color: #ffffff;
    background-color: var(--color-brand-red, #661818);
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background-color 0.2s ease;
  }

  .track-page__submit-btn:hover {
    background-color: #521313;
  }

  .track-page__hint {
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    color: #6b7280;
    text-align: left;
  }

  .track-page__alert {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 44rem;
    padding: 0.85rem 1.15rem;
    border-radius: 0.65rem;
    font-size: 0.9rem;
    font-weight: 500;
    box-sizing: border-box;
  }

  .track-page__alert--error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  .track-page__alert-icon {
    width: 20px !important;
    height: 20px !important;
    min-width: 20px !important;
    min-height: 20px !important;
    max-width: 20px !important;
    max-height: 20px !important;
    flex-shrink: 0;
  }

  .track-page__results {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .track-page__results-summary {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem;
    width: 100%;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .track-page__results-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
  }

  .track-page__results-tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #6b7280;
    text-transform: uppercase;
  }

  .track-page__results-heading {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    color: #111827;
  }

  .track-page__summary-due-card {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.65rem;
    padding: 0.6rem 1.15rem;
  }

  .track-page__summary-due-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #6b7280;
  }

  .track-page__summary-due-value {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-brand-red, #661818);
  }

  .track-page__order-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.85rem;
    padding: 1.5rem;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
    box-sizing: border-box;
  }

  .track-page__order-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .track-page__order-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
  }

  .track-page__order-code {
    font-size: 1.1rem;
    font-weight: 700;
    color: #111827;
  }

  .track-page__order-date {
    font-size: 0.85rem;
    color: #6b7280;
  }

  .track-page__status-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .track-page__status-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: capitalize;
  }

  .track-page__status-badge--active {
    background-color: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
  }

  .track-page__status-badge--closed {
    background-color: #f0fdf4;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }

  .track-page__status-badge--cancelled {
    background-color: #fef2f2;
    color: #b91c1c;
    border: 1px solid #fecaca;
  }

  .track-page__status-badge--paid {
    background-color: #f0fdf4;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  .track-page__status-badge--unpaid {
    background-color: #fffbe6;
    color: #92400e;
    border: 1px solid #fef08a;
  }

  /* Stepper */
  .track-page__stepper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.75rem 0;
    position: relative;
  }

  .track-page__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    z-index: 1;
  }

  .track-page__step-node {
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 9999px;
    background-color: #e5e7eb;
    color: #6b7280;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .track-page__step.is-active .track-page__step-node {
    background-color: var(--color-brand-red, #661818);
    color: #ffffff;
    box-shadow: 0 0 0 3px rgba(102, 24, 24, 0.12);
  }

  .track-page__step-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #6b7280;
  }

  .track-page__step.is-active .track-page__step-label {
    color: #111827;
    font-weight: 700;
  }

  .track-page__step-line {
    flex: 1;
    height: 3px;
    background-color: #e5e7eb;
    margin: 0 0.5rem 1.2rem 0.5rem;
  }

  .track-page__step-line.is-active {
    background-color: var(--color-brand-red, #661818);
  }

  .track-page__amounts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding: 1rem 1.15rem;
    background: #f9fafb;
    border-radius: 0.65rem;
  }

  .track-page__amount-col {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: left;
  }

  .track-page__amount-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #6b7280;
  }

  .track-page__amount-value {
    font-size: 1.1rem;
    font-weight: 800;
    color: #111827;
  }

  .track-page__amount-value--paid {
    color: #15803d;
  }

  .track-page__amount-value--due {
    color: var(--color-brand-red, #661818);
  }

  .track-page__items-section {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-align: left;
  }

  .track-page__items-heading {
    font-size: 0.85rem;
    font-weight: 700;
    color: #374151;
  }

  .track-page__items-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .track-page__item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 0.9rem;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
  }

  .track-page__item-main {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .track-page__item-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: #111827;
  }

  .track-page__item-qty {
    font-size: 0.82rem;
    font-weight: 600;
    color: #4b5563;
    background: #f3f4f6;
    padding: 0.15rem 0.55rem;
    border-radius: 0.35rem;
  }

  .track-page__item-details {
    margin: 0.15rem 0 0 0;
    font-size: 0.82rem;
    color: #6b7280;
  }

  @media (max-width: 640px) {
    .track-page {
      padding: 1.5rem 1rem 3rem 1rem;
    }

    .track-page__form-row {
      flex-direction: column;
    }

    .track-page__submit-btn {
      width: 100%;
    }

    .track-page__amounts {
      grid-template-columns: 1fr;
    }

    .track-page__results-summary {
      flex-direction: column;
      align-items: flex-start;
    }

    .track-page__summary-due-card {
      align-items: flex-start;
      width: 100%;
    }
  }
</style>
