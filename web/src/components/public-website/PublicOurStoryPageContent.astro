---
import AdminContentEditable from "@/components/admin/AdminContentEditable.astro";
import {
  getSectionFieldEntries,
  getSectionHeading,
  type PublicPageContent,
} from "@/lib/public-website/content";
import type { AdminContentEditingContext } from "@/lib/public-website/admin-content-editing";

type Props = {
  content: PublicPageContent;
  contentEditing?: AdminContentEditingContext;
};

const { content, contentEditing } = Astro.props;
---

<div class="our-story-container">
  <h2 class="page-title-brand">OUR STORY</h2>
  <div class="our-story-content">
    {
      content.sections.length > 0 ? (
        content.sections.map((section) => {
          const fields = getSectionFieldEntries(section);
          const heading = getSectionHeading(section);
          const hasCustomHeading =
            heading && heading !== "Our Story" && heading !== "Section";

          return (
            <div class="our-story-section">
              {hasCustomHeading && (
                <AdminContentEditable
                  contentEditing={contentEditing}
                  section={section}
                  fieldKey="heading"
                  fieldLabel="Section heading"
                  value={heading}
                >
                  <h3 class="our-story-subheading">{heading}</h3>
                </AdminContentEditable>
              )}
              {fields.map((field) => (
                <AdminContentEditable
                  contentEditing={contentEditing}
                  section={section}
                  fieldKey={field.key}
                  fieldLabel={field.label}
                  value={field.value}
                  multiline
                >
                  <p class="our-story-paragraph">{field.value}</p>
                </AdminContentEditable>
              ))}
            </div>
          );
        })
      ) : (
        <p class="our-story-paragraph">Our story has not been published yet.</p>
      )
    }
  </div>
</div>
