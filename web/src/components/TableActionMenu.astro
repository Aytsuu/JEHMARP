---
import ActionMenu from "@/components/ActionMenu.astro";

type Props = {
  menuLabel: string;
  pdfHref?: string;
  detailsHref?: string;
  detailsLabel?: string;
};

const {
  menuLabel,
  pdfHref,
  detailsHref,
  detailsLabel = "Order Details",
} = Astro.props;

const items = [
  pdfHref
    ? {
        label: "Open PDF",
        href: pdfHref,
        target: "_blank",
        rel: "noreferrer",
        icon: "external-pdf" as const,
      }
    : null,
  detailsHref
    ? {
        label: detailsLabel,
        href: detailsHref,
        icon: "details" as const,
      }
    : null,
].filter((item): item is NonNullable<typeof item> => item !== null);
---

<ActionMenu menuLabel={menuLabel} items={items} />
