---
import { authRoutes, publicRoutes } from "@/config/navigation";

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") {
    return pathname === "/";
  }
  return pathname.startsWith(href);
};
---

<header class="site-nav">
  <div class="site-nav__announcement">
    <div class="site-nav__announcement-inner">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="site-nav__announcement-icon"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
      <span><strong>FREE DELIVERY</strong> | Within Compostela & Consolacion Public Market (Minimum purchase may apply)</span>
    </div>
  </div>
  <nav class="site-nav__inner" aria-label="Primary navigation">
    <a class="site-nav__brand" href="/">
      <span class="site-nav__brand-mark" aria-hidden="true">Logo</span>
      <span class="site-nav__brand-text">JEHMARP</span>
    </a>
    <ul class="site-nav__list">
      {
        publicRoutes.map((item) => (
          <li>
            <a
              href={item.href}
              class={isActive(item.href) ? "site-nav__link--active" : ""}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      {
        authRoutes.map((item) => {
          const isLogin = item.href === "/login";
          const buttonClass = isLogin
            ? `site-nav__link--button ${isActive(item.href) ? "site-nav__link--active" : ""}`
            : (isActive(item.href) ? "site-nav__link--active" : "");

          return (
            <li>
              <a href={item.href} class={buttonClass}>
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  function initSmartNavbar() {
    const navbar = document.querySelector<HTMLElement>(".site-nav");
    if (!navbar) return;

    let lastScrollTop = 0;
    let navbarHeight = navbar.getBoundingClientRect().height;

    window.addEventListener("resize", () => {
      navbarHeight = navbar.getBoundingClientRect().height;
    });

    window.addEventListener("scroll", () => {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      // If at the initial top most, always show the navbar
      if (scrollTop <= 0) {
        navbar.classList.remove("site-nav--hidden");
        lastScrollTop = scrollTop;
        return;
      }

      // Hide when scrolling down past the navbar height
      if (scrollTop > lastScrollTop && scrollTop > navbarHeight) {
        navbar.classList.add("site-nav--hidden");
      } 
      // Show when scrolling up
      else if (scrollTop < lastScrollTop) {
        navbar.classList.remove("site-nav--hidden");
      }

      lastScrollTop = scrollTop;
    }, { passive: true });
  }

  // Initialize on load and on astro page transitions
  document.addEventListener("DOMContentLoaded", initSmartNavbar);
  document.addEventListener("astro:after-swap", initSmartNavbar);
  
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initSmartNavbar();
  }
</script>
