---
import type { AdminDashboardData } from "@/lib/admin-dashboard/data";
import ViewButton from "@/components/ViewButton.astro";
import { selected, formatDate } from "@/lib/admin-dashboard/view";
import { autoCapitalize } from "@/lib/formatters";

type Props = {
  data: AdminDashboardData;
};

const { data } = Astro.props;
const agentStatuses = ["active", "inactive", "suspended"] as const;
---

<section id="admin-agents" class="admin-panel" aria-labelledby="admin-agents-title">
  <div class="hidden-create-form-holder" style="display: none;">
    <form method="post" class="admin-form" aria-label="Create agent">
      <input type="hidden" name="action" value="create-agent" />
      <div class="admin-form-grid">
        <label class="field-row"><span>Email</span><input name="email" type="email" required /></label>
        <label class="field-row"><span>Temporary password</span><input name="password" type="password" minlength="8" required /></label>
        <label class="field-row"><span>Display name</span><input name="displayName" required /></label>
        <label class="field-row">
          <span>Status</span>
          <select name="status" required>
            {agentStatuses.map((status) => (
              <option value={status}>{autoCapitalize(status)}</option>
            ))}
          </select>
        </label>
      </div>
      <button type="submit">Create agent</button>
    </form>
  </div>

  <div data-interactive-table>
    <div class="table-filters">
      <div style="flex: 1; min-width: 15rem;">
        <input type="text" placeholder="Search agents..." data-search-input style="width: 100%;" />
      </div>
      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 0.35rem;">
          <span style="font-size: 0.9rem; color: var(--color-brand-muted-black);">Show</span>
          <select data-limit-select>
            <option value="10">10</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </div>
        <button type="button" class="btn-table-manage" data-open-create-sheet style="padding: 0.5rem 1rem; border-radius: 0.375rem; text-transform: none; font-size: 0.9rem; font-weight: 600; letter-spacing: normal;">Create Agent</button>
      </div>
    </div>

    <div class="table-wrap">
      <table style="table-layout: fixed; width: 100%;">
        <thead>
          <tr>
            <th scope="col" style="width: 20%; padding: 1.1rem 0.75rem;">Agent</th>
            <th scope="col" style="width: 22%; padding: 1.1rem 0.75rem;">Email</th>
            <th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Contact</th>
            <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Status</th>
            <th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Date Created</th>
            <th scope="col" style="width: 12%; padding: 1.1rem 0.75rem;">Action</th>
          </tr>
        </thead>
        <tbody>
          {data.agents.map((agent) => (
            <tr data-status={agent.status}>
              <!-- 1. Agent Name Column (Editable Popover) -->
              <td style="width: 20%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <button type="button" class="table-cell-trigger" data-open-cell-popover data-popover-title={`Edit Display Name: ${agent.display_name}`} style="width: 100%; text-align: left; display: block; overflow: hidden; cursor: pointer;">
                  <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; color: inherit; font-weight: inherit;">
                    {agent.display_name}
                  </span>
                </button>
                
                <div class="hidden-popover-form-holder" style="display: none;">
                  <form method="post" class="admin-table-form">
                    <input type="hidden" name="action" value="update-agent" />
                    <input type="hidden" name="agentId" value={agent.id} />
                    <input type="hidden" name="status" value={agent.status} />
                    <input type="hidden" name="email" value={agent.email ?? ""} />
                    <input type="hidden" name="contact" value={agent.contact ?? ""} />
                    <label>
                      <span>Display name</span>
                      <input name="displayName" value={agent.display_name} required />
                    </label>
                    <button type="submit">Save</button>
                  </form>
                </div>
              </td>

              <!-- 2. Email Column (Editable Popover) -->
              <td style="width: 22%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <button type="button" class="table-cell-trigger" data-open-cell-popover data-popover-title={`Edit Email: ${agent.display_name}`} style="width: 100%; text-align: left; display: block; overflow: hidden; cursor: pointer;">
                  <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; color: inherit; font-weight: inherit;">
                    {agent.email ?? "No email"}
                  </span>
                </button>
                
                <div class="hidden-popover-form-holder" style="display: none;">
                  <form method="post" class="admin-table-form">
                    <input type="hidden" name="action" value="update-agent" />
                    <input type="hidden" name="agentId" value={agent.id} />
                    <input type="hidden" name="displayName" value={agent.display_name} />
                    <input type="hidden" name="status" value={agent.status} />
                    <input type="hidden" name="contact" value={agent.contact ?? ""} />
                    <label>
                      <span>Email</span>
                      <input name="email" type="email" value={agent.email ?? ""} />
                    </label>
                    <button type="submit">Save</button>
                  </form>
                </div>
              </td>

              <!-- 3. Contact Column (Editable Popover) -->
              <td style="width: 16%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <button type="button" class="table-cell-trigger" data-open-cell-popover data-popover-title={`Edit Contact: ${agent.display_name}`} style="width: 100%; text-align: left; display: block; overflow: hidden; cursor: pointer;">
                  <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; color: inherit; font-weight: inherit;">
                    {agent.contact ?? "No contact"}
                  </span>
                </button>
                
                <div class="hidden-popover-form-holder" style="display: none;">
                  <form method="post" class="admin-table-form">
                    <input type="hidden" name="action" value="update-agent" />
                    <input type="hidden" name="agentId" value={agent.id} />
                    <input type="hidden" name="displayName" value={agent.display_name} />
                    <input type="hidden" name="status" value={agent.status} />
                    <input type="hidden" name="email" value={agent.email ?? ""} />
                    <label>
                      <span>Contact</span>
                      <input name="contact" value={agent.contact ?? ""} />
                    </label>
                    <button type="submit">Save</button>
                  </form>
                </div>
              </td>

              <!-- 4. Status Column (Dropdown Autoupdate on Change) -->
              <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                <form method="post" style="margin: 0; width: 100%;">
                  <input type="hidden" name="action" value="update-agent" />
                  <input type="hidden" name="agentId" value={agent.id} />
                  <input type="hidden" name="displayName" value={agent.display_name} />
                  <input type="hidden" name="email" value={agent.email ?? ""} />
                  <input type="hidden" name="contact" value={agent.contact ?? ""} />
                  <select name="status" onchange="this.closest('form').submit()" style="padding: 0.25rem 0.5rem; border: 1px solid #d1d5db; border-radius: 0.375rem; background-color: white; cursor: pointer; width: 100%;">
                    {agentStatuses.map((status) => (
                      <option value={status} selected={selected(agent.status, status)}>{autoCapitalize(status)}</option>
                    ))}
                  </select>
                </form>
              </td>

              <!-- 5. Date Created Column -->
              <td style="width: 16%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                {formatDate(agent.created_at)}
              </td>

              <!-- 6. Action Column -->
              <td style="width: 12%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                <ViewButton href={`/admin/agents/${agent.id}`} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="table-pagination">
      <span data-page-info style="font-size: 0.9rem; color: var(--color-brand-muted-black); font-weight: 500;"></span>
      <div style="display: flex; gap: 0.25rem; align-items: center;">
        <button type="button" data-pagination-prev class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&lt;</button>
        <div data-pagination-numbers style="display: flex; gap: 0.25rem;"></div>
        <button type="button" data-pagination-next class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&gt;</button>
      </div>
    </div>
  </div>
</section>
