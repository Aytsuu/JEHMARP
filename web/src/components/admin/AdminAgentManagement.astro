---
import Sheet from "@/components/ui/Sheet.astro";
import ViewButton from "@/components/ViewButton.astro";
import type { AdminAgentManagementData } from "@/lib/admin-dashboard/data";
import type { AdminAgentFilters } from "@/lib/admin-dashboard/agent-filters";
import { agentStatuses } from "@/lib/admin-dashboard/agent-filters";
import { selected, formatDate } from "@/lib/admin-dashboard/view";
import { autoCapitalize } from "@/lib/formatters";

type Props = {
  data: AdminAgentManagementData;
  activeFilters: AdminAgentFilters;
  filterQuery: string;
};

const { data, activeFilters, filterQuery } = Astro.props;
const hasActiveFilters = filterQuery.length > 0;
const skeletonRows = Array.from({ length: 6 });
---

<section id="admin-agents" class="admin-panel" aria-labelledby="admin-agents-title">
  <Sheet id="create-agent-sheet" width="34rem">
    <div slot="header" class="agent-create-sheet__header-copy">
      <h3 class="drawer-sheet__title" data-sheet-title>Create Agent</h3>
      <p class="agent-create-sheet__header-description">
        Add the agent's login details, display name, and initial account status.
      </p>
    </div>
    <form id="create-agent-form" method="post" class="admin-form agent-create-form" aria-label="Create agent">
      <input type="hidden" name="action" value="create-agent" />
      <div class="admin-form-grid agent-create-form__grid">
        <label class="field-row"><span>Email</span><input name="email" type="email" required /></label>
        <label class="field-row"><span>Temporary password</span><input name="password" type="password" minlength="8" required /></label>
        <label class="field-row"><span>Display name</span><input name="displayName" required /></label>
        <label class="field-row">
          <span>Status</span>
          <select name="status" required>
            {agentStatuses.map((status) => (
              <option value={status}>{autoCapitalize(status)}</option>
            ))}
          </select>
        </label>
      </div>
    </form>
    <div slot="footer" class="agent-create-sheet__footer">
      <button type="submit" form="create-agent-form">Create agent</button>
    </div>
  </Sheet>

  <div data-interactive-table>
    <div class="table-filters order-management-toolbar">
      <form
        method="get"
        action="/admin/agents"
        class="order-filter-form"
        data-agent-filter-form
        data-current-filter-query={filterQuery}
        aria-label="Filter agents"
      >
        <label class="order-filter-form__field order-filter-form__field--search">
          <span>Search</span>
          <input
            name="search"
            type="search"
            value={activeFilters.search ?? ""}
            placeholder="Search agent name or email..."
            autocomplete="off"
            data-agent-search-input
          />
        </label>
        <label class="order-filter-form__field">
          <span>Status</span>
          <select name="status">
            <option value="">All statuses</option>
            {agentStatuses.map((status) => (
              <option value={status} selected={activeFilters.status === status}>
                {autoCapitalize(status)}
              </option>
            ))}
          </select>
        </label>
        <a
          href="/admin/agents"
          class="order-filter-form__reset"
          data-agent-filter-reset
          hidden={!hasActiveFilters}
        >
          Clear
        </a>
      </form>

      <div class="order-management-toolbar__actions">
        <label class="order-management-toolbar__limit">
          <span>Show</span>
          <select data-limit-select>
            <option value="10">10</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </label>
        <button
          type="button"
          class="btn-table-manage order-management-toolbar__create"
          data-open-create-sheet
          data-sheet-target="#create-agent-sheet"
        >Create Agent</button>
      </div>
    </div>

    <div data-agent-table-shell>
      <div class="table-wrap">
        <table style="table-layout: fixed; width: 100%;">
          <thead>
            <tr>
              <th scope="col" style="width: 20%; padding: 1.1rem 0.75rem;">Agent</th>
              <th scope="col" style="width: 30%; padding: 1.1rem 0.75rem;">Email</th>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Status</th>
              <th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Date Created</th>
              <th scope="col" style="width: 20%; padding: 1.1rem 0.75rem;">Action</th>
            </tr>
          </thead>
          <tbody>
            {data.agents.length === 0 ? (
              <tr class="empty-row">
                <td colspan="5" class="empty-state">No agents match the selected filters.</td>
              </tr>
            ) : data.agents.map((agent) => (
              <tr data-status={agent.status}>
                <td style="width: 20%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  <button type="button" class="table-cell-trigger" data-open-cell-popover data-popover-title={`Edit Display Name: ${agent.display_name}`} style="width: 100%; text-align: left; display: block; overflow: hidden; cursor: pointer;">
                    <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; color: inherit; font-weight: inherit;">
                      {agent.display_name}
                    </span>
                  </button>
                  <div class="hidden-popover-form-holder" style="display: none;">
                    <form method="post" class="admin-table-form">
                      <input type="hidden" name="action" value="update-agent" />
                      <input type="hidden" name="agentId" value={agent.id} />
                      <input type="hidden" name="status" value={agent.status} />
                      <label><span>Display name</span><input name="displayName" value={agent.display_name} required /></label>
                      <button type="submit">Save</button>
                    </form>
                  </div>
                </td>
                <td style="width: 30%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block;">
                    {agent.email ?? "No email"}
                  </span>
                </td>
                <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                    data-popover-title={`Edit Status: ${agent.display_name}`}
                    style="width: 100%; text-align: left; display: block; overflow: hidden; cursor: pointer;"
                  >
                    <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; color: inherit; font-weight: inherit;">
                      {autoCapitalize(agent.status)}
                    </span>
                  </button>
                  <div class="hidden-popover-form-holder" style="display: none;">
                    <form method="post" class="admin-table-form">
                      <input type="hidden" name="action" value="update-agent" />
                      <input type="hidden" name="agentId" value={agent.id} />
                      <input type="hidden" name="displayName" value={agent.display_name} />
                      <label>
                        <span>Status</span>
                        <select name="status" required>
                          {agentStatuses.map((status) => (
                            <option value={status} selected={selected(agent.status, status)}>
                              {autoCapitalize(status)}
                            </option>
                          ))}
                        </select>
                      </label>
                      <button type="submit">Save status</button>
                    </form>
                  </div>
                </td>
                <td style="width: 16%; padding: 1.1rem 0.75rem; vertical-align: middle;">{formatDate(agent.created_at)}</td>
                <td style="width: 20%; padding: 1.1rem 0.75rem; vertical-align: middle;"><ViewButton href={`/admin/agents/${agent.id}`} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="table-pagination">
      <span data-page-info style="font-size: 0.9rem; color: var(--color-brand-muted-black); font-weight: 500;"></span>
      <div style="display: flex; gap: 0.25rem; align-items: center;">
        <button type="button" data-pagination-prev class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&lt;</button>
        <div data-pagination-numbers style="display: flex; gap: 0.25rem;"></div>
        <button type="button" data-pagination-next class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&gt;</button>
      </div>
    </div>
  </div>

  <template data-agent-filter-skeleton>
    <div class="table-wrap" aria-busy="true" aria-live="polite">
      <table class="product-table-skeleton" style="table-layout: fixed; width: 100%;">
        <caption class="sr-only">Loading filtered agents</caption>
        <thead><tr><th scope="col">Agent</th><th scope="col">Email</th><th scope="col">Status</th><th scope="col">Date Created</th><th scope="col">Action</th></tr></thead>
        <tbody>{skeletonRows.map(() => (<tr><td><span class="table-skeleton-block"></span></td><td><span class="table-skeleton-block"></span></td><td><span class="table-skeleton-block table-skeleton-block--short"></span></td><td><span class="table-skeleton-block"></span></td><td><span class="table-skeleton-block table-skeleton-block--short"></span></td></tr>))}</tbody>
      </table>
    </div>
  </template>
</section>

<script>
  function initAdminAgentFilters() {
    const form = document.querySelector<HTMLFormElement>("[data-agent-filter-form]");
    const tableShell = document.querySelector<HTMLElement>("[data-agent-table-shell]");
    const skeletonTemplate = document.querySelector<HTMLTemplateElement>("[data-agent-filter-skeleton]");
    const resetLink = document.querySelector<HTMLAnchorElement>("[data-agent-filter-reset]");
    if (!form || !tableShell || !skeletonTemplate) return;
    if (form.dataset.agentFilterInitialized === "true") return;
    form.dataset.agentFilterInitialized = "true";
    const activeForm = form;
    const activeTableShell = tableShell;
    const activeSkeletonTemplate = skeletonTemplate;
    const cacheKey = "admin-agents-filter-cache-v1";
    const fragmentPath = "/admin/agents-fragment";
    const filterKeys = ["search", "status"] as const;
    const autoSubmitFields = activeForm.querySelectorAll<HTMLSelectElement>("select");
    const searchInput = activeForm.querySelector<HTMLInputElement>("[data-agent-search-input]");
    let submitTimer: number | undefined;
    let searchTimer: number | undefined;
    let activeFetchController: AbortController | undefined;
    function readCache(): string[] { try { const parsed = JSON.parse(sessionStorage.getItem(cacheKey) || "[]"); return Array.isArray(parsed) ? parsed.filter((value): value is string => typeof value === "string") : []; } catch { return []; } }
    function writeCache(values: string[]) { sessionStorage.setItem(cacheKey, JSON.stringify([...new Set(values)])); }
    function normalizeParams(params: URLSearchParams) { const normalized = new URLSearchParams(); filterKeys.forEach((key) => { const value = params.get(key)?.trim(); if (value) normalized.set(key, value); }); return normalized.toString(); }
    function normalizeFormQuery() { const params = new URLSearchParams(); const formData = new FormData(activeForm); filterKeys.forEach((key) => { const value = formData.get(key); if (typeof value === "string" && value.trim()) params.set(key, value.trim()); }); return params.toString(); }
    function buildUrl(path: string, targetQuery: string) { return targetQuery ? `${path}?${targetQuery}` : path; }
    function showSkeletonForQuery(targetQuery: string) { const currentQuery = normalizeParams(new URLSearchParams(window.location.search)); const cachedQueries = readCache(); if (targetQuery === currentQuery || cachedQueries.includes(targetQuery)) return; const skeleton = activeSkeletonTemplate.content.firstElementChild?.cloneNode(true); if (skeleton) activeTableShell.replaceChildren(skeleton); }
    function replaceAgentFragment(fragmentHtml: string) { const parsed = new DOMParser().parseFromString(fragmentHtml, "text/html"); const nextTableShell = parsed.querySelector<HTMLElement>("[data-agent-table-shell]"); if (!nextTableShell) throw new Error("Agents fragment did not include an agent table."); activeTableShell.innerHTML = nextTableShell.innerHTML; document.dispatchEvent(new Event("dashboard:interactive-table-updated")); }
    async function applyFilters(targetQuery: string) { const currentQuery = normalizeParams(new URLSearchParams(window.location.search)); if (targetQuery === currentQuery) return; showSkeletonForQuery(targetQuery); activeFetchController?.abort(); const fetchController = new AbortController(); activeFetchController = fetchController; try { const response = await fetch(buildUrl(fragmentPath, targetQuery), { headers: { "X-Requested-With": "fetch" }, signal: fetchController.signal }); if (!response.ok) throw new Error(`Agent filters failed with ${response.status}.`); const fragmentHtml = await response.text(); window.history.replaceState({ agentFilterQuery: targetQuery }, "", buildUrl("/admin/agents", targetQuery)); replaceAgentFragment(fragmentHtml); activeForm.dataset.currentFilterQuery = targetQuery; if (resetLink) resetLink.hidden = targetQuery.length === 0; writeCache([...readCache(), targetQuery]); } catch (error) { if (error instanceof DOMException && error.name === "AbortError") return; window.location.href = buildUrl("/admin/agents", targetQuery); } finally { if (activeFetchController === fetchController) activeFetchController = undefined; } }
    function submitFilters() { window.clearTimeout(submitTimer); submitTimer = window.setTimeout(() => { void applyFilters(normalizeFormQuery()); }, 120); }
    writeCache([...readCache(), normalizeParams(new URLSearchParams(window.location.search))]);
    activeForm.addEventListener("submit", (event) => { event.preventDefault(); void applyFilters(normalizeFormQuery()); });
    autoSubmitFields.forEach((field) => field.addEventListener("change", submitFilters));
    searchInput?.addEventListener("input", () => { window.clearTimeout(searchTimer); searchTimer = window.setTimeout(submitFilters, 450); });
    resetLink?.addEventListener("click", (event) => { if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return; event.preventDefault(); void applyFilters(""); });
  }
  document.addEventListener("DOMContentLoaded", initAdminAgentFilters);
  document.addEventListener("astro:after-swap", initAdminAgentFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") initAdminAgentFilters();
</script>
