---
import PublicSitePreview from "@/components/public-website/PublicSitePreview.astro";
import { ADMIN_CONTENT_PREVIEW_ROOT } from "@/lib/public-website/admin-content-preview";

type Props = {
  activePath: string;
};

const { activePath } = Astro.props;
const guestViewHref = activePath;
---

<div class="admin-content-preview" data-admin-content-preview>
  <div class="admin-content-preview__scroll">
    <PublicSitePreview
      activePath={activePath}
      previewRoot={ADMIN_CONTENT_PREVIEW_ROOT}
    >
      <slot />
    </PublicSitePreview>
  </div>
  <div class="admin-content-preview-floating-bar">
    <a
      href={guestViewHref}
      class="admin-content-preview-guest-link"
      target="_blank"
      rel="noreferrer"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path
          d="M21 14v4a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3h4"
        ></path></svg
      >
      <span>View as guest</span>
    </a>
  </div>
</div>

<style>
  .admin-content-preview {
    position: relative;
    display: flex;
    flex: 1 0 auto;
    flex-direction: column;
    width: 100%;
    min-height: min-content;
    overflow: visible;
    background: #ffffff;
  }

  .admin-content-preview__scroll {
    flex: 1 0 auto;
    min-height: min-content;
    overflow: visible;
  }

  .admin-content-preview :global(.public-site-preview) {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .admin-content-preview :global(.public-site-preview__main) {
    display: block;
    flex: 1 0 auto;
  }

  .admin-content-preview-floating-bar {
    position: fixed;
    right: 1.5rem;
    bottom: 1.25rem;
    z-index: 40;
    pointer-events: none;
  }

  .admin-content-preview-guest-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.35rem;
    padding: 0 1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.375rem;
    background: #2e2e2e;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    pointer-events: auto;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.24);
  }

  .admin-content-preview-guest-link:hover,
  .admin-content-preview-guest-link:focus-visible {
    background: #3a3a3a;
    color: #ffffff;
    outline: none;
  }

  .admin-content-preview-guest-link svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
