---
import AdminCharts from "@/components/admin/AdminCharts";
import { buildAdminAnalytics } from "@/lib/admin-dashboard/analytics";
import { formatCurrency } from "@/lib/admin-dashboard/view";

import type { AdminDashboardData } from "@/lib/admin-dashboard/data";

type Props = {
  data: AdminDashboardData;
};

const { data } = Astro.props;
const analytics = buildAdminAnalytics(data);
const pendingCustomerBalances = analytics.pendingCustomerBalances;
---

<section class="admin-summary-grid" aria-label="Dashboard summary">
  <article class="admin-summary-card" data-summary-card="orders">
    <h2>Orders</h2>
    <p data-summary-value>{data.summary.orders}</p>
    <a href="/admin/orders">Review orders</a>
  </article>
  <article class="admin-summary-card">
    <h2>Gross Sales</h2>
    <p>{formatCurrency(analytics.summary.grossSales)}</p>
    <a href="/admin/sales">Review sales</a>
  </article>
  <article class="admin-summary-card admin-summary-card--button" data-summary-card="pendingOrderPayments">
    <button
      type="button"
      class="admin-summary-card__trigger"
      data-open-pending-payments-modal
      aria-haspopup="dialog"
      aria-controls="pending-payments-modal"
    >
      <span class="admin-summary-card__label">Pending Payments</span>
      <strong>{formatCurrency(analytics.summary.pendingOrderPayments)}</strong>
      <span class="admin-summary-card__action">View unpaid customers</span>
    </button>
  </article>
  <article class="admin-summary-card" data-summary-card="customers">
    <h2>Customers</h2>
    <p data-summary-value>{data.summary.customers}</p>
    <a href="/admin/customers">Manage customers</a>
  </article>
  <article class="admin-summary-card" data-summary-card="products">
    <h2>Products</h2>
    <p data-summary-value>{data.summary.products}</p>
    <a href="/admin/products">Manage products</a>
  </article>
</section>

<div
  id="pending-payments-modal"
  class="dashboard-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pending-payments-modal-title"
  aria-hidden="true"
  data-pending-payments-modal
>
  <div class="dashboard-modal__backdrop" data-close-pending-payments-modal></div>
  <section class="dashboard-modal__panel" tabindex="-1">
    <header class="dashboard-modal__header">
      <div>
        <h2 id="pending-payments-modal-title">Pending Customer Payments</h2>
        <p>{formatCurrency(analytics.summary.pendingOrderPayments)} total unpaid balance</p>
      </div>
      <button
        type="button"
        class="dashboard-modal__close"
        data-close-pending-payments-modal
        aria-label="Close pending payments"
      >
        &times;
      </button>
    </header>
    <div class="dashboard-modal__body">
      {
        pendingCustomerBalances.length > 0 ? (
          <div class="pending-payments-list">
            {pendingCustomerBalances.map((customer) => (
              <a
                class="pending-payments-list__row"
                href={`/admin/customers/${customer.customerId}`}
              >
                <span>
                  <strong>{customer.customerName}</strong>
                  <small>
                    {customer.orderCount} unpaid {customer.orderCount === 1 ? "order" : "orders"}
                  </small>
                </span>
                <b>{formatCurrency(customer.unpaidBalance)}</b>
              </a>
            ))}
          </div>
        ) : (
          <p class="dashboard-modal__empty">No customer unpaid balances.</p>
        )
      }
    </div>
  </section>
</div>

<section aria-label="Analytics Visualization">
  <AdminCharts client:only="react" analytics={analytics} />
</section>

<script>
  function initAdminDashboardSummary() {
    const summaryCards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-summary-card]"),
    );

    if (summaryCards.length === 0) return;

    const summaryShell = summaryCards[0]?.closest(".admin-summary-grid") as HTMLElement | null;
    if (!summaryShell || summaryShell.dataset.summaryInitialized === "true") return;
    summaryShell.dataset.summaryInitialized = "true";

    const cardByKey = new Map(
      summaryCards.map((card) => [card.dataset.summaryCard ?? "", card]),
    );

    async function refreshSummary() {
      try {
        const response = await fetch("/admin/dashboard-summary.json", {
          headers: {
            Accept: "application/json",
          },
        });

        if (response.status === 503) {
          const body = await response.json().catch(() => null) as { redirectUrl?: string } | null;
          window.location.assign(body?.redirectUrl || "/system-issue");
          return;
        }

        if (!response.ok) {
          throw new Error(`Dashboard summary failed with ${response.status}.`);
        }

        const summary = await response.json() as Record<string, number>;

        cardByKey.forEach((card, key) => {
          const value = summary[key];
          const valueNode = card.querySelector<HTMLElement>("[data-summary-value]");

          if (!valueNode || typeof value !== "number" || Number.isNaN(value)) {
            return;
          }

          valueNode.textContent = new Intl.NumberFormat("en-PH").format(value);
        });
      } catch {
        // Keep the server-rendered values if the refresh fails.
      }
    }

    void refreshSummary();
  }

  document.addEventListener("DOMContentLoaded", initAdminDashboardSummary);
  document.addEventListener("astro:after-swap", initAdminDashboardSummary);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAdminDashboardSummary();
  }

  function initPendingPaymentsModal() {
    const modal = document.querySelector<HTMLElement>("[data-pending-payments-modal]");
    const panel = modal?.querySelector<HTMLElement>(".dashboard-modal__panel");
    const openButton = document.querySelector<HTMLElement>("[data-open-pending-payments-modal]");
    const closeButtons = modal?.querySelectorAll<HTMLElement>("[data-close-pending-payments-modal]");

    if (!modal || !panel || !openButton || modal.dataset.initialized === "true") return;

    const activeModal = modal;
    const activePanel = panel;

    activeModal.dataset.initialized = "true";
    let previousFocus: HTMLElement | null = null;

    function openModal() {
      previousFocus = document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null;
      activeModal.classList.add("dashboard-modal--open");
      activeModal.setAttribute("aria-hidden", "false");
      document.body.classList.add("dashboard-modal-is-open");
      activePanel.focus();
    }

    function closeModal() {
      activeModal.classList.remove("dashboard-modal--open");
      activeModal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("dashboard-modal-is-open");
      previousFocus?.focus();
    }

    openButton.addEventListener("click", openModal);
    closeButtons?.forEach((button) => {
      button.addEventListener("click", closeModal);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && activeModal.classList.contains("dashboard-modal--open")) {
        closeModal();
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initPendingPaymentsModal);
  document.addEventListener("astro:after-swap", initPendingPaymentsModal);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initPendingPaymentsModal();
  }
</script>
