---
import AdminCharts from "@/components/admin/AdminCharts";
import DashboardModal from "@/components/dashboard/DashboardModal.astro";
import { buildAdminAnalytics } from "@/lib/admin-dashboard/analytics";
import { formatCurrency } from "@/lib/admin-dashboard/view";

import type { AdminDashboardData } from "@/lib/admin-dashboard/data";

type Props = {
  data: AdminDashboardData;
};

const { data } = Astro.props;
const analytics = buildAdminAnalytics(data);
const pendingCustomerBalances = analytics.pendingCustomerBalances;
const numberFormatter = new Intl.NumberFormat("en-PH");
---

<section class="admin-summary-grid" aria-label="Dashboard summary">
  <article class="admin-summary-card admin-summary-card--brand">
    <h2>Gross Sales</h2>
    <p>{formatCurrency(analytics.summary.grossSales)}</p>
    <a href="/admin/sales">Review sales</a>
  </article>
  <article class="admin-summary-card" data-summary-card="pendingOrderPayments">
    <h2>Receivables</h2>
    <p>{formatCurrency(analytics.summary.pendingOrderPayments)}</p>
    <button
      type="button"
      class="admin-summary-card__link"
      data-open-dashboard-modal="pending-payments-modal"
      aria-haspopup="dialog"
      aria-controls="pending-payments-modal"
    >
      View unpaid customers
    </button>
  </article>
  <article class="admin-summary-card" data-summary-card="agents">
    <h2>Agents</h2>
    <p data-summary-value>{numberFormatter.format(data.summary.agents)}</p>
    <a href="/admin/agents">Manage agents</a>
  </article>
  <article class="admin-summary-card" data-summary-card="customers">
    <h2>Customers</h2>
    <p data-summary-value>{numberFormatter.format(data.summary.customers)}</p>
    <a href="/admin/customers">Manage customers</a>
  </article>
  <article class="admin-summary-card" data-summary-card="products">
    <h2>Products</h2>
    <p data-summary-value>{numberFormatter.format(data.summary.products)}</p>
    <a href="/admin/products">Manage products</a>
  </article>
</section>

<DashboardModal
  id="pending-payments-modal"
  title="Receivables"
  description={`${formatCurrency(analytics.summary.pendingOrderPayments)} total unpaid balance`}
>
  {
    pendingCustomerBalances.length > 0 ? (
      <div class="pending-payments-list">
        {pendingCustomerBalances.map((customer) => (
          <article class="pending-payments-customer">
            <header class="pending-payments-customer__header">
              <div class="pending-payments-customer__identity">
                <a
                  class="pending-payments-customer__name"
                  href={`/admin/customers/${customer.customerId}`}
                >
                  {customer.customerName}
                </a>
                <p class="pending-payments-customer__meta">
                  {customer.orderCount} unpaid {customer.orderCount === 1 ? "order" : "orders"}
                </p>
              </div>
            </header>

            <ul class="pending-payments-orders">
              {
                customer.orders.map((order) => (
                  <li class="pending-payments-order">
                    <div class="pending-payments-order__header">
                      <span class="pending-payments-order__code">
                        {order.orderCode}
                      </span>
                      <strong class="pending-payments-order__balance">
                        {formatCurrency(order.unpaidBalance)}
                      </strong>
                    </div>
                    <div
                      class="pending-payments-order__calculation"
                      aria-label={`${order.orderCode} receivable calculation`}
                    >
                      {
                        order.hasCommissionAdjustment ? (
                          <>
                            <div class="pending-payments-calculation__row">
                              <span>Gross</span>
                              <span>{formatCurrency(order.grossTotal)}</span>
                            </div>
                            <div class="pending-payments-calculation__row pending-payments-calculation__row--deduction">
                              <span>Commission</span>
                              <span>−{formatCurrency(order.commissionTotal)}</span>
                            </div>
                            <div class="pending-payments-calculation__row">
                              <span>Receivable</span>
                              <span>{formatCurrency(order.receivableTotal)}</span>
                            </div>
                            <div class="pending-payments-calculation__row pending-payments-calculation__row--deduction">
                              <span>Paid</span>
                              <span>−{formatCurrency(order.paidTotal)}</span>
                            </div>
                          </>
                        ) : (
                          <>
                            <div class="pending-payments-calculation__row">
                              <span>Gross</span>
                              <span>{formatCurrency(order.grossTotal)}</span>
                            </div>
                            <div class="pending-payments-calculation__row pending-payments-calculation__row--deduction">
                              <span>Paid</span>
                              <span>−{formatCurrency(order.paidTotal)}</span>
                            </div>
                          </>
                        )
                      }
                    </div>
                    <div class="pending-payments-order__actions">
                      <a
                        class="pending-payments-order__view-link"
                        href={`/admin/orders/customer/${order.orderId}`}
                      >
                        View order details
                      </a>
                    </div>
                  </li>
                ))
              }
            </ul>
          </article>
        ))}
      </div>
    ) : (
      <p class="dashboard-modal__empty">No customer unpaid balances.</p>
    )
  }
</DashboardModal>

<section aria-label="Analytics Visualization">
  <AdminCharts client:only="react" analytics={analytics} />
</section>

<script>
  function initAdminDashboardSummary() {
    const summaryCards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-summary-card]"),
    );

    if (summaryCards.length === 0) return;

    const summaryShell = summaryCards[0]?.closest(".admin-summary-grid") as HTMLElement | null;
    if (!summaryShell || summaryShell.dataset.summaryInitialized === "true") return;
    summaryShell.dataset.summaryInitialized = "true";

    const cardByKey = new Map(
      summaryCards.map((card) => [card.dataset.summaryCard ?? "", card]),
    );

    async function refreshSummary() {
      try {
        const response = await fetch("/admin/dashboard-summary.json", {
          headers: {
            Accept: "application/json",
          },
        });

        if (response.status === 503) {
          const body = await response.json().catch(() => null) as { redirectUrl?: string } | null;
          window.location.assign(body?.redirectUrl || "/system-issue");
          return;
        }

        if (!response.ok) {
          throw new Error(`Dashboard summary failed with ${response.status}.`);
        }

        const summary = await response.json() as Record<string, number>;
        const numberFormatter = new Intl.NumberFormat("en-PH");

        cardByKey.forEach((card, key) => {
          const value = summary[key];
          const valueNode = card.querySelector<HTMLElement>("[data-summary-value]");

          if (!valueNode || typeof value !== "number" || Number.isNaN(value)) {
            return;
          }

          valueNode.textContent = numberFormatter.format(value);
        });
      } catch {
        // Keep the server-rendered values if the refresh fails.
      }
    }

    void refreshSummary();
  }

  document.addEventListener("DOMContentLoaded", initAdminDashboardSummary);
  document.addEventListener("astro:after-swap", initAdminDashboardSummary);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAdminDashboardSummary();
  }
</script>
