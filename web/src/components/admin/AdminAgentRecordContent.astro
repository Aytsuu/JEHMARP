---
import AdminAgentRecordTabTable from "@/components/admin/AdminAgentRecordTabTable.astro";
import AdminCustomerRecordTabTable from "@/components/admin/AdminCustomerRecordTabTable.astro";
import MetricTrend from "@/components/ui/MetricTrend.astro";
import Tooltip from "@/components/ui/Tooltip.astro";
import AlertDialog from "@/components/ui/AlertDialog.astro";
import DashboardModal from "@/components/dashboard/DashboardModal.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import Popover from "@/components/ui/Popover.astro";
import type { AdminAgent, AdminCustomer } from "@/lib/admin-dashboard/data";
import {
  agentAccountLabel,
  type AgentAssignedCustomerRow,
  formatKgSoldTrendDiff,
  type AgentPerformanceQuickStats,
  type AgentPreviousOrderRow,
  type AgentReceivableSegment,
  type AgentRecordFilters,
  type AgentRecordOrderRow,
  type AgentRecordTab,
} from "@/lib/admin-dashboard/agent-record";
import type {
  CustomerInvoiceRow,
  CustomerPaymentRow,
  CustomerSalesRow,
} from "@/lib/admin-dashboard/customer-record";
import type { AdminPagination } from "@/lib/admin-dashboard/pagination";
import {
  formatCompactCurrency,
  formatCurrency,
  formatDate,
  fullName,
  selected,
} from "@/lib/admin-dashboard/view";
type Props = {
  agent: AdminAgent;
  linkedCustomer: AdminCustomer | null;
  activeTab: AgentRecordTab;
  filterQuery: string;
  orderFilters: AgentRecordFilters;
  orderRows: AgentRecordOrderRow[];
  ordersPagination: AdminPagination;
  salesRows: CustomerSalesRow[];
  salesPagination: AdminPagination;
  invoiceRows: CustomerInvoiceRow[];
  invoicesPagination: AdminPagination;
  paymentRows: CustomerPaymentRow[];
  paymentsPagination: AdminPagination;
  assignedCustomerRows: AgentAssignedCustomerRow[];
  assignedCustomersPagination: AdminPagination;
  previousOrderRows: AgentPreviousOrderRow[];
  previousOrdersPagination: AdminPagination;
  orderCounts: {
    total: number;
    pending: number;
    processing: number;
    closed: number;
  };
  processingReceivableTotal: number;
  estimatedInvoiceTotal: number;
  receivableSegments: AgentReceivableSegment[];
  assignedCustomersCount: number;
  commissionEarned: number;
  paymentsSubmitted: number;
  performanceQuickStats: AgentPerformanceQuickStats;
  agentReturnTo: string;
  showPreviousOrdersTab: boolean;
  hasAgentDistributionOrders: boolean;
};

const {
  agent,
  linkedCustomer,
  activeTab,
  filterQuery,
  orderFilters,
  orderRows,
  ordersPagination,
  salesRows,
  salesPagination,
  invoiceRows,
  invoicesPagination,
  paymentRows,
  paymentsPagination,
  assignedCustomerRows,
  assignedCustomersPagination,
  previousOrderRows,
  previousOrdersPagination,
  orderCounts,
  processingReceivableTotal,
  estimatedInvoiceTotal,
  receivableSegments,
  assignedCustomersCount,
  commissionEarned,
  paymentsSubmitted,
  performanceQuickStats,
  agentReturnTo,
  showPreviousOrdersTab,
  hasAgentDistributionOrders,
} = Astro.props;

const promotedCustomerName = linkedCustomer
  ? fullName(linkedCustomer)
  : agent.display_name;
const agentBasePath = `/admin/agents/${agent.id}`;
const receivableBarTotal = receivableSegments.reduce(
  (total, segment) => total + segment.receivable,
  0,
);
const commissionModalId = `agent-${agent.id}-commission-modal`;
const hasCommissionEntries = performanceQuickStats.commissionEntries.length > 0;
const maxCommissionPreviewEntries = 2;
const commissionPreviewEntries = performanceQuickStats.commissionEntries.slice(
  0,
  maxCommissionPreviewEntries,
);
const hiddenCommissionCount = Math.max(
  performanceQuickStats.commissionEntries.length - maxCommissionPreviewEntries,
  0,
);
const kgSoldTrend = performanceQuickStats.kgSoldTrend;

function tabHref(tab: AgentRecordTab) {
  const params = new URLSearchParams(filterQuery);
  params.set("tab", tab);
  params.delete("page");
  return `${agentBasePath}?${params.toString()}`;
}

const customerTabTableProps = {
  customerBasePath: agentBasePath,
  customerReturnTo: agentReturnTo,
  orderFilters,
  orderRows: [],
  ordersPagination,
  salesRows,
  salesPagination,
  invoiceRows,
  invoicesPagination,
  paymentRows,
  paymentsPagination,
};
---

<div
  class="customer-record-page"
  data-agent-record-page
  data-agent-id={agent.id}
>
  {
    agent.promoted_from_customer_id && (
      <section
        class="customer-record-banner"
        aria-label="Agent promotion status"
      >
        <p class="customer-record-banner__copy">
          This agent was promoted from a customer record. If that was accidental,
          you can cancel the promotion.{" "}
          <button
            type="button"
            class="customer-record-banner__action"
            data-open-alert-dialog={
              hasAgentDistributionOrders
                ? "revoke-customer-promotion-blocked-dialog"
                : "revoke-customer-promotion-dialog"
            }
            {...!hasAgentDistributionOrders && {
              "data-alert-dialog-form": "revoke-customer-promotion-form",
            }}
          >
            Cancel Promotion
          </button>
        </p>
      </section>
    )
  }

  <div class="customer-record-cards">
    <article class="customer-record-card">
      <h2 class="customer-record-card__title">Contact information</h2>
      <dl
        class="customer-record-card__list customer-record-card__list--contact"
      >
        <div class="customer-record-card__field">
          <dt class="customer-record-card__contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M3 5h18v14H3z"></path>
              <path d="M7 9h4"></path>
              <path d="M7 13h6"></path>
              <path d="M16 9h1"></path>
            </svg>
            <span class="sr-only">Employee ID</span>
          </dt>
          <dd>{agent.employee_id ?? "No employee ID"}</dd>
        </div>
        <div class="customer-record-card__field">
          <dt class="customer-record-card__contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path
                d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"
              ></path>
              <path d="m22 6-10 7L2 6"></path>
            </svg>
            <span class="sr-only">Email</span>
          </dt>
          <dd>{agent.email ?? "No email"}</dd>
        </div>
        <div class="customer-record-card__field">
          <dt class="customer-record-card__contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.86.3 1.7.54 2.5a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.58-1.11a2 2 0 0 1 2.11-.45c.8.24 1.64.42 2.5.54A2 2 0 0 1 22 16.92Z"
              ></path>
            </svg>
            <span class="sr-only">Contact</span>
          </dt>
          <dd>{agent.contact ?? "No contact"}</dd>
        </div>
        <div class="customer-record-card__field">
          <dt class="customer-record-card__contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12 21s-7-4.35-7-10a7 7 0 1 1 14 0c0 5.65-7 10-7 10Z"
              ></path>
              <circle cx="12" cy="11" r="2.5"></circle>
            </svg>
            <span class="sr-only">Address</span>
          </dt>
          <dd>{agent.address || "No address"}</dd>
        </div>
        <div class="customer-record-card__field">
          <dt class="customer-record-card__contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span class="sr-only">Joined</span>
          </dt>
          <dd>Joined {formatDate(agent.created_at)}</dd>
        </div>
      </dl>
    </article>

    <article class="customer-record-card customer-record-card--status">
      <div class="customer-record-card__header">
        <h2 class="customer-record-card__title">Status</h2>
        <button
          type="button"
          class="customer-record-card__edit-trigger table-cell-trigger"
          data-open-cell-popover
          aria-label={`Edit status for ${agent.display_name}`}
        >
          <span class="sr-only">Edit status</span>
        </button>
        <Popover
          title={`Edit status: ${agent.display_name}`}
          formDataAttributes={{ "data-astro-reload": "" }}
        >
          <input type="hidden" name="action" value="update-agent" />
          <input type="hidden" name="agentId" value={agent.id} />
          <input
            type="hidden"
            name="employeeId"
            value={agent.employee_id ?? ""}
          />
          <input type="hidden" name="firstName" value={agent.first_name} />
          <input type="hidden" name="lastName" value={agent.last_name} />
          <input type="hidden" name="contact" value={agent.contact ?? ""} />
          <input type="hidden" name="email" value={agent.email ?? ""} />
          <label>
            <span>Status</span>
            <select name="status">
              <option value="active" selected={selected(agent.status, "active")}
                >Active</option
              >
              <option
                value="inactive"
                selected={selected(agent.status, "inactive")}>Inactive</option
              >
              <option
                value="suspended"
                selected={selected(agent.status, "suspended")}>Suspended</option
              >
            </select>
          </label>
          <button
            slot="footer"
            type="submit"
            class="ui-popover__button-primary"
          >
            Save changes
          </button>
        </Popover>
      </div>
      <dl
        class="customer-record-card__list customer-record-card__list--status customer-record-card__list--sentence-case"
      >
        <div class="customer-record-card__field">
          <dt>Account</dt>
          <dd>
            <StatusBadge
              kind="agent"
              status={agent.status === "active" ? "active" : "inactive"}
              label={agentAccountLabel(agent.status)}
            />
          </dd>
        </div>
        <div class="customer-record-card__field">
          <dt>Members</dt>
          <dd>{assignedCustomersCount}</dd>
        </div>
        <div class="customer-record-card__field">
          <dt>Performance</dt>
          <dd>—</dd>
        </div>
        <div class="customer-record-card__field">
          <dt>Commission</dt>
          <dd>{formatCompactCurrency(commissionEarned)}</dd>
        </div>
        <div class="customer-record-card__field">
          <dt>Payments submitted</dt>
          <dd>{formatCompactCurrency(paymentsSubmitted)}</dd>
        </div>
      </dl>
    </article>

    <article class="customer-record-card">
      <h2 class="customer-record-card__title">Agent orders</h2>
      <dl
        class="customer-record-card__list customer-record-card__list--stats customer-record-card__list--sentence-case"
      >
        <div class="customer-record-card__field">
          <dt>Total</dt><dd>{orderCounts.total}</dd>
        </div>
        <div class="customer-record-card__field">
          <dt>Pending</dt><dd>{orderCounts.pending}</dd>
        </div>
        <div class="customer-record-card__field">
          <dt>Processing</dt><dd>{orderCounts.processing}</dd>
        </div>
        <div class="customer-record-card__field">
          <dt>Closed</dt><dd>{orderCounts.closed}</dd>
        </div>
      </dl>
    </article>
  </div>

  <section class="customer-record-receivables" aria-label="Receivable summary">
    <div class="customer-record-receivables__totals">
      <div class="customer-record-receivables__total">
        <div class="customer-record-receivables__summary-line">
          <span class="customer-record-receivables__label"
            >Total receivable amount:</span
          >
          <strong class="customer-record-receivables__value">
            {formatCurrency(processingReceivableTotal)}
          </strong>
        </div>
        <p class="customer-record-receivables__hint">Processing orders only</p>
      </div>
      <div class="customer-record-receivables__total">
        <div class="customer-record-receivables__summary-line">
          <span class="customer-record-receivables__label"
            >Total estimated invoice value:</span
          >
          <strong class="customer-record-receivables__value">
            {formatCurrency(estimatedInvoiceTotal)}
          </strong>
        </div>
        <p class="customer-record-receivables__hint">
          Pending, processing, and closed orders
        </p>
      </div>
    </div>

    <div class="customer-record-receivables__bar" aria-hidden="true">
      {
        receivableSegments.map((segment) => {
          const width =
            receivableBarTotal > 0
              ? (segment.receivable / receivableBarTotal) * 100
              : 0;
          return (
            <span
              class="customer-record-receivables__segment"
              style={`width: ${width}%; background-color: ${segment.color};`}
            />
          );
        })
      }
    </div>

    <ul class="customer-record-receivables__legend">
      {
        receivableSegments.map((segment) => (
          <li>
            <Tooltip
              text={segment.tooltip}
              placement="below"
              class="customer-record-receivables__legend-tooltip"
            >
              <span
                class="customer-record-receivables__dot"
                style={`background-color: ${segment.color};`}
              />
              <span class="customer-record-receivables__legend-label">
                {segment.label}
              </span>
              <span class="customer-record-receivables__legend-meta">
                {segment.invoiceCount} invoice
                {segment.invoiceCount === 1 ? "" : "s"}
              </span>
              <strong class="customer-record-receivables__legend-value">
                {formatCurrency(segment.receivable)}
              </strong>
            </Tooltip>
          </li>
        ))
      }
    </ul>

    <div
      class="agent-record-quick-stats"
      aria-label="Agent performance quick stats"
    >
      <article class="agent-record-quick-stats__card">
        <h3 class="agent-record-quick-stats__title">Kg sold</h3>
        <p class="agent-record-quick-stats__value">
          {
            performanceQuickStats.kgSold.toLocaleString("en-PH", {
              maximumFractionDigits: 1,
            })
          }
          <span class="agent-record-quick-stats__unit">kg</span>
          <MetricTrend
            diff={kgSoldTrend.diff}
            formattedDiff={formatKgSoldTrendDiff(kgSoldTrend.diff)}
            tooltip={kgSoldTrend.tooltip}
          />
        </p>
        <p class="agent-record-quick-stats__hint">Across closed orders</p>
      </article>

      <article class="agent-record-quick-stats__card">
        <h3 class="agent-record-quick-stats__title">Most sold category</h3>
        {
          performanceQuickStats.topCategory ? (
            <>
              <p class="agent-record-quick-stats__value agent-record-quick-stats__value--text">
                {performanceQuickStats.topCategory.label}
              </p>
              <p class="agent-record-quick-stats__hint">
                {performanceQuickStats.topCategory.quantity.toLocaleString(
                  "en-PH",
                  {
                    maximumFractionDigits: 1,
                  },
                )}{" "}
                kg sold
              </p>
            </>
          ) : (
            <p class="agent-record-quick-stats__empty">No closed sales yet</p>
          )
        }
      </article>

      <div
        class="agent-record-quick-stats__row"
        data-agent-commission-preview-row
      >
        <article
          class="agent-record-quick-stats__card"
          data-agent-remittance-card
        >
          <h3 class="agent-record-quick-stats__title">
            <span>Remittance performance</span>
            {
              performanceQuickStats.remittance.performanceLabel && (
                <MetricTrend
                  tooltip={
                    performanceQuickStats.remittance.performanceTooltip ?? ""
                  }
                  placement="below"
                  class="agent-record-quick-stats__title-badge"
                >
                  ({performanceQuickStats.remittance.performanceLabel})
                </MetricTrend>
              )
            }
          </h3>
          <dl class="agent-record-quick-stats__metrics">
            <div>
              <dt>Submissions</dt>
              <dd>{performanceQuickStats.remittance.submissionCount}</dd>
            </div>
            <div>
              <dt>Confirmed</dt>
              <dd>
                {performanceQuickStats.remittance.confirmedCount}
                {
                  performanceQuickStats.remittance.submissionCount > 0 && (
                    <span class="agent-record-quick-stats__meta">
                      ({performanceQuickStats.remittance.confirmationRate}%)
                    </span>
                  )
                }
              </dd>
            </div>
            <div>
              <dt>Avg. days to remit</dt>
              <dd>
                {
                  performanceQuickStats.remittance.averageDaysToRemit === null
                    ? "—"
                    : `${performanceQuickStats.remittance.averageDaysToRemit} days`
                }
              </dd>
            </div>
            <div>
              <dt>Last 30 days</dt>
              <dd>
                {performanceQuickStats.remittance.recentSubmissions30Days}
              </dd>
            </div>
            <div>
              <dt>Pending review</dt>
              <dd>{performanceQuickStats.remittance.pendingCount}</dd>
            </div>
            <div>
              <dt>Total remitted</dt>
              <dd>
                {
                  formatCompactCurrency(
                    performanceQuickStats.remittance.totalRemitted,
                  )
                }
              </dd>
            </div>
          </dl>
        </article>

        <article
          class="agent-record-quick-stats__card agent-record-quick-stats__card--paired"
          data-agent-commission-card
        >
          <div
            class="agent-record-quick-stats__card-header"
            data-agent-commission-header
          >
            <div>
              <h3 class="agent-record-quick-stats__title">
                Commission tracking
              </h3>
              <p class="agent-record-quick-stats__hint">
                Closed and fully paid orders only
              </p>
            </div>
            <p
              class="agent-record-quick-stats__value agent-record-quick-stats__value--compact"
            >
              {
                formatCompactCurrency(
                  performanceQuickStats.commissionEarnedTotal,
                )
              }
            </p>
          </div>

          <div class="agent-record-quick-stats__commission-preview">
            {
              hasCommissionEntries ? (
                <ul
                  class="agent-record-quick-stats__commission-list"
                  data-agent-commission-preview-list
                >
                  {commissionPreviewEntries.map((entry) => (
                    <li data-agent-commission-entry>
                      <a
                        href={entry.href}
                        class="agent-record-quick-stats__commission-link"
                      >
                        <span class="agent-record-quick-stats__commission-date">
                          {formatDate(entry.earned_at)}
                        </span>
                        <span class="agent-record-quick-stats__commission-order">
                          {entry.order_label}
                        </span>
                        <strong class="agent-record-quick-stats__commission-amount">
                          {formatCurrency(entry.amount)}
                        </strong>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="agent-record-quick-stats__empty">
                  No earned commission yet
                </p>
              )
            }
          </div>

          <div
            class="agent-record-quick-stats__commission-footer"
            data-agent-commission-footer
          >
            {
              hiddenCommissionCount > 0 && (
                <p class="agent-record-quick-stats__truncation">
                  +{hiddenCommissionCount} more earned commission
                  {hiddenCommissionCount === 1 ? "" : "s"}
                </p>
              )
            }
            {
              hasCommissionEntries && (
                <button
                  type="button"
                  class="agent-record-quick-stats__view-all"
                  data-open-dashboard-modal={commissionModalId}
                  aria-haspopup="dialog"
                  aria-controls={commissionModalId}
                >
                  View all
                </button>
              )
            }
          </div>
        </article>
      </div>
    </div>
  </section>

  <DashboardModal
    id={commissionModalId}
    title="Commission tracking"
    description={`${formatCurrency(performanceQuickStats.commissionEarnedTotal)} total earned commission`}
  >
    {
      performanceQuickStats.commissionEntries.length > 0 ? (
        <ul class="agent-commission-modal-list">
          {performanceQuickStats.commissionEntries.map((entry) => (
            <li class="agent-commission-modal-item">
              <div class="agent-commission-modal-item__header">
                <span class="agent-commission-modal-item__date">
                  {formatDate(entry.earned_at)}
                </span>
                <strong class="agent-commission-modal-item__amount">
                  {formatCurrency(entry.amount)}
                </strong>
              </div>
              <p class="agent-commission-modal-item__order">
                {entry.order_label}
              </p>
              <div class="agent-commission-modal-item__actions">
                <a class="agent-commission-modal-item__link" href={entry.href}>
                  View order details
                </a>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="dashboard-modal__empty">No earned commission yet</p>
      )
    }
  </DashboardModal>

  <div class="customer-record-tabs">
    <nav class="customer-record-tabs__nav" aria-label="Agent record sections">
      <a
        href={tabHref("orders")}
        class:list={[
          "customer-record-tabs__link",
          activeTab === "orders" && "is-active",
        ]}
      >
        Orders
      </a>
      <a
        href={tabHref("sales")}
        class:list={[
          "customer-record-tabs__link",
          activeTab === "sales" && "is-active",
        ]}
      >
        Sales
      </a>
      <a
        href={tabHref("invoices")}
        class:list={[
          "customer-record-tabs__link",
          activeTab === "invoices" && "is-active",
        ]}
      >
        Invoices
      </a>
      <a
        href={tabHref("payments")}
        class:list={[
          "customer-record-tabs__link",
          activeTab === "payments" && "is-active",
        ]}
      >
        Payment records
      </a>
      <a
        href={tabHref("customers")}
        class:list={[
          "customer-record-tabs__link",
          activeTab === "customers" && "is-active",
        ]}
      >
        Customers
      </a>
      {
        showPreviousOrdersTab && (
          <a
            href={tabHref("previous-orders")}
            class:list={[
              "customer-record-tabs__link",
              activeTab === "previous-orders" && "is-active",
            ]}
          >
            Previous orders
          </a>
        )
      }
    </nav>

    {
      activeTab === "orders" && (
        <section class="customer-record-tab-panel" aria-label="Agent orders">
          <AdminAgentRecordTabTable
            tab="orders"
            agentBasePath={agentBasePath}
            agentReturnTo={agentReturnTo}
            orderFilters={orderFilters}
            orderRows={orderRows}
            ordersPagination={ordersPagination}
            assignedCustomerRows={assignedCustomerRows}
            assignedCustomersPagination={assignedCustomersPagination}
            previousOrderRows={previousOrderRows}
            previousOrdersPagination={previousOrdersPagination}
          />
        </section>
      )
    }

    {
      (activeTab === "sales" ||
        activeTab === "invoices" ||
        activeTab === "payments") && (
        <section
          class="customer-record-tab-panel"
          aria-label={`Agent ${activeTab}`}
        >
          <AdminCustomerRecordTabTable
            tab={activeTab}
            {...customerTabTableProps}
          />
        </section>
      )
    }

    {
      (activeTab === "customers" || activeTab === "previous-orders") && (
        <section
          class="customer-record-tab-panel"
          aria-label={`Agent ${activeTab}`}
        >
          <AdminAgentRecordTabTable
            tab={activeTab}
            agentBasePath={agentBasePath}
            agentReturnTo={agentReturnTo}
            orderFilters={orderFilters}
            orderRows={orderRows}
            ordersPagination={ordersPagination}
            assignedCustomerRows={assignedCustomerRows}
            assignedCustomersPagination={assignedCustomersPagination}
            previousOrderRows={previousOrderRows}
            previousOrdersPagination={previousOrdersPagination}
          />
        </section>
      )
    }
  </div>

  {
    agent.promoted_from_customer_id && (
      <>
        <form
          id="revoke-customer-promotion-form"
          method="post"
          hidden
          data-astro-reload
        >
          <input
            type="hidden"
            name="action"
            value="revoke-customer-agent-promotion"
          />
          <input
            type="hidden"
            name="customerId"
            value={agent.promoted_from_customer_id}
          />
        </form>

        <AlertDialog
          id="revoke-customer-promotion-dialog"
          title="Cancel agent promotion?"
          description={`This will deactivate the linked agent account for ${promotedCustomerName} and restore the customer record. Active processing orders will be detached from the agent.`}
          confirmLabel="Cancel promotion"
          variant="danger"
        />

        <AlertDialog
          id="revoke-customer-promotion-blocked-dialog"
          title="Cannot cancel promotion"
          description={`${promotedCustomerName} has linked distribution orders. Cancel promotion is only available before any distribution orders are created.`}
          confirmLabel="OK"
        />
      </>
    )
  }
</div>

<script>
