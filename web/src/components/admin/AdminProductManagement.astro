---
import Sheet from "@/components/ui/Sheet.astro";
import type { AdminProductManagementData } from "@/lib/admin-dashboard/data";
import type { AdminProductFilters } from "@/lib/admin-dashboard/product-filters";
import {
  escapeTextareaValue,
  formatCurrency,
} from "@/lib/admin-dashboard/view";

type Props = {
  data: AdminProductManagementData;
  productCategories: readonly string[];
  productUnitLabels: readonly string[];
  stockStatuses: readonly string[];
  activeFilters: AdminProductFilters;
  filterQuery: string;
};

const { data, productCategories, productUnitLabels, stockStatuses, activeFilters, filterQuery } =
  Astro.props;
const hasActiveFilters = filterQuery.length > 0;
const skeletonRows = Array.from({ length: 6 });
const priceRangeMin = 0;
const priceRangeMax = Math.max(
  1,
  Math.ceil(data.productPriceRange.max),
  Math.ceil(activeFilters.maxPrice ?? 0),
  Math.ceil(activeFilters.minPrice ?? 0),
);
const activeMinPrice = Math.min(
  priceRangeMax,
  Math.max(priceRangeMin, activeFilters.minPrice ?? priceRangeMin),
);
const activeMaxPrice = Math.min(
  priceRangeMax,
  Math.max(activeMinPrice, activeFilters.maxPrice ?? priceRangeMax),
);

function formatStockStatus(status: string): string {
  if (status === "in_stock") return "In Stock";
  if (status === "out_of_stock") return "Out of Stock";
  if (status === "low_stock") return "Low Stock";
  return status.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
}
---

<section
  id="admin-products"
  class="admin-panel"
  aria-labelledby="admin-products-title"
>
  <Sheet
    id="create-product-sheet"
    header="Create Product"
    description="Add a new product to the catalog."
    width="36rem"
  >
    <form
      id="create-product-form"
      method="post"
      enctype="multipart/form-data"
      class="admin-form product-create-form"
      aria-label="Create product"
    >
      <input type="hidden" name="action" value="save-product" />
      <input type="hidden" name="isActive" value="on" />
      <div class="admin-form-grid product-create-form__grid">
        <label class="field-row"
          ><span>Name</span><input name="name" required /></label
        >
        <label class="field-row">
          <span>Unit label</span>
          <select name="unitLabel" required>
            {
              productUnitLabels.map((unitLabel) => (
                <option value={unitLabel}>{unitLabel}</option>
              ))
            }
          </select>
        </label>
        <label class="field-row">
          <span>Category</span>
          <select name="category" required>
            {
              productCategories.map((category) => (
                <option value={category}>{category}</option>
              ))
            }
          </select>
        </label>
        <label class="field-row"
          ><span>Default price</span><input
            name="defaultPrice"
            type="number"
            min="0"
            step="0.01"
            required
          /></label
        >
        <label class="field-row"
          ><span>Reseller price</span><input
            name="resellerPrice"
            type="number"
            min="0"
            step="0.01"
            required
          /></label
        >
        <label class="field-row">
          <span>Stock status</span>
          <select name="stockStatus" required>
            {
              stockStatuses.map((status) => (
                <option value={status}>{status}</option>
              ))
            }
          </select>
        </label>
        <label class="field-row"
          ><span>Description</span><textarea name="description"
          ></textarea></label
        >
        <div class="field-row product-image-field">
          <span>Product image</span>
          <div class="product-image-picker" data-product-image-picker>
            <input
              id="create-product-image-input"
              class="product-image-picker__input"
              name="imageFile"
              type="file"
              accept="image/*"
              required
              data-product-image-input
            />
            <label
              for="create-product-image-input"
              class="product-image-picker__surface"
              data-product-image-surface
            >
              <img
                class="product-image-picker__preview"
                alt="Selected product preview"
                hidden
                data-product-image-preview
              />
              <span class="product-image-picker__placeholder" data-product-image-placeholder>
                Select image
              </span>
            </label>
            <button
              type="button"
              class="product-image-picker__remove"
              aria-label="Remove selected image"
              hidden
              data-product-image-remove
            >
              Remove
            </button>
          </div>
        </div>
      </div>
    </form>
    <div slot="footer" class="product-create-sheet__footer">
      <button type="submit" form="create-product-form">Save product</button>
    </div>
  </Sheet>

  <div data-interactive-table>
    <div class="table-filters product-management-toolbar">
      <form
        method="get"
        action="/admin/products"
        class="product-filter-form"
        data-product-filter-form
        data-current-filter-query={filterQuery}
        aria-label="Filter products"
      >
        <label class="product-filter-form__field product-filter-form__field--search">
          <span>Search</span>
          <input
            name="search"
            type="search"
            value={activeFilters.search ?? ""}
            placeholder="Search products..."
            autocomplete="off"
            data-product-search-input
          />
        </label>
        <label class="product-filter-form__field">
          <span>Status</span>
          <select name="stockStatus">
            <option value="">All statuses</option>
            {stockStatuses.map((status) => (
              <option value={status} selected={activeFilters.stockStatus === status}>
                {formatStockStatus(status)}
              </option>
            ))}
          </select>
        </label>
        <label class="product-filter-form__field">
          <span>Category</span>
          <select name="category">
            <option value="">All categories</option>
            {productCategories.map((category) => (
              <option value={category} selected={activeFilters.category === category}>
                {category}
              </option>
            ))}
          </select>
        </label>
        <fieldset
          class="product-filter-form__price-range"
          data-price-range
          data-price-min={priceRangeMin}
          data-price-max={priceRangeMax}
        >
          <legend>Price range</legend>
          <input
            type="hidden"
            name="minPrice"
            value={activeFilters.minPrice ?? ""}
            data-price-min-hidden
          />
          <input
            type="hidden"
            name="maxPrice"
            value={activeFilters.maxPrice ?? ""}
            data-price-max-hidden
          />
          <div class="product-filter-form__range-values" aria-live="polite">
            <span data-price-min-label>{formatCurrency(activeMinPrice)}</span>
            <span data-price-max-label>{formatCurrency(activeMaxPrice)}</span>
          </div>
          <div class="dual-range-slider">
            <div class="dual-range-slider__track" aria-hidden="true">
              <span class="dual-range-slider__fill" data-price-range-fill></span>
            </div>
            <input
              type="range"
              min={priceRangeMin}
              max={priceRangeMax}
              step="1"
              value={activeMinPrice}
              aria-label="Minimum product price"
              data-price-min-range
            />
            <input
              type="range"
              min={priceRangeMin}
              max={priceRangeMax}
              step="1"
              value={activeMaxPrice}
              aria-label="Maximum product price"
              data-price-max-range
            />
          </div>
        </fieldset>
        <a
          href="/admin/products"
          class="product-filter-form__reset"
          data-product-filter-reset
          hidden={!hasActiveFilters}
        >
          Clear
        </a>
      </form>
      <div class="product-management-toolbar__actions">
        <label class="product-management-toolbar__limit">
          <span>Show</span>
          <select data-limit-select>
            <option value="10">10</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </label>
        <button
          type="button"
          class="btn-table-manage product-management-toolbar__create"
          data-open-create-sheet
          data-sheet-target="#create-product-sheet"
          >Create Product</button
        >
      </div>
    </div>

    <div data-product-table-shell>
      <div class="table-wrap">
      <table style="table-layout: fixed; width: 100%;">
        <thead>
          <tr>
            <th scope="col" style="width: 8%;"></th>
            <th scope="col" style="width: 24%;">Name</th>
            <th scope="col" style="width: 24%;">Description</th>
            <th scope="col" style="width: 17%;">Pricing</th>
            <th scope="col" style="width: 12%;">Status</th>
            <th scope="col" style="width: 15%;">Date Created</th>
            <th scope="col" style="width: 10%;">Action</th>
          </tr>
        </thead>
        <tbody>
          {
            data.products.length === 0 ? (
              <tr class="empty-row">
                <td colspan="7" class="empty-state">
                  No products match the selected filters.
                </td>
              </tr>
            ) : data.products.map((product) => (
              <tr data-status={product.is_active ? "active" : "inactive"}>
                {/* 1. Image Cell (Editable Popover) */}
                <td style="width: 8%; vertical-align: middle;">
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                    data-popover-title={`Edit Image: ${product.name}`}
                    style="width: 100%; display: flex; justify-content: center; cursor: pointer;"
                  >
                    {product.image_path ? (
                      <img
                        src={product.image_path}
                        alt={product.name}
                        style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;"
                      />
                    ) : (
                      <div style="width: 40px; height: 40px; background-color: #e5e7eb; border-radius: 4px;" />
                    )}
                  </button>
                  <div
                    class="hidden-popover-form-holder"
                    style="display: none;"
                  >
                    <form
                      method="post"
                      enctype="multipart/form-data"
                      class="admin-table-form"
                    >
                      <input type="hidden" name="action" value="save-product" />
                      <input
                        type="hidden"
                        name="productId"
                        value={product.id}
                      />

                      <input type="hidden" name="name" value={product.name} />
                      <input
                        type="hidden"
                        name="category"
                        value={product.category}
                      />
                      <input
                        type="hidden"
                        name="unitLabel"
                        value={product.unit_label}
                      />
                      <input
                        type="hidden"
                        name="description"
                        value={product.description ?? ""}
                      />
                      <input
                        type="hidden"
                        name="defaultPrice"
                        value={product.default_price}
                      />
                      <input
                        type="hidden"
                        name="resellerPrice"
                        value={product.reseller_price}
                      />
                      <input
                        type="hidden"
                        name="stockStatus"
                        value={product.stock_status}
                      />
                      {product.is_active && (
                        <input type="hidden" name="isActive" value="on" />
                      )}

                      <label>
                        <>
                          <span>Upload new image</span>
                          <input
                            name="imageFile"
                            type="file"
                            accept="image/*"
                            required
                          />
                        </>
                      </label>
                      <div class="button-row">
                        <button type="submit">Save image</button>
                      </div>
                    </form>
                  </div>
                </td>

                {/* 2. Name Cell (Editable Popover) */}
                <td style="width: 24%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle;">
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                    data-popover-title={`Edit Name & Category: ${product.name}`}
                    style="width: 100%; text-align: left; display: block; overflow: hidden; cursor: pointer;"
                  >
                    <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; color: inherit; font-weight: inherit;">
                      {product.name} ({product.unit_label})
                    </span>
                  </button>
                  <div
                    class="hidden-popover-form-holder"
                    style="display: none;"
                  >
                    <form
                      method="post"
                      enctype="multipart/form-data"
                      class="admin-table-form"
                    >
                      <input type="hidden" name="action" value="save-product" />
                      <input
                        type="hidden"
                        name="productId"
                        value={product.id}
                      />

                      <input
                        type="hidden"
                        name="description"
                        value={product.description ?? ""}
                      />
                      <input
                        type="hidden"
                        name="defaultPrice"
                        value={product.default_price}
                      />
                      <input
                        type="hidden"
                        name="resellerPrice"
                        value={product.reseller_price}
                      />
                      <input
                        type="hidden"
                        name="stockStatus"
                        value={product.stock_status}
                      />
                      {product.is_active && (
                        <input type="hidden" name="isActive" value="on" />
                      )}

                      <label>
                        <>
                          <span>Name</span>
                          <input name="name" value={product.name} required />
                        </>
                      </label>
                      <label>
                        <span>Category</span>
                        <select name="category" required>
                          {productCategories.map((category) => (
                            <option
                              value={category}
                              selected={product.category === category}
                            >
                              {category}
                            </option>
                          ))}
                        </select>
                      </label>
                      <label>
                        <span>Unit label</span>
                        <select name="unitLabel" required>
                          {productUnitLabels.map((unitLabel) => (
                            <option
                              value={unitLabel}
                              selected={product.unit_label === unitLabel}
                            >
                              {unitLabel}
                            </option>
                          ))}
                        </select>
                      </label>
                      <div class="button-row">
                        <button type="submit">Save product name</button>
                      </div>
                    </form>
                  </div>
                </td>

                {/* 3. Description Cell (Editable Popover) */}
                <td style="width: 24%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle;">
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                    data-popover-title={`Edit Description: ${product.name}`}
                    style="width: 100%; text-align: left; display: block; overflow: hidden; cursor: pointer;"
                  >
                    {product.description ? (
                      <span
                        style="display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: inherit;"
                        title={product.description}
                      >
                        {product.description}
                      </span>
                    ) : (
                      <span style="display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #9ca3af; font-size: 0.875rem; font-style: italic;">
                        No description
                      </span>
                    )}
                  </button>
                  <div
                    class="hidden-popover-form-holder"
                    style="display: none;"
                  >
                    <form
                      method="post"
                      enctype="multipart/form-data"
                      class="admin-table-form"
                    >
                      <input type="hidden" name="action" value="save-product" />
                      <input
                        type="hidden"
                        name="productId"
                        value={product.id}
                      />

                      <input type="hidden" name="name" value={product.name} />
                      <input
                        type="hidden"
                        name="category"
                        value={product.category}
                      />
                      <input
                        type="hidden"
                        name="unitLabel"
                        value={product.unit_label}
                      />
                      <input
                        type="hidden"
                        name="defaultPrice"
                        value={product.default_price}
                      />
                      <input
                        type="hidden"
                        name="resellerPrice"
                        value={product.reseller_price}
                      />
                      <input
                        type="hidden"
                        name="stockStatus"
                        value={product.stock_status}
                      />
                      {product.is_active && (
                        <input type="hidden" name="isActive" value="on" />
                      )}

                      <label>
                        <>
                          <span>Description</span>
                          <textarea
                            name="description"
                            set:html={escapeTextareaValue(product.description)}
                          />
                        </>
                      </label>
                      <div class="button-row">
                        <button type="submit">Save description</button>
                      </div>
                    </form>
                  </div>
                </td>

                {/* 4. Pricing Cell (Editable Popover) */}
                <td style="width: 17%; vertical-align: middle;">
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                    data-popover-title={`Edit Pricing: ${product.name}`}
                    style="width: 100%; text-align: left; display: block; overflow: hidden; cursor: pointer;"
                  >
                    <span style="display: block; color: inherit; line-height: 1.4;">
                      {formatCurrency(product.default_price)} (
                      {formatCurrency(product.reseller_price)})
                    </span>
                  </button>
                  <div
                    class="hidden-popover-form-holder"
                    style="display: none;"
                  >
                    <form
                      method="post"
                      enctype="multipart/form-data"
                      class="admin-table-form"
                    >
                      <input type="hidden" name="action" value="save-product" />
                      <input
                        type="hidden"
                        name="productId"
                        value={product.id}
                      />
                      <label>
                        <>
                          <span>Default price</span>
                          <input
                            name="defaultPrice"
                            type="number"
                            min="0"
                            step="0.01"
                            value={product.default_price}
                            required
                          />
                        </>
                      </label>
                      <label>
                        <>
                          <span>Reseller price</span>
                          <input
                            name="resellerPrice"
                            type="number"
                            min="0"
                            step="0.01"
                            value={product.reseller_price}
                            required
                          />
                        </>
                      </label>

                      <input type="hidden" name="name" value={product.name} />
                      <input
                        type="hidden"
                        name="category"
                        value={product.category}
                      />
                      <input
                        type="hidden"
                        name="unitLabel"
                        value={product.unit_label}
                      />
                      <input
                        type="hidden"
                        name="stockStatus"
                        value={product.stock_status}
                      />
                      <input
                        type="hidden"
                        name="description"
                        value={product.description ?? ""}
                      />
                      {product.is_active && (
                        <input type="hidden" name="isActive" value="on" />
                      )}

                      <div class="button-row">
                        <button type="submit">Save pricing</button>
                      </div>
                    </form>
                  </div>
                </td>

                {/* 5. Status Cell (Editable Popover) */}
                <td style="width: 12%; vertical-align: middle;">
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                    data-popover-title={`Edit Status: ${product.name}`}
                    style="width: 100%; text-align: left; display: block; overflow: hidden; cursor: pointer;"
                  >
                    <span style="color: inherit; line-height: 1.4;">
                      {formatStockStatus(product.stock_status)}
                    </span>
                  </button>
                  <div
                    class="hidden-popover-form-holder"
                    style="display: none;"
                  >
                    <form
                      method="post"
                      enctype="multipart/form-data"
                      class="admin-table-form"
                    >
                      <input type="hidden" name="action" value="save-product" />
                      <input
                        type="hidden"
                        name="productId"
                        value={product.id}
                      />
                      <label>
                        <span>Stock status</span>
                        <select name="stockStatus" required>
                          {stockStatuses.map((status) => (
                            <option
                              value={status}
                              selected={product.stock_status === status}
                            >
                              {status}
                            </option>
                          ))}
                        </select>
                      </label>
                      {product.is_active && (
                        <input type="hidden" name="isActive" value="on" />
                      )}

                      <input type="hidden" name="name" value={product.name} />
                      <input
                        type="hidden"
                        name="category"
                        value={product.category}
                      />
                      <input
                        type="hidden"
                        name="unitLabel"
                        value={product.unit_label}
                      />
                      <input
                        type="hidden"
                        name="defaultPrice"
                        value={product.default_price}
                      />
                      <input
                        type="hidden"
                        name="resellerPrice"
                        value={product.reseller_price}
                      />
                      <input
                        type="hidden"
                        name="description"
                        value={product.description ?? ""}
                      />

                      <div class="button-row">
                        <button type="submit">Save status</button>
                      </div>
                    </form>
                  </div>
                </td>

                {/* 6. Date Created Cell (Static) */}
                <td style="width: 15%; vertical-align: middle;">
                  {new Date(product.created_at).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </td>

                {/* 7. Action Cell (Static Form) */}
                <td style="width: 10%; vertical-align: middle;">
                  {product.is_active ? (
                    <form method="post" style="margin: 0;">
                      <input
                        type="hidden"
                        name="action"
                        value="deactivate-product"
                      />
                      <input
                        type="hidden"
                        name="productId"
                        value={product.id}
                      />
                      <button
                        type="submit"
                        class="btn-table-manage"
                        style="background-color: var(--color-brand-muted-black); padding: 0.25rem 0.5rem; font-size: 0.75rem; text-transform: none; letter-spacing: normal; width: auto; display: inline-block;"
                      >
                        Deactivate
                      </button>
                    </form>
                  ) : (
                    <span style="color: #9ca3af; font-style: italic; font-size: 0.85rem;">
                      None
                    </span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      </div>
    </div>

    <div class="table-pagination">
      <span
        data-page-info
        style="font-size: 0.9rem; color: var(--color-brand-muted-black); font-weight: 500;"
      ></span>
      <div style="display: flex; gap: 0.25rem; align-items: center;">
        <button
          type="button"
          data-pagination-prev
          class="btn-secondary"
          style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;"
          >&lt;</button
        >
        <div data-pagination-numbers style="display: flex; gap: 0.25rem;"></div>
        <button
          type="button"
          data-pagination-next
          class="btn-secondary"
          style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;"
          >&gt;</button
        >
      </div>
    </div>
  </div>

  <template data-product-filter-skeleton>
    <div class="table-wrap" aria-busy="true" aria-live="polite">
      <table class="product-table-skeleton" style="table-layout: fixed; width: 100%;">
        <caption class="sr-only">Loading filtered products</caption>
        <thead>
          <tr>
            <th scope="col" style="width: 8%;"></th>
            <th scope="col" style="width: 24%;">Name</th>
            <th scope="col" style="width: 24%;">Description</th>
            <th scope="col" style="width: 17%;">Pricing</th>
            <th scope="col" style="width: 12%;">Status</th>
            <th scope="col" style="width: 15%;">Date Created</th>
            <th scope="col" style="width: 10%;">Action</th>
          </tr>
        </thead>
        <tbody>
          {skeletonRows.map(() => (
            <tr>
              <td><span class="table-skeleton-block table-skeleton-block--image"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--wide"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </template>
</section>

<script>
  function initAdminProductFilters() {
    const form = document.querySelector<HTMLFormElement>("[data-product-filter-form]");
    const tableShell = document.querySelector<HTMLElement>("[data-product-table-shell]");
    const skeletonTemplate = document.querySelector<HTMLTemplateElement>("[data-product-filter-skeleton]");
    const resetLink = document.querySelector<HTMLAnchorElement>("[data-product-filter-reset]");

    if (!form || !tableShell || !skeletonTemplate) return;
    if (form.dataset.productFilterInitialized === "true") return;
    form.dataset.productFilterInitialized = "true";
    const activeForm = form;
    const activeTableShell = tableShell;
    const activeSkeletonTemplate = skeletonTemplate;

    const cacheKey = "admin-products-filter-cache-v1";
    const fragmentPath = "/admin/products-fragment";
    const filterKeys = ["search", "category", "stockStatus", "minPrice", "maxPrice"] as const;
    const autoSubmitFields = activeForm.querySelectorAll<HTMLSelectElement>("select");
    const searchInput = activeForm.querySelector<HTMLInputElement>("[data-product-search-input]");
    const priceRange = activeForm.querySelector<HTMLElement>("[data-price-range]");
    const minRange = activeForm.querySelector<HTMLInputElement>("[data-price-min-range]");
    const maxRange = activeForm.querySelector<HTMLInputElement>("[data-price-max-range]");
    const minHidden = activeForm.querySelector<HTMLInputElement>("[data-price-min-hidden]");
    const maxHidden = activeForm.querySelector<HTMLInputElement>("[data-price-max-hidden]");
    const minLabel = activeForm.querySelector<HTMLElement>("[data-price-min-label]");
    const maxLabel = activeForm.querySelector<HTMLElement>("[data-price-max-label]");
    const rangeFill = activeForm.querySelector<HTMLElement>("[data-price-range-fill]");
    const priceMin = Number(priceRange?.dataset.priceMin ?? "0");
    const priceMax = Number(priceRange?.dataset.priceMax ?? "1");
    let submitTimer: number | undefined;
    let searchTimer: number | undefined;
    let activeFetchController: AbortController | undefined;

    function readCache(): string[] {
      try {
        const parsed = JSON.parse(sessionStorage.getItem(cacheKey) || "[]");
        return Array.isArray(parsed)
          ? parsed.filter((value): value is string => typeof value === "string")
          : [];
      } catch {
        return [];
      }
    }

    function writeCache(values: string[]) {
      sessionStorage.setItem(cacheKey, JSON.stringify([...new Set(values)]));
    }

    function normalizeParams(params: URLSearchParams) {
      const normalized = new URLSearchParams();

      filterKeys.forEach((key) => {
        const value = params.get(key)?.trim();
        if (value) normalized.set(key, value);
      });

      return normalized.toString();
    }

    function normalizeFormQuery() {
      const params = new URLSearchParams();
      const formData = new FormData(activeForm);

      filterKeys.forEach((key) => {
        const value = formData.get(key);
        if (typeof value === "string" && value.trim()) {
          params.set(key, value.trim());
        }
      });

      return params.toString();
    }

    function buildUrl(path: string, targetQuery: string) {
      return targetQuery ? `${path}?${targetQuery}` : path;
    }

    function formatPrice(value: number) {
      return new Intl.NumberFormat("en-PH", {
        style: "currency",
        currency: "PHP",
        maximumFractionDigits: 0,
      }).format(value);
    }

    function syncPriceRange() {
      if (!minRange || !maxRange || !minHidden || !maxHidden) return;

      let minValue = Number(minRange.value);
      let maxValue = Number(maxRange.value);

      if (minValue > maxValue) {
        if (document.activeElement === minRange) {
          maxValue = minValue;
          maxRange.value = String(maxValue);
        } else {
          minValue = maxValue;
          minRange.value = String(minValue);
        }
      }

      minHidden.value = minValue > priceMin ? String(minValue) : "";
      maxHidden.value = maxValue < priceMax ? String(maxValue) : "";

      if (minLabel) minLabel.textContent = formatPrice(minValue);
      if (maxLabel) maxLabel.textContent = formatPrice(maxValue);

      if (rangeFill) {
        const span = Math.max(priceMax - priceMin, 1);
        const left = ((minValue - priceMin) / span) * 100;
        const right = 100 - ((maxValue - priceMin) / span) * 100;
        rangeFill.style.left = `${left}%`;
        rangeFill.style.right = `${right}%`;
      }
    }

    function submitFilters() {
      window.clearTimeout(submitTimer);
      submitTimer = window.setTimeout(() => {
        syncPriceRange();
        void applyFilters(normalizeFormQuery());
      }, 120);
    }

    function showSkeletonForQuery(targetQuery: string) {
      const currentQuery = normalizeParams(new URLSearchParams(window.location.search));
      const cachedQueries = readCache();

      if (targetQuery === currentQuery || cachedQueries.includes(targetQuery)) {
        return;
      }

      const skeleton = activeSkeletonTemplate.content.firstElementChild?.cloneNode(true);
      if (!skeleton) return;

      activeTableShell.replaceChildren(skeleton);
    }

    function replaceProductsFragment(fragmentHtml: string) {
      const parsed = new DOMParser().parseFromString(fragmentHtml, "text/html");
      const nextTableShell = parsed.querySelector<HTMLElement>("[data-product-table-shell]");

      if (!nextTableShell) {
        throw new Error("Products fragment did not include a product table.");
      }

      activeTableShell.innerHTML = nextTableShell.innerHTML;
      document.dispatchEvent(new Event("dashboard:interactive-table-updated"));
    }

    async function applyFilters(
      targetQuery: string,
      options: { updateHistory?: boolean } = {},
    ) {
      const updateHistory = options.updateHistory ?? true;
      const currentQuery = normalizeParams(new URLSearchParams(window.location.search));

      if (targetQuery === currentQuery && updateHistory) {
        return;
      }

      showSkeletonForQuery(targetQuery);
      activeFetchController?.abort();

      const fetchController = new AbortController();
      activeFetchController = fetchController;

      try {
        const response = await fetch(buildUrl(fragmentPath, targetQuery), {
          headers: {
            "X-Requested-With": "fetch",
          },
          signal: fetchController.signal,
        });

        if (!response.ok) {
          throw new Error(`Product filters failed with ${response.status}.`);
        }

        const fragmentHtml = await response.text();
        if (updateHistory) {
          window.history.replaceState(
            { productFilterQuery: targetQuery },
            "",
            buildUrl("/admin/products", targetQuery),
          );
        }

        replaceProductsFragment(fragmentHtml);
        activeForm.dataset.currentFilterQuery = targetQuery;
        if (resetLink) resetLink.hidden = targetQuery.length === 0;
        writeCache([...readCache(), targetQuery]);
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError") {
          return;
        }

        window.location.href = buildUrl("/admin/products", targetQuery);
      } finally {
        if (activeFetchController === fetchController) {
          activeFetchController = undefined;
        }
      }
    }

    writeCache([...readCache(), normalizeParams(new URLSearchParams(window.location.search))]);

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      syncPriceRange();
      void applyFilters(normalizeFormQuery());
    });

    autoSubmitFields.forEach((field) => {
      field.addEventListener("change", submitFilters);
    });

    searchInput?.addEventListener("input", () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(submitFilters, 450);
    });

    minRange?.addEventListener("input", syncPriceRange);
    maxRange?.addEventListener("input", syncPriceRange);
    minRange?.addEventListener("change", submitFilters);
    maxRange?.addEventListener("change", submitFilters);
    syncPriceRange();

    resetLink?.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
        return;
      }

      event.preventDefault();
      void applyFilters("");
    });
  }

  document.addEventListener("DOMContentLoaded", initAdminProductFilters);
  document.addEventListener("astro:after-swap", initAdminProductFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAdminProductFilters();
  }

  function initCreateProductImagePicker() {
    const picker = document.querySelector<HTMLElement>("[data-product-image-picker]");
    if (!picker || picker.dataset.initialized === "true") return;

    const input = picker.querySelector<HTMLInputElement>("[data-product-image-input]");
    const preview = picker.querySelector<HTMLImageElement>("[data-product-image-preview]");
    const placeholder = picker.querySelector<HTMLElement>("[data-product-image-placeholder]");
    const removeButton = picker.querySelector<HTMLButtonElement>("[data-product-image-remove]");
    if (!input || !preview || !placeholder || !removeButton) return;
    picker.dataset.initialized = "true";

    const activePicker = picker;
    const activeInput = input;
    const activePreview = preview;
    const activePlaceholder = placeholder;
    const activeRemoveButton = removeButton;
    let previewUrl = "";

    function clearPreview() {
      if (previewUrl) {
        URL.revokeObjectURL(previewUrl);
        previewUrl = "";
      }

      activePreview.hidden = true;
      activePreview.removeAttribute("src");
      activePlaceholder.hidden = false;
      activeRemoveButton.hidden = true;
      activePicker.dataset.hasImage = "false";
    }

    function updatePreview() {
      const file = activeInput.files?.[0];
      if (!file) {
        clearPreview();
        return;
      }

      if (previewUrl) {
        URL.revokeObjectURL(previewUrl);
      }

      previewUrl = URL.createObjectURL(file);
      activePreview.src = previewUrl;
      activePreview.hidden = false;
      activePlaceholder.hidden = true;
      activeRemoveButton.hidden = false;
      activePicker.dataset.hasImage = "true";
    }

    activeInput.addEventListener("change", updatePreview);
    activeRemoveButton.addEventListener("click", () => {
      activeInput.value = "";
      clearPreview();
    });

    clearPreview();
  }

  document.addEventListener("DOMContentLoaded", initCreateProductImagePicker);
  document.addEventListener("astro:after-swap", initCreateProductImagePicker);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initCreateProductImagePicker();
  }
</script>
