---
import DashboardTableActionsHeader from "@/components/dashboard/DashboardTableActionsHeader.astro";
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import DashboardTableEmptyState from "@/components/dashboard/DashboardTableEmptyState.astro";
import DashboardTableNumberHeader from "@/components/dashboard/DashboardTableNumberHeader.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import Popover from "@/components/ui/Popover.astro";
import Sheet from "@/components/ui/Sheet.astro";
import type { AdminProductManagementData } from "@/lib/admin-dashboard/data";
import type { AdminProductFilters } from "@/lib/admin-dashboard/product-filters";
import { dashboardTableRowNumber } from "@/lib/admin-dashboard/pagination";
import {
  escapeTextareaValue,
  formatCurrency,
  productAgentCommissionLabel,
  productDisplayLabel,
} from "@/lib/admin-dashboard/view";
import { productOtherOptionValue } from "@/lib/admin-dashboard/product-options";
import { resolvePublicStorageUrl } from "@/lib/supabase/storage";

type Props = {
  data: AdminProductManagementData;
  productCategories: readonly string[];
  productUnitLabels: readonly string[];
  stockStatuses: readonly string[];
  activeFilters: AdminProductFilters;
  filterQuery: string;
};

const {
  data,
  productCategories,
  productUnitLabels,
  stockStatuses,
  activeFilters,
  filterQuery,
} = Astro.props;
const skeletonRows = Array.from({ length: 6 });

function formatStockStatus(status: string): string {
  if (status === "in_stock") return "In Stock";
  if (status === "out_of_stock") return "Out of Stock";
  if (status === "low_stock") return "Low Stock";
  return status.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
}
---

<section
  id="admin-products"
  class="admin-panel"
  aria-labelledby="admin-products-title"
>
  <Sheet
    id="create-product-sheet"
    header="Create Product"
    description="Add a new product to the catalog."
    width="36rem"
  >
    <form
      id="create-product-form"
      method="post"
      enctype="multipart/form-data"
      class="admin-form product-create-form"
      aria-label="Create product"
      data-astro-reload
    >
      <input type="hidden" name="action" value="save-product" />
      <input type="hidden" name="isActive" value="on" />
      <div class="admin-form-grid product-create-form__grid">
        <label class="field-row"
          ><span>Name</span><input
            name="name"
            required
            data-create-product-name
          /></label
        >
        <label class="field-row">
          <span>Unit label</span>
          <select
            name="unitLabel"
            required
            data-product-other-option-select
            data-product-other-option-target="create-unit-other"
          >
            {
              productUnitLabels.map((unitLabel) => (
                <option value={unitLabel}>{unitLabel}</option>
              ))
            }
            <option value={productOtherOptionValue}>Other</option>
          </select>
        </label>
        <label
          class="field-row product-other-option-field"
          hidden
          data-product-other-option-field="create-unit-other"
          ><span>Other unit label</span><input
            name="unitLabelOther"
            data-product-other-option-input
          /></label
        >
        <label class="field-row">
          <span>Category</span>
          <select
            name="category"
            required
            data-create-product-category
            data-product-other-option-select
            data-product-other-option-target="create-category-other"
          >
            {
              productCategories.map((category) => (
                <option value={category}>{category}</option>
              ))
            }
            <option value={productOtherOptionValue}>Other</option>
          </select>
        </label>
        <label
          class="field-row product-other-option-field"
          hidden
          data-product-other-option-field="create-category-other"
          ><span>Other category</span><input
            name="categoryOther"
            data-product-other-option-input
          /></label
        >
        <label class="field-row"
          ><span>Default price</span><input
            name="defaultPrice"
            type="number"
            min="0"
            step="0.01"
            required
          /></label
        >
        <label class="field-row">
          <span>Reseller deduction type</span>
          <select
            name="resellerDeductionType"
            required
            data-product-amount-type-select
            data-product-amount-target="create-reseller-deduction"
          >
            <option value="value">Value</option>
            <option value="percentage">Percentage</option>
          </select>
        </label>
        <label class="field-row"
          ><span>Reseller deduction</span>
          <span
            class="product-amount-input"
            data-product-amount-field="create-reseller-deduction"
          >
            <input
              name="resellerDeductionValue"
              type="number"
              min="0"
              step="0.01"
              value="0"
              required
            />
            <span class="product-amount-input__suffix" aria-hidden="true"
              >₱</span
            >
          </span></label
        >
        <label class="field-row">
          <span>Agent commission type</span>
          <select
            name="agentCommissionType"
            required
            data-product-amount-type-select
            data-product-amount-target="create-agent-commission"
          >
            <option value="value">Value</option>
            <option value="percentage">Percentage</option>
          </select>
        </label>
        <label class="field-row"
          ><span>Agent commission</span>
          <span
            class="product-amount-input"
            data-product-amount-field="create-agent-commission"
          >
            <input
              name="agentCommissionValue"
              type="number"
              min="0"
              step="0.01"
              value="0"
              required
            />
            <span class="product-amount-input__suffix" aria-hidden="true"
              >₱</span
            >
          </span></label
        >
        <label class="field-row">
          <span>Stock status</span>
          <select name="stockStatus" required>
            {
              stockStatuses.map((status) => (
                <option value={status}>{status}</option>
              ))
            }
          </select>
        </label>
        <label class="field-row"
          ><span>Description</span><textarea name="description"
          ></textarea></label
        >
        <div class="field-row product-image-field">
          <span>Product image</span>
          <div class="product-image-picker" data-product-image-picker>
            <input
              id="create-product-image-input"
              class="product-image-picker__input"
              name="imageFile"
              type="file"
              accept="image/*"
              data-max-size-bytes="2097152"
              required
              data-product-image-input
            />
            <label
              for="create-product-image-input"
              class="product-image-picker__surface"
              data-product-image-surface
            >
              <img
                class="product-image-picker__preview"
                alt="Selected product preview"
                hidden
                data-product-image-preview
              />
              <span
                class="product-image-picker__placeholder"
                data-product-image-placeholder
              >
                Select image
              </span>
            </label>
            <button
              type="button"
              class="product-image-picker__remove"
              aria-label="Remove selected image"
              hidden
              data-product-image-remove
            >
              Remove
            </button>
          </div>
        </div>
      </div>
    </form>
    <div slot="footer" class="product-create-sheet__footer">
      <button type="submit" form="create-product-form">Save product</button>
    </div>
  </Sheet>

  <div
    data-interactive-table
    data-server-pagination="true"
    class="dashboard-interactive-table"
  >
    <div class="table-filters product-management-toolbar">
      <form
        method="get"
        action="/admin/products"
        class="product-filter-form"
        data-product-filter-form
        data-current-filter-query={filterQuery}
        aria-label="Filter products"
      >
        <div
          class="product-filter-form__field product-filter-form__field--search"
        >
          <input
            name="search"
            type="search"
            value={activeFilters.search ?? ""}
            placeholder="Search products..."
            autocomplete="off"
            aria-label="Search products"
            data-product-search-input
          />
        </div>
        <div class="product-filter-form__field">
          <select name="stockStatus" aria-label="Filter by stock status">
            <option value="">All statuses</option>
            {
              stockStatuses.map((status) => (
                <option
                  value={status}
                  selected={activeFilters.stockStatus === status}
                >
                  {formatStockStatus(status)}
                </option>
              ))
            }
          </select>
        </div>
        <div class="product-filter-form__field">
          <select name="category" aria-label="Filter by category">
            <option value="">All categories</option>
            {
              productCategories.map((category) => (
                <option
                  value={category}
                  selected={activeFilters.category === category}
                >
                  {category}
                </option>
              ))
            }
          </select>
        </div>
      </form>
      <div class="product-management-toolbar__actions">
        <button
          type="button"
          class="btn-table-manage product-management-toolbar__create"
          data-open-create-sheet
          data-sheet-target="#create-product-sheet">Create Product</button
        >
      </div>
    </div>

    <div data-product-table-shell class="dashboard-interactive-table__surface">
      <DashboardTableBoard>
        <table class="product-table-skeleton dashboard-table dashboard-table--products">
          <thead>
            <tr>
              <DashboardTableNumberHeader />
              <th scope="col">Date Created</th>
              <th scope="col" class="dashboard-table__cell--product">
                Product
              </th>
              <th scope="col">Description</th>
              <th scope="col">Pricing</th>
              <th scope="col">Commission</th>
              <th scope="col">Status</th>
              <DashboardTableActionsHeader />
            </tr>
          </thead>
          <tbody>
            {
              data.products.length === 0 ? (
                <DashboardTableEmptyState
                  colspan={8}
                  message="No products match the selected filters."
                />
              ) : (
                data.products.map((product, index) => (
                  <tr data-status={product.is_active ? "active" : "inactive"}>
                    <td class="dashboard-table__number-column">{dashboardTableRowNumber(data.pagination, index)}</td>
                    <td>
                      {new Date(product.created_at).toLocaleDateString(
                        "en-US",
                        {
                          year: "numeric",
                          month: "short",
                          day: "numeric",
                        },
                      )}
                    </td>

                    {/* Product Cell (Editable Product Popover) */}
                    <td class="dashboard-table__cell--product">
                      <button
                        type="button"
                        class="table-cell-trigger dashboard-table__product-summary dashboard-table__product-button"
                        data-open-cell-popover
                      >
                        {product.image_path ? (
                          <img
                            src={
                              resolvePublicStorageUrl(product.image_path) ??
                              product.image_path
                            }
                            alt=""
                            class="dashboard-table__image-thumb"
                          />
                        ) : (
                          <div class="dashboard-table__image-placeholder" />
                        )}
                        <span title={productDisplayLabel(product)}>
                          {productDisplayLabel(product)}
                        </span>
                      </button>
                      <Popover
                        title={`Edit Product: ${product.name}`}
                        formEnctype="multipart/form-data"
                      >
                          <input
                            type="hidden"
                            name="action"
                            value="save-product"
                          />
                          <input
                            type="hidden"
                            name="productId"
                            value={product.id}
                          />
                          <input
                            type="hidden"
                            name="description"
                            value={product.description ?? ""}
                          />
                          <input
                            type="hidden"
                            name="defaultPrice"
                            value={product.default_price}
                          />
                          <input
                            type="hidden"
                            name="resellerDeductionType"
                            value={product.reseller_deduction_type}
                          />
                          <input
                            type="hidden"
                            name="resellerDeductionValue"
                            value={product.reseller_deduction_value}
                          />
                          <input
                            type="hidden"
                            name="agentCommissionType"
                            value={product.agent_commission_type}
                          />
                          <input
                            type="hidden"
                            name="agentCommissionValue"
                            value={product.agent_commission_value}
                          />
                          <input
                            type="hidden"
                            name="stockStatus"
                            value={product.stock_status}
                          />
                          {product.is_active && (
                            <input type="hidden" name="isActive" value="on" />
                          )}

                          <label>
                            <>
                              <span>Upload new image</span>
                              <input
                                name="imageFile"
                                type="file"
                                accept="image/*"
                                data-max-size-bytes="2097152"
                              />
                            </>
                          </label>
                          <label>
                            <>
                              <span>Name</span>
                              <input
                                name="name"
                                value={product.name}
                                required
                              />
                            </>
                          </label>
                          <label>
                            <span>Category</span>
                            <select
                              name="category"
                              required
                              data-product-other-option-select
                              data-product-other-option-target={`product-${product.id}-category-other`}
                            >
                              {productCategories.map((category) => (
                                <option
                                  value={category}
                                  selected={product.category === category}
                                >
                                  {category}
                                </option>
                              ))}
                              <option value={productOtherOptionValue}>
                                Other
                              </option>
                            </select>
                          </label>
                          <label
                            hidden
                            data-product-other-option-field={`product-${product.id}-category-other`}
                          >
                            <span>Other category</span>
                            <input
                              name="categoryOther"
                              data-product-other-option-input
                            />
                          </label>
                          <label>
                            <span>Unit label</span>
                            <select
                              name="unitLabel"
                              required
                              data-product-other-option-select
                              data-product-other-option-target={`product-${product.id}-unit-other`}
                            >
                              {productUnitLabels.map((unitLabel) => (
                                <option
                                  value={unitLabel}
                                  selected={product.unit_label === unitLabel}
                                >
                                  {unitLabel}
                                </option>
                              ))}
                              <option value={productOtherOptionValue}>
                                Other
                              </option>
                            </select>
                          </label>
                          <label
                            hidden
                            data-product-other-option-field={`product-${product.id}-unit-other`}
                          >
                            <span>Other unit label</span>
                            <input
                              name="unitLabelOther"
                              data-product-other-option-input
                            />
                          </label>
                        <button slot="footer" type="submit" class="ui-popover__button-primary">
                          Save Changes
                        </button>
                      </Popover>
                    </td>

                    {/* 2. Description Cell (Editable Popover) */}
                    <td class="dashboard-table__cell--truncate">
                      <button
                        type="button"
                        class="table-cell-trigger"
                        data-open-cell-popover
                      >
                        {product.description ? (
                          <span title={product.description}>
                            {product.description}
                          </span>
                        ) : (
                          <span class="text-gray-400 text-[0.875rem] italic">
                            No description
                          </span>
                        )}
                      </button>
                      <Popover
                        title={`Edit Description: ${product.name}`}
                        formEnctype="multipart/form-data"
                      >
                          <input
                            type="hidden"
                            name="action"
                            value="save-product"
                          />
                          <input
                            type="hidden"
                            name="productId"
                            value={product.id}
                          />

                          <input
                            type="hidden"
                            name="name"
                            value={product.name}
                          />
                          <input
                            type="hidden"
                            name="category"
                            value={product.category}
                          />
                          <input
                            type="hidden"
                            name="unitLabel"
                            value={product.unit_label}
                          />
                          <input
                            type="hidden"
                            name="defaultPrice"
                            value={product.default_price}
                          />
                          <input
                            type="hidden"
                            name="resellerDeductionType"
                            value={product.reseller_deduction_type}
                          />
                          <input
                            type="hidden"
                            name="resellerDeductionValue"
                            value={product.reseller_deduction_value}
                          />
                          <input
                            type="hidden"
                            name="agentCommissionType"
                            value={product.agent_commission_type}
                          />
                          <input
                            type="hidden"
                            name="agentCommissionValue"
                            value={product.agent_commission_value}
                          />
                          <input
                            type="hidden"
                            name="stockStatus"
                            value={product.stock_status}
                          />
                          {product.is_active && (
                            <input type="hidden" name="isActive" value="on" />
                          )}

                          <label>
                            <>
                              <span>Description</span>
                              <textarea
                                name="description"
                                set:html={escapeTextareaValue(
                                  product.description,
                                )}
                              />
                            </>
                          </label>
                        <button slot="footer" type="submit" class="ui-popover__button-primary">
                          Save Changes
                        </button>
                      </Popover>
                    </td>

                    {/* 3. Pricing Cell (Editable Popover) */}
                    <td>
                      <button
                        type="button"
                        class="table-cell-trigger"
                        data-open-cell-popover
                      >
                        <span>
                          {formatCurrency(product.default_price)} (
                          {formatCurrency(product.reseller_price)})
                        </span>
                      </button>
                      <Popover
                        title={`Edit Pricing: ${product.name}`}
                        formEnctype="multipart/form-data"
                      >
                          <input
                            type="hidden"
                            name="action"
                            value="save-product"
                          />
                          <input
                            type="hidden"
                            name="productId"
                            value={product.id}
                          />
                          <label>
                            <>
                              <span>Default price</span>
                              <input
                                name="defaultPrice"
                                type="number"
                                min="0"
                                step="0.01"
                                value={product.default_price}
                                required
                              />
                            </>
                          </label>
                          <label>
                            <>
                              <span>Reseller deduction type</span>
                              <select
                                name="resellerDeductionType"
                                required
                                data-product-amount-type-select
                                data-product-amount-target={`product-${product.id}-reseller-deduction`}
                              >
                                <option
                                  value="value"
                                  selected={product.reseller_deduction_type ===
                                    "value"}
                                >
                                  Value
                                </option>
                                <option
                                  value="percentage"
                                  selected={product.reseller_deduction_type ===
                                    "percentage"}
                                >
                                  Percentage
                                </option>
                              </select>
                            </>
                          </label>
                          <label>
                            <>
                              <span>Reseller deduction</span>
                              <span
                                class="product-amount-input"
                                data-product-amount-field={`product-${product.id}-reseller-deduction`}
                              >
                                <input
                                  name="resellerDeductionValue"
                                  type="number"
                                  min="0"
                                  step="0.01"
                                  value={product.reseller_deduction_value}
                                  required
                                />
                                <span
                                  class="product-amount-input__suffix"
                                  aria-hidden="true"
                                >
                                  {product.reseller_deduction_type ===
                                  "percentage"
                                    ? "%"
                                    : "₱"}
                                </span>
                              </span>
                            </>
                          </label>

                          <input
                            type="hidden"
                            name="agentCommissionType"
                            value={product.agent_commission_type}
                          />
                          <input
                            type="hidden"
                            name="agentCommissionValue"
                            value={product.agent_commission_value}
                          />
                          <input
                            type="hidden"
                            name="name"
                            value={product.name}
                          />
                          <input
                            type="hidden"
                            name="category"
                            value={product.category}
                          />
                          <input
                            type="hidden"
                            name="unitLabel"
                            value={product.unit_label}
                          />
                          <input
                            type="hidden"
                            name="stockStatus"
                            value={product.stock_status}
                          />
                          <input
                            type="hidden"
                            name="description"
                            value={product.description ?? ""}
                          />
                          {product.is_active && (
                            <input type="hidden" name="isActive" value="on" />
                          )}

                        <button slot="footer" type="submit" class="ui-popover__button-primary">
                          Save Changes
                        </button>
                      </Popover>
                    </td>

                    {/* 4. Commission Cell (Editable Popover) */}
                    <td>
                      <button
                        type="button"
                        class="table-cell-trigger"
                        data-open-cell-popover
                      >
                        <span title={productAgentCommissionLabel(product)}>
                          {productAgentCommissionLabel(product)}
                        </span>
                      </button>
                      <Popover
                        title={`Edit Commission: ${product.name}`}
                        formEnctype="multipart/form-data"
                      >
                          <input
                            type="hidden"
                            name="action"
                            value="save-product"
                          />
                          <input
                            type="hidden"
                            name="productId"
                            value={product.id}
                          />
                          <label>
                            <>
                              <span>Agent commission type</span>
                              <select
                                name="agentCommissionType"
                                required
                                data-product-amount-type-select
                                data-product-amount-target={`product-${product.id}-agent-commission`}
                              >
                                <option
                                  value="value"
                                  selected={product.agent_commission_type ===
                                    "value"}
                                >
                                  Value
                                </option>
                                <option
                                  value="percentage"
                                  selected={product.agent_commission_type ===
                                    "percentage"}
                                >
                                  Percentage
                                </option>
                              </select>
                            </>
                          </label>
                          <label>
                            <>
                              <span>Agent commission</span>
                              <span
                                class="product-amount-input"
                                data-product-amount-field={`product-${product.id}-agent-commission`}
                              >
                                <input
                                  name="agentCommissionValue"
                                  type="number"
                                  min="0"
                                  step="0.01"
                                  value={product.agent_commission_value}
                                  required
                                />
                                <span
                                  class="product-amount-input__suffix"
                                  aria-hidden="true"
                                >
                                  {product.agent_commission_type ===
                                  "percentage"
                                    ? "%"
                                    : "₱"}
                                </span>
                              </span>
                            </>
                          </label>

                          <input
                            type="hidden"
                            name="name"
                            value={product.name}
                          />
                          <input
                            type="hidden"
                            name="category"
                            value={product.category}
                          />
                          <input
                            type="hidden"
                            name="unitLabel"
                            value={product.unit_label}
                          />
                          <input
                            type="hidden"
                            name="defaultPrice"
                            value={product.default_price}
                          />
                          <input
                            type="hidden"
                            name="resellerDeductionType"
                            value={product.reseller_deduction_type}
                          />
                          <input
                            type="hidden"
                            name="resellerDeductionValue"
                            value={product.reseller_deduction_value}
                          />
                          <input
                            type="hidden"
                            name="stockStatus"
                            value={product.stock_status}
                          />
                          <input
                            type="hidden"
                            name="description"
                            value={product.description ?? ""}
                          />
                          {product.is_active && (
                            <input type="hidden" name="isActive" value="on" />
                          )}

                        <button slot="footer" type="submit" class="ui-popover__button-primary">
                          Save Changes
                        </button>
                      </Popover>
                    </td>

                    {/* 5. Status Cell (Editable Popover) */}
                    <td>
                      <button
                        type="button"
                        class="table-cell-trigger"
                        data-open-cell-popover
                      >
                        <StatusBadge
                          kind="stock"
                          status={product.stock_status}
                          label={formatStockStatus(product.stock_status)}
                        />
                      </button>
                      <Popover
                        title={`Edit Status: ${product.name}`}
                        formEnctype="multipart/form-data"
                      >
                          <input
                            type="hidden"
                            name="action"
                            value="save-product"
                          />
                          <input
                            type="hidden"
                            name="productId"
                            value={product.id}
                          />
                          <label>
                            <span>Stock status</span>
                            <select name="stockStatus" required>
                              {stockStatuses.map((status) => (
                                <option
                                  value={status}
                                  selected={product.stock_status === status}
                                >
                                  {status}
                                </option>
                              ))}
                            </select>
                          </label>
                          {product.is_active && (
                            <input type="hidden" name="isActive" value="on" />
                          )}

                          <input
                            type="hidden"
                            name="name"
                            value={product.name}
                          />
                          <input
                            type="hidden"
                            name="category"
                            value={product.category}
                          />
                          <input
                            type="hidden"
                            name="unitLabel"
                            value={product.unit_label}
                          />
                          <input
                            type="hidden"
                            name="defaultPrice"
                            value={product.default_price}
                          />
                          <input
                            type="hidden"
                            name="resellerDeductionType"
                            value={product.reseller_deduction_type}
                          />
                          <input
                            type="hidden"
                            name="resellerDeductionValue"
                            value={product.reseller_deduction_value}
                          />
                          <input
                            type="hidden"
                            name="agentCommissionType"
                            value={product.agent_commission_type}
                          />
                          <input
                            type="hidden"
                            name="agentCommissionValue"
                            value={product.agent_commission_value}
                          />
                          <input
                            type="hidden"
                            name="description"
                            value={product.description ?? ""}
                          />

                        <button slot="footer" type="submit" class="ui-popover__button-primary">
                          Save Changes
                        </button>
                      </Popover>
                    </td>

                    <td class="dashboard-table__actions-column"></td>
                  </tr>
                ))
              )
            }
          </tbody>
        </table>
      </DashboardTableBoard>
    </div>

    <DashboardTablePagination pagination={data.pagination} />
  </div>

  <template data-product-filter-skeleton>
    <DashboardTableBoard aria-busy="true" aria-live="polite">
      <table
        class="product-table-skeleton dashboard-table dashboard-table--products"
      >
        <caption class="sr-only">Loading filtered products</caption>
        <thead>
          <tr>
            <DashboardTableNumberHeader />
            <th scope="col">Date Created</th>
            <th scope="col" class="dashboard-table__cell--product">
              Product
            </th>
            <th scope="col">Description</th>
            <th scope="col">Pricing</th>
            <th scope="col">Commission</th>
            <th scope="col">Status</th>
            <DashboardTableActionsHeader />
          </tr>
        </thead>
        <tbody>
          {
            skeletonRows.map(() => (
              <tr>
                <td>
                  <span class="table-skeleton-block table-skeleton-block--short" />
                </td>
                <td>
                  <span class="table-skeleton-block" />
                </td>
                <td class="dashboard-table__cell--product">
                  <div class="dashboard-table__product-skeleton">
                    <span class="table-skeleton-block table-skeleton-block--image" />
                    <span class="table-skeleton-block" />
                  </div>
                </td>
                <td>
                  <span class="table-skeleton-block table-skeleton-block--wide" />
                </td>
                <td>
                  <span class="table-skeleton-block" />
                </td>
                <td>
                  <span class="table-skeleton-block table-skeleton-block--short" />
                </td>
                <td>
                  <span class="table-skeleton-block" />
                </td>
                <td>
                  <span class="table-skeleton-block table-skeleton-block--short" />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </DashboardTableBoard>
  </template>
</section>

<script>
  import { initDashboardFragmentTable } from "@/lib/client/dashboard-fragment-table";

  function initAdminProductFilters() {
    initDashboardFragmentTable({
      cacheKey: "admin-products-filter-cache-v2",
      fragmentPath: "/admin/products-fragment",
      pagePath: "/admin/products",
      formSelector: "[data-product-filter-form]",
      tableShellSelector: "[data-product-table-shell]",
      skeletonTemplateSelector: "[data-product-filter-skeleton]",
      filterKeys: ["search", "category", "stockStatus"],
      searchInputSelector: "[data-product-search-input]",
      historyStateKey: "productFilterQuery",
    });
  }

  document.addEventListener("DOMContentLoaded", initAdminProductFilters);
  document.addEventListener("astro:after-swap", initAdminProductFilters);
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initAdminProductFilters();
  }

  function initCreateProductImagePicker() {
    const picker = document.querySelector<HTMLElement>(
      "[data-product-image-picker]",
    );
    if (!picker || picker.dataset.initialized === "true") return;

    const input = picker.querySelector<HTMLInputElement>(
      "[data-product-image-input]",
    );
    const preview = picker.querySelector<HTMLImageElement>(
      "[data-product-image-preview]",
    );
    const placeholder = picker.querySelector<HTMLElement>(
      "[data-product-image-placeholder]",
    );
    const removeButton = picker.querySelector<HTMLButtonElement>(
      "[data-product-image-remove]",
    );
    if (!input || !preview || !placeholder || !removeButton) return;
    picker.dataset.initialized = "true";

    const activePicker = picker;
    const activeInput = input;
    const activePreview = preview;
    const activePlaceholder = placeholder;
    const activeRemoveButton = removeButton;
    let previewUrl = "";

    function clearPreview() {
      if (previewUrl) {
        URL.revokeObjectURL(previewUrl);
        previewUrl = "";
      }

      activePreview.hidden = true;
      activePreview.removeAttribute("src");
      activePlaceholder.hidden = false;
      activeRemoveButton.hidden = true;
      activePicker.dataset.hasImage = "false";
    }

    function updatePreview() {
      const file = activeInput.files?.[0];
      if (!file) {
        clearPreview();
        return;
      }

      if (previewUrl) {
        URL.revokeObjectURL(previewUrl);
      }

      previewUrl = URL.createObjectURL(file);
      activePreview.src = previewUrl;
      activePreview.hidden = false;
      activePlaceholder.hidden = true;
      activeRemoveButton.hidden = false;
      activePicker.dataset.hasImage = "true";
    }

    activeInput.addEventListener("change", updatePreview);
    activeRemoveButton.addEventListener("click", () => {
      activeInput.value = "";
      clearPreview();
    });

    clearPreview();
  }

  document.addEventListener("DOMContentLoaded", initCreateProductImagePicker);
  document.addEventListener("astro:after-swap", initCreateProductImagePicker);
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initCreateProductImagePicker();
  }

  function syncProductOtherOptionField(select: HTMLSelectElement) {
    const target = select.dataset.productOtherOptionTarget;
    const form = select.closest("form");
    if (!target || !form) return;

    const fields = Array.from(
      form.querySelectorAll<HTMLElement>("[data-product-other-option-field]"),
    );
    const field = fields.find(
      (candidate) => candidate.dataset.productOtherOptionField === target,
    );
    if (!field) return;

    const input = field.querySelector<HTMLInputElement>(
      "[data-product-other-option-input]",
    );
    const isOtherSelected = select.value === "__other";

    field.hidden = !isOtherSelected;
    if (input) {
      input.required = isOtherSelected;
      if (!isOtherSelected) input.value = "";
    }
  }

  function initProductOtherOptionFields() {
    document
      .querySelectorAll<HTMLSelectElement>("[data-product-other-option-select]")
      .forEach(syncProductOtherOptionField);

    if (document.documentElement.dataset.productOtherOptionHandler === "true") {
      return;
    }

    document.documentElement.dataset.productOtherOptionHandler = "true";
    document.addEventListener("change", (event) => {
      const select = event.target;
      if (
        select instanceof HTMLSelectElement &&
        select.matches("[data-product-other-option-select]")
      ) {
        syncProductOtherOptionField(select);
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initProductOtherOptionFields);
  document.addEventListener("astro:after-swap", initProductOtherOptionFields);
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initProductOtherOptionFields();
  }

  function syncProductAmountSuffix(select: HTMLSelectElement) {
    const target = select.dataset.productAmountTarget;
    const form = select.closest("form");
    if (!target || !form) return;

    const fields = Array.from(
      form.querySelectorAll<HTMLElement>("[data-product-amount-field]"),
    );
    const field = fields.find(
      (candidate) => candidate.dataset.productAmountField === target,
    );
    if (!field) return;

    const suffix = field.querySelector<HTMLElement>(
      ".product-amount-input__suffix",
    );
    if (!suffix) return;

    const isPercentage = select.value === "percentage";
    suffix.textContent = isPercentage ? "%" : "₱";
    field.dataset.amountType = isPercentage ? "percentage" : "value";
  }

  function initProductAmountSuffixes() {
    document
      .querySelectorAll<HTMLSelectElement>("[data-product-amount-type-select]")
      .forEach(syncProductAmountSuffix);

    if (document.documentElement.dataset.productAmountSuffixHandler === "true") {
      return;
    }

    document.documentElement.dataset.productAmountSuffixHandler = "true";
    document.addEventListener("change", (event) => {
      const select = event.target;
      if (
        select instanceof HTMLSelectElement &&
        select.matches("[data-product-amount-type-select]")
      ) {
        syncProductAmountSuffix(select);
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initProductAmountSuffixes);
  document.addEventListener("astro:after-swap", initProductAmountSuffixes);
  document.addEventListener(
    "dashboard:interactive-table-updated",
    initProductAmountSuffixes,
  );
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initProductAmountSuffixes();
  }

  function initCreateProductCategorySuggestion() {
    const form = document.querySelector<HTMLFormElement>(
      "#create-product-form",
    );
    if (!form || form.dataset.categorySuggestionInitialized === "true") return;

    const nameInput = form.querySelector<HTMLInputElement>(
      "[data-create-product-name]",
    );
    const categorySelect = form.querySelector<HTMLSelectElement>(
      "[data-create-product-category]",
    );
    if (!nameInput || !categorySelect) return;

    form.dataset.categorySuggestionInitialized = "true";
    let lastSuggestedCategory = "";
    let hasManualOverride = false;

    function inferCategory(value: string) {
      const normalizedValue = value.trim().toLowerCase();
      if (!normalizedValue) return "";
      if (
        normalizedValue.includes("chicken") ||
        normalizedValue.includes("chick")
      )
        return "chicken";
      if (normalizedValue.includes("pork")) return "pork";
      if (normalizedValue.includes("egg")) return "egg";
      return "";
    }

    function syncCategorySuggestion() {
      if (!nameInput || !categorySelect) return;

      const nextCategory = inferCategory(nameInput.value);
      const currentCategory = categorySelect.value;
      const canAutoApply =
        !hasManualOverride || currentCategory === lastSuggestedCategory;

      if (nextCategory && canAutoApply && currentCategory !== nextCategory) {
        categorySelect.value = nextCategory;
        hasManualOverride = false;
      }

      lastSuggestedCategory = nextCategory;
    }

    if (!nameInput || !categorySelect) return;

    nameInput.addEventListener("input", syncCategorySuggestion);
    categorySelect.addEventListener("change", () => {
      hasManualOverride = categorySelect.value !== lastSuggestedCategory;
    });

    syncCategorySuggestion();
  }

  document.addEventListener(
    "DOMContentLoaded",
    initCreateProductCategorySuggestion,
  );
  document.addEventListener(
    "astro:after-swap",
    initCreateProductCategorySuggestion,
  );
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initCreateProductCategorySuggestion();
  }
</script>
