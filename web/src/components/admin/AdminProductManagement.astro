---
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import DashboardTableEmptyState from "@/components/dashboard/DashboardTableEmptyState.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import Sheet from "@/components/ui/Sheet.astro";
import type { AdminProductManagementData } from "@/lib/admin-dashboard/data";
import type { AdminProductFilters } from "@/lib/admin-dashboard/product-filters";
import {
  escapeTextareaValue,
  formatCurrency,
  productDisplayLabel,
} from "@/lib/admin-dashboard/view";
import { resolvePublicStorageUrl } from "@/lib/supabase/storage";

type Props = {
  data: AdminProductManagementData;
  productCategories: readonly string[];
  productUnitLabels: readonly string[];
  stockStatuses: readonly string[];
  activeFilters: AdminProductFilters;
  filterQuery: string;
};

const {
  data,
  productCategories,
  productUnitLabels,
  stockStatuses,
  activeFilters,
  filterQuery,
} = Astro.props;
const skeletonRows = Array.from({ length: 6 });

function formatStockStatus(status: string): string {
  if (status === "in_stock") return "In Stock";
  if (status === "out_of_stock") return "Out of Stock";
  if (status === "low_stock") return "Low Stock";
  return status.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
}
---

<section
  id="admin-products"
  class="admin-panel"
  aria-labelledby="admin-products-title"
>
  <Sheet
    id="create-product-sheet"
    header="Create Product"
    description="Add a new product to the catalog."
    width="36rem"
  >
    <form
      id="create-product-form"
      method="post"
      enctype="multipart/form-data"
      class="admin-form product-create-form"
      aria-label="Create product"
    >
      <input type="hidden" name="action" value="save-product" />
      <input type="hidden" name="isActive" value="on" />
      <div class="admin-form-grid product-create-form__grid">
        <label class="field-row"
          ><span>Name</span><input
            name="name"
            required
            data-create-product-name
          /></label
        >
        <label class="field-row">
          <span>Unit label</span>
          <select name="unitLabel" required>
            {
              productUnitLabels.map((unitLabel) => (
                <option value={unitLabel}>{unitLabel}</option>
              ))
            }
          </select>
        </label>
        <label class="field-row">
          <span>Category</span>
          <select name="category" required data-create-product-category>
            {
              productCategories.map((category) => (
                <option value={category}>{category}</option>
              ))
            }
          </select>
        </label>
        <label class="field-row"
          ><span>Default price</span><input
            name="defaultPrice"
            type="number"
            min="0"
            step="0.01"
            required
          /></label
        >
        <label class="field-row"
          ><span>Reseller price</span><input
            name="resellerPrice"
            type="number"
            min="0"
            step="0.01"
            required
          /></label
        >
        <label class="field-row">
          <span>Stock status</span>
          <select name="stockStatus" required>
            {
              stockStatuses.map((status) => (
                <option value={status}>{status}</option>
              ))
            }
          </select>
        </label>
        <label class="field-row"
          ><span>Description</span><textarea name="description"
          ></textarea></label
        >
        <div class="field-row product-image-field">
          <span>Product image</span>
          <div class="product-image-picker" data-product-image-picker>
            <input
              id="create-product-image-input"
              class="product-image-picker__input"
              name="imageFile"
              type="file"
              accept="image/*"
              required
              data-product-image-input
            />
            <label
              for="create-product-image-input"
              class="product-image-picker__surface"
              data-product-image-surface
            >
              <img
                class="product-image-picker__preview"
                alt="Selected product preview"
                hidden
                data-product-image-preview
              />
              <span
                class="product-image-picker__placeholder"
                data-product-image-placeholder
              >
                Select image
              </span>
            </label>
            <button
              type="button"
              class="product-image-picker__remove"
              aria-label="Remove selected image"
              hidden
              data-product-image-remove
            >
              Remove
            </button>
          </div>
        </div>
      </div>
    </form>
    <div slot="footer" class="product-create-sheet__footer">
      <button type="submit" form="create-product-form">Save product</button>
    </div>
  </Sheet>

  <div data-interactive-table class="dashboard-interactive-table">
    <div class="table-filters product-management-toolbar">
      <form
        method="get"
        action="/admin/products"
        class="product-filter-form"
        data-product-filter-form
        data-current-filter-query={filterQuery}
        aria-label="Filter products"
      >
        <div
          class="product-filter-form__field product-filter-form__field--search"
        >
          <input
            name="search"
            type="search"
            value={activeFilters.search ?? ""}
            placeholder="Search products..."
            autocomplete="off"
            aria-label="Search products"
            data-product-search-input
          />
        </div>
        <div class="product-filter-form__field">
          <select name="stockStatus" aria-label="Filter by stock status">
            <option value="">All statuses</option>
            {
              stockStatuses.map((status) => (
                <option
                  value={status}
                  selected={activeFilters.stockStatus === status}
                >
                  {formatStockStatus(status)}
                </option>
              ))
            }
          </select>
        </div>
        <div class="product-filter-form__field">
          <select name="category" aria-label="Filter by category">
            <option value="">All categories</option>
            {
              productCategories.map((category) => (
                <option
                  value={category}
                  selected={activeFilters.category === category}
                >
                  {category}
                </option>
              ))
            }
          </select>
        </div>
      </form>
      <div class="product-management-toolbar__actions">
        <button
          type="button"
          class="btn-table-manage product-management-toolbar__create"
          data-open-create-sheet
          data-sheet-target="#create-product-sheet">Create Product</button
        >
      </div>
    </div>

    <div data-product-table-shell class="dashboard-interactive-table__surface">
      <DashboardTableBoard>
        <table class="product-table-skeleton dashboard-table dashboard-table--products">
          <thead>
            <tr>
              <th scope="col" class="dashboard-table__cell--product">
                Product
              </th>
              <th scope="col">Description</th>
              <th scope="col">Pricing</th>
              <th scope="col">Status</th>
              <th scope="col">Date Created</th>
              <th scope="col">Action</th>
            </tr>
          </thead>
          <tbody>
            {
              data.products.length === 0 ? (
                <DashboardTableEmptyState
                  colspan={6}
                  message="No products match the selected filters."
                />
              ) : (
                data.products.map((product) => (
                  <tr data-status={product.is_active ? "active" : "inactive"}>
                    {/* 1. Product Cell (Editable Product Popover) */}
                    <td class="dashboard-table__cell--product">
                      <button
                        type="button"
                        class="table-cell-trigger dashboard-table__product-summary dashboard-table__product-button"
                        data-open-cell-popover
                        data-popover-title={`Edit Product: ${product.name}`}
                      >
                        {product.image_path ? (
                          <img
                            src={
                              resolvePublicStorageUrl(product.image_path) ??
                              product.image_path
                            }
                            alt=""
                            class="dashboard-table__image-thumb"
                          />
                        ) : (
                          <div class="dashboard-table__image-placeholder" />
                        )}
                        <span title={productDisplayLabel(product)}>
                          {productDisplayLabel(product)}
                        </span>
                      </button>
                      <div
                        class="hidden-popover-form-holder"
                        style="display: none;"
                      >
                        <form
                          method="post"
                          enctype="multipart/form-data"
                          class="admin-table-form"
                        >
                          <input
                            type="hidden"
                            name="action"
                            value="save-product"
                          />
                          <input
                            type="hidden"
                            name="productId"
                            value={product.id}
                          />
                          <input
                            type="hidden"
                            name="description"
                            value={product.description ?? ""}
                          />
                          <input
                            type="hidden"
                            name="defaultPrice"
                            value={product.default_price}
                          />
                          <input
                            type="hidden"
                            name="resellerPrice"
                            value={product.reseller_price}
                          />
                          <input
                            type="hidden"
                            name="stockStatus"
                            value={product.stock_status}
                          />
                          {product.is_active && (
                            <input type="hidden" name="isActive" value="on" />
                          )}

                          <label>
                            <>
                              <span>Upload new image</span>
                              <input
                                name="imageFile"
                                type="file"
                                accept="image/*"
                              />
                            </>
                          </label>
                          <label>
                            <>
                              <span>Name</span>
                              <input
                                name="name"
                                value={product.name}
                                required
                              />
                            </>
                          </label>
                          <label>
                            <span>Category</span>
                            <select name="category" required>
                              {productCategories.map((category) => (
                                <option
                                  value={category}
                                  selected={product.category === category}
                                >
                                  {category}
                                </option>
                              ))}
                            </select>
                          </label>
                          <label>
                            <span>Unit label</span>
                            <select name="unitLabel" required>
                              {productUnitLabels.map((unitLabel) => (
                                <option
                                  value={unitLabel}
                                  selected={product.unit_label === unitLabel}
                                >
                                  {unitLabel}
                                </option>
                              ))}
                            </select>
                          </label>
                          <div class="button-row">
                            <button type="submit">Save product</button>
                          </div>
                        </form>
                      </div>
                    </td>

                    {/* 2. Description Cell (Editable Popover) */}
                    <td class="dashboard-table__cell--truncate">
                      <button
                        type="button"
                        class="table-cell-trigger"
                        data-open-cell-popover
                        data-popover-title={`Edit Description: ${product.name}`}
                      >
                        {product.description ? (
                          <span title={product.description}>
                            {product.description}
                          </span>
                        ) : (
                          <span class="text-gray-400 text-[0.875rem] italic">
                            No description
                          </span>
                        )}
                      </button>
                      <div
                        class="hidden-popover-form-holder"
                        style="display: none;"
                      >
                        <form
                          method="post"
                          enctype="multipart/form-data"
                          class="admin-table-form"
                        >
                          <input
                            type="hidden"
                            name="action"
                            value="save-product"
                          />
                          <input
                            type="hidden"
                            name="productId"
                            value={product.id}
                          />

                          <input
                            type="hidden"
                            name="name"
                            value={product.name}
                          />
                          <input
                            type="hidden"
                            name="category"
                            value={product.category}
                          />
                          <input
                            type="hidden"
                            name="unitLabel"
                            value={product.unit_label}
                          />
                          <input
                            type="hidden"
                            name="defaultPrice"
                            value={product.default_price}
                          />
                          <input
                            type="hidden"
                            name="resellerPrice"
                            value={product.reseller_price}
                          />
                          <input
                            type="hidden"
                            name="stockStatus"
                            value={product.stock_status}
                          />
                          {product.is_active && (
                            <input type="hidden" name="isActive" value="on" />
                          )}

                          <label>
                            <>
                              <span>Description</span>
                              <textarea
                                name="description"
                                set:html={escapeTextareaValue(
                                  product.description,
                                )}
                              />
                            </>
                          </label>
                          <div class="button-row">
                            <button type="submit">Save description</button>
                          </div>
                        </form>
                      </div>
                    </td>

                    {/* 3. Pricing Cell (Editable Popover) */}
                    <td>
                      <button
                        type="button"
                        class="table-cell-trigger"
                        data-open-cell-popover
                        data-popover-title={`Edit Pricing: ${product.name}`}
                      >
                        <span>
                          {formatCurrency(product.default_price)} (
                          {formatCurrency(product.reseller_price)})
                        </span>
                      </button>
                      <div class="hidden-popover-form-holder">
                        <form
                          method="post"
                          enctype="multipart/form-data"
                          class="admin-table-form"
                        >
                          <input
                            type="hidden"
                            name="action"
                            value="save-product"
                          />
                          <input
                            type="hidden"
                            name="productId"
                            value={product.id}
                          />
                          <label>
                            <>
                              <span>Default price</span>
                              <input
                                name="defaultPrice"
                                type="number"
                                min="0"
                                step="0.01"
                                value={product.default_price}
                                required
                              />
                            </>
                          </label>
                          <label>
                            <>
                              <span>Reseller price</span>
                              <input
                                name="resellerPrice"
                                type="number"
                                min="0"
                                step="0.01"
                                value={product.reseller_price}
                                required
                              />
                            </>
                          </label>

                          <input
                            type="hidden"
                            name="name"
                            value={product.name}
                          />
                          <input
                            type="hidden"
                            name="category"
                            value={product.category}
                          />
                          <input
                            type="hidden"
                            name="unitLabel"
                            value={product.unit_label}
                          />
                          <input
                            type="hidden"
                            name="stockStatus"
                            value={product.stock_status}
                          />
                          <input
                            type="hidden"
                            name="description"
                            value={product.description ?? ""}
                          />
                          {product.is_active && (
                            <input type="hidden" name="isActive" value="on" />
                          )}

                          <div class="button-row">
                            <button type="submit">Save pricing</button>
                          </div>
                        </form>
                      </div>
                    </td>

                    {/* 4. Status Cell (Editable Popover) */}
                    <td>
                      <button
                        type="button"
                        class="table-cell-trigger"
                        data-open-cell-popover
                        data-popover-title={`Edit Status: ${product.name}`}
                      >
                        <StatusBadge
                          kind="stock"
                          status={product.stock_status}
                          label={formatStockStatus(product.stock_status)}
                        />
                      </button>
                      <div class="hidden-popover-form-holder">
                        <form
                          method="post"
                          enctype="multipart/form-data"
                          class="admin-table-form"
                        >
                          <input
                            type="hidden"
                            name="action"
                            value="save-product"
                          />
                          <input
                            type="hidden"
                            name="productId"
                            value={product.id}
                          />
                          <label>
                            <span>Stock status</span>
                            <select name="stockStatus" required>
                              {stockStatuses.map((status) => (
                                <option
                                  value={status}
                                  selected={product.stock_status === status}
                                >
                                  {status}
                                </option>
                              ))}
                            </select>
                          </label>
                          {product.is_active && (
                            <input type="hidden" name="isActive" value="on" />
                          )}

                          <input
                            type="hidden"
                            name="name"
                            value={product.name}
                          />
                          <input
                            type="hidden"
                            name="category"
                            value={product.category}
                          />
                          <input
                            type="hidden"
                            name="unitLabel"
                            value={product.unit_label}
                          />
                          <input
                            type="hidden"
                            name="defaultPrice"
                            value={product.default_price}
                          />
                          <input
                            type="hidden"
                            name="resellerPrice"
                            value={product.reseller_price}
                          />
                          <input
                            type="hidden"
                            name="description"
                            value={product.description ?? ""}
                          />

                          <div class="button-row">
                            <button type="submit">Save status</button>
                          </div>
                        </form>
                      </div>
                    </td>

                    {/* 5. Date Created Cell (Static) */}
                    <td>
                      {new Date(product.created_at).toLocaleDateString(
                        "en-US",
                        {
                          year: "numeric",
                          month: "short",
                          day: "numeric",
                        },
                      )}
                    </td>

                    {/* 6. Action Cell (Static Form) */}
                    <td>
                      {product.is_active ? (
                        <form method="post" style="margin: 0;">
                          <input
                            type="hidden"
                            name="action"
                            value="deactivate-product"
                          />
                          <input
                            type="hidden"
                            name="productId"
                            value={product.id}
                          />
                          <button
                            type="submit"
                            class="btn-table-manage"
                            style="background-color: var(--color-brand-muted-black); padding: 0.25rem 0.5rem; font-size: 0.75rem; text-transform: none; letter-spacing: normal; width: auto; display: inline-block;"
                          >
                            Deactivate
                          </button>
                        </form>
                      ) : (
                        <span style="color: #9ca3af; font-style: italic; font-size: 0.85rem;">
                          None
                        </span>
                      )}
                    </td>
                  </tr>
                ))
              )
            }
          </tbody>
        </table>
      </DashboardTableBoard>
    </div>

    <DashboardTablePagination />
  </div>

  <template data-product-filter-skeleton>
    <DashboardTableBoard aria-busy="true" aria-live="polite">
      <table
        class="product-table-skeleton dashboard-table dashboard-table--products"
      >
        <caption class="sr-only">Loading filtered products</caption>
        <thead>
          <tr>
            <th scope="col" class="dashboard-table__cell--product">
              Product
            </th>
            <th scope="col">Description</th>
            <th scope="col">Pricing</th>
            <th scope="col">Status</th>
            <th scope="col">Date Created</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          {
            skeletonRows.map(() => (
              <tr>
                <td class="dashboard-table__cell--product">
                  <div class="dashboard-table__product-skeleton">
                    <span class="table-skeleton-block table-skeleton-block--image" />
                    <span class="table-skeleton-block" />
                  </div>
                </td>
                <td>
                  <span class="table-skeleton-block table-skeleton-block--wide" />
                </td>
                <td>
                  <span class="table-skeleton-block" />
                </td>
                <td>
                  <span class="table-skeleton-block table-skeleton-block--short" />
                </td>
                <td>
                  <span class="table-skeleton-block" />
                </td>
                <td>
                  <span class="table-skeleton-block table-skeleton-block--short" />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </DashboardTableBoard>
  </template>
</section>

<script>
  import {
    readDashboardFragmentCache,
    writeDashboardFragmentCache,
  } from "@/lib/client/dashboard-fragment-cache";

  function initAdminProductFilters() {
    const form = document.querySelector<HTMLFormElement>(
      "[data-product-filter-form]",
    );
    const tableShell = document.querySelector<HTMLElement>(
      "[data-product-table-shell]",
    );
    const skeletonTemplate = document.querySelector<HTMLTemplateElement>(
      "[data-product-filter-skeleton]",
    );

    if (!form || !tableShell || !skeletonTemplate) return;
    if (form.dataset.productFilterInitialized === "true") return;
    form.dataset.productFilterInitialized = "true";
    const activeForm = form;
    const activeTableShell = tableShell;
    const activeSkeletonTemplate = skeletonTemplate;

    const cacheKey = "admin-products-filter-cache-v1";
    const fragmentPath = "/admin/products-fragment";
    const filterKeys = ["search", "category", "stockStatus"] as const;
    const autoSubmitFields =
      activeForm.querySelectorAll<HTMLSelectElement>("select");
    const searchInput = activeForm.querySelector<HTMLInputElement>(
      "[data-product-search-input]",
    );
    let submitTimer: number | undefined;
    let searchTimer: number | undefined;
    let activeFetchController: AbortController | undefined;

    function normalizeParams(params: URLSearchParams) {
      const normalized = new URLSearchParams();

      filterKeys.forEach((key) => {
        const value = params.get(key)?.trim();
        if (value) normalized.set(key, value);
      });

      return normalized.toString();
    }

    function normalizeFormQuery() {
      const params = new URLSearchParams();
      const formData = new FormData(activeForm);

      filterKeys.forEach((key) => {
        const value = formData.get(key);
        if (typeof value === "string" && value.trim()) {
          params.set(key, value.trim());
        }
      });

      return params.toString();
    }

    function buildUrl(path: string, targetQuery: string) {
      return targetQuery ? `${path}?${targetQuery}` : path;
    }

    function submitFilters() {
      window.clearTimeout(submitTimer);
      submitTimer = window.setTimeout(() => {
        void applyFilters(normalizeFormQuery());
      }, 120);
    }

    function showSkeletonForQuery(targetQuery: string) {
      const currentQuery = normalizeParams(
        new URLSearchParams(window.location.search),
      );
      const cachedFragment = readDashboardFragmentCache(cacheKey, targetQuery);

      if (targetQuery === currentQuery || cachedFragment) {
        return;
      }

      const skeleton =
        activeSkeletonTemplate.content.firstElementChild?.cloneNode(true);
      if (!skeleton) return;

      activeTableShell.replaceChildren(skeleton);
    }

    function replaceProductsFragment(fragmentHtml: string) {
      const parsed = new DOMParser().parseFromString(fragmentHtml, "text/html");
      const nextTableShell = parsed.querySelector<HTMLElement>(
        "[data-product-table-shell]",
      );

      if (!nextTableShell) {
        throw new Error("Products fragment did not include a product table.");
      }

      activeTableShell.innerHTML = nextTableShell.innerHTML;
      document.dispatchEvent(new Event("dashboard:interactive-table-updated"));
    }

    async function applyFilters(
      targetQuery: string,
      options: { updateHistory?: boolean } = {},
    ) {
      const updateHistory = options.updateHistory ?? true;
      const currentQuery = normalizeParams(
        new URLSearchParams(window.location.search),
      );

      if (targetQuery === currentQuery && updateHistory) {
        return;
      }

      const cachedFragment = readDashboardFragmentCache(cacheKey, targetQuery);
      if (cachedFragment) {
        if (updateHistory) {
          window.history.replaceState(
            { productFilterQuery: targetQuery },
            "",
            buildUrl("/admin/products", targetQuery),
          );
        }

        replaceProductsFragment(cachedFragment);
        activeForm.dataset.currentFilterQuery = targetQuery;
        return;
      }

      showSkeletonForQuery(targetQuery);
      activeFetchController?.abort();

      const fetchController = new AbortController();
      activeFetchController = fetchController;

      try {
        const response = await fetch(buildUrl(fragmentPath, targetQuery), {
          headers: {
            "X-Requested-With": "fetch",
          },
          signal: fetchController.signal,
        });

        const fragmentHtml = await window.readDashboardFragmentResponse(response);
        if (updateHistory) {
          window.history.replaceState(
            { productFilterQuery: targetQuery },
            "",
            buildUrl("/admin/products", targetQuery),
          );
        }

        replaceProductsFragment(fragmentHtml);
        activeForm.dataset.currentFilterQuery = targetQuery;
        writeDashboardFragmentCache(cacheKey, targetQuery, fragmentHtml);
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError") {
          return;
        }

        window.location.href = buildUrl("/admin/products", targetQuery);
      } finally {
        if (activeFetchController === fetchController) {
          activeFetchController = undefined;
        }
      }
    }

    writeDashboardFragmentCache(
      cacheKey,
      normalizeParams(new URLSearchParams(window.location.search)),
      activeTableShell.outerHTML,
    );

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void applyFilters(normalizeFormQuery());
    });

    autoSubmitFields.forEach((field) => {
      field.addEventListener("change", submitFilters);
    });

    searchInput?.addEventListener("input", () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(submitFilters, 450);
    });
  }

  document.addEventListener("DOMContentLoaded", initAdminProductFilters);
  document.addEventListener("astro:after-swap", initAdminProductFilters);
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initAdminProductFilters();
  }

  function initCreateProductImagePicker() {
    const picker = document.querySelector<HTMLElement>(
      "[data-product-image-picker]",
    );
    if (!picker || picker.dataset.initialized === "true") return;

    const input = picker.querySelector<HTMLInputElement>(
      "[data-product-image-input]",
    );
    const preview = picker.querySelector<HTMLImageElement>(
      "[data-product-image-preview]",
    );
    const placeholder = picker.querySelector<HTMLElement>(
      "[data-product-image-placeholder]",
    );
    const removeButton = picker.querySelector<HTMLButtonElement>(
      "[data-product-image-remove]",
    );
    if (!input || !preview || !placeholder || !removeButton) return;
    picker.dataset.initialized = "true";

    const activePicker = picker;
    const activeInput = input;
    const activePreview = preview;
    const activePlaceholder = placeholder;
    const activeRemoveButton = removeButton;
    let previewUrl = "";

    function clearPreview() {
      if (previewUrl) {
        URL.revokeObjectURL(previewUrl);
        previewUrl = "";
      }

      activePreview.hidden = true;
      activePreview.removeAttribute("src");
      activePlaceholder.hidden = false;
      activeRemoveButton.hidden = true;
      activePicker.dataset.hasImage = "false";
    }

    function updatePreview() {
      const file = activeInput.files?.[0];
      if (!file) {
        clearPreview();
        return;
      }

      if (previewUrl) {
        URL.revokeObjectURL(previewUrl);
      }

      previewUrl = URL.createObjectURL(file);
      activePreview.src = previewUrl;
      activePreview.hidden = false;
      activePlaceholder.hidden = true;
      activeRemoveButton.hidden = false;
      activePicker.dataset.hasImage = "true";
    }

    activeInput.addEventListener("change", updatePreview);
    activeRemoveButton.addEventListener("click", () => {
      activeInput.value = "";
      clearPreview();
    });

    clearPreview();
  }

  document.addEventListener("DOMContentLoaded", initCreateProductImagePicker);
  document.addEventListener("astro:after-swap", initCreateProductImagePicker);
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initCreateProductImagePicker();
  }

  function initCreateProductCategorySuggestion() {
    const form = document.querySelector<HTMLFormElement>(
      "#create-product-form",
    );
    if (!form || form.dataset.categorySuggestionInitialized === "true") return;

    const nameInput = form.querySelector<HTMLInputElement>(
      "[data-create-product-name]",
    );
    const categorySelect = form.querySelector<HTMLSelectElement>(
      "[data-create-product-category]",
    );
    if (!nameInput || !categorySelect) return;

    form.dataset.categorySuggestionInitialized = "true";
    let lastSuggestedCategory = "";
    let hasManualOverride = false;

    function inferCategory(value: string) {
      const normalizedValue = value.trim().toLowerCase();
      if (!normalizedValue) return "";
      if (
        normalizedValue.includes("chicken") ||
        normalizedValue.includes("chick")
      )
        return "chicken";
      if (normalizedValue.includes("pork")) return "pork";
      if (normalizedValue.includes("egg")) return "egg";
      return "";
    }

    function syncCategorySuggestion() {
      if (!nameInput || !categorySelect) return;

      const nextCategory = inferCategory(nameInput.value);
      const currentCategory = categorySelect.value;
      const canAutoApply =
        !hasManualOverride || currentCategory === lastSuggestedCategory;

      if (nextCategory && canAutoApply && currentCategory !== nextCategory) {
        categorySelect.value = nextCategory;
        hasManualOverride = false;
      }

      lastSuggestedCategory = nextCategory;
    }

    if (!nameInput || !categorySelect) return;

    nameInput.addEventListener("input", syncCategorySuggestion);
    categorySelect.addEventListener("change", () => {
      hasManualOverride = categorySelect.value !== lastSuggestedCategory;
    });

    syncCategorySuggestion();
  }

  document.addEventListener(
    "DOMContentLoaded",
    initCreateProductCategorySuggestion,
  );
  document.addEventListener(
    "astro:after-swap",
    initCreateProductCategorySuggestion,
  );
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initCreateProductCategorySuggestion();
  }
</script>
