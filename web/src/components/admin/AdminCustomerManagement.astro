---
import ViewButton from "@/components/ViewButton.astro";
import type { AdminCustomerManagementData } from "@/lib/admin-dashboard/data";
import type { AdminCustomerFilters } from "@/lib/admin-dashboard/customer-filters";
import { customerTypes } from "@/lib/admin-dashboard/customer-filters";
import { fullName } from "@/lib/admin-dashboard/view";

type Props = {
  data: AdminCustomerManagementData;
  activeFilters: AdminCustomerFilters;
  filterQuery: string;
};

const { data, activeFilters, filterQuery } = Astro.props;
const skeletonRows = Array.from({ length: 6 });

function formatCustomerType(customerType: (typeof customerTypes)[number]) {
  return customerType === "reseller" ? "Reseller" : "Retail";
}
---

<section id="admin-customers" class="admin-panel" aria-labelledby="admin-customers-title">
  <div data-interactive-table>
    <div class="table-filters order-management-toolbar">
      <form
        method="get"
        action="/admin/customers"
        class="order-filter-form"
        data-customer-filter-form
        data-current-filter-query={filterQuery}
        aria-label="Filter customers"
      >
        <label class="order-filter-form__field order-filter-form__field--search">
          <span>Search</span>
          <input
            name="search"
            type="search"
            value={activeFilters.search ?? ""}
            placeholder="Search name, email, contact, or assigned agent..."
            autocomplete="off"
            data-customer-search-input
          />
        </label>
        <label class="order-filter-form__field">
          <span>Type</span>
          <select name="customerType">
            <option value="">All types</option>
            {customerTypes.map((customerType) => (
              <option value={customerType} selected={activeFilters.customerType === customerType}>
                {formatCustomerType(customerType)}
              </option>
            ))}
          </select>
        </label>
      </form>

      <div class="order-management-toolbar__actions"></div>
    </div>

    <div data-customer-table-shell>
      <div class="table-wrap">
        <table class="dashboard-table">
          <thead>
            <tr>
              <th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Customer</th>
              <th scope="col" style="width: 20%; padding: 1.1rem 0.75rem;">Email</th>
              <th scope="col" style="width: 20%; padding: 1.1rem 0.75rem;">Contact</th>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Type</th>
              <th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Assigned Agent</th>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Action</th>
            </tr>
          </thead>
          <tbody>
            {data.customers.length === 0 ? (
              <tr class="empty-row">
                <td colspan="6" class="empty-state">
                  No customers match the selected filters.
                </td>
              </tr>
            ) : data.customers.map((customer) => (
              <tr>
                <td style="width: 16%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  {fullName(customer)}
                </td>
                <td style="width: 20%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  {customer.email ?? "No email"}
                </td>
                <td style="width: 20%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  {customer.phone_number}
                </td>
                <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                  {customer.is_reseller ? "Reseller" : "Retail"}
                </td>
                <td style="width: 16%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  {data.agents.find((agent) => agent.id === customer.assigned_agent_id)?.display_name ?? "None"}
                </td>
                <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                  <ViewButton href={`/admin/customers/${customer.id}`} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="table-pagination">
      <div class="table-pagination__summary">
        <span data-page-info></span>
        <label class="table-pagination__limit">
          <select data-limit-select>
            <option value="10">10 rows</option>
            <option value="50">50 rows</option>
            <option value="100">100 rows</option>
          </select>
        </label>
      </div>
      <div class="table-pagination__controls">
        <button type="button" data-pagination-prev class="btn-secondary"><svg class="table-pagination__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button>
        <div data-pagination-numbers class="table-pagination__numbers"></div>
        <button type="button" data-pagination-next class="btn-secondary"><svg class="table-pagination__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button>
      </div>
    </div>
  </div>

  <template data-customer-filter-skeleton>
    <div class="table-wrap" aria-busy="true" aria-live="polite">
      <table class="product-table-skeleton dashboard-table">
        <caption class="sr-only">Loading filtered customers</caption>
        <thead>
          <tr>
            <th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Customer</th>
            <th scope="col" style="width: 20%; padding: 1.1rem 0.75rem;">Email</th>
            <th scope="col" style="width: 20%; padding: 1.1rem 0.75rem;">Contact</th>
            <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Type</th>
            <th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Assigned Agent</th>
            <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Action</th>
          </tr>
        </thead>
        <tbody>
          {skeletonRows.map(() => (
            <tr>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </template>
</section>

<script>
  function initAdminCustomerFilters() {
    const form = document.querySelector<HTMLFormElement>("[data-customer-filter-form]");
    const tableShell = document.querySelector<HTMLElement>("[data-customer-table-shell]");
    const skeletonTemplate = document.querySelector<HTMLTemplateElement>("[data-customer-filter-skeleton]");
    if (!form || !tableShell || !skeletonTemplate) return;
    if (form.dataset.customerFilterInitialized === "true") return;
    form.dataset.customerFilterInitialized = "true";

    const activeForm = form;
    const activeTableShell = tableShell;
    const activeSkeletonTemplate = skeletonTemplate;
    const cacheKey = "admin-customers-filter-cache-v1";
    const fragmentPath = "/admin/customers-fragment";
    const filterKeys = ["search", "customerType"] as const;
    const autoSubmitFields = activeForm.querySelectorAll<HTMLSelectElement>("select");
    const searchInput = activeForm.querySelector<HTMLInputElement>("[data-customer-search-input]");
    let submitTimer: number | undefined;
    let searchTimer: number | undefined;
    let activeFetchController: AbortController | undefined;

    function readCache(): string[] {
      try {
        const parsed = JSON.parse(sessionStorage.getItem(cacheKey) || "[]");
        return Array.isArray(parsed)
          ? parsed.filter((value): value is string => typeof value === "string")
          : [];
      } catch {
        return [];
      }
    }

    function writeCache(values: string[]) {
      sessionStorage.setItem(cacheKey, JSON.stringify([...new Set(values)]));
    }

    function normalizeParams(params: URLSearchParams) {
      const normalized = new URLSearchParams();

      filterKeys.forEach((key) => {
        const value = params.get(key)?.trim();
        if (value) normalized.set(key, value);
      });

      return normalized.toString();
    }

    function normalizeFormQuery() {
      const params = new URLSearchParams();
      const formData = new FormData(activeForm);

      filterKeys.forEach((key) => {
        const value = formData.get(key);
        if (typeof value === "string" && value.trim()) {
          params.set(key, value.trim());
        }
      });

      return params.toString();
    }

    function buildUrl(path: string, targetQuery: string) {
      return targetQuery ? `${path}?${targetQuery}` : path;
    }

    function showSkeletonForQuery(targetQuery: string) {
      const currentQuery = normalizeParams(new URLSearchParams(window.location.search));
      const cachedQueries = readCache();

      if (targetQuery === currentQuery || cachedQueries.includes(targetQuery)) {
        return;
      }

      const skeleton = activeSkeletonTemplate.content.firstElementChild?.cloneNode(true);
      if (!skeleton) return;

      activeTableShell.replaceChildren(skeleton);
    }

    function replaceCustomersFragment(fragmentHtml: string) {
      const parsed = new DOMParser().parseFromString(fragmentHtml, "text/html");
      const nextTableShell = parsed.querySelector<HTMLElement>("[data-customer-table-shell]");

      if (!nextTableShell) {
        throw new Error("Customers fragment did not include a customer table.");
      }

      activeTableShell.innerHTML = nextTableShell.innerHTML;
      document.dispatchEvent(new Event("dashboard:interactive-table-updated"));
    }

    async function applyFilters(targetQuery: string) {
      const currentQuery = normalizeParams(new URLSearchParams(window.location.search));

      if (targetQuery === currentQuery) {
        return;
      }

      showSkeletonForQuery(targetQuery);
      activeFetchController?.abort();

      const fetchController = new AbortController();
      activeFetchController = fetchController;

      try {
        const response = await fetch(buildUrl(fragmentPath, targetQuery), {
          headers: {
            "X-Requested-With": "fetch",
          },
          signal: fetchController.signal,
        });

        if (!response.ok) {
          throw new Error(`Customer filters failed with ${response.status}.`);
        }

        const fragmentHtml = await response.text();
        window.history.replaceState(
          { customerFilterQuery: targetQuery },
          "",
          buildUrl("/admin/customers", targetQuery),
        );
        replaceCustomersFragment(fragmentHtml);
        activeForm.dataset.currentFilterQuery = targetQuery;
        writeCache([...readCache(), targetQuery]);
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError") {
          return;
        }

        window.location.href = buildUrl("/admin/customers", targetQuery);
      } finally {
        if (activeFetchController === fetchController) {
          activeFetchController = undefined;
        }
      }
    }

    function submitFilters() {
      window.clearTimeout(submitTimer);
      submitTimer = window.setTimeout(() => {
        void applyFilters(normalizeFormQuery());
      }, 120);
    }

    writeCache([...readCache(), normalizeParams(new URLSearchParams(window.location.search))]);

    activeForm.addEventListener("submit", (event) => {
      event.preventDefault();
      void applyFilters(normalizeFormQuery());
    });

    autoSubmitFields.forEach((field) => {
      field.addEventListener("change", submitFilters);
    });

    searchInput?.addEventListener("input", () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(submitFilters, 450);
    });

  }

  document.addEventListener("DOMContentLoaded", initAdminCustomerFilters);
  document.addEventListener("astro:after-swap", initAdminCustomerFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAdminCustomerFilters();
  }
</script>
