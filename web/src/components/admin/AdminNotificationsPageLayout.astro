---
import type { AdminDashboardData } from "@/lib/admin-dashboard/data";
import type { AdminActionFeedback } from "@/lib/admin-dashboard/actions";
import PageAvailabilityNotice from "@/components/dashboard/PageAvailabilityNotice.astro";
import RouteBackButton from "@/components/dashboard/RouteBackButton.astro";
import {
  getUnreadAdminInquiryIds,
  getUnreadAdminOrderIds,
  getUnreadAdminResellerApplicationIds,
} from "@/lib/admin-dashboard/notifications";
import { adminDashboardRoutes } from "@/config/navigation";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getDashboardPageAvailability } from "@/lib/page-availability";

type Props = {
  title: string;
  description: string;
  heading: string;
  intro: string;
  backUrl?: string;
  backLabel?: string;
  feedback?: AdminActionFeedback;
  dashboardData?: AdminDashboardData;
  contentMaxWidth?: string;
  fullHeight?: boolean;
};

const {
  title,
  description,
  heading,
  intro,
  backUrl,
  backLabel,
  feedback,
  dashboardData,
  contentMaxWidth = "48rem",
  fullHeight = false,
} = Astro.props;
const headingId = `${heading
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "")}-title`;
const unreadOrderCount = dashboardData ? getUnreadAdminOrderIds(dashboardData).length : 0;
const unreadInquiryCount = dashboardData ? getUnreadAdminInquiryIds(dashboardData).length : 0;
const unreadResellerApplicationCount = dashboardData
  ? getUnreadAdminResellerApplicationIds(dashboardData).length
  : 0;
const unreadNotificationCount =
  unreadOrderCount + unreadInquiryCount + unreadResellerApplicationCount;
const pageAvailability = getDashboardPageAvailability(Astro.url.pathname);
const isPageReady = pageAvailability.status === "ready";
---

<DashboardLayout
  title={title}
  description={description}
  navLabel="Admin operations"
  navItems={adminDashboardRoutes}
  sidebarUnreadBadges={{
    "/admin/orders": {
      count: unreadOrderCount,
    },
    "/admin/inquiries": {
      count: unreadInquiryCount,
    },
    "/admin/reseller-applications": {
      count: unreadResellerApplicationCount,
    },
    "/admin/notifications": {
      count: unreadNotificationCount,
    },
  }}
>
  <div
    class:list={[
      "admin-notifications-page",
      fullHeight && "admin-notifications-page--full-height",
    ]}
    data-admin-record-page={fullHeight || undefined}
    data-admin-notifications-page
  >
    <div
      class="admin-notifications-page__inner"
      style={`max-width: ${contentMaxWidth};`}
    >
      <div class="admin-notifications-page__sticky">
        <header class="admin-notifications-page__header">
          <div class="admin-notifications-page__heading-row">
            {backUrl && (
              <RouteBackButton href={backUrl} label={backLabel ?? `Back from ${heading}`} />
            )}
            <div class="admin-notifications-page__heading-copy">
              <h1 id={headingId} class="admin-notifications-page__title">{heading}</h1>
              <p class="admin-notifications-page__intro">{intro}</p>
            </div>
          </div>
        </header>

        {
          feedback?.status && (
            <p class="status-message" role="status">
              {feedback.status}
            </p>
          )
        }
        {
          feedback?.error && (
            <p class="error-message" role="alert">
              {feedback.error}
            </p>
          )
        }
      </div>

      <div class="admin-notifications-page__content">
        {isPageReady ? <slot /> : <PageAvailabilityNotice availability={pageAvailability} />}
      </div>
    </div>
  </div>
</DashboardLayout>

{
  feedback?.cleanPath && (
    <script is:inline define:vars={{ adminFeedbackCleanPath: feedback.cleanPath }}>
      if (typeof adminFeedbackCleanPath === "string" && window.history.replaceState) {
        window.history.replaceState(window.history.state, "", adminFeedbackCleanPath);
      }
    </script>
  )
}

<style>
  :global(.dashboard-body:has([data-admin-record-page])) {
    height: 100vh;
    overflow: hidden;
  }

  :global(.dashboard-frame:has([data-admin-record-page])) {
    height: 100vh;
    min-height: 0;
    overflow: hidden;
  }

  :global(.dashboard-main:has([data-admin-record-page])) {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    max-height: 100vh;
    overflow: hidden;
    padding: 0;
  }

  .admin-notifications-page {
    width: 100%;
    min-height: 100%;
    padding: 2rem 1rem 3rem;
  }

  .admin-notifications-page--full-height {
    display: flex;
    flex: 1;
    flex-direction: column;
    width: 100%;
    min-height: 0;
    height: 100%;
    overflow: hidden;
    padding: 0;
  }

  .admin-notifications-page__inner {
    width: 100%;
    margin: 0 auto;
    padding: 2rem 1.25rem 2.5rem;
    background: #ffffff;
  }

  .admin-notifications-page--full-height .admin-notifications-page__inner {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    height: 100%;
    margin: 0 auto;
    padding: 0;
    background: #ffffff;
  }

  .admin-notifications-page__sticky {
    flex-shrink: 0;
  }

  .admin-notifications-page--full-height .admin-notifications-page__sticky {
    padding: 1.5rem 1.25rem 0;
  }

  .admin-notifications-page__header {
    margin-bottom: 1.75rem;
  }

  .admin-notifications-page--full-height .admin-notifications-page__header {
    margin-bottom: 1.25rem;
  }

  .admin-notifications-page__heading-row {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .admin-notifications-page__heading-copy {
    min-width: 0;
    flex: 1;
  }

  .admin-notifications-page__title {
    margin: 0;
    font-size: clamp(1.4rem, 1.9vw, 1.85rem);
    line-height: 1;
    font-weight: 700;
    color: #000000;
    letter-spacing: -0.025em;
  }

  .admin-notifications-page__intro {
    margin: 0.4rem 0 0;
    max-width: none;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-brand-muted-black);
  }

  .admin-notifications-page__content {
    display: grid;
    gap: 1rem;
  }

  .admin-notifications-page--full-height .admin-notifications-page__content {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0 1.25rem 1.5rem;
    -webkit-overflow-scrolling: touch;
  }

  .admin-notifications-page :global(.status-message),
  .admin-notifications-page :global(.error-message) {
    margin: 0 0 1rem;
  }

  .admin-notifications-page--full-height :global(.status-message),
  .admin-notifications-page--full-height :global(.error-message) {
    margin: 0 0 0.75rem;
  }
</style>
