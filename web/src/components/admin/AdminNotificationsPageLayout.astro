---
import type { AdminDashboardData } from "@/lib/admin-dashboard/data";
import type { AdminActionFeedback } from "@/lib/admin-dashboard/actions";
import PageAvailabilityNotice from "@/components/dashboard/PageAvailabilityNotice.astro";
import RouteBackButton from "@/components/dashboard/RouteBackButton.astro";
import {
  getUnreadAdminInquiryIds,
  getUnreadAdminOrderIds,
  getUnreadAdminResellerApplicationIds,
} from "@/lib/admin-dashboard/notifications";
import { adminDashboardRoutes } from "@/config/navigation";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getDashboardPageAvailability } from "@/lib/page-availability";

type Props = {
  title: string;
  description: string;
  heading: string;
  intro?: string;
  backUrl?: string;
  backLabel?: string;
  feedback?: AdminActionFeedback;
  dashboardData?: AdminDashboardData;
  contentMaxWidth?: string;
  fullHeight?: boolean;
};

const {
  title,
  description,
  heading,
  intro,
  backUrl,
  backLabel,
  feedback,
  dashboardData,
  contentMaxWidth = "48rem",
  fullHeight = false,
} = Astro.props;
const headingId = `${heading
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "")}-title`;
const unreadOrderCount = dashboardData ? getUnreadAdminOrderIds(dashboardData).length : 0;
const unreadInquiryCount = dashboardData ? getUnreadAdminInquiryIds(dashboardData).length : 0;
const unreadResellerApplicationCount = dashboardData
  ? getUnreadAdminResellerApplicationIds(dashboardData).length
  : 0;
const unreadNotificationCount =
  unreadOrderCount + unreadInquiryCount + unreadResellerApplicationCount;
const pageAvailability = getDashboardPageAvailability(Astro.url.pathname);
const isPageReady = pageAvailability.status === "ready";
const hasHeadingMeta = Astro.slots.has("heading-meta");
const hasHeadingAside = Astro.slots.has("heading-aside");
---

<DashboardLayout
  title={title}
  description={description}
  navLabel="Admin operations"
  navItems={adminDashboardRoutes}
  sidebarUnreadBadges={{
    "/admin/orders": {
      count: unreadOrderCount,
    },
    "/admin/inquiries": {
      count: unreadInquiryCount,
    },
    "/admin/reseller-applications": {
      count: unreadResellerApplicationCount,
    },
    "/admin/notifications": {
      count: unreadNotificationCount,
    },
  }}
>
  <div
    class="admin-notifications-page"
    data-dashboard-record-page
    data-admin-record-page
    data-admin-notifications-page
  >
    <div
      class="admin-notifications-page__inner"
      style={`max-width: ${contentMaxWidth};`}
    >
      <header class="admin-notifications-page__header">
        <div class="admin-notifications-page__heading-row">
          {backUrl && (
            <RouteBackButton href={backUrl} label={backLabel ?? `Back from ${heading}`} />
          )}
          <div
            class:list={[
              "admin-notifications-page__heading-main",
              hasHeadingAside && "admin-notifications-page__heading-main--with-aside",
            ]}
          >
            <div class="admin-notifications-page__heading-copy">
              <h1 id={headingId} class="admin-notifications-page__title">{heading}</h1>
              {
                hasHeadingMeta ? (
                  <div class="admin-notifications-page__heading-meta">
                    <slot name="heading-meta" />
                  </div>
                ) : (
                  intro && <p class="admin-notifications-page__intro">{intro}</p>
                )
              }
            </div>
            {
              hasHeadingAside && (
                <div class="admin-notifications-page__heading-aside">
                  <slot name="heading-aside" />
                </div>
              )
            }
          </div>
        </div>
      </header>

      {
        feedback?.status && (
          <p class="status-message" role="status">
            {feedback.status}
          </p>
        )
      }
      {
        feedback?.error && (
          <p class="error-message" role="alert">
            {feedback.error}
          </p>
        )
      }

      <div class="admin-notifications-page__content">
        {isPageReady ? <slot /> : <PageAvailabilityNotice availability={pageAvailability} />}
      </div>
    </div>
  </div>
</DashboardLayout>

{
  feedback?.cleanPath && (
    <script is:inline define:vars={{ adminFeedbackCleanPath: feedback.cleanPath }}>
      if (typeof adminFeedbackCleanPath === "string" && window.history.replaceState) {
        window.history.replaceState(window.history.state, "", adminFeedbackCleanPath);
      }
    </script>
  )
}

<style>
  .admin-notifications-page__heading-row {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .admin-notifications-page__heading-main {
    min-width: 0;
    flex: 1;
  }

  .admin-notifications-page__heading-main--with-aside {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .admin-notifications-page__heading-copy {
    min-width: 0;
    flex: 1;
  }

  .admin-notifications-page__heading-aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.45rem;
    flex-shrink: 0;
    padding-top: 0.15rem;
  }

  .admin-notifications-page__title {
    margin: 0;
    font-size: clamp(1.4rem, 1.9vw, 1.85rem);
    line-height: 1;
    font-weight: 700;
    color: #000000;
    letter-spacing: -0.025em;
  }

  .admin-notifications-page__intro {
    margin: 0.4rem 0 0;
    max-width: none;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-brand-muted-black);
  }

  .admin-notifications-page__heading-meta {
    margin-top: 0.65rem;
  }

  .admin-notifications-page__heading-meta :global(.record-meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .admin-notifications-page__heading-meta :global(.record-meta__item) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--color-brand-muted-black);
  }

  .admin-notifications-page__heading-meta :global(.record-meta__item--wide) {
    flex: 1 1 100%;
    align-items: flex-start;
  }

  .admin-notifications-page__heading-meta :global(.record-meta__icon) {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
    color: #6b7280;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .admin-notifications-page__heading-meta :global(.record-meta__item--wide .record-meta__icon) {
    margin-top: 0.15rem;
  }

  .admin-notifications-page__heading-meta :global(.record-meta__text) {
    min-width: 0;
    white-space: pre-line;
  }
</style>
