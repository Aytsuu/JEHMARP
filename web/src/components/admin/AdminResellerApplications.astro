---
import type { AdminResellerApplicationManagementData } from "@/lib/admin-dashboard/data";
import type { AdminResellerApplicationFilters } from "@/lib/admin-dashboard/reseller-application-filters";
import { selected } from "@/lib/admin-dashboard/view";
import { autoCapitalize } from "@/lib/formatters";

type Props = {
  data: AdminResellerApplicationManagementData;
  applicationStatuses: readonly string[];
  activeFilters: AdminResellerApplicationFilters;
  filterQuery: string;
};

const { data, applicationStatuses, activeFilters, filterQuery } = Astro.props;
const skeletonRows = Array.from({ length: 6 });
---

<section class="admin-panel" aria-labelledby="admin-reseller-applications-title">
  <div data-interactive-table>
    <div class="table-filters order-management-toolbar">
      <form method="get" action="/admin/reseller-applications" class="order-filter-form" data-reseller-filter-form data-current-filter-query={filterQuery} aria-label="Filter reseller applications">
        <label class="order-filter-form__field order-filter-form__field--search">
          <span>Search</span>
          <input name="search" type="search" value={activeFilters.search ?? ""} placeholder="Search applicant name, email, or contact..." autocomplete="off" data-reseller-search-input />
        </label>
        <label class="order-filter-form__field">
          <span>Status</span>
          <select name="status">
            <option value="">All statuses</option>
            {applicationStatuses.map((status) => (
              <option value={status} selected={activeFilters.status === status}>{autoCapitalize(status)}</option>
            ))}
          </select>
        </label>
      </form>
      <div class="order-management-toolbar__actions">
      </div>
    </div>
    <div data-reseller-table-shell>
      <div class="table-wrap">
        <table style="table-layout: fixed; width: 100%;">
          <thead><tr><th scope="col" style="width: 15%; padding: 1.1rem 0.75rem;">Applicant</th><th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Email</th><th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Contact</th><th scope="col" style="width: 12%; padding: 1.1rem 0.75rem;">Supply Needs</th><th scope="col" style="width: 21%; padding: 1.1rem 0.75rem;">Message</th><th scope="col" style="width: 12%; padding: 1.1rem 0.75rem;">Status</th><th scope="col" style="width: 8%; padding: 1.1rem 0.75rem;"><span class="sr-only">Email Status</span></th></tr></thead>
          <tbody>
            {data.resellerApplications.length === 0 ? (
              <tr class="empty-row">
                <td colspan="7" class="empty-state">No reseller applications match the selected filters.</td>
              </tr>
            ) : data.resellerApplications.map((application) => {
              const isUnread = !application.admin_read_at && application.application_status === "submitted";
              return (
                <tr data-status={application.application_status}>
                  <td style="width: 15%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><div style="display: flex; align-items: center; gap: 0.5rem; width: 100%; overflow: hidden;"><span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500;">{application.name}</span>{isUnread && (<form method="post" class="unread-record-form" style="margin: 0; display: inline-flex; align-items: center; flex-shrink: 0;"><input type="hidden" name="action" value="mark-reseller-application-read" /><input type="hidden" name="applicationId" value={application.id} /><button type="submit" class="unread-record-button" style="border: none; background: transparent; padding: 0; cursor: pointer; display: inline-flex; align-items: center;"><span class="record-unread-dot" aria-label="Unread" style="width: 8px; height: 8px; background-color: var(--color-brand-red); border-radius: 50%; display: inline-block;"></span><span class="sr-only">Mark reseller application as read</span></button></form>)}</div></td>
                  <td style="width: 16%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{application.email}</td>
                  <td style="width: 16%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{application.contact_number}</td>
                  <td style="width: 12%; padding: 1.1rem 0.75rem; vertical-align: middle;">{application.expected_quantity_per_week}</td>
                  <td style="width: 21%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title={application.message ?? "No message"}>{application.message ?? "-"}</td>
                  <td style="width: 12%; padding: 1.1rem 0.75rem; vertical-align: middle;"><button type="button" class="table-cell-trigger" data-open-cell-popover data-popover-title={`Edit Status: ${application.name}`} style="width: 100%; text-align: left; display: block; overflow: hidden; cursor: pointer;"><span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; color: inherit; font-weight: inherit;">{autoCapitalize(application.application_status)}</span></button><div class="hidden-popover-form-holder" style="display: none;"><form method="post" class="admin-table-form"><input type="hidden" name="action" value="update-reseller-application" /><input type="hidden" name="applicationId" value={application.id} /><label><span>Status</span><select name="applicationStatus" required>{applicationStatuses.map((status) => (<option value={status} selected={selected(application.application_status, status)}>{autoCapitalize(status)}</option>))}</select></label><button type="submit">Save status</button></form></div></td>
                  <td style="width: 8%; padding: 1.1rem 0.75rem; vertical-align: middle; text-align: center;">{application.email_delivery_status === "sent" ? (<div title="Price list sent to email" style="display: inline-flex; align-items: center; justify-content: center; color: #10b981; cursor: help;"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h9"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/><path d="m16 19 2 2 4-4"/></svg></div>) : application.email_delivery_status === "failed" ? (<div title="Failed to send the price list to email" style="display: inline-flex; align-items: center; justify-content: center; color: #ef4444; cursor: help;"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10.5V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h12.5"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/><path d="M20 14v4"/><path d="M20 22v.01"/></svg></div>) : (<div title="Sending price list email..." style="display: inline-flex; align-items: center; justify-content: center; color: #6b7280; cursor: help;"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></div>)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
    <div class="table-pagination"><div class="table-pagination__summary"><span data-page-info></span><label class="table-pagination__limit"><select data-limit-select><option value="10">10 rows</option><option value="50">50 rows</option><option value="100">100 rows</option></select></label></div><div class="table-pagination__controls"><button type="button" data-pagination-prev class="btn-secondary"><svg class="table-pagination__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button><div data-pagination-numbers class="table-pagination__numbers"></div><button type="button" data-pagination-next class="btn-secondary"><svg class="table-pagination__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button></div></div>
  </div>
  <template data-reseller-filter-skeleton><div class="table-wrap" aria-busy="true" aria-live="polite"><table class="product-table-skeleton" style="table-layout: fixed; width: 100%;"><caption class="sr-only">Loading filtered reseller applications</caption><thead><tr><th scope="col">Applicant</th><th scope="col">Email</th><th scope="col">Contact</th><th scope="col">Supply Needs</th><th scope="col">Message</th><th scope="col">Status</th><th scope="col">Email Status</th></tr></thead><tbody>{skeletonRows.map(() => (<tr><td><span class="table-skeleton-block"></span></td><td><span class="table-skeleton-block"></span></td><td><span class="table-skeleton-block"></span></td><td><span class="table-skeleton-block table-skeleton-block--short"></span></td><td><span class="table-skeleton-block"></span></td><td><span class="table-skeleton-block table-skeleton-block--short"></span></td><td><span class="table-skeleton-block table-skeleton-block--short"></span></td></tr>))}</tbody></table></div></template>
</section>

<script>
  function initAdminResellerFilters() {
    const form = document.querySelector<HTMLFormElement>("[data-reseller-filter-form]");
    const tableShell = document.querySelector<HTMLElement>("[data-reseller-table-shell]");
    const skeletonTemplate = document.querySelector<HTMLTemplateElement>("[data-reseller-filter-skeleton]");
    if (!form || !tableShell || !skeletonTemplate) return;
    if (form.dataset.resellerFilterInitialized === "true") return;
    form.dataset.resellerFilterInitialized = "true";
    const activeForm = form, activeTableShell = tableShell, activeSkeletonTemplate = skeletonTemplate;
    const cacheKey = "admin-reseller-filter-cache-v1", fragmentPath = "/admin/reseller-applications-fragment";
    const filterKeys = ["search", "status"] as const;
    const autoSubmitFields = activeForm.querySelectorAll<HTMLSelectElement>("select");
    const searchInput = activeForm.querySelector<HTMLInputElement>("[data-reseller-search-input]");
    let submitTimer: number | undefined, searchTimer: number | undefined, activeFetchController: AbortController | undefined;
    function readCache(): string[] { try { const parsed = JSON.parse(sessionStorage.getItem(cacheKey) || "[]"); return Array.isArray(parsed) ? parsed.filter((value): value is string => typeof value === "string") : []; } catch { return []; } }
    function writeCache(values: string[]) { sessionStorage.setItem(cacheKey, JSON.stringify([...new Set(values)])); }
    function normalizeParams(params: URLSearchParams) { const normalized = new URLSearchParams(); filterKeys.forEach((key) => { const value = params.get(key)?.trim(); if (value) normalized.set(key, value); }); return normalized.toString(); }
    function normalizeFormQuery() { const params = new URLSearchParams(); const formData = new FormData(activeForm); filterKeys.forEach((key) => { const value = formData.get(key); if (typeof value === "string" && value.trim()) params.set(key, value.trim()); }); return params.toString(); }
    function buildUrl(path: string, targetQuery: string) { return targetQuery ? `${path}?${targetQuery}` : path; }
    function showSkeletonForQuery(targetQuery: string) { const currentQuery = normalizeParams(new URLSearchParams(window.location.search)); const cachedQueries = readCache(); if (targetQuery === currentQuery || cachedQueries.includes(targetQuery)) return; const skeleton = activeSkeletonTemplate.content.firstElementChild?.cloneNode(true); if (skeleton) activeTableShell.replaceChildren(skeleton); }
    function replaceFragment(fragmentHtml: string) { const parsed = new DOMParser().parseFromString(fragmentHtml, "text/html"); const nextTableShell = parsed.querySelector<HTMLElement>("[data-reseller-table-shell]"); if (!nextTableShell) throw new Error("Reseller applications fragment did not include a table."); activeTableShell.innerHTML = nextTableShell.innerHTML; document.dispatchEvent(new Event("dashboard:interactive-table-updated")); }
    async function applyFilters(targetQuery: string) { const currentQuery = normalizeParams(new URLSearchParams(window.location.search)); if (targetQuery === currentQuery) return; showSkeletonForQuery(targetQuery); activeFetchController?.abort(); const fetchController = new AbortController(); activeFetchController = fetchController; try { const response = await fetch(buildUrl(fragmentPath, targetQuery), { headers: { "X-Requested-With": "fetch" }, signal: fetchController.signal }); if (!response.ok) throw new Error(`Reseller application filters failed with ${response.status}.`); const fragmentHtml = await response.text(); window.history.replaceState({ resellerFilterQuery: targetQuery }, "", buildUrl("/admin/reseller-applications", targetQuery)); replaceFragment(fragmentHtml); activeForm.dataset.currentFilterQuery = targetQuery; writeCache([...readCache(), targetQuery]); } catch (error) { if (error instanceof DOMException && error.name === "AbortError") return; window.location.href = buildUrl("/admin/reseller-applications", targetQuery); } finally { if (activeFetchController === fetchController) activeFetchController = undefined; } }
    function submitFilters() { window.clearTimeout(submitTimer); submitTimer = window.setTimeout(() => { void applyFilters(normalizeFormQuery()); }, 120); }
    writeCache([...readCache(), normalizeParams(new URLSearchParams(window.location.search))]);
    activeForm.addEventListener("submit", (event) => { event.preventDefault(); void applyFilters(normalizeFormQuery()); });
    autoSubmitFields.forEach((field) => field.addEventListener("change", submitFilters));
    searchInput?.addEventListener("input", () => { window.clearTimeout(searchTimer); searchTimer = window.setTimeout(submitFilters, 450); });
  }
  document.addEventListener("DOMContentLoaded", initAdminResellerFilters);
  document.addEventListener("astro:after-swap", initAdminResellerFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") initAdminResellerFilters();
</script>
