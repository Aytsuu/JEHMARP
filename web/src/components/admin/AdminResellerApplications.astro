---
import type { AdminDashboardData } from "@/lib/admin-dashboard/data";
import { selected } from "@/lib/admin-dashboard/view";
import { autoCapitalize } from "@/lib/formatters";

type Props = {
  data: AdminDashboardData;
  applicationStatuses: readonly string[];
};

const { data, applicationStatuses } = Astro.props;
---

<section
  class="admin-panel"
  aria-labelledby="admin-reseller-applications-title"
>
  {
    data.resellerApplications.length > 0 ? (
      <div data-interactive-table>
        <div class="table-filters">
          <div style="flex: 1; min-width: 15rem;">
            <input type="text" placeholder="Search applications..." data-search-input style="width: 100%;" />
          </div>
          <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 0.35rem;">
              <span style="font-size: 0.9rem; color: var(--color-brand-muted-black);">Show</span>
              <select data-limit-select>
                <option value="10">10</option>
                <option value="50">50</option>
                <option value="100">100</option>
              </select>
            </div>
          </div>
        </div>

        <div class="table-wrap">
          <table style="table-layout: fixed; width: 100%;">
            <thead>
              <tr>
                <th scope="col" style="width: 15%; padding: 1.1rem 0.75rem;">Applicant</th>
                <th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Email</th>
                <th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Contact</th>
                <th scope="col" style="width: 12%; padding: 1.1rem 0.75rem;">Supply Needs</th>
                <th scope="col" style="width: 21%; padding: 1.1rem 0.75rem;">Message</th>
                <th scope="col" style="width: 12%; padding: 1.1rem 0.75rem;">Status</th>
                <th scope="col" style="width: 8%; padding: 1.1rem 0.75rem;"><span class="sr-only">Email Status</span></th>
              </tr>
            </thead>
            <tbody>
              {data.resellerApplications.map((application) => {
                const isUnread =
                  !application.admin_read_at &&
                  application.application_status === "submitted";

                return (
                  <tr data-status={application.application_status}>
                    <!-- 1. Applicant Column -->
                    <td style="width: 15%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                      <div style="display: flex; align-items: center; gap: 0.5rem; width: 100%; overflow: hidden;">
                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500;">
                          {application.name}
                        </span>
                        {isUnread && (
                          <form method="post" class="unread-record-form" style="margin: 0; display: inline-flex; align-items: center; flex-shrink: 0;">
                            <input
                              type="hidden"
                              name="action"
                              value="mark-reseller-application-read"
                            />
                            <input
                              type="hidden"
                              name="applicationId"
                              value={application.id}
                            />
                            <button type="submit" class="unread-record-button" style="border: none; background: transparent; padding: 0; cursor: pointer; display: inline-flex; align-items: center;">
                              <span class="record-unread-dot" aria-label="Unread" style="width: 8px; height: 8px; background-color: var(--color-brand-red); border-radius: 50%; display: inline-block;"></span>
                              <span class="sr-only">Mark reseller application as read</span>
                            </button>
                          </form>
                        )}
                      </div>
                    </td>

                    <!-- 2. Email Column -->
                    <td style="width: 16%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                      {application.email}
                    </td>

                    <!-- 3. Contact Column -->
                    <td style="width: 16%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                      {application.contact_number}
                    </td>

                    <!-- 4. Supply Needs Column -->
                    <td style="width: 12%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                      {application.expected_quantity_per_week}
                    </td>

                    <!-- 5. Message Column -->
                    <td style="width: 21%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title={application.message ?? "No message"}>
                      {application.message ?? "—"}
                    </td>

                    <!-- 6. Status Column -->
                    <td style="width: 12%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                      <form method="post" class="admin-table-form" style="margin: 0; width: 100%;">
                        <input
                          type="hidden"
                          name="action"
                          value="update-reseller-application"
                        />
                        <input
                          type="hidden"
                          name="applicationId"
                          value={application.id}
                        />
                        <select
                          name="applicationStatus"
                          onchange="this.form.submit()"
                          required
                          style="padding: 0.25rem 0.5rem; font-size: 0.9rem; border-radius: 0.375rem; border: 1px solid #d1d5db; background-color: #ffffff; cursor: pointer; width: 100%;"
                        >
                          {applicationStatuses.map((status) => (
                            <option
                              value={status}
                              selected={selected(
                                application.application_status,
                                status,
                              )}
                            >
                              {autoCapitalize(status)}
                            </option>
                          ))}
                        </select>
                      </form>
                    </td>

                    <!-- 7. Blank (right-most) Column: Email Delivery Status Tooltip Icon -->
                    <td style="width: 8%; padding: 1.1rem 0.75rem; vertical-align: middle; text-align: center;">
                      {application.email_delivery_status === "sent" ? (
                        <div title="Price list sent to email" style="display: inline-flex; align-items: center; justify-content: center; color: #10b981; cursor: help;">
                          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail-check"><path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h9"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/><path d="m16 19 2 2 4-4"/></svg>
                        </div>
                      ) : application.email_delivery_status === "failed" ? (
                        <div title="Failed to send the price list to email" style="display: inline-flex; align-items: center; justify-content: center; color: #ef4444; cursor: help;">
                          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail-warning"><path d="M22 10.5V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h12.5"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/><path d="M20 14v4"/><path d="M20 22v.01"/></svg>
                        </div>
                      ) : (
                        <div title="Sending price list email..." style="display: inline-flex; align-items: center; justify-content: center; color: #6b7280; cursor: help;">
                          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        </div>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <div class="table-pagination">
          <span data-page-info style="font-size: 0.9rem; color: var(--color-brand-muted-black); font-weight: 500;"></span>
          <div style="display: flex; gap: 0.25rem; align-items: center;">
            <button type="button" data-pagination-prev class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&lt;</button>
            <div data-pagination-numbers style="display: flex; gap: 0.25rem;"></div>
            <button type="button" data-pagination-next class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&gt;</button>
          </div>
        </div>
      </div>
    ) : (
      <p class="empty-state">
        No reseller applications have been submitted yet.
      </p>
    )
  }
</section>
