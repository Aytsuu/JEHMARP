---
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import DashboardTableEmptyState from "@/components/dashboard/DashboardTableEmptyState.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import ResellerEmailDeliveryStatus from "@/components/admin/ResellerEmailDeliveryStatus.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import type { AdminResellerApplicationManagementData } from "@/lib/admin-dashboard/data";
import type { AdminResellerApplicationFilters } from "@/lib/admin-dashboard/reseller-application-filters";
import { selected } from "@/lib/admin-dashboard/view";
import { autoCapitalize } from "@/lib/formatters";

type Props = {
  data: AdminResellerApplicationManagementData;
  applicationStatuses: readonly string[];
  activeFilters: AdminResellerApplicationFilters;
  filterQuery: string;
};

const { data, applicationStatuses, activeFilters, filterQuery } = Astro.props;
const skeletonRows = Array.from({ length: 6 });
---

<section class="admin-panel" aria-labelledby="admin-reseller-applications-title">
  <div data-interactive-table class="dashboard-interactive-table">
    <div class="table-filters order-management-toolbar">
      <form method="get" action="/admin/reseller-applications" class="order-filter-form" data-reseller-filter-form data-current-filter-query={filterQuery} aria-label="Filter reseller applications">
        <div class="order-filter-form__field order-filter-form__field--search">
          <input name="search" type="search" value={activeFilters.search ?? ""} placeholder="Search applicant name, email, or contact..." autocomplete="off" aria-label="Search reseller applications" data-reseller-search-input />
        </div>
        <div class="order-filter-form__field">
          <select name="status" aria-label="Filter by status">
            <option value="">All statuses</option>
            {applicationStatuses.map((status) => (
              <option value={status} selected={activeFilters.status === status}>{autoCapitalize(status)}</option>
            ))}
          </select>
        </div>
      </form>
      <div class="order-management-toolbar__actions">
      </div>
    </div>
    <div data-reseller-table-shell class="dashboard-interactive-table__surface">
      <DashboardTableBoard>
        <table class="dashboard-table">
          <thead>
            <tr>
              <th scope="col">Applicant</th>
              <th scope="col">Email</th>
              <th scope="col">Contact</th>
              <th scope="col">Supply Needs</th>
              <th scope="col">Message</th>
              <th scope="col">Status</th>
              <th scope="col"><span class="sr-only">Email Status</span></th>
            </tr>
          </thead>
          <tbody>
            {data.resellerApplications.length === 0 ? (
              <DashboardTableEmptyState
                colspan={7}
                message="No reseller applications match the selected filters."
              />
            ) : data.resellerApplications.map((application) => {
              const isUnread = !application.admin_read_at && application.application_status === "submitted";
              return (
                <tr
                  data-status={application.application_status}
                  data-application-id={application.id}
                  {...(isUnread ? { "data-reseller-unread": "true" } : {})}
                >
                  <td class="dashboard-table__cell--truncate">{application.name}</td>
                  <td class="dashboard-table__cell--truncate">{application.email}</td>
                  <td class="dashboard-table__cell--truncate">{application.contact_number}</td>
                  <td>{application.expected_quantity_per_week}</td>
                  <td class="dashboard-table__cell--truncate" title={application.message ?? "No message"}>
                    {application.message ?? "-"}
                  </td>
                  <td>
                    <button
                      type="button"
                      class="table-cell-trigger"
                      data-open-cell-popover
                      data-popover-title={`Edit Status: ${application.name}`}
                    >
                      <StatusBadge kind="reseller" status={application.application_status} />
                    </button>
                    <div class="hidden-popover-form-holder">
                      <form method="post" class="admin-table-form">
                        <input type="hidden" name="action" value="update-reseller-application" />
                        <input type="hidden" name="applicationId" value={application.id} />
                        <label>
                          <span>Status</span>
                          <select name="applicationStatus" required>
                            {applicationStatuses.map((status) => (
                              <option value={status} selected={selected(application.application_status, status)}>
                                {autoCapitalize(status)}
                              </option>
                            ))}
                          </select>
                        </label>
                        <button type="submit">Save status</button>
                      </form>
                    </div>
                  </td>
                  <td class="dashboard-table__cell--center">
                    <ResellerEmailDeliveryStatus
                      status={application.email_delivery_status}
                      error={application.email_error}
                    />
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </DashboardTableBoard>
    </div>
    <DashboardTablePagination />
  </div>
  <template data-reseller-filter-skeleton>
    <DashboardTableBoard aria-busy="true" aria-live="polite">
      <table class="product-table-skeleton dashboard-table">
        <caption class="sr-only">Loading filtered reseller applications</caption>
        <thead>
          <tr>
            <th scope="col">Applicant</th>
            <th scope="col">Email</th>
            <th scope="col">Contact</th>
            <th scope="col">Supply Needs</th>
            <th scope="col">Message</th>
            <th scope="col">Status</th>
            <th scope="col">Email Status</th>
          </tr>
        </thead>
        <tbody>
          {skeletonRows.map(() => (
            <tr>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </DashboardTableBoard>
  </template>
</section>

<script>
  import {
    readDashboardFragmentCache,
    writeDashboardFragmentCache,
  } from "@/lib/client/dashboard-fragment-cache";

  function initAdminResellerFilters() {
    const form = document.querySelector<HTMLFormElement>("[data-reseller-filter-form]");
    const tableShell = document.querySelector<HTMLElement>("[data-reseller-table-shell]");
    const skeletonTemplate = document.querySelector<HTMLTemplateElement>("[data-reseller-filter-skeleton]");
    if (!form || !tableShell || !skeletonTemplate) return;
    if (form.dataset.resellerFilterInitialized === "true") return;
    form.dataset.resellerFilterInitialized = "true";
    const activeForm = form, activeTableShell = tableShell, activeSkeletonTemplate = skeletonTemplate;
    const cacheKey = "admin-reseller-filter-cache-v1", fragmentPath = "/admin/reseller-applications-fragment";
    const filterKeys = ["search", "status"] as const;
    const autoSubmitFields = activeForm.querySelectorAll<HTMLSelectElement>("select");
    const searchInput = activeForm.querySelector<HTMLInputElement>("[data-reseller-search-input]");
    let submitTimer: number | undefined, searchTimer: number | undefined, activeFetchController: AbortController | undefined;
    function normalizeParams(params: URLSearchParams) { const normalized = new URLSearchParams(); filterKeys.forEach((key) => { const value = params.get(key)?.trim(); if (value) normalized.set(key, value); }); return normalized.toString(); }
    function normalizeFormQuery() { const params = new URLSearchParams(); const formData = new FormData(activeForm); filterKeys.forEach((key) => { const value = formData.get(key); if (typeof value === "string" && value.trim()) params.set(key, value.trim()); }); return params.toString(); }
    function buildUrl(path: string, targetQuery: string) { return targetQuery ? `${path}?${targetQuery}` : path; }
    function showSkeletonForQuery(targetQuery: string) { const currentQuery = normalizeParams(new URLSearchParams(window.location.search)); const cachedFragment = readDashboardFragmentCache(cacheKey, targetQuery); if (targetQuery === currentQuery || cachedFragment) return; const skeleton = activeSkeletonTemplate.content.firstElementChild?.cloneNode(true); if (skeleton) activeTableShell.replaceChildren(skeleton); }
    function replaceFragment(fragmentHtml: string) { const parsed = new DOMParser().parseFromString(fragmentHtml, "text/html"); const nextTableShell = parsed.querySelector<HTMLElement>("[data-reseller-table-shell]"); if (!nextTableShell) throw new Error("Reseller applications fragment did not include a table."); activeTableShell.innerHTML = nextTableShell.innerHTML; document.dispatchEvent(new Event("dashboard:interactive-table-updated")); document.dispatchEvent(new Event("dashboard:reseller-applications-table-updated")); }
    async function applyFilters(targetQuery: string) { const currentQuery = normalizeParams(new URLSearchParams(window.location.search)); if (targetQuery === currentQuery) return; const cachedFragment = readDashboardFragmentCache(cacheKey, targetQuery); if (cachedFragment) { window.history.replaceState({ resellerFilterQuery: targetQuery }, "", buildUrl("/admin/reseller-applications", targetQuery)); replaceFragment(cachedFragment); activeForm.dataset.currentFilterQuery = targetQuery; return; } showSkeletonForQuery(targetQuery); activeFetchController?.abort(); const fetchController = new AbortController(); activeFetchController = fetchController; try { const response = await fetch(buildUrl(fragmentPath, targetQuery), { headers: { "X-Requested-With": "fetch" }, signal: fetchController.signal }); const fragmentHtml = await window.readDashboardFragmentResponse(response); window.history.replaceState({ resellerFilterQuery: targetQuery }, "", buildUrl("/admin/reseller-applications", targetQuery)); replaceFragment(fragmentHtml); activeForm.dataset.currentFilterQuery = targetQuery; writeDashboardFragmentCache(cacheKey, targetQuery, fragmentHtml); } catch (error) { if (error instanceof DOMException && error.name === "AbortError") return; window.location.href = buildUrl("/admin/reseller-applications", targetQuery); } finally { if (activeFetchController === fetchController) activeFetchController = undefined; } }
    function submitFilters() { window.clearTimeout(submitTimer); submitTimer = window.setTimeout(() => { void applyFilters(normalizeFormQuery()); }, 120); }
    writeDashboardFragmentCache(cacheKey, normalizeParams(new URLSearchParams(window.location.search)), activeTableShell.outerHTML);
    activeForm.addEventListener("submit", (event) => { event.preventDefault(); void applyFilters(normalizeFormQuery()); });
    autoSubmitFields.forEach((field) => field.addEventListener("change", submitFilters));
    searchInput?.addEventListener("input", () => { window.clearTimeout(searchTimer); searchTimer = window.setTimeout(submitFilters, 450); });
  }
  document.addEventListener("DOMContentLoaded", initAdminResellerFilters);
  document.addEventListener("astro:after-swap", initAdminResellerFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") initAdminResellerFilters();

  function initResellerApplicationAutoRead() {
    const tableShell = document.querySelector<HTMLElement>("[data-reseller-table-shell]");
    if (!tableShell) return;
    const activeTableShell = tableShell;
    const interactiveTable = activeTableShell.closest<HTMLElement>("[data-interactive-table]");
    if (!interactiveTable) return;
    if (interactiveTable.dataset.resellerAutoReadInitialized === "true") return;
    interactiveTable.dataset.resellerAutoReadInitialized = "true";

    const markedApplicationIds = new Set<string>();
    let markRequestInFlight = false;

    function getVisibleUnreadApplicationIds() {
      return Array.from(
        activeTableShell.querySelectorAll<HTMLTableRowElement>("tr[data-reseller-unread='true']"),
      )
        .filter((row) => row.style.display !== "none")
        .map((row) => row.dataset.applicationId)
        .filter((id): id is string => typeof id === "string" && id.length > 0)
        .filter((id) => !markedApplicationIds.has(id));
    }

    function clearUnreadIndicators(applicationIds: string[]) {
      applicationIds.forEach((applicationId) => {
        const row = activeTableShell.querySelector<HTMLTableRowElement>(
          `tr[data-application-id="${applicationId}"]`,
        );
        if (!row) return;
        row.removeAttribute("data-reseller-unread");
      });
    }

    function adjustUnreadBadgeCount(href: string, delta: number) {
      const badge = document.querySelector<HTMLElement>(
        `.dashboard-sidebar a[href="${href}"] .dashboard-sidebar__nav-badge`,
      );
      if (!badge) return;

      const nextCount = Math.max(0, Number.parseInt(badge.textContent || "0", 10) + delta);
      badge.textContent = String(nextCount);
      badge.hidden = nextCount < 1;
    }

    async function markVisibleUnreadApplications() {
      const applicationIds = getVisibleUnreadApplicationIds();
      if (applicationIds.length === 0 || markRequestInFlight) return;

      applicationIds.forEach((applicationId) => markedApplicationIds.add(applicationId));
      markRequestInFlight = true;

      try {
        const response = await fetch("/admin/reseller-applications-mark-read.json", {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ applicationIds }),
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(
            typeof body.error === "string"
              ? body.error
              : "Unable to mark reseller applications as read.",
          );
        }

        const markedCount = typeof body.markedCount === "number" ? body.markedCount : applicationIds.length;
        clearUnreadIndicators(applicationIds);
        adjustUnreadBadgeCount("/admin/reseller-applications", -markedCount);
        adjustUnreadBadgeCount("/admin/notifications", -markedCount);
      } catch {
        applicationIds.forEach((applicationId) => markedApplicationIds.delete(applicationId));
      } finally {
        markRequestInFlight = false;
      }
    }

    const scheduleMarkVisibleUnread = () => {
      window.requestAnimationFrame(() => {
        void markVisibleUnreadApplications();
      });
    };

    interactiveTable.addEventListener("dashboard:interactive-table-page-changed", scheduleMarkVisibleUnread);
    document.addEventListener("dashboard:reseller-applications-table-updated", scheduleMarkVisibleUnread);
    document.addEventListener("dashboard:interactive-table-updated", scheduleMarkVisibleUnread);
    scheduleMarkVisibleUnread();
  }

  document.addEventListener("DOMContentLoaded", initResellerApplicationAutoRead);
  document.addEventListener("astro:after-swap", initResellerApplicationAutoRead);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initResellerApplicationAutoRead();
  }
</script>
