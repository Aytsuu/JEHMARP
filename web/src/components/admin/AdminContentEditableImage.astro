---
import Popover from "@/components/ui/Popover.astro";
import { jsonTextareaValue } from "@/lib/admin-dashboard/view";
import type { AdminContentEditingContext } from "@/lib/public-website/admin-content-editing";
import type { PublicPageSectionRecord } from "@/lib/public-website/content";

type Props = {
  contentEditing?: AdminContentEditingContext;
  section: PublicPageSectionRecord;
  imageSrc: string;
  imageAlt: string;
  displaySrc: string;
  imageClass?: string;
  popoverTitle?: string;
  categoryIndex?: number;
  class?: string;
};

const {
  contentEditing,
  section,
  imageAlt,
  displaySrc,
  imageClass,
  popoverTitle = "Replace Image",
  categoryIndex,
  class: className,
} = Astro.props;
---

{
  contentEditing ? (
    <div
      class:list={["admin-content-editable", "admin-content-editable--image", className]}
      data-page-section-image-editable
      data-section-id={section.id}
      {...categoryIndex !== undefined ? { "data-category-index": String(categoryIndex) } : {}}
    >
      <div class="admin-content-editable__surface">
        <img src={displaySrc} alt={imageAlt} class={imageClass} loading="lazy" decoding="async" />
      </div>
      <button
        type="button"
        class="admin-content-editable__trigger"
        data-open-cell-popover
        aria-label={popoverTitle}
      >
        <span class="admin-content-editable__overlay" aria-hidden="true">
          <span class="admin-content-editable__edit-label">Replace Image</span>
        </span>
      </button>
      <Popover
        title={popoverTitle}
        formEnctype="multipart/form-data"
        formClass="admin-image-upload-form"
        formDataAttributes={{ "data-image-upload-form": "" }}
      >
        <input type="hidden" name="action" value="save-page-section" />
        <input type="hidden" name="sectionId" value={section.id} />
        <input type="hidden" name="pageId" value={section.page_id} />
        <input type="hidden" name="type" value={section.type} />
        <input type="hidden" name="sortOrder" value={section.sort_order} />
        <input type="hidden" name="status" value={section.status} />
        <input type="hidden" name="returnPath" value={contentEditing.returnPath} />
        {
          categoryIndex !== undefined ? (
            <input type="hidden" name="categoryIndex" value={categoryIndex} />
          ) : null
        }
        <input
          type="hidden"
          name="currentContent"
          value={jsonTextareaValue(section.content)}
        />
        <label>
          <span>Upload new image</span>
          <input name="imageFile" type="file" accept="image/*" required />
        </label>
        <button slot="footer" type="submit" class="ui-popover__button-primary">
          Save image
        </button>
      </Popover>
    </div>
  ) : (
    <img src={displaySrc} alt={imageAlt} class={imageClass} loading="lazy" decoding="async" />
  )
}

<script>
  import { initPageSectionContentEditors } from "@/lib/client/page-section-content-editor";

  function init() {
    initPageSectionContentEditors();
  }

  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:after-swap", init);
  if (document.readyState !== "loading") {
    init();
  }
</script>
