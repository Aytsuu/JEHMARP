---
import type { AdminDashboardData } from "@/lib/admin-dashboard/data";
import ViewButton from "@/components/ViewButton.astro";
import {
  formatCurrency,
  formatDate,
  fullName,
  orderBalance,
  orderPaymentTotal,
  orderTotal,
} from "@/lib/admin-dashboard/view";

type Props = {
  data: AdminDashboardData;
};

const { data } = Astro.props;
const invoiceOrders = data.orders.filter((order) => order.invoice.length > 0);
---

<section id="admin-invoices" class="admin-panel" aria-labelledby="admin-invoices-title">
  {invoiceOrders.length === 0 ? (
    <p class="empty-state">No invoices have been created from orders yet.</p>
  ) : (
    <div data-interactive-table>
      <div class="table-filters">
        <div style="flex: 1; min-width: 15rem;">
          <input type="text" placeholder="Search invoices..." data-search-input style="width: 100%;" />
        </div>
        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
          <div style="display: flex; align-items: center; gap: 0.35rem;">
            <span style="font-size: 0.9rem; color: var(--color-brand-muted-black);">Show</span>
            <select data-limit-select>
              <option value="10">10</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </div>
        </div>
      </div>

      <div class="table-wrap">
        <table style="table-layout: fixed; width: 100%;">
          <thead>
            <tr>
              <th scope="col" style="width: 14.28%; padding: 1.1rem 0.75rem;">Invoice Number</th>
              <th scope="col" style="width: 14.28%; padding: 1.1rem 0.75rem;">Customer</th>
              <th scope="col" style="width: 14.28%; padding: 1.1rem 0.75rem;">Date</th>
              <th scope="col" style="width: 14.28%; padding: 1.1rem 0.75rem;">Invoice Total</th>
              <th scope="col" style="width: 14.28%; padding: 1.1rem 0.75rem;">Paid</th>
              <th scope="col" style="width: 14.28%; padding: 1.1rem 0.75rem;">Balance</th>
              <th scope="col" style="width: 14.28%; padding: 1.1rem 0.75rem;">Action</th>
            </tr>
          </thead>
          <tbody>
            {invoiceOrders.map((order) => {
              const invoice = order.invoice[0];
              const invoiceTotal = orderTotal(order, "final_quantity");
              const paidTotal = orderPaymentTotal(order);
              const balance = orderBalance(order);

              return (
                <tr data-status={order.payment_status}>
                  <td style="width: 14.28%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                    {invoice.invoice_number}
                  </td>
                  <td style="width: 14.28%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    {order.customer ? fullName(order.customer) : "Guest"}
                  </td>
                  <td style="width: 14.28%; padding: 1.1rem 0.75rem; vertical-align: middle;">{formatDate(invoice.created_at)}</td>
                  <td style="width: 14.28%; padding: 1.1rem 0.75rem; vertical-align: middle;">{formatCurrency(invoiceTotal)}</td>
                  <td style="width: 14.28%; padding: 1.1rem 0.75rem; vertical-align: middle;">{formatCurrency(paidTotal)}</td>
                  <td style="width: 14.28%; padding: 1.1rem 0.75rem; vertical-align: middle;">{formatCurrency(balance)}</td>
                  <td style="width: 14.28%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                    <ViewButton href={`/admin/invoices/${invoice.id}`} />
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div class="table-pagination">
        <span data-page-info style="font-size: 0.9rem; color: var(--color-brand-muted-black); font-weight: 500;"></span>
        <div style="display: flex; gap: 0.25rem; align-items: center;">
          <button type="button" data-pagination-prev class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&lt;</button>
          <div data-pagination-numbers style="display: flex; gap: 0.25rem;"></div>
          <button type="button" data-pagination-next class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&gt;</button>
        </div>
      </div>
    </div>
  )}
</section>
