---
import Accordion from "@/components/ui/Accordion.astro";
import ActionMenu from "@/components/ActionMenu.astro";
import Sheet from "@/components/ui/Sheet.astro";
import type { AdminOrderManagementData } from "@/lib/admin-dashboard/data";
import ViewButton from "@/components/ViewButton.astro";
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import DashboardTableEmptyState from "@/components/dashboard/DashboardTableEmptyState.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import type { AdminOrderFilters } from "@/lib/admin-dashboard/order-filters";
import { getAdminOrderStatusFilters, orderSources, paymentStatuses } from "@/lib/admin-dashboard/order-filters";
import { buildAdminOrderTargetOptions } from "@/lib/admin-dashboard/order-target-options";
import {
  formatCurrency,
  formatDate,
} from "@/lib/admin-dashboard/view";
import { autoCapitalize, formatOrderSource } from "@/lib/formatters";

type Props = {
  data: AdminOrderManagementData;
  activeFilters: AdminOrderFilters;
  filterQuery: string;
};

const { data, activeFilters, filterQuery } = Astro.props;
const defaultTime = new Intl.DateTimeFormat("en-GB", {
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
  timeZone: "Asia/Manila",
}).format(new Date());
const activeProducts = data.products.filter((product) => product.is_active);
const canCreateOrder = activeProducts.length > 0;
const customerPaymentNoticeMap = new Map<string, "unpaid" | "partial">();

for (const order of data.orders) {
  if (!order.customer_id) continue;
  if (customerPaymentNoticeMap.get(order.customer_id) === "unpaid") continue;
  if (order.payment_status === "unpaid") {
    customerPaymentNoticeMap.set(order.customer_id, "unpaid");
    continue;
  }
  if (order.payment_status === "partial") {
    customerPaymentNoticeMap.set(order.customer_id, "partial");
  }
}

const orderTargetOptions = buildAdminOrderTargetOptions({
  customers: data.customers,
  agents: data.agents,
  customerPaymentNoticeById: customerPaymentNoticeMap,
  customerBalances: data.customerBalances,
});
const orderStatuses = getAdminOrderStatusFilters();
const skeletonRows = Array.from({ length: 6 });
const orderRows = data.orderRows;
const orderActionPath = filterQuery ? `/admin/orders?${filterQuery}` : "/admin/orders";

function isPendingCustomerOrderRow(order: (typeof orderRows)[number]) {
  return order.row_type === "customer" && order.status === "pending";
}

function pendingCustomerOrderLabel(count: number) {
  return count === 1
    ? "1 customer order awaiting acceptance"
    : `${count} customer orders awaiting acceptance`;
}
---

<section id="admin-orders" class="admin-panel" aria-labelledby="admin-orders-title">
  <Sheet id="create-order-sheet" width="42rem">
    <div slot="header" class="order-create-sheet__header-copy">
      <h3 class="drawer-sheet__title" data-sheet-title>Create Order</h3>
      <p class="order-create-sheet__header-description">
        Select an existing customer or enter new customer details, then add the order items below.
      </p>
    </div>
    <form id="create-order-form" method="post" class="order-create-form" aria-label="Create order" data-astro-reload>
      <input type="hidden" name="action" value="create-order" />

      {!canCreateOrder && (
        <p class="empty-state">
          Add at least one active product before creating an admin order.
        </p>
      )}

      <section class="order-create-section">
        <div class="order-create-section__body">
          <div class="admin-form-grid order-create-form__existing-customer-grid">
            <label class="field-row">
              <p
                class="order-create-form__existing-customer-notice"
                hidden
                data-customer-order-notice
              ></p>
              <div class="order-customer-picker" data-customer-picker>
                <input
                  name="customerLookup"
                  autocomplete="off"
                  placeholder="Type a customer or agent name"
                  aria-label="Search customer or agent"
                  data-customer-search
                  data-customer-search-input
                />
                <button
                  type="button"
                  class="order-customer-picker__toggle"
                  aria-label="Show customer options"
                  aria-expanded="false"
                  data-customer-picker-toggle
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="order-customer-picker__menu" hidden data-customer-picker-menu>
                  <div class="order-customer-picker__options" data-customer-options></div>
                  <p class="order-customer-picker__empty" hidden data-customer-options-empty>
                    No customers or agents found.
                  </p>
                </div>
              </div>
              <input type="hidden" name="customerId" data-customer-id />
              <input type="hidden" name="agentId" data-agent-order-agent-id />
            </label>
          </div>
          <template data-customer-option-template>
            {orderTargetOptions.map((target) => (
              target.type === "customer" ? (
                <button
                  type="button"
                  class="order-customer-picker__option"
                  data-order-target-option
                  data-order-target-type="customer"
                  data-customer-id={target.customer.id}
                  data-customer-label={target.label}
                  data-customer-first-name={target.customer.first_name}
                  data-customer-last-name={target.customer.last_name}
                  data-customer-phone-number={target.customer.phone_number}
                  data-customer-email={target.customer.email ?? ""}
                  data-customer-address={target.customer.address}
                  data-customer-assigned-agent-id={target.customer.assigned_agent_id ?? ""}
                  data-customer-is-reseller={String(target.customer.is_reseller)}
                  data-customer-payment-notice={target.paymentNotice}
                  data-customer-balance={target.balance}
                  data-customer-credit-limit={target.creditLimit}
                  data-customer-credit-exceeded={String(target.creditExceeded)}
                >
                  {target.label} - Customer
                </button>
              ) : (
                <button
                  type="button"
                  class="order-customer-picker__option"
                  data-order-target-option
                  data-order-target-type="agent"
                  data-agent-id={target.agent.id}
                  data-customer-id=""
                  data-customer-label={target.label}
                  data-customer-phone-number={target.agent.contact ?? ""}
                  data-customer-email={target.agent.email ?? ""}
                  data-customer-first-name=""
                  data-customer-last-name=""
                  data-customer-address=""
                  data-customer-assigned-agent-id=""
                  data-customer-is-reseller="false"
                  data-customer-payment-notice=""
                  data-customer-balance="0"
                  data-customer-credit-limit="0"
                  data-customer-credit-exceeded="false"
                >
                  {target.label} - Agent
                </button>
              )
            ))}
          </template>
        </div>
      </section>

      <section class="order-create-section">
        <div class="order-create-section__body">
          <div class="admin-form-grid">
            <label class="field-row" hidden data-agent-order-fields>
              <span>Order type</span>
              <select name="agentOrderType" data-agent-order-type disabled>
                <option value="personal">Personal</option>
                <option value="distribution">Distribution</option>
              </select>
            </label>
          </div>
        </div>
      </section>

      <section class="order-create-section" data-new-customer-fields>
        <h3 class="order-create-section__title">Customer details</h3>
        <div class="order-create-section__body">
          <div class="admin-form-grid order-create-form__customer-grid">
            <div class="order-create-form__name-row">
              <label class="field-row"><span>First name</span><input name="firstName" required data-customer-first-name /></label>
              <label class="field-row"><span>Last name</span><input name="lastName" required data-customer-last-name /></label>
            </div>
            <label class="field-row"><span>Phone number</span><input name="phoneNumber" required data-customer-phone-number /></label>
            <label class="field-row"><span>Email</span><input name="email" type="email" data-customer-email /></label>
            <label class="field-row">
              <span>Agent</span>
              <select name="assignedAgentId" data-customer-assigned-agent-id>
                <option value="">None</option>
                {data.agents.map((agent) => (
                  <option value={agent.id}>{agent.display_name}</option>
                ))}
              </select>
            </label>
            <label class="checkbox-row">
              <input name="isReseller" type="checkbox" data-customer-is-reseller />
              <span>Reseller customer</span>
            </label>
          </div>
          <label class="field-row"><span>Address</span><textarea name="address" required data-customer-address></textarea></label>
        </div>
      </section>

      <section class="order-create-section">
        <div class="order-create-section__header">
          <h3 class="order-create-section__title">Order items</h3>
        </div>
        <div class="order-create-section__body">
          <div class="order-item-list" data-order-items>
            <Accordion class="order-item-accordion" open>
              <span slot="title" data-order-item-title>Select product</span>
              <button
                slot="actions"
                type="button"
                class="order-item-accordion__remove"
                data-remove-order-item
                aria-label="Remove item"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M3 6h18"></path>
                  <path d="M8 6V4h8v2"></path>
                  <path d="M19 6l-1 14H6L5 6"></path>
                  <path d="M10 11v6"></path>
                  <path d="M14 11v6"></path>
                </svg>
              </button>
              <div class="order-item-accordion__fields" data-order-item-row>
                <label class="field-row">
                  <span>Product</span>
                  <select name="productId" required disabled={activeProducts.length === 0} data-order-product-select>
                    <option value="">Select product</option>
                    {activeProducts.map((product) => (
                      <option
                        value={product.id}
                        data-product-name={product.name}
                        data-product-retail-price={product.default_price}
                        data-product-reseller-price={product.reseller_price}
                      >
                        {product.name} - retail {formatCurrency(product.default_price)} / reseller {formatCurrency(product.reseller_price)} per {product.unit_label}
                      </option>
                    ))}
                  </select>
                </label>
                <label class="field-row">
                  <span>Quantity</span>
                  <input name="quantity" type="number" min="0.001" step="0.001" required />
                </label>
                <label class="field-row">
                  <span>Details</span>
                  <textarea name="addDetails" placeholder="Cut, packing, or delivery notes"></textarea>
                </label>
              </div>
            </Accordion>
          </div>
          <button
            type="button"
            class="order-create-form__add-item"
            data-add-order-item
            disabled={!canCreateOrder}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 5v14"></path>
              <path d="M5 12h14"></path>
            </svg>
            <span>Add Item</span>
          </button>

          <div class="order-create-section order-create-section--subblock">
            <div class="order-create-section__header">
              <h3 class="order-create-section__title">Release</h3>
            </div>
            <div class="order-create-section__body">
              <div class="order-create-form__field-pair">
                <label class="field-row">
                  <span>Release date</span>
                  <input name="releaseDate" type="date" required data-release-date />
                </label>
                <label class="field-row">
                  <span>Release time</span>
                  <input name="releaseTime" type="time" required data-release-time />
                </label>
              </div>
            </div>
          </div>
        </div>
      </section>

      <template data-order-item-template>
        <details class="ui-accordion order-item-accordion" data-order-item-accordion>
          <summary class="ui-accordion__summary">
            <span class="ui-accordion__title" data-order-item-title>Select product</span>
            <span class="ui-accordion__summary-actions">
              <button
                type="button"
                class="order-item-accordion__remove"
                data-remove-order-item
                aria-label="Remove item"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M3 6h18"></path>
                  <path d="M8 6V4h8v2"></path>
                  <path d="M19 6l-1 14H6L5 6"></path>
                  <path d="M10 11v6"></path>
                  <path d="M14 11v6"></path>
                </svg>
              </button>
              <span class="ui-accordion__icon" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </span>
          </summary>
          <div class="ui-accordion__content">
            <div class="order-item-accordion__fields" data-order-item-row>
              <label class="field-row">
                <span>Product</span>
                <select name="productId" required disabled={activeProducts.length === 0} data-order-product-select>
                  <option value="">Select product</option>
                  {activeProducts.map((product) => (
                    <option
                      value={product.id}
                      data-product-name={product.name}
                      data-product-retail-price={product.default_price}
                      data-product-reseller-price={product.reseller_price}
                    >
                      {product.name} - retail {formatCurrency(product.default_price)} / reseller {formatCurrency(product.reseller_price)} per {product.unit_label}
                    </option>
                  ))}
                </select>
              </label>
              <label class="field-row">
                <span>Quantity</span>
                <input name="quantity" type="number" min="0.001" step="0.001" required />
              </label>
              <label class="field-row">
                <span>Details</span>
                <textarea name="addDetails" placeholder="Cut, packing, or delivery notes"></textarea>
              </label>
            </div>
          </div>
        </details>
      </template>

      <section class="order-create-section" data-downpayment-section>
        <div class="order-create-section__header">
          <h3 class="order-create-section__title">Payment</h3>
        </div>
        <div class="order-create-section__body order-create-form__payment-fields">
          <label class="field-row">
            <span>Amount received</span>
            <input name="downpaymentAmount" type="number" min="0.01" step="0.01" data-downpayment-amount />
          </label>
          <div class="order-create-form__field-pair">
            <label class="field-row">
              <span>Payment method</span>
              <select name="downpaymentMethod" data-downpayment-method>
                <option value="Cash">Cash</option>
                <option value="Check">Check</option>
              </select>
            </label>
            <label class="field-row">
              <span>Payment terms</span>
              <select name="downpaymentTerms" data-downpayment-terms>
                <option value="Cash on Delivery (COD)">Cash on Delivery (COD)</option>
                <option value="Bank Transfer">Bank Transfer</option>
                <option value="Gcash">Gcash</option>
              </select>
            </label>
          </div>
          <div class="order-create-form__field-pair">
            <label class="field-row">
              <span>Payment date</span>
              <input name="downpaymentDate" type="date" value={new Date().toISOString().slice(0, 10)} data-downpayment-date />
            </label>
            <label class="field-row">
              <span>Payment time</span>
              <input name="downpaymentTime" type="time" value={defaultTime} data-downpayment-time />
            </label>
          </div>
          <label class="field-row">
            <span>Reference</span>
            <input name="downpaymentReferenceNumber" data-downpayment-reference />
          </label>
          <label class="field-row">
            <span>Payment notes</span>
            <textarea name="downpaymentNotes" rows="2" data-downpayment-notes></textarea>
          </label>
        </div>
      </section>
    </form>
    <div slot="footer" class="order-create-sheet__footer">
      <div class="order-create-sheet__footer-total" aria-live="polite">
        <span>Total amount</span>
        <strong data-order-total-value>{formatCurrency(0)}</strong>
      </div>
      <button type="submit" form="create-order-form" disabled={!canCreateOrder}>Create order</button>
    </div>
  </Sheet>

  <div data-interactive-table data-server-pagination="true" class="dashboard-interactive-table">
    <div class="table-filters order-management-toolbar">
      <form
        method="get"
        action="/admin/orders"
        class="order-filter-form"
        data-order-filter-form
        data-current-filter-query={filterQuery}
        aria-label="Filter orders"
      >
        <div class="order-filter-form__field order-filter-form__field--search">
          <input
            name="search"
            type="search"
            value={activeFilters.search ?? ""}
            placeholder="Search customer, phone, email, or customers in agent orders..."
            autocomplete="off"
            aria-label="Search orders"
            data-order-search-input
          />
        </div>
        <div class="order-filter-form__field">
          <select name="source" aria-label="Filter by source">
            <option value="">All sources</option>
            {orderSources.map((source) => (
              <option value={source} selected={activeFilters.source === source}>
                {formatOrderSource(source)}
              </option>
            ))}
          </select>
        </div>
        <div class="order-filter-form__field">
          <select name="orderStatus" aria-label="Filter by order status">
            <option value="">All order statuses</option>
            {orderStatuses.map((status) => (
              <option value={status} selected={activeFilters.orderStatus === status}>
                {autoCapitalize(status)}
              </option>
            ))}
          </select>
        </div>
        <div class="order-filter-form__field">
          <select name="paymentStatus" aria-label="Filter by payment status">
            <option value="">All payment statuses</option>
            {paymentStatuses.map((status) => (
              <option value={status} selected={activeFilters.paymentStatus === status}>
                {autoCapitalize(status)}
              </option>
            ))}
          </select>
        </div>
      </form>
      <div class="order-management-toolbar__actions">
        <ActionMenu
          id="admin-orders-document-menu"
          menuLabel="Document options for selected orders"
          triggerLabel="Document"
          triggerClass="order-management-toolbar__document-menu"
          disabled
          items={[
            {
              label: "Sales Invoice",
              icon: "external-pdf",
              dataAction: "bulk-sales-invoice-pdf",
            },
            {
              label: "Order Slip",
              icon: "external-pdf",
              dataAction: "bulk-order-slip-pdf",
            },
          ]}
        />
        <button
          type="button"
          class="btn-table-manage order-management-toolbar__create"
          data-open-create-sheet
          data-sheet-target="#create-order-sheet"
          disabled={!canCreateOrder}
          >Create Order</button
        >
      </div>
    </div>

    <div data-order-table-shell class="dashboard-interactive-table__surface">
      <DashboardTableBoard>
        <table class="dashboard-table">
          <thead>
            <tr>
              <th scope="col" class="dashboard-table__select-column">
                <label class="dashboard-table__select-all">
                  <span class="sr-only">Select all orders on this page</span>
                  <input type="checkbox" data-order-select-all />
                </label>
              </th>
              <th scope="col">Date Created</th>
              <th scope="col">Customer</th>
              <th scope="col">Source</th>
              <th scope="col">Order Status</th>
              <th scope="col">Payment Status</th>
              <th scope="col">Order Total</th>
              <th scope="col">Remaining Receivable</th>
              <th scope="col">Action</th>
            </tr>
          </thead>
          <tbody>
            {orderRows.length === 0 ? (
              <DashboardTableEmptyState
                colspan={9}
                message="No orders match the selected filters."
              />
            ) : orderRows.map((order) => {
              return (
                <tr data-status={order.status}>
                  <td class="dashboard-table__select-column">
                    <label class="dashboard-table__row-select">
                      <span class="sr-only">Select order for {order.customer_label}</span>
                      <input
                        type="checkbox"
                        value={order.id}
                        data-order-row-checkbox
                        data-order-row-type={order.row_type}
                      />
                    </label>
                  </td>
                  <td>{formatDate(order.created_at)}</td>
                  <td class="dashboard-table__cell--truncate">
                    <span class="order-customer-cell">
                      <span class="order-customer-cell__name">{order.customer_label}</span>
                    {order.linked_customer_count !== null && (
                      <span
                        class="order-customer-count"
                        tabindex="0"
                        aria-label={`${order.linked_customer_count} linked customer orders in this agent order`}
                        title="Linked customer orders in this agent order"
                        data-tooltip="Linked customer orders in this agent order"
                      >
                        {order.linked_customer_count}
                      </span>
                    )}
                    </span>
                  </td>
                  <td>{order.source_label}</td>
                  <td>
                    <span class="order-status-cell">
                      <StatusBadge kind="order" status={order.status} label={autoCapitalize(order.status)} />
                      {
                        order.row_type === "agent"
                          && (order.pending_customer_order_count ?? 0) > 0 && (
                          <span
                            class="order-pending-customer-badge"
                            title={pendingCustomerOrderLabel(order.pending_customer_order_count ?? 0)}
                            aria-label={pendingCustomerOrderLabel(order.pending_customer_order_count ?? 0)}
                          >
                            {order.pending_customer_order_count} pending
                          </span>
                        )
                      }
                    </span>
                  </td>
                  <td>
                    {order.payment_status ? (
                      <StatusBadge kind="payment" status={order.payment_status} />
                    ) : (
                      <span class="dashboard-table__muted-line">N/A</span>
                    )}
                  </td>
                  <td>{formatCurrency(order.total_amount)}</td>
                  <td>{formatCurrency(order.remaining_receivable)}</td>
                  <td>
                    {
                      isPendingCustomerOrderRow(order) ? (
                        <form
                          method="post"
                          action={orderActionPath}
                          class="order-table-action-form"
                          data-astro-reload
                        >
                          <input type="hidden" name="action" value="update-order-status" />
                          <input type="hidden" name="orderId" value={order.id} />
                          <input type="hidden" name="orderStatus" value="processing" />
                          <button type="submit" class="btn-table-manage">
                            Accept order
                          </button>
                        </form>
                      ) : (
                        <ViewButton href={order.href} data-astro-prefetch="false" />
                      )
                    }
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </DashboardTableBoard>
    </div>

    <DashboardTablePagination pagination={data.pagination} />
  </div>

  <template data-order-filter-skeleton>
    <DashboardTableBoard aria-busy="true" aria-live="polite">
      <table class="product-table-skeleton dashboard-table">
        <caption class="sr-only">Loading filtered orders</caption>
        <thead>
          <tr>
            <th scope="col" class="dashboard-table__select-column">
              <span class="table-skeleton-block table-skeleton-block--short"></span>
            </th>
            <th scope="col">Date Created</th>
            <th scope="col">Customer</th>
            <th scope="col">Source</th>
            <th scope="col">Order Status</th>
            <th scope="col">Payment Status</th>
            <th scope="col">Order Total</th>
            <th scope="col">Remaining Receivable</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          {skeletonRows.map(() => (
            <tr>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </DashboardTableBoard>
  </template>
</section>

<script>
  import { resetFormSubmissionState } from "@/lib/client/form-submission-state";
  import { initAdminOrderBulkPdf } from "@/lib/client/admin-order-bulk-pdf";
  import { initDashboardFragmentTable } from "@/lib/client/dashboard-fragment-table";
  import { getOrderCreditLimitWarning } from "@/lib/client/order-credit-limit";

  const defaultNewCustomerCreditLimit = 1000;

  function initCreateOrderSheet() {
    const form = document.querySelector<HTMLFormElement>("#create-order-form");
    if (!form || form.dataset.orderSheetInitialized === "true") return;
    form.dataset.orderSheetInitialized = "true";
    const orderForm = form;

    const orderItems = form.querySelector<HTMLElement>("[data-order-items]");
    const orderItemTemplate = form.querySelector<HTMLTemplateElement>("[data-order-item-template]");
    const addOrderItemButton = form.querySelector<HTMLButtonElement>("[data-add-order-item]");
    const customerSearch = form.querySelector<HTMLInputElement>("[data-customer-search]");
    const customerIdInput = form.querySelector<HTMLInputElement>("[data-customer-id]");
    const customerPicker = form.querySelector<HTMLElement>("[data-customer-picker]");
    const customerPickerToggle = form.querySelector<HTMLButtonElement>("[data-customer-picker-toggle]");
    const customerPickerMenu = form.querySelector<HTMLElement>("[data-customer-picker-menu]");
    const customerOptionsContainer = form.querySelector<HTMLElement>("[data-customer-options]");
    const customerOptionsEmpty = form.querySelector<HTMLElement>("[data-customer-options-empty]");
    const customerOptionTemplate = form.querySelector<HTMLTemplateElement>("[data-customer-option-template]");
    const customerOrderNotice = form.querySelector<HTMLElement>("[data-customer-order-notice]");
    const orderTotalValues = Array.from(
      document.querySelectorAll<HTMLElement>("#create-order-sheet [data-order-total-value]"),
    );
    const releaseDateInput = form.querySelector<HTMLInputElement>("[data-release-date]");
    const releaseTimeInput = form.querySelector<HTMLInputElement>("[data-release-time]");
    const downpaymentAmountInput = form.querySelector<HTMLInputElement>("[data-downpayment-amount]");
    const downpaymentSection = form.querySelector<HTMLElement>("[data-downpayment-section]");
    const agentOrderAgentInput = form.querySelector<HTMLInputElement>("[data-agent-order-agent-id]");
    const agentOrderFields = form.querySelector<HTMLElement>("[data-agent-order-fields]");
    const agentOrderTypeSelect = form.querySelector<HTMLSelectElement>("[data-agent-order-type]");
    const newCustomerFields = form.querySelector<HTMLElement>("[data-new-customer-fields]");
    const firstNameInput = form.querySelector<HTMLInputElement>("input[data-customer-first-name]");
    const lastNameInput = form.querySelector<HTMLInputElement>("input[data-customer-last-name]");
    const phoneNumberInput = form.querySelector<HTMLInputElement>("input[data-customer-phone-number]");
    const emailInput = form.querySelector<HTMLInputElement>("input[data-customer-email]");
    const addressTextarea = form.querySelector<HTMLTextAreaElement>("textarea[data-customer-address]");
    const assignedAgentSelect = form.querySelector<HTMLSelectElement>("select[data-customer-assigned-agent-id]");
    const isResellerCheckbox = form.querySelector<HTMLInputElement>("input[data-customer-is-reseller]");
    const customerOptionNodes = Array.from(
      customerOptionTemplate?.content.querySelectorAll<HTMLButtonElement>("[data-order-target-option]") ?? [],
    );
    const customerSearchCache = new Map<string, HTMLButtonElement[]>();
    let customerSearchTimer: number | undefined;

    function setCustomerPickerOpen(isOpen: boolean) {
      if (!customerPicker || !customerPickerMenu || !customerPickerToggle) return;
      customerPickerMenu.hidden = !isOpen;
      customerPickerToggle.setAttribute("aria-expanded", String(isOpen));
      customerPicker.dataset.open = String(isOpen);
    }

    function showCustomerPickerMessage(message: string) {
      if (!customerOptionsContainer || !customerOptionsEmpty) return;
      customerOptionsContainer.replaceChildren();
      customerOptionsEmpty.textContent = message;
      customerOptionsEmpty.hidden = false;
    }

    function showCustomerPickerSkeleton() {
      if (!customerOptionsContainer || !customerOptionsEmpty) return;

      customerOptionsEmpty.hidden = true;
      customerOptionsContainer.replaceChildren(
        ...Array.from({ length: 3 }, () => {
          const skeleton = document.createElement("div");
          skeleton.className = "order-customer-picker__skeleton";
          skeleton.innerHTML = `
            <span class="table-skeleton-block table-skeleton-block--wide"></span>
          `;
          return skeleton;
        }),
      );
    }

    function renderCustomerOptions(searchTerm: string) {
      if (!customerOptionsContainer || !customerOptionsEmpty) return;

      const normalizedSearch = searchTerm.trim().toLowerCase();
      if (normalizedSearch.length === 0) {
        showCustomerPickerMessage("Try entering a customer or agent name");
        return;
      }

      const matchingCustomers = customerSearchCache.get(normalizedSearch)
        ?? customerOptionNodes
            .filter((customer) =>
              (customer.dataset.customerLabel ?? "").toLowerCase().includes(normalizedSearch) ||
              (customer.dataset.customerEmail ?? "").toLowerCase().includes(normalizedSearch) ||
              (customer.dataset.customerPhoneNumber ?? "").toLowerCase().includes(normalizedSearch)
            )
            .slice(0, 25);

      if (!customerSearchCache.has(normalizedSearch)) {
        customerSearchCache.set(normalizedSearch, matchingCustomers);
      }

      customerOptionsContainer.replaceChildren(
        ...matchingCustomers.map((customer) => {
          return customer.cloneNode(true);
        }),
      );

      if (matchingCustomers.length === 0) {
        showCustomerPickerMessage("No match found");
        return;
      }

      customerOptionsEmpty.hidden = true;
    }

    function getRenderedCustomerOptions() {
      return Array.from(
        customerOptionsContainer?.querySelectorAll<HTMLButtonElement>("[data-order-target-option]") ?? [],
      );
    }

    function getSelectedOrderTarget() {
      return getRenderedCustomerOptions().find(
        (option) => option.dataset.customerLabel === customerSearch?.value,
      );
    }

    function getSelectedCustomer() {
      const selectedTarget = getSelectedOrderTarget();
      return selectedTarget?.dataset.orderTargetType === "customer"
        ? selectedTarget
        : undefined;
    }

    function getSelectedAgentId() {
      const selectedTarget = getSelectedOrderTarget();
      return selectedTarget?.dataset.orderTargetType === "agent"
        ? selectedTarget.dataset.agentId ?? ""
        : "";
    }

    function fillCustomerFields(customer: HTMLElement | undefined) {
      if (firstNameInput) firstNameInput.value = customer?.dataset.customerFirstName ?? "";
      if (lastNameInput) lastNameInput.value = customer?.dataset.customerLastName ?? "";
      if (phoneNumberInput) phoneNumberInput.value = customer?.dataset.customerPhoneNumber ?? "";
      if (emailInput) emailInput.value = customer?.dataset.customerEmail ?? "";
      if (addressTextarea) addressTextarea.value = customer?.dataset.customerAddress ?? "";
      if (assignedAgentSelect) assignedAgentSelect.value = customer?.dataset.customerAssignedAgentId ?? "";
      if (isResellerCheckbox) isResellerCheckbox.checked = customer?.dataset.customerIsReseller === "true";
    }

    function updateCustomerOrderNotice(customer: HTMLElement | undefined) {
      if (!customerOrderNotice) return;

      const paymentNotice = customer?.dataset.customerPaymentNotice;
      const customerBalance = Number(customer?.dataset.customerBalance ?? 0);
      const creditLimit = Number(customer?.dataset.customerCreditLimit ?? 1000);
      const creditLimitExceeded = customer?.dataset.customerCreditExceeded === "true";
      const balanceLabel = Number.isFinite(customerBalance) && customerBalance > 0
        ? ` Overall balance: ${formatCompactCurrencyForClient(customerBalance)}.`
        : "";
      const creditLabel = Number.isFinite(creditLimit)
        ? ` Credit limit: ${formatCompactCurrencyForClient(creditLimit)}.`
        : "";

      if (creditLimitExceeded) {
        customerOrderNotice.textContent = `This customer has exceeded their credit limit.${balanceLabel}${creditLabel}`;
        customerOrderNotice.dataset.noticeKind = "unpaid";
        customerOrderNotice.hidden = false;
        return;
      }

      if (paymentNotice === "unpaid") {
        customerOrderNotice.textContent = `This customer currently has an unpaid order.${balanceLabel}${creditLabel}`;
        customerOrderNotice.dataset.noticeKind = "unpaid";
        customerOrderNotice.hidden = false;
        return;
      }

      if (paymentNotice === "partial") {
        customerOrderNotice.textContent = `This customer currently has a partially paid order.${balanceLabel}${creditLabel}`;
        customerOrderNotice.dataset.noticeKind = "partial";
        customerOrderNotice.hidden = false;
        return;
      }

      if (customerBalance > 0) {
        customerOrderNotice.textContent = `Overall balance: ${formatCompactCurrencyForClient(customerBalance)}.${creditLabel}`;
        customerOrderNotice.dataset.noticeKind = "partial";
        customerOrderNotice.hidden = false;
        return;
      }

      customerOrderNotice.textContent = "";
      customerOrderNotice.hidden = true;
      delete customerOrderNotice.dataset.noticeKind;
    }

    function refreshCustomerMode() {
      const selectedCustomer = getSelectedCustomer();
      const selectedAgentId = getSelectedAgentId();
      const hasAgentTarget = selectedAgentId.length > 0;
      const selectedCustomerId = hasAgentTarget
        ? ""
        : selectedCustomer?.dataset.customerId ?? "";

      if (customerIdInput) {
        customerIdInput.value = selectedCustomerId;
      }
      if (agentOrderAgentInput) {
        agentOrderAgentInput.value = selectedAgentId;
      }

      fillCustomerFields(hasAgentTarget ? undefined : selectedCustomer);
      updateCustomerOrderNotice(hasAgentTarget ? undefined : selectedCustomer);

      const fields = newCustomerFields?.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        "input, select, textarea",
      );
      fields?.forEach((field) => {
        if (field === customerIdInput) return;
        field.disabled = hasAgentTarget || selectedCustomerId.length > 0;
      });
      newCustomerFields?.toggleAttribute("data-disabled", hasAgentTarget || selectedCustomerId.length > 0);
      updateOrderTotal();
    }

    function selectedCustomerIsReseller() {
      if (agentOrderAgentInput?.value) {
        return false;
      }

      const selectedCustomer = getSelectedCustomer();

      if (selectedCustomer) {
        return selectedCustomer.dataset.customerIsReseller === "true";
      }

      return isResellerCheckbox?.checked ?? false;
    }

    function calculateOrderTotal() {
      return Array.from(orderForm.querySelectorAll<HTMLElement>("[data-order-item-row]")).reduce((total, row) => {
        const select = row.querySelector<HTMLSelectElement>("[data-order-product-select]");
        const quantityInput = row.querySelector<HTMLInputElement>("input[name='quantity']");
        const selectedOption = select?.selectedOptions?.[0];
        const quantity = Number(quantityInput?.value ?? 0);
        const unitPrice = Number(
          selectedCustomerIsReseller()
            ? selectedOption?.dataset.productResellerPrice
            : selectedOption?.dataset.productRetailPrice,
        );

        if (!Number.isFinite(quantity) || !Number.isFinite(unitPrice)) return total;

        return total + quantity * unitPrice;
      }, 0);
    }

    function updateOrderTotal() {
      const formatted = formatCurrencyForClient(calculateOrderTotal());
      orderTotalValues.forEach((node) => {
        node.textContent = formatted;
      });
    }

    function formatCurrencyForClient(value: number) {
      return new Intl.NumberFormat("en-PH", {
        style: "currency",
        currency: "PHP",
      }).format(value);
    }

    function formatCompactCurrencyForClient(value: number) {
      const normalizedValue = Number.isFinite(value) ? value : 0;
      const absoluteValue = Math.abs(normalizedValue);
      const sign = normalizedValue < 0 ? "-" : "";
      const currencySymbol = new Intl.NumberFormat("en-PH", {
        style: "currency",
        currency: "PHP",
        maximumFractionDigits: 0,
      }).formatToParts(0).find((part) => part.type === "currency")?.value ?? "PHP";

      if (absoluteValue >= 1000) {
        const compactValue = new Intl.NumberFormat("en-PH", {
          maximumFractionDigits: 1,
          minimumFractionDigits: 0,
        }).format(absoluteValue / 1000);

        return `${sign}${currencySymbol}${compactValue}k`;
      }

      return new Intl.NumberFormat("en-PH", {
        style: "currency",
        currency: "PHP",
        maximumFractionDigits: 0,
      }).format(normalizedValue);
    }

    function daysUntilReleaseDate() {
      if (!releaseDateInput?.value) return null;

      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const releaseDate = new Date(`${releaseDateInput.value}T${releaseTimeInput?.value || "00:00"}:00`);
      const difference = Math.round((releaseDate.getTime() - today.getTime()) / 86_400_000);

      return Number.isFinite(difference) ? difference : null;
    }

    function shouldConfirmCreditLimit() {
      if (agentOrderAgentInput?.value) return null;

      const selectedCustomer = getSelectedCustomer();
      const orderTotal = calculateOrderTotal();
      const downpaymentAmount = Number(downpaymentAmountInput?.value ?? 0);

      return getOrderCreditLimitWarning({
        currentBalance: selectedCustomer
          ? Number(selectedCustomer.dataset.customerBalance ?? 0)
          : 0,
        creditLimit: selectedCustomer
          ? Number(selectedCustomer.dataset.customerCreditLimit ?? defaultNewCustomerCreditLimit)
          : defaultNewCustomerCreditLimit,
        orderTotal,
        downpaymentAmount,
        isAgentOrder: false,
      });
    }

    function cancelOrderSubmit(event: SubmitEvent) {
      event.preventDefault();
      resetFormSubmissionState(orderForm);
    }

    function refreshAgentOrderMode() {
      refreshCustomerMode();

      const hasAgentTarget = Boolean(agentOrderAgentInput?.value);
      const isDistributionOrder = hasAgentTarget && agentOrderTypeSelect?.value === "distribution";

      if (agentOrderFields) agentOrderFields.hidden = !hasAgentTarget;
      if (agentOrderTypeSelect) agentOrderTypeSelect.disabled = !hasAgentTarget;

      const paymentFields = downpaymentSection?.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        "input, select, textarea",
      );
      paymentFields?.forEach((field) => {
        field.disabled = isDistributionOrder;
      });
      downpaymentSection?.toggleAttribute("data-disabled", isDistributionOrder);
      if (isDistributionOrder && downpaymentAmountInput) {
        downpaymentAmountInput.value = "";
      }
    }

    form.addEventListener("submit", (event) => {
      const downpaymentAmount = Number(downpaymentAmountInput?.value ?? 0);
      const releaseDays = daysUntilReleaseDate();

      if (
        (!Number.isFinite(downpaymentAmount) || downpaymentAmount <= 0) &&
        releaseDays !== null &&
        releaseDays >= 1 &&
        releaseDays <= 2
      ) {
        const shouldProceed = window.confirm(
          "The release date is 1-2 days away and no downpayment has been recorded. Proceed with this order?",
        );

        if (!shouldProceed) {
          cancelOrderSubmit(event);
          return;
        }
      }

      const creditLimitWarning = shouldConfirmCreditLimit();

      if (creditLimitWarning) {
        const shouldProceed = window.confirm(
          [
            "This order will exceed the customer's credit limit.",
            `Current balance: ${formatCompactCurrencyForClient(creditLimitWarning.currentBalance)}.`,
            `New unpaid amount: ${formatCompactCurrencyForClient(creditLimitWarning.addedBalance)}.`,
            `Projected balance: ${formatCompactCurrencyForClient(creditLimitWarning.projectedBalance)}.`,
            `Credit limit: ${formatCompactCurrencyForClient(creditLimitWarning.creditLimit)}.`,
            "Proceed with this order?",
          ].join("\n"),
        );

        if (!shouldProceed) {
          cancelOrderSubmit(event);
        }
      }
    });

    function updateOrderItemTitle(scope: ParentNode) {
      const title = scope.querySelector<HTMLElement>("[data-order-item-title]");
      const select = scope.querySelector<HTMLSelectElement>("[data-order-product-select]");
      const selectedOption = select?.selectedOptions?.[0];
      const productName = selectedOption?.dataset.productName?.trim() || "Select product";
      if (title) title.textContent = productName;
    }

    function bindOrderItem(scope: ParentNode) {
      const select = scope.querySelector<HTMLSelectElement>("[data-order-product-select]");
      const quantityInput = scope.querySelector<HTMLInputElement>("input[name='quantity']");
      select?.addEventListener("change", () => {
        updateOrderItemTitle(scope);
        updateOrderTotal();
      });
      quantityInput?.addEventListener("input", updateOrderTotal);
      updateOrderItemTitle(scope);
    }

    orderItems?.querySelectorAll<HTMLElement>(".order-item-accordion").forEach((item) => {
      bindOrderItem(item);
    });

    addOrderItemButton?.addEventListener("click", () => {
      const templateItem = orderItemTemplate?.content.firstElementChild;

      if (!orderItems || !templateItem) return;

      const clonedItem = templateItem.cloneNode(true);
      orderItems.append(clonedItem);

      if (clonedItem instanceof HTMLElement) {
        bindOrderItem(clonedItem);
      }

      if (clonedItem instanceof HTMLDetailsElement) {
        clonedItem.open = true;
      }

      updateOrderTotal();
    });

    orderItems?.addEventListener("click", (event) => {
      const target = event.target;
      const removeButton = target instanceof HTMLElement
        ? target.closest<HTMLElement>("[data-remove-order-item]")
        : null;

      if (!removeButton) return;

      event.preventDefault();
      event.stopPropagation();
      removeButton.closest(".order-item-accordion")?.remove();
      updateOrderTotal();
    });

    isResellerCheckbox?.addEventListener("change", updateOrderTotal);
    agentOrderTypeSelect?.addEventListener("change", refreshAgentOrderMode);

    customerSearch?.addEventListener("input", () => {
      window.clearTimeout(customerSearchTimer);
      setCustomerPickerOpen(true);

      const searchValue = customerSearch.value;
      if (searchValue.trim().length === 0) {
        renderCustomerOptions("");
        refreshAgentOrderMode();
        return;
      }

      refreshAgentOrderMode();
      showCustomerPickerSkeleton();
      customerSearchTimer = window.setTimeout(() => {
        renderCustomerOptions(searchValue);
        refreshAgentOrderMode();
      }, 450);
    });

    customerSearch?.addEventListener("focus", () => {
      renderCustomerOptions(customerSearch.value);
      setCustomerPickerOpen(true);
    });

    customerPickerToggle?.addEventListener("click", () => {
      renderCustomerOptions(customerSearch?.value ?? "");
      const isOpen = customerPickerToggle.getAttribute("aria-expanded") === "true";
      setCustomerPickerOpen(!isOpen);
    });

    customerOptionsContainer?.addEventListener("click", (event) => {
      const target = event.target;
      const option = target instanceof HTMLElement
        ? target.closest<HTMLButtonElement>("[data-order-target-option]")
        : null;

      if (!option || !customerSearch) return;

      customerSearch.value = option.dataset.customerLabel ?? "";
      refreshAgentOrderMode();
      setCustomerPickerOpen(false);
    });

    document.addEventListener("click", (event) => {
      if (!customerPicker) return;
      const target = event.target;
      if (target instanceof Node && customerPicker.contains(target)) return;
      setCustomerPickerOpen(false);
    });

    renderCustomerOptions(customerSearch?.value ?? "");
    setCustomerPickerOpen(false);
    refreshAgentOrderMode();
    updateOrderTotal();
  }

  document.addEventListener("DOMContentLoaded", initCreateOrderSheet);
  document.addEventListener("astro:after-swap", initCreateOrderSheet);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initCreateOrderSheet();
  }

  function initAdminOrderFilters() {
    initDashboardFragmentTable({
      cacheKey: "admin-orders-filter-cache-v2",
      fragmentPath: "/admin/orders-fragment",
      pagePath: "/admin/orders",
      formSelector: "[data-order-filter-form]",
      tableShellSelector: "[data-order-table-shell]",
      skeletonTemplateSelector: "[data-order-filter-skeleton]",
      filterKeys: ["search", "source", "orderStatus", "paymentStatus"],
      searchInputSelector: "[data-order-search-input]",
      historyStateKey: "orderFilterQuery",
    });
  }

  document.addEventListener("DOMContentLoaded", initAdminOrderFilters);
  document.addEventListener("astro:after-swap", initAdminOrderFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAdminOrderFilters();
  }

  function initAdminOrderBulkPdfControls() {
    initAdminOrderBulkPdf();
  }

  document.addEventListener("DOMContentLoaded", initAdminOrderBulkPdfControls);
  document.addEventListener("astro:after-swap", initAdminOrderBulkPdfControls);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAdminOrderBulkPdfControls();
  }
</script>

