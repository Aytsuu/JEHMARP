---
import type { AdminDashboardData } from "@/lib/admin-dashboard/data";
import {
  formatCurrency,
  formatDate,
  fullName,
  orderTotal,
} from "@/lib/admin-dashboard/view";
import { autoCapitalize, formatOrderSource } from "@/lib/formatters";

type Props = {
  data: AdminDashboardData;
};

const { data } = Astro.props;
const activeProducts = data.products.filter((product) => product.is_active);
const canCreateOrder = activeProducts.length > 0;
const customerOptions = data.customers.map((customer) => ({
  customer,
  label: `${fullName(customer)} - ${customer.phone_number}`,
}));
---

<section id="admin-orders" class="admin-panel" aria-labelledby="admin-orders-title">
  <div class="hidden-create-form-holder" style="display: none;">
    <form method="post" class="admin-form" aria-labelledby="create-order-title">
      <input type="hidden" name="action" value="create-order" />
      <h3 id="create-order-title">Create order</h3>

        {!canCreateOrder && (
          <p class="empty-state">
            Add at least one active product before creating an admin order.
          </p>
        )}

        <fieldset class="fieldset-block">
          <legend>Existing customer</legend>
          <div class="admin-form-grid">
            <label class="field-row">
              <span>Search customer</span>
              <input
                name="customerLookup"
                list="admin-order-customer-options"
                autocomplete="off"
                placeholder="Type a customer name"
                data-customer-search
              />
              <input type="hidden" name="customerId" data-customer-id />
            </label>
          </div>
          <datalist id="admin-order-customer-options">
            {customerOptions.map(({ customer, label }) => (
              <option
                value={label}
                data-customer-id={customer.id}
                data-customer-first-name={customer.first_name}
                data-customer-last-name={customer.last_name}
                data-customer-phone-number={customer.phone_number}
                data-customer-email={customer.email ?? ""}
                data-customer-address={customer.address}
                data-customer-assigned-agent-id={customer.assigned_agent_id ?? ""}
                data-customer-is-reseller={String(customer.is_reseller)}
              >
                {customer.email ?? customer.address}
              </option>
            ))}
          </datalist>
        </fieldset>

        <fieldset class="fieldset-block" data-new-customer-fields>
          <legend>Customer details</legend>
          <div class="admin-form-grid">
            <label class="field-row"><span>First name</span><input name="firstName" required data-customer-first-name /></label>
            <label class="field-row"><span>Last name</span><input name="lastName" required data-customer-last-name /></label>
            <label class="field-row"><span>Phone number</span><input name="phoneNumber" required data-customer-phone-number /></label>
            <label class="field-row"><span>Email</span><input name="email" type="email" data-customer-email /></label>
            <label class="field-row">
              <span>Assigned customer agent</span>
              <select name="assignedAgentId" data-customer-assigned-agent-id>
                <option value="">None</option>
                {data.agents.map((agent) => (
                  <option value={agent.id}>{agent.display_name}</option>
                ))}
              </select>
            </label>
            <label class="checkbox-row">
              <input name="isReseller" type="checkbox" data-customer-is-reseller />
              <span>Reseller customer</span>
            </label>
          </div>
          <label class="field-row"><span>Address</span><textarea name="address" required data-customer-address></textarea></label>
        </fieldset>

        <div class="table-wrap">
          <table>
            <caption>Order items</caption>
            <thead>
              <tr>
                <th scope="col">Product</th>
                <th scope="col">Quantity</th>
                <th scope="col">Details</th>
                <th scope="col">Manage</th>
              </tr>
            </thead>
            <tbody data-order-items>
              <tr data-order-item-row>
                <td>
                  <label class="field-row">
                    <span>Product <span data-row-number>1</span></span>
                    <select name="productId" required disabled={activeProducts.length === 0}>
                      <option value="">Select product</option>
                      {activeProducts.map((product) => (
                        <option value={product.id}>
                          {product.name} - retail {formatCurrency(product.default_price)} / reseller {formatCurrency(product.reseller_price)} per {product.unit_label}
                        </option>
                      ))}
                    </select>
                  </label>
                </td>
                <td>
                  <label class="field-row">
                    <span>Quantity <span data-row-number>1</span></span>
                    <input name="quantity" type="number" min="0.001" step="0.001" required />
                  </label>
                </td>
                <td>
                  <label class="field-row">
                    <span>Details <span data-row-number>1</span></span>
                    <textarea name="addDetails" placeholder="Cut, packing, or delivery notes"></textarea>
                  </label>
                </td>
                <td>
                  <span class="empty-state">Required</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <template data-order-item-template>
          <tr data-order-item-row>
            <td>
              <label class="field-row">
                <span>Product <span data-row-number></span></span>
                <select name="productId" required disabled={activeProducts.length === 0}>
                  <option value="">Select product</option>
                  {activeProducts.map((product) => (
                    <option value={product.id}>
                      {product.name} - retail {formatCurrency(product.default_price)} / reseller {formatCurrency(product.reseller_price)} per {product.unit_label}
                    </option>
                  ))}
                </select>
              </label>
            </td>
            <td>
              <label class="field-row">
                <span>Quantity <span data-row-number></span></span>
                <input name="quantity" type="number" min="0.001" step="0.001" required />
              </label>
            </td>
            <td>
              <label class="field-row">
                <span>Details <span data-row-number></span></span>
                <textarea name="addDetails" placeholder="Cut, packing, or delivery notes"></textarea>
              </label>
            </td>
            <td>
              <button type="button" data-remove-order-item>Remove</button>
            </td>
          </tr>
        </template>

        <button type="button" data-add-order-item disabled={!canCreateOrder}>Add item</button>
        <button type="submit" disabled={!canCreateOrder}>Create order</button>
      </form>
    </div>

  {data.orders.length === 0 ? (
    <p class="empty-state">No orders yet.</p>
  ) : (
    <div data-interactive-table>
      <div class="table-filters">
        <div style="flex: 1; min-width: 15rem;">
          <input type="text" placeholder="Search orders..." data-search-input style="width: 100%;" />
        </div>
        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
          <div style="display: flex; align-items: center; gap: 0.35rem;">
            <span style="font-size: 0.9rem; color: var(--color-brand-muted-black);">Show</span>
            <select data-limit-select>
              <option value="10">10</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </div>
          <button type="button" class="btn-table-manage" data-open-create-sheet style="padding: 0.5rem 1rem; border-radius: 0.375rem; text-transform: none; font-size: 0.9rem; font-weight: 600; letter-spacing: normal;" disabled={!canCreateOrder}>Create Order</button>
        </div>
      </div>

      <div class="table-wrap">
        <table style="table-layout: fixed; width: 100%;">
          <thead>
            <tr>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Customer</th>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Date</th>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Source</th>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Order Status</th>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Payment Status</th>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Order Total</th>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Action</th>
              <th scope="col" class="unread-record-heading" style="width: 2%; padding: 1.1rem 0.75rem;"><span class="sr-only">Unread</span></th>
            </tr>
          </thead>
          <tbody>
            {data.orders.map((order) => {
              const invoice = order.invoice[0];
              const total = orderTotal(order, invoice ? "final_quantity" : "partial_quantity");
              const isUnread =
                !order.admin_read_at &&
                order.order_status === "submitted" &&
                order.source !== "admin_manual";

              return (
                <tr data-status={order.order_status}>
                  <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    {order.customer ? fullName(order.customer) : "Guest"}
                  </td>
                  <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">{formatDate(order.created_at)}</td>
                  <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">{formatOrderSource(order.source)}</td>
                  <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">{autoCapitalize(order.order_status)}</td>
                  <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">{autoCapitalize(order.payment_status)}</td>
                  <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">{formatCurrency(total)}</td>
                  <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                    <form method="post" style="margin: 0;">
                      <input type="hidden" name="action" value="mark-order-read" />
                      <input type="hidden" name="orderId" value={order.id} />
                      <input type="hidden" name="returnTo" value={`/admin/orders/${order.id}`} />
                      <button type="submit" class="btn-table-manage" style="background-color: var(--color-brand-muted-black); padding: 0.25rem 0.5rem; font-size: 0.75rem; text-transform: none; letter-spacing: normal; width: auto; display: inline-block; text-decoration: none;">View</button>
                    </form>
                  </td>
                  <td class="unread-record-cell" style="width: 2%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                    {isUnread && <span class="record-unread-dot" aria-label="Unread"></span>}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div class="table-pagination">
        <span data-page-info style="font-size: 0.9rem; color: var(--color-brand-muted-black); font-weight: 500;"></span>
        <div style="display: flex; gap: 0.25rem; align-items: center;">
          <button type="button" data-pagination-prev class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&lt;</button>
          <div data-pagination-numbers style="display: flex; gap: 0.25rem;"></div>
          <button type="button" data-pagination-next class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&gt;</button>
        </div>
      </div>
    </div>
  )}
</section>

<script>
  const orderItems = document.querySelector("[data-order-items]");
  const orderItemTemplate = document.querySelector<HTMLTemplateElement>("[data-order-item-template]");
  const addOrderItemButton = document.querySelector<HTMLButtonElement>("[data-add-order-item]");
  const customerSearch = document.querySelector<HTMLInputElement>("[data-customer-search]");
  const customerIdInput = document.querySelector<HTMLInputElement>("[data-customer-id]");
  const newCustomerFields = document.querySelector<HTMLFieldSetElement>("[data-new-customer-fields]");
  const firstNameInput = document.querySelector<HTMLInputElement>("input[data-customer-first-name]");
  const lastNameInput = document.querySelector<HTMLInputElement>("input[data-customer-last-name]");
  const phoneNumberInput = document.querySelector<HTMLInputElement>("input[data-customer-phone-number]");
  const emailInput = document.querySelector<HTMLInputElement>("input[data-customer-email]");
  const addressTextarea = document.querySelector<HTMLTextAreaElement>("textarea[data-customer-address]");
  const assignedAgentSelect = document.querySelector<HTMLSelectElement>("select[data-customer-assigned-agent-id]");
  const isResellerCheckbox = document.querySelector<HTMLInputElement>("input[data-customer-is-reseller]");
  const customerOptionElements = Array.from(
    document.querySelectorAll<HTMLOptionElement>("[data-customer-id]"),
  ).filter((option) => option.matches("option"));

  function fillCustomerFields(customer: HTMLOptionElement | undefined) {
    if (firstNameInput) firstNameInput.value = customer?.dataset.customerFirstName ?? "";
    if (lastNameInput) lastNameInput.value = customer?.dataset.customerLastName ?? "";
    if (phoneNumberInput) phoneNumberInput.value = customer?.dataset.customerPhoneNumber ?? "";
    if (emailInput) emailInput.value = customer?.dataset.customerEmail ?? "";
    if (addressTextarea) addressTextarea.value = customer?.dataset.customerAddress ?? "";
    if (assignedAgentSelect) assignedAgentSelect.value = customer?.dataset.customerAssignedAgentId ?? "";
    if (isResellerCheckbox) isResellerCheckbox.checked = customer?.dataset.customerIsReseller === "true";
  }

  function refreshCustomerMode() {
    const selectedCustomer = customerOptionElements.find((option) => option.value === customerSearch?.value);
    const selectedCustomerId = selectedCustomer?.dataset.customerId ?? "";

    if (customerIdInput) {
      customerIdInput.value = selectedCustomerId;
    }

    fillCustomerFields(selectedCustomer);

    if (newCustomerFields) {
      newCustomerFields.disabled = selectedCustomerId.length > 0;
    }
  }

  function refreshOrderItemRowNumbers() {
    if (!orderItems) return;

    orderItems.querySelectorAll("[data-order-item-row]").forEach((row, index) => {
      row.querySelectorAll("[data-row-number]").forEach((label) => {
        label.textContent = String(index + 1);
      });
    });
  }

  addOrderItemButton?.addEventListener("click", () => {
    const templateRow = orderItemTemplate?.content.firstElementChild;

    if (!orderItems || !templateRow) return;

    orderItems.append(templateRow.cloneNode(true));
    refreshOrderItemRowNumbers();
  });

  orderItems?.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof HTMLElement) || !target.matches("[data-remove-order-item]")) return;

    target.closest("[data-order-item-row]")?.remove();
    refreshOrderItemRowNumbers();
  });

  customerSearch?.addEventListener("input", refreshCustomerMode);
  refreshCustomerMode();
</script>
