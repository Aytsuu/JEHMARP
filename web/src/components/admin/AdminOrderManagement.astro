---
import Accordion from "@/components/ui/Accordion.astro";
import Sheet from "@/components/ui/Sheet.astro";
import type { AdminOrderManagementData } from "@/lib/admin-dashboard/data";
import ViewButton from "@/components/ViewButton.astro";
import { getOrderStatuses } from "@/lib/admin-dashboard/actions";
import type { AdminOrderFilters } from "@/lib/admin-dashboard/order-filters";
import { orderSources, paymentStatuses } from "@/lib/admin-dashboard/order-filters";
import {
  formatCurrency,
  formatDate,
  fullName,
  orderTotal,
} from "@/lib/admin-dashboard/view";
import { autoCapitalize, formatOrderSource } from "@/lib/formatters";

type Props = {
  data: AdminOrderManagementData;
  activeFilters: AdminOrderFilters;
  filterQuery: string;
};

const { data, activeFilters, filterQuery } = Astro.props;
const activeProducts = data.products.filter((product) => product.is_active);
const canCreateOrder = activeProducts.length > 0;
const customerOptions = data.customers.map((customer) => ({
  customer,
  label: `${fullName(customer)} - ${customer.phone_number}`,
}));
const orderStatuses = getOrderStatuses();
const hasActiveFilters = filterQuery.length > 0;
const skeletonRows = Array.from({ length: 6 });
const totalRangeMin = 0;
const totalRangeMax = Math.max(
  1,
  Math.ceil(data.orderTotalRange.max),
  Math.ceil(activeFilters.maxTotal ?? 0),
  Math.ceil(activeFilters.minTotal ?? 0),
);
const activeMinTotal = Math.min(
  totalRangeMax,
  Math.max(totalRangeMin, activeFilters.minTotal ?? totalRangeMin),
);
const activeMaxTotal = Math.min(
  totalRangeMax,
  Math.max(activeMinTotal, activeFilters.maxTotal ?? totalRangeMax),
);
---

<section id="admin-orders" class="admin-panel" aria-labelledby="admin-orders-title">
  <Sheet id="create-order-sheet" width="42rem">
    <div slot="header" class="order-create-sheet__header-copy">
      <h3 class="drawer-sheet__title" data-sheet-title>Create Order</h3>
      <p class="order-create-sheet__header-description">
        Select an existing customer or enter new customer details, then add the order items below.
      </p>
    </div>
    <form id="create-order-form" method="post" class="order-create-form" aria-label="Create order">
      <input type="hidden" name="action" value="create-order" />

      {!canCreateOrder && (
        <p class="empty-state">
          Add at least one active product before creating an admin order.
        </p>
      )}

      <section class="order-create-section">
        <div class="order-create-section__body">
          <div class="admin-form-grid order-create-form__existing-customer-grid">
            <label class="field-row">
              <span>Search customer</span>
              <div class="order-customer-picker" data-customer-picker>
                <input
                  name="customerLookup"
                  autocomplete="off"
                  placeholder="Type a customer name"
                  data-customer-search
                  data-customer-search-input
                />
                <button
                  type="button"
                  class="order-customer-picker__toggle"
                  aria-label="Show customer options"
                  aria-expanded="false"
                  data-customer-picker-toggle
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="order-customer-picker__menu" hidden data-customer-picker-menu>
                  <div class="order-customer-picker__options" data-customer-options></div>
                  <p class="order-customer-picker__empty" hidden data-customer-options-empty>
                    No customers found.
                  </p>
                </div>
              </div>
              <input type="hidden" name="customerId" data-customer-id />
            </label>
          </div>
          <template data-customer-option-template>
            {customerOptions.map(({ customer, label }) => (
              <button
                type="button"
                class="order-customer-picker__option"
                data-customer-id={customer.id}
                data-customer-label={label}
                data-customer-first-name={customer.first_name}
                data-customer-last-name={customer.last_name}
                data-customer-phone-number={customer.phone_number}
                data-customer-email={customer.email ?? ""}
                data-customer-address={customer.address}
                data-customer-assigned-agent-id={customer.assigned_agent_id ?? ""}
                data-customer-is-reseller={String(customer.is_reseller)}
              >
                <span class="order-customer-picker__option-title">{label}</span>
                <span class="order-customer-picker__option-meta">
                  {customer.email ?? customer.address}
                </span>
              </button>
            ))}
          </template>
        </div>
      </section>

      <section class="order-create-section" data-new-customer-fields>
        <h3 class="order-create-section__title">Customer details</h3>
        <div class="order-create-section__body">
          <div class="admin-form-grid order-create-form__customer-grid">
            <div class="order-create-form__name-row">
              <label class="field-row"><span>First name</span><input name="firstName" required data-customer-first-name /></label>
              <label class="field-row"><span>Last name</span><input name="lastName" required data-customer-last-name /></label>
            </div>
            <label class="field-row"><span>Phone number</span><input name="phoneNumber" required data-customer-phone-number /></label>
            <label class="field-row"><span>Email</span><input name="email" type="email" data-customer-email /></label>
            <label class="field-row">
              <span>Assigned customer agent</span>
              <select name="assignedAgentId" data-customer-assigned-agent-id>
                <option value="">None</option>
                {data.agents.map((agent) => (
                  <option value={agent.id}>{agent.display_name}</option>
                ))}
              </select>
            </label>
            <label class="checkbox-row">
              <input name="isReseller" type="checkbox" data-customer-is-reseller />
              <span>Reseller customer</span>
            </label>
          </div>
          <label class="field-row"><span>Address</span><textarea name="address" required data-customer-address></textarea></label>
        </div>
      </section>

      <section class="order-create-section">
        <div class="order-create-section__header">
          <h3 class="order-create-section__title">Order items</h3>
        </div>
        <div class="order-create-section__body">
          <div class="order-item-list" data-order-items>
            <Accordion class="order-item-accordion" open>
              <span slot="title" data-order-item-title>Select product</span>
              <button
                slot="actions"
                type="button"
                class="order-item-accordion__remove"
                data-remove-order-item
                aria-label="Remove item"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M3 6h18"></path>
                  <path d="M8 6V4h8v2"></path>
                  <path d="M19 6l-1 14H6L5 6"></path>
                  <path d="M10 11v6"></path>
                  <path d="M14 11v6"></path>
                </svg>
              </button>
              <div class="order-item-accordion__fields" data-order-item-row>
                <label class="field-row">
                  <span>Product</span>
                  <select name="productId" required disabled={activeProducts.length === 0} data-order-product-select>
                    <option value="">Select product</option>
                    {activeProducts.map((product) => (
                      <option value={product.id} data-product-name={product.name}>
                        {product.name} - retail {formatCurrency(product.default_price)} / reseller {formatCurrency(product.reseller_price)} per {product.unit_label}
                      </option>
                    ))}
                  </select>
                </label>
                <label class="field-row">
                  <span>Quantity</span>
                  <input name="quantity" type="number" min="0.001" step="0.001" required />
                </label>
                <label class="field-row">
                  <span>Details</span>
                  <textarea name="addDetails" placeholder="Cut, packing, or delivery notes"></textarea>
                </label>
              </div>
            </Accordion>
          </div>
          <button
            type="button"
            class="order-create-form__add-item"
            data-add-order-item
            disabled={!canCreateOrder}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 5v14"></path>
              <path d="M5 12h14"></path>
            </svg>
            <span>Add Item</span>
          </button>
        </div>
      </section>

      <template data-order-item-template>
        <details class="ui-accordion order-item-accordion" data-order-item-accordion>
          <summary class="ui-accordion__summary">
            <span class="ui-accordion__title" data-order-item-title>Select product</span>
            <span class="ui-accordion__summary-actions">
              <button
                type="button"
                class="order-item-accordion__remove"
                data-remove-order-item
                aria-label="Remove item"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M3 6h18"></path>
                  <path d="M8 6V4h8v2"></path>
                  <path d="M19 6l-1 14H6L5 6"></path>
                  <path d="M10 11v6"></path>
                  <path d="M14 11v6"></path>
                </svg>
              </button>
              <span class="ui-accordion__icon" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </span>
          </summary>
          <div class="ui-accordion__content">
            <div class="order-item-accordion__fields" data-order-item-row>
              <label class="field-row">
                <span>Product</span>
                <select name="productId" required disabled={activeProducts.length === 0} data-order-product-select>
                  <option value="">Select product</option>
                  {activeProducts.map((product) => (
                    <option value={product.id} data-product-name={product.name}>
                      {product.name} - retail {formatCurrency(product.default_price)} / reseller {formatCurrency(product.reseller_price)} per {product.unit_label}
                    </option>
                  ))}
                </select>
              </label>
              <label class="field-row">
                <span>Quantity</span>
                <input name="quantity" type="number" min="0.001" step="0.001" required />
              </label>
              <label class="field-row">
                <span>Details</span>
                <textarea name="addDetails" placeholder="Cut, packing, or delivery notes"></textarea>
              </label>
            </div>
          </div>
        </details>
      </template>
    </form>
    <div slot="footer" class="order-create-sheet__footer">
      <button type="submit" form="create-order-form" disabled={!canCreateOrder}>Create order</button>
    </div>
  </Sheet>

  <div data-interactive-table>
    <div class="table-filters order-management-toolbar">
      <form
        method="get"
        action="/admin/orders"
        class="order-filter-form"
        data-order-filter-form
        data-current-filter-query={filterQuery}
        aria-label="Filter orders"
      >
        <label class="order-filter-form__field order-filter-form__field--search">
          <span>Search</span>
          <input
            name="search"
            type="search"
            value={activeFilters.search ?? ""}
            placeholder="Search customer, phone, email, order ID..."
            autocomplete="off"
            data-order-search-input
          />
        </label>
        <label class="order-filter-form__field">
          <span>Source</span>
          <select name="source">
            <option value="">All sources</option>
            {orderSources.map((source) => (
              <option value={source} selected={activeFilters.source === source}>
                {formatOrderSource(source)}
              </option>
            ))}
          </select>
        </label>
        <label class="order-filter-form__field">
          <span>Order status</span>
          <select name="orderStatus">
            <option value="">All order statuses</option>
            {orderStatuses.map((status) => (
              <option value={status} selected={activeFilters.orderStatus === status}>
                {autoCapitalize(status)}
              </option>
            ))}
          </select>
        </label>
        <label class="order-filter-form__field">
          <span>Payment status</span>
          <select name="paymentStatus">
            <option value="">All payment statuses</option>
            {paymentStatuses.map((status) => (
              <option value={status} selected={activeFilters.paymentStatus === status}>
                {autoCapitalize(status)}
              </option>
            ))}
          </select>
        </label>
        <fieldset
          class="order-filter-form__total-range"
          data-order-total-range
          data-total-min={totalRangeMin}
          data-total-max={totalRangeMax}
        >
          <legend>Order total</legend>
          <input
            type="hidden"
            name="minTotal"
            value={activeFilters.minTotal ?? ""}
            data-total-min-hidden
          />
          <input
            type="hidden"
            name="maxTotal"
            value={activeFilters.maxTotal ?? ""}
            data-total-max-hidden
          />
          <div class="order-filter-form__range-values" aria-live="polite">
            <span data-total-min-label>{formatCurrency(activeMinTotal)}</span>
            <span data-total-max-label>{formatCurrency(activeMaxTotal)}</span>
          </div>
          <div class="dual-range-slider">
            <div class="dual-range-slider__track" aria-hidden="true">
              <span class="dual-range-slider__fill" data-total-range-fill></span>
            </div>
            <input
              type="range"
              min={totalRangeMin}
              max={totalRangeMax}
              step="1"
              value={activeMinTotal}
              aria-label="Minimum order total"
              data-total-min-range
            />
            <input
              type="range"
              min={totalRangeMin}
              max={totalRangeMax}
              step="1"
              value={activeMaxTotal}
              aria-label="Maximum order total"
              data-total-max-range
            />
          </div>
        </fieldset>
        <a
          href="/admin/orders"
          class="order-filter-form__reset"
          data-order-filter-reset
          hidden={!hasActiveFilters}
        >
          Clear
        </a>
      </form>
      <div class="order-management-toolbar__actions">
        <label class="order-management-toolbar__limit">
          <span>Show</span>
          <select data-limit-select>
            <option value="10">10</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </label>
        <button
          type="button"
          class="btn-table-manage order-management-toolbar__create"
          data-open-create-sheet
          data-sheet-target="#create-order-sheet"
          disabled={!canCreateOrder}
          >Create Order</button
        >
      </div>
    </div>

    <div data-order-table-shell>
      <div class="table-wrap">
        <table style="table-layout: fixed; width: 100%;">
          <thead>
            <tr>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Customer</th>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Date</th>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Source</th>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Order Status</th>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Payment Status</th>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Order Total</th>
              <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Action</th>
              <th scope="col" class="unread-record-heading" style="width: 2%; padding: 1.1rem 0.75rem;"><span class="sr-only">Unread</span></th>
            </tr>
          </thead>
          <tbody>
            {data.orders.length === 0 ? (
              <tr class="empty-row">
                <td colspan="8" class="empty-state">
                  No orders match the selected filters.
                </td>
              </tr>
            ) : data.orders.map((order) => {
              const invoice = order.invoice[0];
              const total = orderTotal(order, invoice ? "final_quantity" : "partial_quantity");
              const isUnread =
                !order.admin_read_at &&
                order.order_status === "pending" &&
                order.source !== "admin_manual";

              return (
                <tr data-status={order.order_status}>
                  <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    {order.customer ? fullName(order.customer) : "Guest"}
                  </td>
                  <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">{formatDate(order.created_at)}</td>
                  <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">{formatOrderSource(order.source)}</td>
                  <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">{autoCapitalize(order.order_status)}</td>
                  <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">{autoCapitalize(order.payment_status)}</td>
                  <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">{formatCurrency(total)}</td>
                  <td style="width: 14%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                    <form method="post" style="margin: 0;">
                      <input type="hidden" name="action" value="mark-order-read" />
                      <input type="hidden" name="orderId" value={order.id} />
                      <input type="hidden" name="returnTo" value={`/admin/orders/${order.id}`} />
                      <ViewButton type="submit" />
                    </form>
                  </td>
                  <td class="unread-record-cell" style="width: 2%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                    {isUnread && <span class="record-unread-dot" aria-label="Unread"></span>}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

      <div class="table-pagination">
        <span data-page-info style="font-size: 0.9rem; color: var(--color-brand-muted-black); font-weight: 500;"></span>
        <div style="display: flex; gap: 0.25rem; align-items: center;">
          <button type="button" data-pagination-prev class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&lt;</button>
          <div data-pagination-numbers style="display: flex; gap: 0.25rem;"></div>
          <button type="button" data-pagination-next class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&gt;</button>
        </div>
      </div>
    </div>

  <template data-order-filter-skeleton>
    <div class="table-wrap" aria-busy="true" aria-live="polite">
      <table class="product-table-skeleton" style="table-layout: fixed; width: 100%;">
        <caption class="sr-only">Loading filtered orders</caption>
        <thead>
          <tr>
            <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Customer</th>
            <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Date</th>
            <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Source</th>
            <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Order Status</th>
            <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Payment Status</th>
            <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Order Total</th>
            <th scope="col" style="width: 14%; padding: 1.1rem 0.75rem;">Action</th>
            <th scope="col" class="unread-record-heading" style="width: 2%; padding: 1.1rem 0.75rem;"><span class="sr-only">Unread</span></th>
          </tr>
        </thead>
        <tbody>
          {skeletonRows.map(() => (
            <tr>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </template>
</section>

<script>
  function initCreateOrderSheet() {
    const form = document.querySelector<HTMLFormElement>("#create-order-form");
    if (!form || form.dataset.orderSheetInitialized === "true") return;
    form.dataset.orderSheetInitialized = "true";

    const orderItems = form.querySelector<HTMLElement>("[data-order-items]");
    const orderItemTemplate = form.querySelector<HTMLTemplateElement>("[data-order-item-template]");
    const addOrderItemButton = form.querySelector<HTMLButtonElement>("[data-add-order-item]");
    const customerSearch = form.querySelector<HTMLInputElement>("[data-customer-search]");
    const customerIdInput = form.querySelector<HTMLInputElement>("[data-customer-id]");
    const customerPicker = form.querySelector<HTMLElement>("[data-customer-picker]");
    const customerPickerToggle = form.querySelector<HTMLButtonElement>("[data-customer-picker-toggle]");
    const customerPickerMenu = form.querySelector<HTMLElement>("[data-customer-picker-menu]");
    const customerOptionsContainer = form.querySelector<HTMLElement>("[data-customer-options]");
    const customerOptionsEmpty = form.querySelector<HTMLElement>("[data-customer-options-empty]");
    const customerOptionTemplate = form.querySelector<HTMLTemplateElement>("[data-customer-option-template]");
    const newCustomerFields = form.querySelector<HTMLElement>("[data-new-customer-fields]");
    const firstNameInput = form.querySelector<HTMLInputElement>("input[data-customer-first-name]");
    const lastNameInput = form.querySelector<HTMLInputElement>("input[data-customer-last-name]");
    const phoneNumberInput = form.querySelector<HTMLInputElement>("input[data-customer-phone-number]");
    const emailInput = form.querySelector<HTMLInputElement>("input[data-customer-email]");
    const addressTextarea = form.querySelector<HTMLTextAreaElement>("textarea[data-customer-address]");
    const assignedAgentSelect = form.querySelector<HTMLSelectElement>("select[data-customer-assigned-agent-id]");
    const isResellerCheckbox = form.querySelector<HTMLInputElement>("input[data-customer-is-reseller]");
    const customerOptionNodes = Array.from(
      customerOptionTemplate?.content.querySelectorAll<HTMLButtonElement>("[data-customer-id]") ?? [],
    );
    const customerSearchCache = new Map<string, HTMLButtonElement[]>();
    let customerSearchTimer: number | undefined;

    function setCustomerPickerOpen(isOpen: boolean) {
      if (!customerPicker || !customerPickerMenu || !customerPickerToggle) return;
      customerPickerMenu.hidden = !isOpen;
      customerPickerToggle.setAttribute("aria-expanded", String(isOpen));
      customerPicker.dataset.open = String(isOpen);
    }

    function showCustomerPickerMessage(message: string) {
      if (!customerOptionsContainer || !customerOptionsEmpty) return;
      customerOptionsContainer.replaceChildren();
      customerOptionsEmpty.textContent = message;
      customerOptionsEmpty.hidden = false;
    }

    function showCustomerPickerSkeleton() {
      if (!customerOptionsContainer || !customerOptionsEmpty) return;

      customerOptionsEmpty.hidden = true;
      customerOptionsContainer.replaceChildren(
        ...Array.from({ length: 3 }, () => {
          const skeleton = document.createElement("div");
          skeleton.className = "order-customer-picker__skeleton";
          skeleton.innerHTML = `
            <span class="table-skeleton-block table-skeleton-block--wide"></span>
            <span class="table-skeleton-block table-skeleton-block--short"></span>
          `;
          return skeleton;
        }),
      );
    }

    function renderCustomerOptions(searchTerm: string) {
      if (!customerOptionsContainer || !customerOptionsEmpty) return;

      const normalizedSearch = searchTerm.trim().toLowerCase();
      if (normalizedSearch.length === 0) {
        showCustomerPickerMessage("Try entering customer name");
        return;
      }

      const matchingCustomers = customerSearchCache.get(normalizedSearch)
        ?? customerOptionNodes
            .filter((customer) =>
              (customer.dataset.customerLabel ?? "").toLowerCase().includes(normalizedSearch) ||
              (customer.dataset.customerEmail ?? "").toLowerCase().includes(normalizedSearch) ||
              (customer.dataset.customerPhoneNumber ?? "").toLowerCase().includes(normalizedSearch)
            )
            .slice(0, 25);

      if (!customerSearchCache.has(normalizedSearch)) {
        customerSearchCache.set(normalizedSearch, matchingCustomers);
      }

      customerOptionsContainer.replaceChildren(
        ...matchingCustomers.map((customer) => {
          return customer.cloneNode(true);
        }),
      );

      if (matchingCustomers.length === 0) {
        showCustomerPickerMessage("No match found");
        return;
      }

      customerOptionsEmpty.hidden = true;
    }

    function getRenderedCustomerOptions() {
      return Array.from(
        customerOptionsContainer?.querySelectorAll<HTMLButtonElement>("[data-customer-id]") ?? [],
      );
    }

    function fillCustomerFields(customer: HTMLElement | undefined) {
      if (firstNameInput) firstNameInput.value = customer?.dataset.customerFirstName ?? "";
      if (lastNameInput) lastNameInput.value = customer?.dataset.customerLastName ?? "";
      if (phoneNumberInput) phoneNumberInput.value = customer?.dataset.customerPhoneNumber ?? "";
      if (emailInput) emailInput.value = customer?.dataset.customerEmail ?? "";
      if (addressTextarea) addressTextarea.value = customer?.dataset.customerAddress ?? "";
      if (assignedAgentSelect) assignedAgentSelect.value = customer?.dataset.customerAssignedAgentId ?? "";
      if (isResellerCheckbox) isResellerCheckbox.checked = customer?.dataset.customerIsReseller === "true";
    }

    function refreshCustomerMode() {
      const selectedCustomer = getRenderedCustomerOptions().find(
        (option) => option.dataset.customerLabel === customerSearch?.value,
      );
      const selectedCustomerId = selectedCustomer?.dataset.customerId ?? "";

      if (customerIdInput) {
        customerIdInput.value = selectedCustomerId;
      }

      fillCustomerFields(selectedCustomer);

      const fields = newCustomerFields?.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        "input, select, textarea",
      );
      fields?.forEach((field) => {
        if (field === customerIdInput) return;
        field.disabled = selectedCustomerId.length > 0;
      });
      newCustomerFields?.toggleAttribute("data-disabled", selectedCustomerId.length > 0);
    }

    function updateOrderItemTitle(scope: ParentNode) {
      const title = scope.querySelector<HTMLElement>("[data-order-item-title]");
      const select = scope.querySelector<HTMLSelectElement>("[data-order-product-select]");
      const selectedOption = select?.selectedOptions?.[0];
      const productName = selectedOption?.dataset.productName?.trim() || "Select product";
      if (title) title.textContent = productName;
    }

    function bindOrderItem(scope: ParentNode) {
      const select = scope.querySelector<HTMLSelectElement>("[data-order-product-select]");
      select?.addEventListener("change", () => updateOrderItemTitle(scope));
      updateOrderItemTitle(scope);
    }

    orderItems?.querySelectorAll<HTMLElement>(".order-item-accordion").forEach((item) => {
      bindOrderItem(item);
    });

    addOrderItemButton?.addEventListener("click", () => {
      const templateItem = orderItemTemplate?.content.firstElementChild;

      if (!orderItems || !templateItem) return;

      const clonedItem = templateItem.cloneNode(true);
      orderItems.append(clonedItem);

      if (clonedItem instanceof HTMLElement) {
        bindOrderItem(clonedItem);
      }

      if (clonedItem instanceof HTMLDetailsElement) {
        clonedItem.open = true;
      }
    });

    orderItems?.addEventListener("click", (event) => {
      const target = event.target;
      const removeButton = target instanceof HTMLElement
        ? target.closest<HTMLElement>("[data-remove-order-item]")
        : null;

      if (!removeButton) return;

      event.preventDefault();
      event.stopPropagation();
      removeButton.closest(".order-item-accordion")?.remove();
    });

    customerSearch?.addEventListener("input", () => {
      window.clearTimeout(customerSearchTimer);
      setCustomerPickerOpen(true);

      const searchValue = customerSearch.value;
      if (searchValue.trim().length === 0) {
        renderCustomerOptions("");
        refreshCustomerMode();
        return;
      }

      showCustomerPickerSkeleton();
      customerSearchTimer = window.setTimeout(() => {
        renderCustomerOptions(searchValue);
        refreshCustomerMode();
      }, 450);
    });

    customerSearch?.addEventListener("focus", () => {
      renderCustomerOptions(customerSearch.value);
      setCustomerPickerOpen(true);
    });

    customerPickerToggle?.addEventListener("click", () => {
      renderCustomerOptions(customerSearch?.value ?? "");
      const isOpen = customerPickerToggle.getAttribute("aria-expanded") === "true";
      setCustomerPickerOpen(!isOpen);
    });

    customerOptionsContainer?.addEventListener("click", (event) => {
      const target = event.target;
      const option = target instanceof HTMLElement
        ? target.closest<HTMLButtonElement>("[data-customer-id]")
        : null;

      if (!option || !customerSearch) return;

      customerSearch.value = option.dataset.customerLabel ?? "";
      refreshCustomerMode();
      setCustomerPickerOpen(false);
    });

    document.addEventListener("click", (event) => {
      if (!customerPicker) return;
      const target = event.target;
      if (target instanceof Node && customerPicker.contains(target)) return;
      setCustomerPickerOpen(false);
    });

    renderCustomerOptions(customerSearch?.value ?? "");
    setCustomerPickerOpen(false);
    refreshCustomerMode();
  }

  document.addEventListener("DOMContentLoaded", initCreateOrderSheet);
  document.addEventListener("astro:after-swap", initCreateOrderSheet);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initCreateOrderSheet();
  }

  function initAdminOrderFilters() {
    const form = document.querySelector<HTMLFormElement>("[data-order-filter-form]");
    const tableShell = document.querySelector<HTMLElement>("[data-order-table-shell]");
    const skeletonTemplate = document.querySelector<HTMLTemplateElement>("[data-order-filter-skeleton]");
    const resetLink = document.querySelector<HTMLAnchorElement>("[data-order-filter-reset]");

    if (!form || !tableShell || !skeletonTemplate) return;
    if (form.dataset.orderFilterInitialized === "true") return;
    form.dataset.orderFilterInitialized = "true";

    const activeForm = form;
    const activeTableShell = tableShell;
    const activeSkeletonTemplate = skeletonTemplate;
    const cacheKey = "admin-orders-filter-cache-v1";
    const fragmentPath = "/admin/orders-fragment";
    const filterKeys = ["search", "source", "orderStatus", "paymentStatus", "minTotal", "maxTotal"] as const;
    const autoSubmitFields = activeForm.querySelectorAll<HTMLSelectElement>("select");
    const searchInput = activeForm.querySelector<HTMLInputElement>("[data-order-search-input]");
    const totalRange = activeForm.querySelector<HTMLElement>("[data-order-total-range]");
    const minRange = activeForm.querySelector<HTMLInputElement>("[data-total-min-range]");
    const maxRange = activeForm.querySelector<HTMLInputElement>("[data-total-max-range]");
    const minHidden = activeForm.querySelector<HTMLInputElement>("[data-total-min-hidden]");
    const maxHidden = activeForm.querySelector<HTMLInputElement>("[data-total-max-hidden]");
    const minLabel = activeForm.querySelector<HTMLElement>("[data-total-min-label]");
    const maxLabel = activeForm.querySelector<HTMLElement>("[data-total-max-label]");
    const rangeFill = activeForm.querySelector<HTMLElement>("[data-total-range-fill]");
    const totalMin = Number(totalRange?.dataset.totalMin ?? "0");
    const totalMax = Number(totalRange?.dataset.totalMax ?? "1");
    let submitTimer: number | undefined;
    let searchTimer: number | undefined;
    let activeFetchController: AbortController | undefined;

    function readCache(): string[] {
      try {
        const parsed = JSON.parse(sessionStorage.getItem(cacheKey) || "[]");
        return Array.isArray(parsed)
          ? parsed.filter((value): value is string => typeof value === "string")
          : [];
      } catch {
        return [];
      }
    }

    function writeCache(values: string[]) {
      sessionStorage.setItem(cacheKey, JSON.stringify([...new Set(values)]));
    }

    function normalizeParams(params: URLSearchParams) {
      const normalized = new URLSearchParams();

      filterKeys.forEach((key) => {
        const value = params.get(key)?.trim();
        if (value) normalized.set(key, value);
      });

      return normalized.toString();
    }

    function normalizeFormQuery() {
      const params = new URLSearchParams();
      const formData = new FormData(activeForm);

      filterKeys.forEach((key) => {
        const value = formData.get(key);
        if (typeof value === "string" && value.trim()) {
          params.set(key, value.trim());
        }
      });

      return params.toString();
    }

    function buildUrl(path: string, targetQuery: string) {
      return targetQuery ? `${path}?${targetQuery}` : path;
    }

    function formatTotal(value: number) {
      return new Intl.NumberFormat("en-PH", {
        style: "currency",
        currency: "PHP",
        maximumFractionDigits: 0,
      }).format(value);
    }

    function syncTotalRange() {
      if (!minRange || !maxRange || !minHidden || !maxHidden) return;

      let minValue = Number(minRange.value);
      let maxValue = Number(maxRange.value);

      if (minValue > maxValue) {
        if (document.activeElement === minRange) {
          maxValue = minValue;
          maxRange.value = String(maxValue);
        } else {
          minValue = maxValue;
          minRange.value = String(minValue);
        }
      }

      minHidden.value = minValue > totalMin ? String(minValue) : "";
      maxHidden.value = maxValue < totalMax ? String(maxValue) : "";

      if (minLabel) minLabel.textContent = formatTotal(minValue);
      if (maxLabel) maxLabel.textContent = formatTotal(maxValue);

      if (rangeFill) {
        const span = Math.max(totalMax - totalMin, 1);
        const left = ((minValue - totalMin) / span) * 100;
        const right = 100 - ((maxValue - totalMin) / span) * 100;
        rangeFill.style.left = `${left}%`;
        rangeFill.style.right = `${right}%`;
      }
    }

    function showSkeletonForQuery(targetQuery: string) {
      const currentQuery = normalizeParams(new URLSearchParams(window.location.search));
      const cachedQueries = readCache();

      if (targetQuery === currentQuery || cachedQueries.includes(targetQuery)) {
        return;
      }

      const skeleton = activeSkeletonTemplate.content.firstElementChild?.cloneNode(true);
      if (!skeleton) return;

      activeTableShell.replaceChildren(skeleton);
    }

    function replaceOrdersFragment(fragmentHtml: string) {
      const parsed = new DOMParser().parseFromString(fragmentHtml, "text/html");
      const nextTableShell = parsed.querySelector<HTMLElement>("[data-order-table-shell]");

      if (!nextTableShell) {
        throw new Error("Orders fragment did not include an order table.");
      }

      activeTableShell.innerHTML = nextTableShell.innerHTML;
      document.dispatchEvent(new Event("dashboard:interactive-table-updated"));
    }

    async function applyFilters(targetQuery: string) {
      const currentQuery = normalizeParams(new URLSearchParams(window.location.search));

      if (targetQuery === currentQuery) {
        return;
      }

      showSkeletonForQuery(targetQuery);
      activeFetchController?.abort();

      const fetchController = new AbortController();
      activeFetchController = fetchController;

      try {
        const response = await fetch(buildUrl(fragmentPath, targetQuery), {
          headers: {
            "X-Requested-With": "fetch",
          },
          signal: fetchController.signal,
        });

        if (!response.ok) {
          throw new Error(`Order filters failed with ${response.status}.`);
        }

        const fragmentHtml = await response.text();
        window.history.replaceState(
          { orderFilterQuery: targetQuery },
          "",
          buildUrl("/admin/orders", targetQuery),
        );
        replaceOrdersFragment(fragmentHtml);
        activeForm.dataset.currentFilterQuery = targetQuery;
        if (resetLink) resetLink.hidden = targetQuery.length === 0;
        writeCache([...readCache(), targetQuery]);
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError") {
          return;
        }

        window.location.href = buildUrl("/admin/orders", targetQuery);
      } finally {
        if (activeFetchController === fetchController) {
          activeFetchController = undefined;
        }
      }
    }

    function submitFilters() {
      window.clearTimeout(submitTimer);
      submitTimer = window.setTimeout(() => {
        syncTotalRange();
        void applyFilters(normalizeFormQuery());
      }, 120);
    }

    writeCache([...readCache(), normalizeParams(new URLSearchParams(window.location.search))]);

    activeForm.addEventListener("submit", (event) => {
      event.preventDefault();
      syncTotalRange();
      void applyFilters(normalizeFormQuery());
    });

    autoSubmitFields.forEach((field) => {
      field.addEventListener("change", submitFilters);
    });

    searchInput?.addEventListener("input", () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(submitFilters, 450);
    });

    minRange?.addEventListener("input", syncTotalRange);
    maxRange?.addEventListener("input", syncTotalRange);
    minRange?.addEventListener("change", submitFilters);
    maxRange?.addEventListener("change", submitFilters);
    syncTotalRange();

    resetLink?.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
        return;
      }

      event.preventDefault();
      void applyFilters("");
    });
  }

  document.addEventListener("DOMContentLoaded", initAdminOrderFilters);
  document.addEventListener("astro:after-swap", initAdminOrderFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAdminOrderFilters();
  }
</script>
