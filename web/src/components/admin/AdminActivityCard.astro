---
import type { AdminActivityTableRow } from "@/lib/admin-dashboard/data";
import { formatDateTime } from "@/lib/admin-dashboard/view";
import { autoCapitalize } from "@/lib/formatters";
import { resolveStatusBadgeVariant } from "@/lib/status-badge";

type Props = {
  item: AdminActivityTableRow;
};

const { item } = Astro.props;
const categoryLabel = autoCapitalize(item.category);
const severity = resolveStatusBadgeVariant("activity", item.category);
---

<article class="activity-item">
  <div class="activity-item__content">
    <div class="activity-item__meta">
      <span class={`activity-item__type activity-item__type--${severity}`}>
        {
          item.category === "order" && (
            <svg class="activity-item__type-icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="9" cy="21" r="1" />
              <circle cx="20" cy="21" r="1" />
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
            </svg>
          )
        }
        {
          item.category === "customer" && (
            <svg class="activity-item__type-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
          )
        }
        {
          item.category === "product" && (
            <svg class="activity-item__type-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
              <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
              <line x1="12" y1="22.08" x2="12" y2="12" />
            </svg>
          )
        }
        {
          item.category === "invoice" && (
            <svg class="activity-item__type-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" />
              <line x1="16" y1="13" x2="8" y2="13" />
              <line x1="16" y1="17" x2="8" y2="17" />
            </svg>
          )
        }
        {
          item.category === "content" && (
            <svg class="activity-item__type-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
              <path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4z" />
            </svg>
          )
        }
        {
          item.category === "inquiry" && (
            <svg class="activity-item__type-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
          )
        }
        {
          item.category === "reseller" && (
            <svg class="activity-item__type-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="8.5" cy="7" r="4" />
              <polyline points="17 11 19 13 23 9" />
            </svg>
          )
        }
        <span>{categoryLabel}</span>
      </span>
      <time class="activity-item__time" datetime={item.occurredAt}>
        {formatDateTime(item.occurredAt)}
      </time>
    </div>

    <h3 class="activity-item__title">{item.title}</h3>
    <p class="activity-item__message">{item.detail}</p>
  </div>
</article>

<style>
  .activity-item {
    padding: 1rem 1rem 0.9rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: #ffffff;
    transition: border-color 0.2s ease;
  }

  .activity-item:hover {
    border-color: #d1d5db;
  }

  .activity-item__content {
    display: grid;
    gap: 0.55rem;
    min-width: 0;
  }

  .activity-item__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem 0.65rem;
  }

  .activity-item__type {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.18rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .activity-item__type-icon {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .activity-item__type--warning {
    background: #fef3c7;
    color: #92400e;
  }

  .activity-item__type--info {
    background: #dbeafe;
    color: #1e40af;
  }

  .activity-item__type--success {
    background: #d1fae5;
    color: #065f46;
  }

  .activity-item__type--neutral {
    background: #f3f4f6;
    color: #4b5563;
  }

  .activity-item__time {
    font-size: 0.78rem;
    color: #6b7280;
    font-weight: 500;
  }

  .activity-item__title {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.35;
    font-weight: 700;
    color: #111827;
    letter-spacing: -0.01em;
  }

  .activity-item__message {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: #4b5563;
  }
</style>
