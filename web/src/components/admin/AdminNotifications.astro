---
import type { AdminDashboardData } from "@/lib/admin-dashboard/data";
import { buildAdminNotifications } from "@/lib/admin-dashboard/notifications";
import { formatDate } from "@/lib/admin-dashboard/view";

type Props = {
  data: AdminDashboardData;
};

const { data } = Astro.props;
const notifications = buildAdminNotifications(data);
---

<section id="admin-notifications" class="admin-panel" aria-labelledby="admin-notifications-title" style="max-width: 48rem; margin: 0 auto;">
  <div data-interactive-table>
    <div class="table-filters" style="justify-content: flex-end; gap: 0.75rem;">
      <form method="post" style="margin: 0;">
        <input type="hidden" name="action" value="mark-all-admin-notifications-read" />
        <button type="submit" class="btn-table-manage" style="padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.9rem; font-weight: 600; letter-spacing: normal;">Mark All as Read</button>
      </form>
    </div>

    <div style="display: flex; flex-direction: column; gap: 1rem;" data-notifications-list>
      {notifications.map((notif) => (
        <article
          class={`admin-card notification-item${notif.isUnread ? "" : " read"}`}
          style="border-radius: 0.5rem; display: flex; flex-direction: column; gap: 0.5rem; transition: opacity 0.2s ease, transform 0.2s ease;"
        >
          <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <span
                class={`notification-badge badge-${notif.severity}`}
                style="padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;"
              >
                {notif.type}
              </span>
              <strong style="font-size: 1.05rem; color: var(--color-brand-red);">{notif.title}</strong>
              {notif.isUnread && <span class="unread-dot" style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: var(--color-brand-gold);"></span>}
            </div>
            <span style="font-size: 0.85rem; color: var(--color-brand-muted-black); font-weight: 500;">{formatDate(notif.date)}</span>
          </div>

          <p style="margin: 0.25rem 0; font-size: 0.95rem; line-height: 1.5; color: var(--color-brand-muted-black);">{notif.message}</p>

          <div style="display: flex; gap: 0.75rem; margin-top: 0.25rem; align-items: center;">
            <a href={notif.link} class="btn-table-manage" style="text-decoration: none; padding: 0.35rem 0.75rem; font-size: 0.85rem;">View Details</a>
            {notif.isUnread ? (
              <form method="post" style="margin: 0;">
                <input type="hidden" name="action" value="mark-admin-notification-read" />
                <input type="hidden" name="notificationId" value={notif.id} />
                <button type="submit" class="btn-table-manage" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background-color: transparent; border: 1px solid #d1d5db; color: var(--color-brand-muted-black);">Mark as read</button>
              </form>
            ) : (
              <span style="font-size: 0.85rem; color: var(--color-brand-muted-black);">Read</span>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .badge-warning {
    background-color: #fef3c7;
    color: #92400e;
  }
  .badge-info {
    background-color: #dbeafe;
    color: #1e40af;
  }
  .badge-success {
    background-color: #d1fae5;
    color: #065f46;
  }
  .notification-item.read {
    opacity: 0.65;
  }
  .notification-item.read .unread-dot {
    display: none !important;
  }
</style>
