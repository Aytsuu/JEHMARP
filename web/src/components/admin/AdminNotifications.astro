---
import type { AdminDashboardData } from "@/lib/admin-dashboard/data";
import { buildAdminNotifications } from "@/lib/admin-dashboard/notifications";
import AdminNotificationCard from "./AdminNotificationCard.astro";

type Props = {
  data: AdminDashboardData;
};

const { data } = Astro.props;
const notifications = buildAdminNotifications(data);
const unreadCount = notifications.filter((notification) => notification.isUnread).length;
---

<section
  id="admin-notifications"
  class="admin-notifications"
  aria-labelledby="admin-notifications-title"
>
  <div class="admin-notifications__toolbar">
    <p class="admin-notifications__summary">
      {
        unreadCount > 0 ? (
          <>
            <span class="admin-notifications__summary-count">{unreadCount}</span>
            unread notification{unreadCount === 1 ? "" : "s"}
          </>
        ) : (
          "All caught up"
        )
      }
    </p>

    {
      unreadCount > 0 && (
        <form method="post" class="admin-notifications__form">
          <input type="hidden" name="action" value="mark-all-admin-notifications-read" />
          <button type="submit" class="notification-action notification-action--secondary notification-action--compact">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            <span>Mark all as read</span>
          </button>
        </form>
      )
    }
  </div>

  <div class="admin-notifications__list" data-notifications-list>
    {notifications.map((notif) => <AdminNotificationCard notification={notif} />)}
  </div>
</section>

<style>
  .admin-notifications__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .admin-notifications__summary {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: #4b5563;
  }

  .admin-notifications__summary-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.35rem;
    height: 1.35rem;
    margin-right: 0.35rem;
    padding: 0 0.35rem;
    border-radius: 9999px;
    background: #fef3c7;
    color: #92400e;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .admin-notifications__form {
    margin: 0;
  }

  .notification-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .notification-action svg {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .notification-action--secondary {
    background-color: #f3f4f6;
    border-color: #e5e7eb;
    color: #4b5563;
  }

  .notification-action--secondary:hover,
  .notification-action--secondary:focus-visible {
    background-color: #e5e7eb;
    border-color: #d1d5db;
    color: #374151;
    outline: none;
  }

  .notification-action--compact {
    min-height: 1.75rem;
    padding: 0.28rem 0.55rem;
    font-size: 0.78rem;
  }

  .admin-notifications__toolbar .notification-action--compact {
    padding: 0.35rem 0.65rem;
    font-size: 0.8rem;
  }

  .admin-notifications__list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
</style>
