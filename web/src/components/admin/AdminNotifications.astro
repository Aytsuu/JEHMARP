---
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import type { AdminNotificationsPageData } from "@/lib/admin-dashboard/notifications";
import AdminNotificationCard from "./AdminNotificationCard.astro";

type Props = {
  data: AdminNotificationsPageData;
  paginationQuery: string;
};

const { data, paginationQuery } = Astro.props;
const { notifications, pagination, unreadCount } = data;
const skeletonItems = Array.from({ length: 3 });
---

<section
  id="admin-notifications"
  class="admin-notifications"
  aria-labelledby="admin-notifications-title"
>
  <form
    method="get"
    action="/admin/notifications"
    data-notifications-pagination-form
    data-current-filter-query={paginationQuery}
    hidden
    aria-hidden="true"
  ></form>

  <div data-interactive-table data-server-pagination="true" class="admin-notifications__feed">
    <div class="admin-notifications__toolbar">
      <p class="admin-notifications__summary">
        {
          unreadCount > 0 ? (
            <>
              {unreadCount} unread notification{unreadCount === 1 ? "" : "s"}
            </>
          ) : (
            "All caught up"
          )
        }
      </p>

      {
        unreadCount > 0 && (
          <form method="post" class="admin-notifications__form">
            <input type="hidden" name="action" value="mark-all-admin-notifications-read" />
            <button type="submit" class="notification-action notification-action--secondary notification-action--compact">
              <svg viewBox="0 0 24 24" aria-hidden="true"
                ><polyline points="20 6 9 17 4 12"></polyline></svg
              >
              <span>Mark all as read</span>
            </button>
          </form>
        )
      }
    </div>

    <div data-notifications-list-shell class="admin-notifications__list">
      {notifications.map((notif) => <AdminNotificationCard notification={notif} />)}
    </div>

    <DashboardTablePagination pagination={pagination} />
  </div>

  <template data-notifications-pagination-skeleton>
    <div class="admin-notifications__list" aria-busy="true" aria-live="polite">
      {
        skeletonItems.map(() => (
          <article class="admin-notifications__skeleton-card">
            <span class="table-skeleton-block table-skeleton-block--short"></span>
            <span class="table-skeleton-block"></span>
            <span class="table-skeleton-block table-skeleton-block--wide"></span>
          </article>
        ))
      }
    </div>
  </template>
</section>

<script>
  import { initDashboardFragmentTable } from "@/lib/client/dashboard-fragment-table";

  function initAdminNotificationsPagination() {
    initDashboardFragmentTable({
      cacheKey: "admin-notifications-pagination-cache-v1",
      fragmentPath: "/admin/notifications-fragment",
      pagePath: "/admin/notifications",
      formSelector: "[data-notifications-pagination-form]",
      tableShellSelector: "[data-notifications-list-shell]",
      skeletonTemplateSelector: "[data-notifications-pagination-skeleton]",
      filterKeys: [],
      historyStateKey: "notificationsPaginationQuery",
    });
  }

  document.addEventListener("DOMContentLoaded", initAdminNotificationsPagination);
  document.addEventListener("astro:after-swap", initAdminNotificationsPagination);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAdminNotificationsPagination();
  }
</script>

<style>
  .admin-notifications__feed {
    display: grid;
    gap: 0;
  }

  .admin-notifications__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .admin-notifications__summary {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: #4b5563;
  }

  .admin-notifications__form {
    margin: 0;
  }

  .notification-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .notification-action svg {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .notification-action--secondary {
    background-color: #f3f4f6;
    border-color: #e5e7eb;
    color: #4b5563;
  }

  .notification-action--secondary:hover:not(:disabled),
  .notification-action--secondary:focus-visible:not(:disabled) {
    background-color: #e5e7eb;
    border-color: #d1d5db;
    color: #374151;
    outline: none;
  }

  .notification-action--compact {
    min-height: 1.75rem;
    padding: 0.28rem 0.55rem;
    font-size: 0.78rem;
  }

  .admin-notifications__toolbar .notification-action--compact {
    padding: 0.35rem 0.65rem;
    font-size: 0.8rem;
  }

  .admin-notifications__list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .admin-notifications__skeleton-card {
    display: grid;
    gap: 0.55rem;
    padding: 1rem;
    border: 1px solid rgba(17, 24, 39, 0.08);
    border-radius: 0.75rem;
    background: #ffffff;
  }

  .admin-notifications :global(.dashboard-interactive-table__footer) {
    border-top: 1px solid #e5e7eb;
    background: transparent;
    min-height: 0;
  }

  .admin-notifications :global(.dashboard-interactive-table__footer .table-pagination) {
    margin-top: 0;
    padding: 0.75rem 0 0;
  }
</style>
