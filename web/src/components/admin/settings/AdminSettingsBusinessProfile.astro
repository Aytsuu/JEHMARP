---
import type { PlatformSettings } from "@/lib/platform-settings";
import { resolvePublicStorageUrl } from "@/lib/supabase/storage";

type Props = { settings: PlatformSettings };
const { settings } = Astro.props;
const profile = settings.businessProfile;
const logoUrl = resolvePublicStorageUrl(profile.logoPath);
---

<section class="admin-card admin-settings-card">
  <header class="admin-card__header">
    <h3>Business profile</h3>
    <p>Legal identity and logo used on the public site and printed documents.</p>
  </header>
  <form method="post" class="admin-form admin-settings-form" enctype="multipart/form-data" data-astro-reload>
    <input type="hidden" name="action" value="save-platform-settings-business-profile" />
    <input type="hidden" name="logoPath" value={profile.logoPath ?? ""} />
    <div class="admin-form-grid admin-settings-form__grid">
      <label class="field-row"><span>Trade name</span><input name="tradeName" required value={profile.tradeName} /></label>
      <label class="field-row"><span>Legal name</span><input name="legalName" value={profile.legalName} /></label>
      <label class="field-row"><span>Phone</span><input name="phone" required value={profile.phone} /></label>
      <label class="field-row"><span>TIN / BIR details</span><input name="tin" value={profile.tin} /></label>
      <label class="field-row admin-settings-form__full"><span>Address</span><textarea name="address" rows="3" required>{profile.address}</textarea></label>
      <div class="field-row admin-settings-form__full">
        <span>Logo</span>
        <div class="admin-settings-logo-field">
          {logoUrl ? <img src={logoUrl} alt="" class="admin-settings-logo-field__preview" /> : <div class="admin-settings-logo-field__placeholder">No logo uploaded</div>}
          <input name="logoFile" type="file" accept="image/png,image/jpeg,image/webp,image/gif" />
          {logoUrl && <label class="checkbox-row"><input name="removeLogo" type="checkbox" /><span>Remove current logo</span></label>}
        </div>
      </div>
    </div>
    <div class="admin-settings-form__actions"><button type="submit">Save business profile</button></div>
  </form>
</section>

<style>
  .admin-settings-form__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .admin-settings-form__full { grid-column: 1 / -1; }
  .admin-settings-logo-field { display: grid; gap: 0.75rem; }
  .admin-settings-logo-field__preview, .admin-settings-logo-field__placeholder { width: 7rem; height: 7rem; border-radius: 0.75rem; border: 1px solid #e5e7eb; object-fit: contain; background: #fff; }
  .admin-settings-logo-field__placeholder { display: grid; place-items: center; color: #9ca3af; font-size: 0.75rem; text-align: center; padding: 0.5rem; }
  .admin-settings-form__actions { display: flex; justify-content: flex-end; margin-top: 1rem; }
</style>
