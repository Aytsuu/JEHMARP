---
import type { PlatformSettings } from "@/lib/platform-settings";
type Props = { settings: PlatformSettings };
const { settings } = Astro.props;
---

<section class="admin-card admin-settings-card">
  <header class="admin-card__header">
    <h3>Defaults</h3>
    <p>Business rules applied when creating new records.</p>
  </header>
  <form method="post" class="admin-form admin-settings-form" data-astro-reload>
    <input type="hidden" name="action" value="save-platform-settings-defaults" />
    <label class="field-row">
      <span>Default customer credit limit</span>
      <input name="customerCreditLimit" type="number" min="0" step="1" required value={settings.defaults.customerCreditLimit} />
    </label>
    <p class="admin-settings-help">Applies to new customers only. Existing customer credit limits stay unchanged.</p>
    <div class="admin-settings-form__actions"><button type="submit">Save defaults</button></div>
  </form>
</section>

<style>
  .admin-settings-help { margin: 0.75rem 0 0; font-size: 0.8125rem; color: #6b7280; }
  .admin-settings-form__actions { display: flex; justify-content: flex-end; margin-top: 1rem; }
</style>
