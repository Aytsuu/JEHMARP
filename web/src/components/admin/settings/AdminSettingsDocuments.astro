---
import type { PlatformSettings } from "@/lib/platform-settings";
type Props = { settings: PlatformSettings };
const { settings } = Astro.props;
const payment = settings.documentPayment;
const numbering = settings.documentNumbering;
---

<section class="admin-card admin-settings-card">
  <header class="admin-card__header">
    <h3>Documents</h3>
    <p>Payment instructions for order slips and invoices, plus invoice numbering preferences.</p>
  </header>
  <form method="post" class="admin-form admin-settings-form" data-astro-reload>
    <input type="hidden" name="action" value="save-platform-settings-document-payment" />
    <div class="admin-form-grid admin-settings-form__grid">
      <label class="field-row admin-settings-form__full"><span>Payment instructions</span><textarea name="paymentInstructions" rows="4">{payment.instructions}</textarea></label>
      <label class="field-row"><span>Bank name</span><input name="bankName" value={payment.bankName} /></label>
      <label class="field-row"><span>Account name</span><input name="accountName" value={payment.accountName} /></label>
      <label class="field-row"><span>Account number</span><input name="accountNumber" value={payment.accountNumber} /></label>
      <label class="field-row"><span>GCash number</span><input name="gcashNumber" value={payment.gcashNumber} /></label>
      <label class="field-row"><span>Maya number</span><input name="mayaNumber" value={payment.mayaNumber} /></label>
    </div>
    <div class="admin-settings-form__actions"><button type="submit">Save payment details</button></div>
  </form>
  <form method="post" class="admin-form admin-settings-form admin-settings-form--section" data-astro-reload>
    <input type="hidden" name="action" value="save-platform-settings-document-numbering" />
    <h4>Document numbering</h4>
    <p class="admin-settings-help">Invoice numbers use the prefix plus the Postgres sequence.</p>
    <div class="admin-form-grid admin-settings-form__grid">
      <label class="field-row"><span>Invoice prefix</span><input name="invoicePrefix" required value={numbering.invoicePrefix} /></label>
      <label class="field-row"><span>Invoice next number</span><input name="invoiceNext" type="number" min="1" step="1" required value={numbering.invoiceNext} /></label>
      <label class="field-row"><span>Order slip prefix</span><input name="orderSlipPrefix" required value={numbering.orderSlipPrefix} /></label>
      <label class="field-row"><span>Order slip next number</span><input name="orderSlipNext" type="number" min="1" step="1" required value={numbering.orderSlipNext} /></label>
    </div>
    <div class="admin-settings-form__actions"><button type="submit">Save numbering preferences</button></div>
  </form>
</section>

<style>
  .admin-settings-form__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .admin-settings-form__full { grid-column: 1 / -1; }
  .admin-settings-form--section { margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb; }
  .admin-settings-help { margin: 0 0 1rem; font-size: 0.8125rem; color: #6b7280; }
  .admin-settings-form__actions { display: flex; justify-content: flex-end; margin-top: 1rem; }
</style>
