---
type Props = {
  status: "pending" | "sent" | "failed";
  error?: string | null;
};

const { status, error } = Astro.props;

const failedMessage = error?.trim() || "Email delivery failed.";
const ariaLabel =
  status === "sent"
    ? "Price list email sent"
    : status === "failed"
      ? `Price list email failed: ${failedMessage}`
      : "Price list email pending";
---

<span
  class:list={[
    "dashboard-table__delivery-status",
    `dashboard-table__delivery-status--${status}`,
  ]}
  title={status === "failed" ? failedMessage : undefined}
  aria-label={ariaLabel}
>
  {
    status === "sent" && (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h8"></path>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        <path d="m16 19 2 2 4-4"></path>
      </svg>
    )
  }
  {
    status === "failed" && (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h8"></path>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        <path d="m17 17 5 5"></path>
        <path d="m22 17-5 5"></path>
      </svg>
    )
  }
  {
    status === "pending" && (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect width="20" height="16" x="2" y="4" rx="2"></rect>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
      </svg>
    )
  }
  {status === "failed" && <span class="sr-only">{failedMessage}</span>}
</span>
