---
import type { AdminInquiryManagementData } from "@/lib/admin-dashboard/data";
import type { AdminInquiryFilters } from "@/lib/admin-dashboard/inquiry-filters";
import { selected } from "@/lib/admin-dashboard/view";
import { autoCapitalize } from "@/lib/formatters";

type Props = {
  data: AdminInquiryManagementData;
  inquiryStatuses: readonly string[];
  activeFilters: AdminInquiryFilters;
  filterQuery: string;
};

const { data, inquiryStatuses, activeFilters, filterQuery } = Astro.props;
const hasActiveFilters = filterQuery.length > 0;
const skeletonRows = Array.from({ length: 6 });
---

<section id="admin-inquiries" class="admin-panel" aria-labelledby="admin-inquiries-title">
  <div data-interactive-table>
    <div class="table-filters order-management-toolbar">
      <form method="get" action="/admin/inquiries" class="order-filter-form" data-inquiry-filter-form data-current-filter-query={filterQuery} aria-label="Filter inquiries">
        <label class="order-filter-form__field order-filter-form__field--search">
          <span>Search</span>
          <input name="search" type="search" value={activeFilters.search ?? ""} placeholder="Search name, email, or contact..." autocomplete="off" data-inquiry-search-input />
        </label>
        <label class="order-filter-form__field">
          <span>Status</span>
          <select name="status">
            <option value="">All statuses</option>
            {inquiryStatuses.map((status) => (
              <option value={status} selected={activeFilters.status === status}>{autoCapitalize(status)}</option>
            ))}
          </select>
        </label>
        <a href="/admin/inquiries" class="order-filter-form__reset" data-inquiry-filter-reset hidden={!hasActiveFilters}>Clear</a>
      </form>
      <div class="order-management-toolbar__actions">
        <label class="order-management-toolbar__limit">
          <span>Show</span>
          <select data-limit-select><option value="10">10</option><option value="50">50</option><option value="100">100</option></select>
        </label>
      </div>
    </div>
    <div data-inquiry-table-shell>
      {data.contactInquiries.length > 0 ? (
        <div class="table-wrap">
          <table style="table-layout: fixed; width: 100%;">
            <thead><tr><th scope="col" style="width: 18%; padding: 1.1rem 0.75rem;">Name</th><th scope="col" style="width: 18%; padding: 1.1rem 0.75rem;">Email</th><th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Contact</th><th scope="col" style="width: 32%; padding: 1.1rem 0.75rem;">Message</th><th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Status</th></tr></thead>
            <tbody>
              {data.contactInquiries.map((inquiry) => {
                const isUnread = !inquiry.admin_read_at && inquiry.inquiry_status === "new";
                return (
                  <tr data-status={inquiry.inquiry_status}>
                    <td style="width: 18%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><div style="display: flex; align-items: center; gap: 0.5rem; width: 100%; overflow: hidden;"><span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500;">{inquiry.name}</span>{isUnread && (<form method="post" class="unread-record-form" style="margin: 0; display: inline-flex; align-items: center; flex-shrink: 0;"><input type="hidden" name="action" value="mark-inquiry-read" /><input type="hidden" name="inquiryId" value={inquiry.id} /><button type="submit" class="unread-record-button" style="border: none; background: transparent; padding: 0; cursor: pointer; display: inline-flex; align-items: center;"><span class="record-unread-dot" aria-label="Unread" style="width: 8px; height: 8px; background-color: var(--color-brand-red); border-radius: 50%; display: inline-block;"></span><span class="sr-only">Mark inquiry as read</span></button></form>)}</div></td>
                    <td style="width: 18%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{inquiry.email ?? "-"}</td>
                    <td style="width: 16%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{inquiry.phone_number ?? "-"}</td>
                    <td style="width: 32%; padding: 1.1rem 0.75rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title={inquiry.message}>{inquiry.message}</td>
                    <td style="width: 16%; padding: 1.1rem 0.75rem; vertical-align: middle;"><form method="post" class="admin-table-form" style="margin: 0; width: 100%;"><input type="hidden" name="action" value="update-inquiry" /><input type="hidden" name="inquiryId" value={inquiry.id} /><input type="hidden" name="internalNotes" value={inquiry.internal_notes ?? ""} /><select name="inquiryStatus" onchange="this.form.submit()" required style="padding: 0.25rem 0.5rem; font-size: 0.9rem; border-radius: 0.375rem; border: 1px solid #d1d5db; background-color: #ffffff; cursor: pointer; width: 100%;">{inquiryStatuses.map((status) => (<option value={status} selected={selected(inquiry.inquiry_status, status)}>{autoCapitalize(status)}</option>))}</select></form></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-state">No inquiries match the selected filters.</p>
      )}
    </div>
    <div class="table-pagination"><span data-page-info style="font-size: 0.9rem; color: var(--color-brand-muted-black); font-weight: 500;"></span><div style="display: flex; gap: 0.25rem; align-items: center;"><button type="button" data-pagination-prev class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&lt;</button><div data-pagination-numbers style="display: flex; gap: 0.25rem;"></div><button type="button" data-pagination-next class="btn-secondary" style="padding: 0.25rem 0.75rem; border: none; border-radius: 0.25rem; cursor: pointer;">&gt;</button></div></div>
  </div>
  <template data-inquiry-filter-skeleton><div class="table-wrap" aria-busy="true" aria-live="polite"><table class="product-table-skeleton" style="table-layout: fixed; width: 100%;"><caption class="sr-only">Loading filtered inquiries</caption><thead><tr><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Contact</th><th scope="col">Message</th><th scope="col">Status</th></tr></thead><tbody>{skeletonRows.map(() => (<tr><td><span class="table-skeleton-block"></span></td><td><span class="table-skeleton-block"></span></td><td><span class="table-skeleton-block"></span></td><td><span class="table-skeleton-block"></span></td><td><span class="table-skeleton-block table-skeleton-block--short"></span></td></tr>))}</tbody></table></div></template>
</section>

<script>
  function initAdminInquiryFilters() {
    const form = document.querySelector<HTMLFormElement>("[data-inquiry-filter-form]");
    const tableShell = document.querySelector<HTMLElement>("[data-inquiry-table-shell]");
    const skeletonTemplate = document.querySelector<HTMLTemplateElement>("[data-inquiry-filter-skeleton]");
    const resetLink = document.querySelector<HTMLAnchorElement>("[data-inquiry-filter-reset]");
    if (!form || !tableShell || !skeletonTemplate) return;
    if (form.dataset.inquiryFilterInitialized === "true") return;
    form.dataset.inquiryFilterInitialized = "true";
    const activeForm = form, activeTableShell = tableShell, activeSkeletonTemplate = skeletonTemplate;
    const cacheKey = "admin-inquiry-filter-cache-v1", fragmentPath = "/admin/inquiries-fragment";
    const filterKeys = ["search", "status"] as const;
    const autoSubmitFields = activeForm.querySelectorAll<HTMLSelectElement>("select");
    const searchInput = activeForm.querySelector<HTMLInputElement>("[data-inquiry-search-input]");
    let submitTimer: number | undefined, searchTimer: number | undefined, activeFetchController: AbortController | undefined;
    function readCache(): string[] { try { const parsed = JSON.parse(sessionStorage.getItem(cacheKey) || "[]"); return Array.isArray(parsed) ? parsed.filter((value): value is string => typeof value === "string") : []; } catch { return []; } }
    function writeCache(values: string[]) { sessionStorage.setItem(cacheKey, JSON.stringify([...new Set(values)])); }
    function normalizeParams(params: URLSearchParams) { const normalized = new URLSearchParams(); filterKeys.forEach((key) => { const value = params.get(key)?.trim(); if (value) normalized.set(key, value); }); return normalized.toString(); }
    function normalizeFormQuery() { const params = new URLSearchParams(); const formData = new FormData(activeForm); filterKeys.forEach((key) => { const value = formData.get(key); if (typeof value === "string" && value.trim()) params.set(key, value.trim()); }); return params.toString(); }
    function buildUrl(path: string, targetQuery: string) { return targetQuery ? `${path}?${targetQuery}` : path; }
    function showSkeletonForQuery(targetQuery: string) { const currentQuery = normalizeParams(new URLSearchParams(window.location.search)); const cachedQueries = readCache(); if (targetQuery === currentQuery || cachedQueries.includes(targetQuery)) return; const skeleton = activeSkeletonTemplate.content.firstElementChild?.cloneNode(true); if (skeleton) activeTableShell.replaceChildren(skeleton); }
    function replaceFragment(fragmentHtml: string) { const parsed = new DOMParser().parseFromString(fragmentHtml, "text/html"); const nextTableShell = parsed.querySelector<HTMLElement>("[data-inquiry-table-shell]"); if (!nextTableShell) throw new Error("Inquiries fragment did not include a table."); activeTableShell.innerHTML = nextTableShell.innerHTML; document.dispatchEvent(new Event("dashboard:interactive-table-updated")); }
    async function applyFilters(targetQuery: string) { const currentQuery = normalizeParams(new URLSearchParams(window.location.search)); if (targetQuery === currentQuery) return; showSkeletonForQuery(targetQuery); activeFetchController?.abort(); const fetchController = new AbortController(); activeFetchController = fetchController; try { const response = await fetch(buildUrl(fragmentPath, targetQuery), { headers: { "X-Requested-With": "fetch" }, signal: fetchController.signal }); if (!response.ok) throw new Error(`Inquiry filters failed with ${response.status}.`); const fragmentHtml = await response.text(); window.history.replaceState({ inquiryFilterQuery: targetQuery }, "", buildUrl("/admin/inquiries", targetQuery)); replaceFragment(fragmentHtml); activeForm.dataset.currentFilterQuery = targetQuery; if (resetLink) resetLink.hidden = targetQuery.length === 0; writeCache([...readCache(), targetQuery]); } catch (error) { if (error instanceof DOMException && error.name === "AbortError") return; window.location.href = buildUrl("/admin/inquiries", targetQuery); } finally { if (activeFetchController === fetchController) activeFetchController = undefined; } }
    function submitFilters() { window.clearTimeout(submitTimer); submitTimer = window.setTimeout(() => { void applyFilters(normalizeFormQuery()); }, 120); }
    writeCache([...readCache(), normalizeParams(new URLSearchParams(window.location.search))]);
    activeForm.addEventListener("submit", (event) => { event.preventDefault(); void applyFilters(normalizeFormQuery()); });
    autoSubmitFields.forEach((field) => field.addEventListener("change", submitFilters));
    searchInput?.addEventListener("input", () => { window.clearTimeout(searchTimer); searchTimer = window.setTimeout(submitFilters, 450); });
    resetLink?.addEventListener("click", (event) => { if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return; event.preventDefault(); void applyFilters(""); });
  }
  document.addEventListener("DOMContentLoaded", initAdminInquiryFilters);
  document.addEventListener("astro:after-swap", initAdminInquiryFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") initAdminInquiryFilters();
</script>
