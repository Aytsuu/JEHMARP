---
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import DashboardTableEmptyState from "@/components/dashboard/DashboardTableEmptyState.astro";
import DashboardTableNumberHeader from "@/components/dashboard/DashboardTableNumberHeader.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import type { AdminInquiryManagementData } from "@/lib/admin-dashboard/data";
import type { AdminInquiryFilters } from "@/lib/admin-dashboard/inquiry-filters";
import { dashboardTableRowNumber } from "@/lib/admin-dashboard/pagination";
import { formatDate, selected } from "@/lib/admin-dashboard/view";
import { autoCapitalize } from "@/lib/formatters";

type Props = {
  data: AdminInquiryManagementData;
  inquiryStatuses: readonly string[];
  activeFilters: AdminInquiryFilters;
  filterQuery: string;
};

const { data, inquiryStatuses, activeFilters, filterQuery } = Astro.props;
const skeletonRows = Array.from({ length: 6 });
---

<section id="admin-inquiries" class="admin-panel" aria-labelledby="admin-inquiries-title">
  <div data-interactive-table data-server-pagination="true" class="dashboard-interactive-table">
    <div class="table-filters order-management-toolbar">
      <form method="get" action="/admin/inquiries" class="order-filter-form" data-inquiry-filter-form data-current-filter-query={filterQuery} aria-label="Filter inquiries">
        <div class="order-filter-form__field order-filter-form__field--search">
          <input name="search" type="search" value={activeFilters.search ?? ""} placeholder="Search name, email, or contact..." autocomplete="off" aria-label="Search inquiries" data-inquiry-search-input />
        </div>
        <div class="order-filter-form__field">
          <select name="status" aria-label="Filter by status">
            <option value="">All statuses</option>
            {inquiryStatuses.map((status) => (
              <option value={status} selected={activeFilters.status === status}>{autoCapitalize(status)}</option>
            ))}
          </select>
        </div>
      </form>
      <div class="order-management-toolbar__actions">
      </div>
    </div>
    <div data-inquiry-table-shell class="dashboard-interactive-table__surface">
      <DashboardTableBoard>
        <table class="dashboard-table">
          <thead>
            <tr>
              <DashboardTableNumberHeader />
              <th scope="col">Date Created</th>
              <th scope="col">Name</th>
              <th scope="col">Email</th>
              <th scope="col">Contact</th>
              <th scope="col">Message</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {data.contactInquiries.length === 0 ? (
              <DashboardTableEmptyState
                colspan={7}
                message="No inquiries match the selected filters."
              />
            ) : data.contactInquiries.map((inquiry, index) => (
                <tr data-status={inquiry.inquiry_status}>
                  <td class="dashboard-table__number-column">{dashboardTableRowNumber(data.pagination, index)}</td>
                  <td>{formatDate(inquiry.created_at)}</td>
                  <td class="dashboard-table__cell--truncate">{inquiry.name}</td>
                  <td class="dashboard-table__cell--truncate">{inquiry.email ?? "-"}</td>
                  <td class="dashboard-table__cell--truncate">{inquiry.phone_number ?? "-"}</td>
                  <td class="dashboard-table__cell--truncate" title={inquiry.message}>{inquiry.message}</td>
                  <td>
                    <button
                      type="button"
                      class="table-cell-trigger"
                      data-open-cell-popover
                      data-popover-title={`Edit Status: ${inquiry.name}`}
                    >
                      <StatusBadge kind="inquiry" status={inquiry.inquiry_status} />
                    </button>
                    <div class="hidden-popover-form-holder">
                      <form method="post" class="admin-table-form">
                        <input type="hidden" name="action" value="update-inquiry" />
                        <input type="hidden" name="inquiryId" value={inquiry.id} />
                        <input type="hidden" name="internalNotes" value={inquiry.internal_notes ?? ""} />
                        <label>
                          <span>Status</span>
                          <select name="inquiryStatus" required>
                            {inquiryStatuses.map((status) => (
                              <option value={status} selected={selected(inquiry.inquiry_status, status)}>
                                {autoCapitalize(status)}
                              </option>
                            ))}
                          </select>
                        </label>
                        <button type="submit">Save Changes</button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
          </tbody>
        </table>
      </DashboardTableBoard>
    </div>
    <DashboardTablePagination pagination={data.pagination} />
  </div>
  <template data-inquiry-filter-skeleton>
    <DashboardTableBoard aria-busy="true" aria-live="polite">
      <table class="product-table-skeleton dashboard-table">
        <caption class="sr-only">Loading filtered inquiries</caption>
        <thead>
          <tr>
            <DashboardTableNumberHeader />
            <th scope="col">Date Created</th>
            <th scope="col">Name</th>
            <th scope="col">Email</th>
            <th scope="col">Contact</th>
            <th scope="col">Message</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          {skeletonRows.map(() => (
            <tr>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </DashboardTableBoard>
  </template>
</section>

<script>
  import { initDashboardFragmentTable } from "@/lib/client/dashboard-fragment-table";

  function initAdminInquiryFilters() {
    initDashboardFragmentTable({
      cacheKey: "admin-inquiry-filter-cache-v2",
      fragmentPath: "/admin/inquiries-fragment",
      pagePath: "/admin/inquiries",
      formSelector: "[data-inquiry-filter-form]",
      tableShellSelector: "[data-inquiry-table-shell]",
      skeletonTemplateSelector: "[data-inquiry-filter-skeleton]",
      filterKeys: ["search", "status"],
      searchInputSelector: "[data-inquiry-search-input]",
      historyStateKey: "inquiryFilterQuery",
    });
  }
  document.addEventListener("DOMContentLoaded", initAdminInquiryFilters);
  document.addEventListener("astro:after-swap", initAdminInquiryFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") initAdminInquiryFilters();
</script>
