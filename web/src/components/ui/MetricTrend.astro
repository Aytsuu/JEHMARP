---
import Tooltip from "@/components/ui/Tooltip.astro";
import { getMetricTrendDirection } from "@/lib/dashboard/metric-trend";

type Props = {
  tooltip: string;
  placement?: "above" | "below";
  class?: string;
  diff?: number;
  formattedDiff?: string;
};

const { tooltip, placement = "above", class: className, diff, formattedDiff } = Astro.props;
const direction = diff === undefined ? null : getMetricTrendDirection(diff);
const hasTrend = direction !== null && direction !== "flat";
const hasSlot = Astro.slots.has("default");
---

{
  hasTrend ? (
    <Tooltip
      text={tooltip}
      placement={placement}
      class:list={[
        "dashboard-metric-trend",
        `dashboard-metric-trend--${direction}`,
        className,
      ]}
    >
      {
        direction === "up" && (
          <svg
            class="dashboard-metric-trend__icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
            <polyline points="16 7 22 7 22 13" />
          </svg>
        )
      }
      {
        direction === "down" && (
          <svg
            class="dashboard-metric-trend__icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="22 17 13.5 8.5 8.5 13.5 2 7" />
            <polyline points="16 17 22 17 22 11" />
          </svg>
        )
      }
      {formattedDiff}
    </Tooltip>
  ) : hasSlot ? (
    <Tooltip text={tooltip} placement={placement} class={className}>
      <slot />
    </Tooltip>
  ) : null
}
