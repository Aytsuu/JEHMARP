---
type Props = {
  text: string;
  placement?: "above" | "below" | "right";
  class?: string;
  sidebarOnly?: boolean;
  focusable?: boolean;
  interactive?: boolean;
};

const {
  text,
  placement = "above",
  class: className,
  sidebarOnly = false,
  focusable,
  interactive = false,
} = Astro.props;
const isFocusable = focusable ?? !interactive;
---

<span
  class:list={[
    "dashboard-tooltip",
    interactive && "dashboard-tooltip--interactive",
    className,
  ]}
  tabindex={isFocusable ? 0 : undefined}
  data-tooltip={text}
  data-tooltip-placement={placement}
  data-tooltip-sidebar-only={sidebarOnly ? "true" : undefined}
  aria-label={isFocusable ? text : undefined}
>
  <slot />
</span>

<script>
  import { initDashboardTooltips } from "@/lib/client/dashboard-tooltip";

  initDashboardTooltips();
  document.addEventListener("astro:after-swap", initDashboardTooltips);
  document.addEventListener("astro:page-load", initDashboardTooltips);
</script>
