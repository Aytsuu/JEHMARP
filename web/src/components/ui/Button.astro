---
import type { HTMLAttributes } from "astro/types";

type Props = {
  variant?: "primary" | "outlined" | "ghost" | "muted";
  size?: "default" | "toolbar";
} & HTMLAttributes<"button">;

const {
  variant = "primary",
  size = "toolbar",
  class: className,
  type = "button",
  ...rest
} = Astro.props;
---

<button
  type={type}
  class:list={[
    "ui-button",
    size === "toolbar" && "ui-button--toolbar",
    variant === "outlined" && "ui-button--outlined",
    variant === "ghost" && "ui-button--ghost",
    variant === "muted" && "ui-button--muted",
    className,
  ]}
  {...rest}
>
  <slot />
</button>

<style>
  .ui-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-brand-red);
    color: #ffffff;
    padding: 0.4rem 0.85rem;
    border: none;
    border-radius: 0.375rem;
    font: inherit;
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: none;
    letter-spacing: normal;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .ui-button:hover:not(:disabled) {
    background-color: #551313;
  }

  .ui-button:disabled,
  .ui-button:disabled:hover,
  .ui-button:disabled:active {
    opacity: 0.6;
    cursor: not-allowed;
    background-color: var(--color-brand-red);
  }

  .ui-button--toolbar {
    min-height: 2.35rem;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }

  .ui-button--outlined {
    border: 1px solid #d1d5db;
    background-color: transparent;
    color: #111827;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .ui-button--outlined:hover:not(:disabled) {
    background-color: #f3f4f6;
    border-color: #d1d5db;
    color: #111827;
  }

  .ui-button--outlined:disabled,
  .ui-button--outlined:disabled:hover,
  .ui-button--outlined:disabled:active {
    background-color: transparent;
    border-color: #d1d5db;
    color: #111827;
  }

  .ui-button--ghost {
    border: 1px solid #d1d5db;
    background-color: transparent;
    color: var(--color-brand-muted-black);
  }

  .ui-button--ghost:hover:not(:disabled) {
    background-color: #f3f4f6;
    color: #111827;
  }

  .ui-button--ghost:disabled,
  .ui-button--ghost:disabled:hover,
  .ui-button--ghost:disabled:active {
    background-color: transparent;
    color: var(--color-brand-muted-black);
  }

  .ui-button--muted {
    background-color: var(--color-brand-muted-black);
  }

  .ui-button--muted:hover:not(:disabled) {
    background-color: #2f2f2f;
  }

  .ui-button--muted:disabled,
  .ui-button--muted:disabled:hover,
  .ui-button--muted:disabled:active {
    background-color: var(--color-brand-muted-black);
  }
</style>
