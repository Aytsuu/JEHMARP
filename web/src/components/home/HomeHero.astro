---
import type { PublicPageSectionRecord } from "@/lib/public-website/content";
import { toAdminContentPreviewHref } from "@/lib/public-website/admin-content-preview";

type Props = {
  section: PublicPageSectionRecord;
  previewRoot?: string;
};

const { section, previewRoot } = Astro.props;

function linkHref(href: string) {
  return previewRoot ? toAdminContentPreviewHref(href) : href;
}

function stringValue(value: unknown): string | undefined {
  return typeof value === "string" && value.trim().length > 0
    ? value.trim()
    : undefined;
}

const heading = stringValue(section.content.heading) ?? "JEHMARP";
const summary = stringValue(section.content.summary);
const supportingText = stringValue(section.content.supportingText);
const heroSlides = [
  {
    src: "/images/hero_carousel_1.jpg",
    alt: "Fresh meat selection at JEHMARP",
    width: 2560,
    height: 1600,
  },
  {
    src: "/images/hero_carousel_2.jpg",
    alt: "JEHMARP butcher shop display",
    width: 1280,
    height: 881,
  },
  {
    src: "/images/hero_carousel_3.jpg",
    alt: "Premium cuts prepared at JEHMARP",
    width: 3600,
    height: 2025,
  },
] as const;
---

<section class="home-hero" aria-labelledby="home-hero-heading">
  <div class="home-hero__slides">
    {
      heroSlides.map((slide, index) => (
        <div
          class:list={[
            "home-hero__slide",
            index === 0 && "home-hero__slide--active",
          ]}
          data-slide-index={index}
        >
          <img
            src={slide.src}
            alt={slide.alt}
            class="home-hero__slide-image"
            width={slide.width}
            height={slide.height}
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        </div>
      ))
    }
  </div>
  <div class="home-hero__overlay"></div>
  <div class="home-hero__content">
    <h1 id="home-hero-heading" class="home-hero__title">{heading}</h1>
    {summary && <p class="home-hero__summary">{summary}</p>}
    {
      supportingText && (
        <p class="home-hero__supporting-text">{supportingText}</p>
      )
    }

    <div class="home-hero__actions">
      <a
        href={linkHref("/shop")}
        class="home-hero__button home-hero__button--primary"
      >
        Browse shop
      </a>
    </div>
  </div>

  <div class="home-hero__indicators" aria-label="Hero carousel navigation">
    <button class="home-hero__indicator-dot home-hero__indicator-dot--active" aria-label="Go to slide 1" aria-current="true" data-indicator-index="0"></button>
    <button class="home-hero__indicator-dot" aria-label="Go to slide 2" data-indicator-index="1"></button>
    <button class="home-hero__indicator-dot" aria-label="Go to slide 3" data-indicator-index="2"></button>
  </div>
</section>

<script>
  function initHeroCarousel() {
    const slides = document.querySelectorAll<HTMLElement>(".home-hero__slide");
    const dots = document.querySelectorAll<HTMLButtonElement>(".home-hero__indicator-dot");
    if (slides.length === 0 || dots.length === 0) return;

    let currentSlide = 0;
    const intervalTime = 5000;
    let timerId: number | undefined;

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.add("home-hero__slide--active");
        } else {
          slide.classList.remove("home-hero__slide--active");
        }
      });

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.add("home-hero__indicator-dot--active");
          dot.setAttribute("aria-current", "true");
        } else {
          dot.classList.remove("home-hero__indicator-dot--active");
          dot.removeAttribute("aria-current");
        }
      });

      currentSlide = index;
    }

    function startAutoPlay() {
      stopAutoPlay();
      timerId = window.setInterval(() => {
        const nextIndex = (currentSlide + 1) % slides.length;
        showSlide(nextIndex);
      }, intervalTime);
    }

    function stopAutoPlay() {
      if (timerId !== undefined) {
        clearInterval(timerId);
        timerId = undefined;
      }
    }

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        showSlide(i);
        startAutoPlay();
      });
    });

    // Start
    showSlide(0);
    startAutoPlay();
  }

  // Initialize on load and on astro page transitions
  document.addEventListener("DOMContentLoaded", initHeroCarousel);
  document.addEventListener("astro:after-swap", initHeroCarousel);
  
  // Also run immediately if script executes after DOMContentLoaded
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initHeroCarousel();
  }
</script>
