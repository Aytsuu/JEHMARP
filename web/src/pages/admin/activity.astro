---
import AdminActivity from "@/components/admin/AdminActivity.astro";
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import { formatAdminActionFeedback } from "@/lib/admin-dashboard/actions";
import { loadAdminDashboardData } from "@/lib/admin-dashboard/data";
import {
  parseAdminActivityFilters,
  serializeAdminActivityFilters,
} from "@/lib/admin-dashboard/activity-filters";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const activityFilters = parseAdminActivityFilters(Astro.url);
const activityFilterQuery = serializeAdminActivityFilters(activityFilters);
const data = await loadAdminDashboardData();
const feedback = formatAdminActionFeedback(Astro.url);
---

<AdminPageFrame
  title="Admin Activity - JEHMARP"
  description="Admin activity feed for operational changes."
  heading="Activity"
  intro="Review recent order, customer, product, invoice, and content activity."
  feedback={feedback}
  dashboardData={data}
>
  <AdminActivity
    data={data}
    activeFilters={activityFilters}
    filterQuery={activityFilterQuery}
  />
</AdminPageFrame>
