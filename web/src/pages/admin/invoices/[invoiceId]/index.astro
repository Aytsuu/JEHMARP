---
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import OrderPdfLinks from "@/components/OrderPdfLinks.astro";
import { formatAdminActionFeedback } from "@/lib/admin-dashboard/actions";
import { loadAdminDashboardData } from "@/lib/admin-dashboard/data";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import {
  formatCurrency,
  formatDate,
  fullName,
  orderBalance,
  orderPaymentTotal,
  orderTotal,
} from "@/lib/admin-dashboard/view";
import { autoCapitalize } from "@/lib/formatters";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const { invoiceId } = Astro.params;
const data = await loadAdminDashboardData();
const order = data.orders.find((o) => o.invoice.some((inv) => inv.id === invoiceId));

if (!order) {
  return Astro.redirect("/admin/invoices", 302);
}

const invoice = order.invoice.find((inv) => inv.id === invoiceId);
if (!invoice) {
  return Astro.redirect("/admin/invoices", 302);
}

const invoiceTotal = orderTotal(order, "final_quantity");
const paidTotal = orderPaymentTotal(order);
const balance = orderBalance(order);
const feedback = formatAdminActionFeedback(Astro.url);
---

<AdminPageFrame
  title={`Invoice Details ${invoice.invoice_number} - JEHMARP`}
  description="Admin invoice details, items list, payments, and PDF generation."
  heading={`Invoice Details: ${invoice.invoice_number}`}
  intro={`Review detailed invoice line items, record payments, and download pdf copies for Invoice ${invoice.invoice_number}.`}
  feedback={feedback}
  dashboardData={data}
  backUrl="/admin/invoices"
>
  <div style="display: flex; flex-direction: column; gap: 2rem; max-width: 100%;">
    <!-- 1. Invoice Information -->
    <div class="content-section">
      <h3 style="margin-top: 0; margin-bottom: 1.5rem;">Invoice Information</h3>
      
      <div class="invoice-info-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
        <div class="detail-field" style="display: flex; flex-direction: column; gap: 0.25rem; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem;">
          <span class="detail-field-label" style="font-size: 0.75rem; font-weight: 700; color: var(--color-brand-muted-black); text-transform: uppercase; letter-spacing: 0.05em;">Customer</span>
          <div class="detail-field-value" style="font-size: 1rem; color: #111827; font-weight: 500;">
            {order.customer ? fullName(order.customer) : "Guest"}
          </div>
        </div>
        
        <div class="detail-field" style="display: flex; flex-direction: column; gap: 0.25rem; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem;">
          <span class="detail-field-label" style="font-size: 0.75rem; font-weight: 700; color: var(--color-brand-muted-black); text-transform: uppercase; letter-spacing: 0.05em;">Order Status</span>
          <div class="detail-field-value" style="font-size: 1rem; color: #111827; font-weight: 500;">
            {autoCapitalize(order.order_status)}
          </div>
        </div>

        <div class="detail-field" style="display: flex; flex-direction: column; gap: 0.25rem; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem;">
          <span class="detail-field-label" style="font-size: 0.75rem; font-weight: 700; color: var(--color-brand-muted-black); text-transform: uppercase; letter-spacing: 0.05em;">Payment Status</span>
          <div class="detail-field-value" style="font-size: 1rem; color: #111827; font-weight: 500;">
            {autoCapitalize(order.payment_status)}
          </div>
        </div>

        <div class="detail-field" style="display: flex; flex-direction: column; gap: 0.25rem; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem;">
          <span class="detail-field-label" style="font-size: 0.75rem; font-weight: 700; color: var(--color-brand-muted-black); text-transform: uppercase; letter-spacing: 0.05em;">Invoice Total</span>
          <div class="detail-field-value" style="font-size: 1rem; color: #111827; font-weight: 500;">
            {formatCurrency(invoiceTotal)}
          </div>
        </div>

        <div class="detail-field" style="display: flex; flex-direction: column; gap: 0.25rem; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem;">
          <span class="detail-field-label" style="font-size: 0.75rem; font-weight: 700; color: var(--color-brand-muted-black); text-transform: uppercase; letter-spacing: 0.05em;">Paid</span>
          <div class="detail-field-value" style="font-size: 1rem; color: #111827; font-weight: 500;">
            {formatCurrency(paidTotal)}
          </div>
        </div>

        <div class="detail-field" style="display: flex; flex-direction: column; gap: 0.25rem; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem;">
          <span class="detail-field-label" style="font-size: 0.75rem; font-weight: 700; color: var(--color-brand-muted-black); text-transform: uppercase; letter-spacing: 0.05em;">Balance</span>
          <div class="detail-field-value" style="font-size: 1rem; color: #111827; font-weight: 500;">
            {formatCurrency(balance)}
          </div>
        </div>

        <div class="detail-field" style="display: flex; flex-direction: column; gap: 0.25rem; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem;">
          <span class="detail-field-label" style="font-size: 0.75rem; font-weight: 700; color: var(--color-brand-muted-black); text-transform: uppercase; letter-spacing: 0.05em;">Created Date</span>
          <div class="detail-field-value" style="font-size: 1rem; color: #111827; font-weight: 500;">
            {formatDate(invoice.created_at)}
          </div>
        </div>
      </div>

      <div class="pdf-links-container" style="margin-top: 1.5rem; display: flex; gap: 1rem; align-items: center; border-top: 1px solid #e5e7eb; padding-top: 1.25rem; flex-wrap: wrap;">
        <OrderPdfLinks
          orderId={order.id}
          basePath="/admin/orders"
          showOrderSlip={false}
          showSalesInvoice
        />
      </div>
    </div>

    <!-- 2. Invoice Line Items -->
    <div class="content-section">
      <h3 style="margin-top: 0; margin-bottom: 1.5rem;">Invoice Line Items</h3>
      <div class="table-wrap">
        <table style="table-layout: fixed; width: 100%;">
          <thead>
            <tr>
              <th scope="col" style="width: 40%; padding: 0.75rem;">Product</th>
              <th scope="col" style="width: 30%; padding: 0.75rem;">Quantity</th>
              <th scope="col" style="width: 15%; padding: 0.75rem;">Unit price</th>
              <th scope="col" style="width: 15%; padding: 0.75rem;">Line total</th>
            </tr>
          </thead>
          <tbody>
            {order.customer_order_item.map((item) => (
              <tr>
                <td style="vertical-align: middle;">{item.product?.name ?? "Missing product"}</td>
                <td style="vertical-align: middle;">
                  <form method="post" style="margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                    <input type="hidden" name="action" value="update-invoice-item-quantity" />
                    <input type="hidden" name="orderItemId" value={item.id} />
                    <input
                      type="number"
                      name="quantity"
                      value={item.final_quantity}
                      min="0.001"
                      step="0.001"
                      required
                      style="width: 6rem; padding: 0.25rem 0.5rem; border: 1px solid #d1d5db; border-radius: 0.375rem;"
                    />
                    <button type="submit" class="btn-table-manage" style="background-color: var(--color-brand-muted-black); padding: 0.25rem 0.5rem; font-size: 0.75rem; text-transform: none; letter-spacing: normal; width: auto; display: inline-block;">Save</button>
                  </form>
                </td>
                <td style="vertical-align: middle;">{formatCurrency(item.unit_price)} {item.price_type}</td>
                <td style="vertical-align: middle;">{formatCurrency(item.final_quantity * item.unit_price)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- 3. Payments -->
    <div class="content-section">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <h3 style="margin: 0;">Payments</h3>
        
        <div class="admin-panel" style="border: none; padding: 0; margin: 0; box-shadow: none; display: inline-block;">
          <button type="button" class="btn-table-manage" data-open-create-sheet style="text-transform: none; font-size: 0.9rem; font-weight: 600; letter-spacing: normal;" disabled={balance <= 0}>Record Payment</button>
          
          <div class="hidden-create-form-holder" style="display: none;">
            <form method="post" class="admin-form" style="margin: 0;">
              <input type="hidden" name="action" value="record-payment" />
              <input type="hidden" name="orderId" value={order.id} />
              <label class="field-row">
                <span>Amount</span>
                <input name="amount" type="number" min="0.01" step="0.01" max={balance > 0 ? balance : undefined} required />
              </label>
              <label class="field-row">
                <span>Method</span>
                <input name="paymentMethod" required placeholder="cash, bank transfer" />
              </label>
              <label class="field-row">
                <span>Payment date</span>
                <input name="paymentDate" type="date" value={new Date().toISOString().slice(0, 10)} required />
              </label>
              <label class="field-row">
                <span>Reference</span>
                <input name="referenceNumber" />
              </label>
              <label class="field-row">
                <span>Notes</span>
                <textarea name="notes"></textarea>
              </label>
              <button type="submit" style="width: 100%;">Record payment</button>
            </form>
          </div>
        </div>
      </div>

      {order.payment.length === 0 ? (
        <p class="empty-state">No payments recorded.</p>
      ) : (
        <ul class="compact-list" style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; margin: 0;">
          {order.payment.map((payment) => (
            <li style="padding: 0.75rem 1rem; background-color: var(--color-brand-cream); border-radius: 0.5rem; display: flex; justify-content: space-between; align-items: center;">
              <span>
                {payment.payment_method} on {formatDate(payment.payment_date)}
                {payment.reference_number ? ` (Ref: ${payment.reference_number})` : ""}
              </span>
              <strong>{formatCurrency(payment.amount)}</strong>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</AdminPageFrame>

<style>
  /* Remove shadows on cards, add matching gray border and border-radius */
  .content-section {
    box-shadow: none !important;
    border: 1px solid #d1d5db !important;
    border-radius: 0.75rem !important;
  }
  
  /* PDF Links aesthetics */
  .pdf-links-container a {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(102, 24, 24, 0.15);
    border-radius: 0.375rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-brand-muted-black);
    background-color: #ffffff;
    transition: all 0.2s ease;
  }
  .pdf-links-container a:hover {
    background-color: #f3f4f6;
    border-color: var(--color-brand-muted-black);
    color: #111827;
  }
</style>
