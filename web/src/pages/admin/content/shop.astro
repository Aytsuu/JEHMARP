---
import AdminContentPageLayout from "@/components/admin/AdminContentPageLayout.astro";
import AdminContentPreviewFrame from "@/components/admin/AdminContentPreviewFrame.astro";
import PageShell from "@/components/PageShell.astro";
import PublicShopPageContent from "@/components/public-website/PublicShopPageContent.astro";
import { loadAdminContentPreviewPage } from "@/lib/admin-dashboard/content-preview-page";
import { getPublicEnv } from "@/lib/env";
import { ADMIN_CONTENT_PREVIEW_ROOT } from "@/lib/public-website/admin-content-preview";
import {
  listOrderablePublicProducts,
} from "@/lib/public-website/shop";

export const prerender = false;

const preview = await loadAdminContentPreviewPage(Astro);

if (!preview.ready) {
  return preview.response;
}

const shopPath = `${ADMIN_CONTENT_PREVIEW_ROOT}/shop`;
const products = await listOrderablePublicProducts();
const orderStatus = Astro.url.searchParams.get("order");
const orderEmailStatus = (() => {
  const email = Astro.url.searchParams.get("email");
  if (email === "1") return "sent";
  if (email === "failed") return "failed";
  if (email === "unavailable") return "unavailable";
  return null;
})();
const orderMessage = Astro.url.searchParams.get("message");
const { turnstileSiteKey } = getPublicEnv();
---

<AdminContentPageLayout
  title="Shop Preview - JEHMARP"
  description="Admin shop page preview."
  feedback={preview.feedback}
  dashboardData={preview.dashboardData}
>
  <AdminContentPreviewFrame activePath="/shop">
    <PageShell title="Shop">
      <PublicShopPageContent
        products={products}
        orderStatus={orderStatus}
        orderEmailStatus={orderEmailStatus}
        orderMessage={orderMessage}
        turnstileSiteKey={turnstileSiteKey ?? null}
        returnPath={shopPath}
      />
    </PageShell>
  </AdminContentPreviewFrame>
</AdminContentPageLayout>
