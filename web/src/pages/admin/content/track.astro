---
import AdminContentPageLayout from "@/components/admin/AdminContentPageLayout.astro";
import AdminContentPreviewFrame from "@/components/admin/AdminContentPreviewFrame.astro";
import PageShell from "@/components/PageShell.astro";
import PublicTrackPageContent from "@/components/public-website/PublicTrackPageContent.astro";
import { loadAdminContentPreviewPage } from "@/lib/admin-dashboard/content-preview-page";
import { ADMIN_CONTENT_PREVIEW_ROOT } from "@/lib/public-website/admin-content-preview";
import {
  lookupCustomerOrdersByTrackingNumber,
  normalizeCustomerTrackingNumber,
} from "@/lib/public-website/customer-tracking";
import { getClientIp } from "@/lib/security/client-ip";

export const prerender = false;

const preview = await loadAdminContentPreviewPage(Astro);

if (!preview.ready) {
  return preview.response;
}

const trackPath = `${ADMIN_CONTENT_PREVIEW_ROOT}/track`;
const submittedTrackingNumber = Astro.url.searchParams.get("number") ?? "";
const lookupError = Astro.url.searchParams.get("error");
let lookupResult = null as Awaited<
  ReturnType<typeof lookupCustomerOrdersByTrackingNumber>
> | null;
let rateLimitMessage: string | null = null;

if (submittedTrackingNumber.trim()) {
  const normalized = normalizeCustomerTrackingNumber(submittedTrackingNumber);

  if (!normalized) {
    rateLimitMessage =
      "Enter a valid tracking number in the format JHM-XXXXXXXX.";
  } else {
    try {
      lookupResult = await lookupCustomerOrdersByTrackingNumber(normalized, {
        clientIp: getClientIp(Astro.request.headers),
      });
    } catch (error) {
      rateLimitMessage =
        error instanceof Error
          ? error.message
          : "Unable to look up this tracking number right now.";
    }
  }
}
---

<AdminContentPageLayout
  title="Track Orders Preview - JEHMARP"
  description="Admin track orders page preview."
  feedback={preview.feedback}
  dashboardData={preview.dashboardData}
>
  <AdminContentPreviewFrame activePath="/track">
    <PageShell title="Track Orders">
      <PublicTrackPageContent
        submittedTrackingNumber={submittedTrackingNumber}
        lookupError={lookupError}
        rateLimitMessage={rateLimitMessage}
        lookupResult={lookupResult}
        formAction={trackPath}
        inputId="admin-tracking-number"
      />
    </PageShell>
  </AdminContentPreviewFrame>
</AdminContentPageLayout>
