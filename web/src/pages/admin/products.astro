---
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import AdminProductManagement from "@/components/admin/AdminProductManagement.astro";
import {
  formatAdminActionFeedback,
  getProductCategories,
  getProductUnitLabels,
  getStockStatuses,
} from "@/lib/admin-dashboard/actions";
import { loadAdminDashboardData } from "@/lib/admin-dashboard/data";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import {
  parseAdminProductFilters,
  serializeAdminProductFilters,
} from "@/lib/admin-dashboard/product-filters";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const productFilters = parseAdminProductFilters(Astro.url);
const productFilterQuery = serializeAdminProductFilters(productFilters);
const data = await loadAdminDashboardData({
  productFilters,
});
const feedback = formatAdminActionFeedback(Astro.url);
---

<AdminPageFrame
  title="Admin Products - JEHMARP"
  description="Admin product management."
  heading="Product Management"
  intro="Create products, manage public and reseller pricing, update stock status, and deactivate products safely."
  feedback={feedback}
  dashboardData={data}
>
  <AdminProductManagement
    data={data}
    productCategories={getProductCategories()}
    productUnitLabels={getProductUnitLabels()}
    stockStatuses={getStockStatuses()}
    activeFilters={productFilters}
    filterQuery={productFilterQuery}
  />
</AdminPageFrame>
