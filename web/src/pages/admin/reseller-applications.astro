---
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import AdminResellerApplications from "@/components/admin/AdminResellerApplications.astro";
import {
  formatAdminActionFeedback,
  getResellerApplicationStatuses,
  markUnreadAdminResellerApplicationsRead,
} from "@/lib/admin-dashboard/actions";
import {
  loadAdminDashboardData,
  loadAdminResellerApplicationManagementData,
} from "@/lib/admin-dashboard/data";
import {
  parseAdminResellerApplicationFilters,
  serializeAdminResellerApplicationFilters,
} from "@/lib/admin-dashboard/reseller-application-filters";
import {
  mergeAdminPaginationQuery,
  parseAdminPagination,
} from "@/lib/admin-dashboard/pagination";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

await markUnreadAdminResellerApplicationsRead(Astro, adminRoute.userId);

const resellerApplicationFilters = parseAdminResellerApplicationFilters(Astro.url);
const resellerApplicationPagination = parseAdminPagination(Astro.url);
const resellerApplicationFilterQuery =
  mergeAdminPaginationQuery(
    serializeAdminResellerApplicationFilters(resellerApplicationFilters),
    resellerApplicationPagination,
  );
const [dashboardData, data] = await Promise.all([
  loadAdminDashboardData(),
  loadAdminResellerApplicationManagementData(
    resellerApplicationFilters,
    resellerApplicationPagination,
  ),
]);
const feedback = formatAdminActionFeedback(Astro.url);
---

<AdminPageFrame
  title="Admin Reseller Applications - JEHMARP"
  description="Admin reseller application management."
  heading="Reseller Applications"
  intro="Review reseller applications and price-list email delivery status."
  feedback={feedback}
  dashboardData={dashboardData}
>
  <AdminResellerApplications
    data={data}
    applicationStatuses={getResellerApplicationStatuses()}
    activeFilters={resellerApplicationFilters}
    filterQuery={resellerApplicationFilterQuery}
  />
</AdminPageFrame>
