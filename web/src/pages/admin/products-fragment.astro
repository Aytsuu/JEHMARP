---
import AdminProductManagement from "@/components/admin/AdminProductManagement.astro";
import { getStockStatuses } from "@/lib/admin-dashboard/actions";
import {
  loadAdminProductManagementData,
  loadAdminProductOptionData,
} from "@/lib/admin-dashboard/data";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import {
  buildProductCategoryOptions,
  buildProductUnitOptions,
} from "@/lib/admin-dashboard/product-options";
import {
  parseAdminProductFilters,
  serializeAdminProductFilters,
} from "@/lib/admin-dashboard/product-filters";
import {
  mergeAdminPaginationQuery,
  parseAdminPagination,
} from "@/lib/admin-dashboard/pagination";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const productFilters = parseAdminProductFilters(Astro.url);
const productPagination = parseAdminPagination(Astro.url);
const productFilterQuery = mergeAdminPaginationQuery(
  serializeAdminProductFilters(productFilters),
  productPagination,
);
const [data, productOptionData] = await Promise.all([
  loadAdminProductManagementData(productFilters, productPagination),
  loadAdminProductOptionData(),
]);
const productCategories = buildProductCategoryOptions(productOptionData.products);
const productUnitLabels = buildProductUnitOptions(productOptionData.products);
---

<AdminProductManagement
  data={data}
  productCategories={productCategories}
  productUnitLabels={productUnitLabels}
  stockStatuses={getStockStatuses()}
  activeFilters={productFilters}
  filterQuery={productFilterQuery}
/>
