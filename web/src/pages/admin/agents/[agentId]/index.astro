---
import AdminNotificationsPageLayout from "@/components/admin/AdminNotificationsPageLayout.astro";
import ViewButton from "@/components/ViewButton.astro";
import { formatAdminActionFeedback } from "@/lib/admin-dashboard/actions";
import { loadAdminDashboardData } from "@/lib/admin-dashboard/data";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import { fullName, formatDate } from "@/lib/admin-dashboard/view";
import { autoCapitalize } from "@/lib/formatters";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const { agentId } = Astro.params;
const data = await loadAdminDashboardData();
const agent = data.agents.find((a) => a.id === agentId);

if (!agent) {
  return Astro.redirect("/admin/agents", 302);
}

const assignedCustomers = data.customers.filter((c) => c.assigned_agent_id === agent.id);
const customersWithPendingOrders = assignedCustomers.filter((customer) =>
  data.orders.some(
    (order) => order.customer_id === customer.id && order.order_status !== "closed",
  ),
);

function hasPendingOrders(customerId: string): boolean {
  return data.orders.some(
    (order) => order.customer_id === customerId && order.order_status !== "closed",
  );
}

const feedback = formatAdminActionFeedback(Astro.url);
const agentReturnTo = encodeURIComponent(`/admin/agents/${agent.id}`);
---

<AdminNotificationsPageLayout
  title={`Agent Details - ${agent.display_name} - JEHMARP`}
  description="Admin agent assignment summary and assigned customer list."
  heading={agent.display_name}
  backUrl="/admin/agents"
  backLabel="Back to agents"
  feedback={feedback}
  dashboardData={data}
  contentMaxWidth="72rem"
  fullHeight
>
  <ul slot="heading-meta" class="record-meta" aria-label="Agent details">
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
      <span class="record-meta__text">{agent.email ?? "No email"}</span>
    </li>
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
        ></path>
      </svg>
      <span class="record-meta__text">{agent.contact ?? "No contact"}</span>
    </li>
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span class="record-meta__text">{autoCapitalize(agent.status)}</span>
    </li>
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <span class="record-meta__text">Joined {formatDate(agent.created_at)}</span>
    </li>
  </ul>

  <div class="agent-record-content">
    <div class="content-section">
      <h3 class="agent-record-content__heading">Assigned Summary</h3>
      <div class="assigned-summary-grid">
        <div class="detail-field">
          <span class="detail-field-label">Assigned customers</span>
          <div class="detail-field-value">{assignedCustomers.length}</div>
        </div>

        <div class="detail-field detail-field--wide">
          <span class="detail-field-label">Active tracing</span>
          <div class="detail-field-value">
            {customersWithPendingOrders.length} customer(s) with pending orders
          </div>
        </div>
      </div>
    </div>

    <div class="content-section">
      <h3 class="agent-record-content__heading">
        Assigned Customers ({assignedCustomers.length})
      </h3>
      {
        assignedCustomers.length === 0 ? (
          <p class="empty-state">No customers assigned to this agent yet.</p>
        ) : (
          <div class="table-wrap">
            <table class="agent-customers-table">
              <thead>
                <tr>
                  <th scope="col">Customer</th>
                  <th scope="col">Contact</th>
                  <th scope="col">Address</th>
                  <th scope="col">Status indicators</th>
                  <th scope="col">Action</th>
                </tr>
              </thead>
              <tbody>
                {
                  assignedCustomers.map((customer) => {
                    const pending = hasPendingOrders(customer.id);
                    return (
                      <tr>
                        <td>
                          {fullName(customer)}
                          {
                            customer.is_reseller && (
                              <span class="agent-customers-table__reseller">(reseller)</span>
                            )
                          }
                        </td>
                        <td>
                          {customer.phone_number}
                          <br />
                          {customer.email ?? "No email"}
                        </td>
                        <td>{customer.address}</td>
                        <td>
                          {
                            pending ? (
                              <span class="agent-customers-table__pending-badge">
                                PENDING ORDERS
                              </span>
                            ) : (
                              <span class="agent-customers-table__idle">No pending orders</span>
                            )
                          }
                        </td>
                        <td>
                          <ViewButton
                            href={`/admin/customers/${customer.id}?returnTo=${agentReturnTo}`}
                          />
                        </td>
                      </tr>
                    );
                  })
                }
              </tbody>
            </table>
          </div>
        )
      }
    </div>
  </div>
</AdminNotificationsPageLayout>

<style>
  .agent-record-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 100%;
  }

  .agent-record-content__heading {
    margin: 0 0 1.5rem;
  }

  .content-section {
    box-shadow: none !important;
    border: 1px solid #d1d5db !important;
    border-radius: 0.75rem !important;
  }

  .assigned-summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .detail-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background-color: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
  }

  .detail-field--wide {
    grid-column: span 2;
  }

  .detail-field-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-brand-muted-black);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .detail-field-value {
    font-size: 1rem;
    color: #111827;
    font-weight: 500;
  }

  .agent-customers-table {
    table-layout: fixed;
    width: 100%;
  }

  .agent-customers-table th,
  .agent-customers-table td {
    padding: 1.1rem 0.75rem;
    vertical-align: middle;
  }

  .agent-customers-table th:nth-child(1),
  .agent-customers-table td:nth-child(1) {
    width: 25%;
  }

  .agent-customers-table th:nth-child(2),
  .agent-customers-table td:nth-child(2) {
    width: 25%;
  }

  .agent-customers-table th:nth-child(3),
  .agent-customers-table td:nth-child(3) {
    width: 25%;
  }

  .agent-customers-table th:nth-child(4),
  .agent-customers-table td:nth-child(4) {
    width: 15%;
  }

  .agent-customers-table th:nth-child(5),
  .agent-customers-table td:nth-child(5) {
    width: 10%;
  }

  .agent-customers-table__reseller {
    font-size: 0.75rem;
    color: var(--color-brand-muted-black);
    margin-left: 0.25rem;
  }

  .agent-customers-table__pending-badge {
    background-color: var(--color-brand-red);
    color: white;
    padding: 0.25rem 0.65rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    display: inline-block;
  }

  .agent-customers-table__idle {
    color: var(--color-brand-muted-black);
    font-size: 0.875rem;
  }

  @media (max-width: 900px) {
    .detail-field--wide {
      grid-column: auto;
    }
  }
</style>
