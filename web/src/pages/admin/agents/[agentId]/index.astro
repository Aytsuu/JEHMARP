---
import AdminNotificationsPageLayout from "@/components/admin/AdminNotificationsPageLayout.astro";
import ViewButton from "@/components/ViewButton.astro";
import {
  formatAdminActionFeedback,
  handleAdminDashboardAction,
} from "@/lib/admin-dashboard/actions";
import {
  loadAdminAgentDetailsData,
  loadAdminDashboardData,
} from "@/lib/admin-dashboard/data";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import {
  agentOrderPaymentStatus,
  agentOrderTotal,
  canConvertPromotedCustomerOrderToDistribution,
  formatCurrency,
  fullName,
  formatDate,
  getCustomerOrderDistributionConversionBlockReason,
  orderBalance,
  orderTotal,
} from "@/lib/admin-dashboard/view";
import { autoCapitalize, formatOrderSource } from "@/lib/formatters";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const { agentId } = Astro.params;

if (!agentId) {
  return Astro.redirect("/admin/agents", 302);
}

if (Astro.request.method === "POST") {
  return handleAdminDashboardAction(
    Astro,
    adminRoute.userId,
    `/admin/agents/${agentId}`,
  );
}

const [dashboardData, detailData] = await Promise.all([
  loadAdminDashboardData(),
  loadAdminAgentDetailsData(agentId),
]);

if (!detailData) {
  return Astro.redirect("/admin/agents", 302);
}

const agent = detailData.agent;
const assignedCustomers = detailData.assignedCustomers;
const previousCustomerOrders = detailData.previousCustomerOrders.map((order) => {
  const blockReason = getCustomerOrderDistributionConversionBlockReason(order, agent.id);

  return {
    order,
    blockReason,
    canConvert: canConvertPromotedCustomerOrderToDistribution(order, agent.id),
    balance: orderBalance(order),
    totalAmount: orderTotal(order, "final_quantity"),
  };
});
const agentOrders = detailData.agentOrders.map((order) => {
  const paymentStatus = agentOrderPaymentStatus(order);
  const indication = order.order_status !== "processing" && order.order_status !== "closed"
    ? "Pending order"
    : order.order_status === "processing" && paymentStatus !== "paid"
      ? "Pending payment"
      : autoCapitalize(order.order_status);

  return {
    order,
    paymentStatus,
    indication,
    totalAmount: agentOrderTotal(order),
  };
});

const feedback = formatAdminActionFeedback(Astro.url);
const agentReturnTo = encodeURIComponent(`/admin/agents/${agent.id}`);
---

<AdminNotificationsPageLayout
  title={`Agent Details - ${agent.display_name} - JEHMARP`}
  description="Admin agent assignment summary and assigned customer list."
  heading={agent.display_name}
  backUrl="/admin/agents"
  backLabel="Back to agents"
  feedback={feedback}
  dashboardData={dashboardData}
  contentMaxWidth="72rem"
  fullHeight
>
  <ul slot="heading-meta" class="record-meta" aria-label="Agent details">
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 5h18v14H3z"></path>
        <path d="M7 9h4"></path>
        <path d="M7 13h6"></path>
        <path d="M16 9h1"></path>
      </svg>
      <span class="record-meta__text">{agent.employee_id ?? "No employee ID"}</span>
    </li>
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
      <span class="record-meta__text">{agent.email ?? "No email"}</span>
    </li>
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
        ></path>
      </svg>
      <span class="record-meta__text">{agent.contact ?? "No contact"}</span>
    </li>
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span class="record-meta__text">{autoCapitalize(agent.status)}</span>
    </li>
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <span class="record-meta__text">Joined {formatDate(agent.created_at)}</span>
    </li>
  </ul>

  <div class="agent-record-content">
    {
      agent.promoted_from_customer_at && (
        <div class="agent-promotion-note" role="note">
          <strong>Promoted customer record</strong>
          <span>
            This agent was previously a customer. Completed customer orders remain unchanged; eligible unpaid orders can be converted into agent distribution orders below.
          </span>
        </div>
      )
    }

    <div class="content-section">
      <h3 class="agent-record-content__heading">Assigned Summary</h3>
      <div class="assigned-summary-grid">
        <div class="detail-field">
          <span class="detail-field-label">Assigned customers</span>
          <div class="detail-field-value">{assignedCustomers.length}</div>
        </div>

        <div class="detail-field detail-field--wide">
          <span class="detail-field-label">Customer remaining balance</span>
          <div class="detail-field-value">{formatCurrency(detailData.remainingBalance)}</div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Agent remaining balance</span>
          <div class="detail-field-value">{formatCurrency(detailData.agentRemainingBalance)}</div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Agent orders</span>
          <div class="detail-field-value">{agentOrders.length}</div>
        </div>
      </div>
    </div>

    {
      agent.promoted_from_customer_id && (
        <div class="content-section">
          <h3 class="agent-record-content__heading">
            Previous Customer Orders ({previousCustomerOrders.length})
          </h3>
          {
            previousCustomerOrders.length === 0 ? (
              <p class="empty-state">No previous customer orders found for this promoted agent.</p>
            ) : (
              <div class="table-wrap">
                <table class="agent-customers-table promoted-customer-orders-table">
                  <thead>
                    <tr>
                      <th scope="col">Action</th>
                      <th scope="col">Date Created</th>
                      <th scope="col">Source</th>
                      <th scope="col">Status</th>
                      <th scope="col">Payment</th>
                      <th scope="col">Balance</th>
                      <th scope="col">Total Amount</th>
                      <th scope="col">Order</th>
                    </tr>
                  </thead>
                  <tbody>
                    {previousCustomerOrders.map(({ order, blockReason, canConvert, balance, totalAmount }) => (
                      <tr>
                        <td>
                          {canConvert ? (
                            <form
                              method="post"
                              class="promoted-order-conversion-form"
                              data-astro-reload
                              onsubmit="return confirm('Convert this customer order into an agent distribution order?')"
                            >
                              <input
                                type="hidden"
                                name="action"
                                value="convert-customer-order-to-agent-distribution"
                              />
                              <input type="hidden" name="orderId" value={order.id} />
                              <input type="hidden" name="returnTo" value={`/admin/agents/${agent.id}`} />
                              <button type="submit">Convert</button>
                            </form>
                          ) : order.converted_to_agent_order_id ? (
                            <ViewButton
                              href={`/admin/orders/agent/${order.converted_to_agent_order_id}?returnTo=${agentReturnTo}`}
                            />
                          ) : (
                            <span class="promoted-order-state">{blockReason ?? "Unavailable"}</span>
                          )}
                        </td>
                        <td>{formatDate(order.created_at)}</td>
                        <td>{formatOrderSource(order.source)}</td>
                        <td>{autoCapitalize(order.order_status)}</td>
                        <td>{autoCapitalize(order.payment_status)}</td>
                        <td>{formatCurrency(balance)}</td>
                        <td>{formatCurrency(totalAmount)}</td>
                        <td>
                          <ViewButton
                            href={`/admin/orders/customer/${order.id}?returnTo=${agentReturnTo}`}
                          />
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )
          }
        </div>
      )
    }

    <div class="content-section">
      <h3 class="agent-record-content__heading">
        Assigned Customers ({assignedCustomers.length})
      </h3>
      {
        assignedCustomers.length === 0 ? (
          <p class="empty-state">No customers assigned to this agent yet.</p>
        ) : (
          <div class="table-wrap">
            <table class="agent-customers-table">
              <thead>
                <tr>
                  <th scope="col">Date Created</th>
                  <th scope="col">Customer</th>
                  <th scope="col">Contact</th>
                  <th scope="col">Address</th>
                  <th scope="col">Action</th>
                </tr>
              </thead>
              <tbody>
                {
                  assignedCustomers.map((customer) => (
                    <tr>
                      <td>{formatDate(customer.created_at)}</td>
                      <td>
                        {fullName(customer)}
                        {
                          customer.is_reseller && (
                            <span class="agent-customers-table__reseller">(reseller)</span>
                          )
                        }
                      </td>
                      <td>
                        {customer.phone_number}
                        <br />
                        {customer.email ?? "No email"}
                      </td>
                      <td>{customer.address}</td>
                      <td>
                        <ViewButton
                          href={`/admin/customers/${customer.id}?returnTo=${agentReturnTo}`}
                        />
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        )
      }
    </div>

    <div class="content-section">
      <h3 class="agent-record-content__heading">
        Agent Orders ({agentOrders.length})
      </h3>
      {
        agentOrders.length === 0 ? (
          <p class="empty-state">No agent orders submitted by this agent yet.</p>
        ) : (
          <div class="table-wrap">
            <table class="agent-customers-table agent-orders-table">
              <thead>
                <tr>
                  <th scope="col">Date Created</th>
                  <th scope="col">Order</th>
                  <th scope="col">Status</th>
                  <th scope="col">Payment</th>
                  <th scope="col">Total Amount</th>
                  <th scope="col">Indication</th>
                  <th scope="col">Action</th>
                </tr>
              </thead>
              <tbody>
                {agentOrders.map(({ order, paymentStatus, totalAmount, indication }) => (
                  <tr>
                    <td>{formatDate(order.created_at)}</td>
                    <td>Agent order {order.id.slice(0, 8)}</td>
                    <td>{autoCapitalize(order.order_status)}</td>
                    <td>{autoCapitalize(paymentStatus)}</td>
                    <td>{formatCurrency(totalAmount)}</td>
                    <td>
                      <span class:list={[
                        "agent-orders-table__indicator",
                        {
                          "agent-orders-table__indicator--warning": indication === "Pending order",
                          "agent-orders-table__indicator--payment": indication === "Pending payment",
                        },
                      ]}>
                        {indication}
                      </span>
                    </td>
                    <td>
                      <ViewButton href={`/admin/orders/agent/${order.id}?returnTo=${agentReturnTo}`} />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>
  </div>
</AdminNotificationsPageLayout>

<style>
  .agent-record-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 100%;
  }

  .agent-record-content__heading {
    margin: 0 0 1.5rem;
  }

  .content-section {
    box-shadow: none !important;
    border: 1px solid #d1d5db !important;
    border-radius: 0.75rem !important;
  }

  .agent-promotion-note {
    display: grid;
    gap: 0.35rem;
    border: 1px solid #f59e0b;
    border-radius: 0.5rem;
    background: #fffbeb;
    color: #78350f;
    padding: 0.85rem 1rem;
    font-size: 0.9rem;
  }

  .agent-promotion-note strong {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .assigned-summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .detail-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background-color: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
  }

  .detail-field--wide {
    grid-column: span 2;
  }

  .detail-field-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-brand-muted-black);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .detail-field-value {
    font-size: 1rem;
    color: #111827;
    font-weight: 500;
  }

  .agent-customers-table {
    table-layout: fixed;
    width: 100%;
  }

  .agent-customers-table th,
  .agent-customers-table td {
    padding: 1.1rem 0.75rem;
    vertical-align: middle;
  }

  .agent-customers-table:not(.agent-orders-table):not(.promoted-customer-orders-table) th:nth-child(1),
  .agent-customers-table:not(.agent-orders-table):not(.promoted-customer-orders-table) td:nth-child(1) {
    width: 16%;
  }

  .agent-customers-table:not(.agent-orders-table):not(.promoted-customer-orders-table) th:nth-child(2),
  .agent-customers-table:not(.agent-orders-table):not(.promoted-customer-orders-table) td:nth-child(2) {
    width: 24%;
  }

  .agent-customers-table:not(.agent-orders-table):not(.promoted-customer-orders-table) th:nth-child(3),
  .agent-customers-table:not(.agent-orders-table):not(.promoted-customer-orders-table) td:nth-child(3) {
    width: 24%;
  }

  .agent-customers-table:not(.agent-orders-table):not(.promoted-customer-orders-table) th:nth-child(4),
  .agent-customers-table:not(.agent-orders-table):not(.promoted-customer-orders-table) td:nth-child(4) {
    width: 26%;
  }

  .agent-customers-table:not(.agent-orders-table):not(.promoted-customer-orders-table) th:nth-child(5),
  .agent-customers-table:not(.agent-orders-table):not(.promoted-customer-orders-table) td:nth-child(5) {
    width: 10%;
  }

  .agent-customers-table__reseller {
    font-size: 0.75rem;
    color: var(--color-brand-muted-black);
    margin-left: 0.25rem;
  }

  .agent-orders-table {
    min-width: 760px;
  }

  .promoted-customer-orders-table {
    min-width: 980px;
  }

  .promoted-order-conversion-form {
    margin: 0;
  }

  .promoted-order-conversion-form button {
    min-height: 2.25rem;
    border: 1px solid rgba(102, 24, 24, 0.2);
    border-radius: 0.45rem;
    background: var(--color-brand-red);
    color: #ffffff;
    padding: 0.35rem 0.65rem;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
  }

  .promoted-order-conversion-form button:hover,
  .promoted-order-conversion-form button:focus-visible {
    background: #111827;
  }

  .promoted-order-state {
    display: inline-flex;
    min-height: 1.7rem;
    align-items: center;
    border-radius: 0.35rem;
    background: #f3f4f6;
    color: #4b5563;
    padding: 0.2rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .agent-orders-table__indicator {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0.2rem 0.55rem;
    border-radius: 0.25rem;
    background: #f3f4f6;
    color: #374151;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .agent-orders-table__indicator--warning {
    background: #fef3c7;
    color: #92400e;
  }

  .agent-orders-table__indicator--payment {
    background: #fee2e2;
    color: #991b1b;
  }

  @media (max-width: 900px) {
    .detail-field--wide {
      grid-column: auto;
    }
  }
</style>
