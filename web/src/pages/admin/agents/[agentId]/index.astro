---
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import ViewButton from "@/components/ViewButton.astro";
import { formatAdminActionFeedback } from "@/lib/admin-dashboard/actions";
import { loadAdminDashboardData } from "@/lib/admin-dashboard/data";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import { fullName, formatDate } from "@/lib/admin-dashboard/view";
import { autoCapitalize } from "@/lib/formatters";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const { agentId } = Astro.params;
const data = await loadAdminDashboardData();
const agent = data.agents.find((a) => a.id === agentId);

if (!agent) {
  return Astro.redirect("/admin/agents", 302);
}

// Find customers assigned to this agent
const assignedCustomers = data.customers.filter((c) => c.assigned_agent_id === agent.id);

// Check if a customer has active orders (status is not closed)
function hasPendingOrders(customerId: string): boolean {
  return data.orders.some(
    (order) =>
      order.customer_id === customerId &&
      order.order_status !== "closed"
  );
}

const feedback = formatAdminActionFeedback(Astro.url);
---

<AdminPageFrame
  title={`Agent Details - ${agent.display_name} - JEHMARP`}
  description="Admin agent profile details and assigned customer list."
  heading={`Agent Record: ${agent.display_name}`}
  intro={`Review detailed profile settings and customer assignments for Agent ${agent.display_name}.`}
  feedback={feedback}
  dashboardData={data}
  backUrl="/admin/agents"
>
  <div style="display: flex; flex-direction: column; gap: 2rem; max-width: 100%;">
    <!-- 1. Agent Profile -->
    <div class="content-section">
      <h3 style="margin-top: 0; margin-bottom: 1.5rem;">Agent Profile</h3>
      <div class="agent-info-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem;">
        <div class="detail-field" style="display: flex; flex-direction: column; gap: 0.25rem; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem;">
          <span class="detail-field-label" style="font-size: 0.75rem; font-weight: 700; color: var(--color-brand-muted-black); text-transform: uppercase; letter-spacing: 0.05em;">Display Name</span>
          <div class="detail-field-value" style="font-size: 1rem; color: #111827; font-weight: 500;">
            {agent.display_name}
          </div>
        </div>

        <div class="detail-field" style="display: flex; flex-direction: column; gap: 0.25rem; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem;">
          <span class="detail-field-label" style="font-size: 0.75rem; font-weight: 700; color: var(--color-brand-muted-black); text-transform: uppercase; letter-spacing: 0.05em;">Email Address</span>
          <div class="detail-field-value" style="font-size: 1rem; color: #111827; font-weight: 500;">
            {agent.email ?? "No email"}
          </div>
        </div>

        <div class="detail-field" style="display: flex; flex-direction: column; gap: 0.25rem; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem;">
          <span class="detail-field-label" style="font-size: 0.75rem; font-weight: 700; color: var(--color-brand-muted-black); text-transform: uppercase; letter-spacing: 0.05em;">Contact Number</span>
          <div class="detail-field-value" style="font-size: 1rem; color: #111827; font-weight: 500;">
            {agent.contact ?? "No contact"}
          </div>
        </div>

        <div class="detail-field" style="display: flex; flex-direction: column; gap: 0.25rem; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem;">
          <span class="detail-field-label" style="font-size: 0.75rem; font-weight: 700; color: var(--color-brand-muted-black); text-transform: uppercase; letter-spacing: 0.05em;">Status</span>
          <div class="detail-field-value" style="font-size: 1rem; color: #111827; font-weight: 500;">
            {autoCapitalize(agent.status)}
          </div>
        </div>



        <div class="detail-field" style="display: flex; flex-direction: column; gap: 0.25rem; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem;">
          <span class="detail-field-label" style="font-size: 0.75rem; font-weight: 700; color: var(--color-brand-muted-black); text-transform: uppercase; letter-spacing: 0.05em;">Date Created</span>
          <div class="detail-field-value" style="font-size: 1rem; color: #111827; font-weight: 500;">
            {formatDate(agent.created_at)}
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Assigned Summary -->
    <div class="content-section">
      <h3 style="margin-top: 0; margin-bottom: 1.5rem;">Assigned Summary</h3>
      <div class="assigned-summary-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem;">
        <div class="detail-field" style="display: flex; flex-direction: column; gap: 0.25rem; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem;">
          <span class="detail-field-label" style="font-size: 0.75rem; font-weight: 700; color: var(--color-brand-muted-black); text-transform: uppercase; letter-spacing: 0.05em;">Assigned Customers</span>
          <div class="detail-field-value" style="font-size: 1rem; color: #111827; font-weight: 500;">
            {assignedCustomers.length}
          </div>
        </div>

        <div class="detail-field" style="display: flex; flex-direction: column; gap: 0.25rem; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem; grid-column: span 2;">
          <span class="detail-field-label" style="font-size: 0.75rem; font-weight: 700; color: var(--color-brand-muted-black); text-transform: uppercase; letter-spacing: 0.05em;">Active tracing</span>
          <div class="detail-field-value" style="font-size: 1rem; color: #111827; font-weight: 500;">
            {assignedCustomers.filter((c) => hasPendingOrders(c.id)).length} customer(s) with pending orders
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Assigned Customers Section -->
    <div class="content-section">
      <h3 style="margin-top: 0; margin-bottom: 1.5rem;">Assigned Customers ({assignedCustomers.length})</h3>
      {assignedCustomers.length === 0 ? (
        <p class="empty-state">No customers assigned to this agent yet.</p>
      ) : (
        <div class="table-wrap">
          <table style="table-layout: fixed; width: 100%;">
            <thead>
              <tr>
                <th scope="col" style="width: 25%; padding: 1.1rem 0.75rem;">Customer</th>
                <th scope="col" style="width: 25%; padding: 1.1rem 0.75rem;">Contact</th>
                <th scope="col" style="width: 25%; padding: 1.1rem 0.75rem;">Address</th>
                <th scope="col" style="width: 15%; padding: 1.1rem 0.75rem;">Status Indicators</th>
                <th scope="col" style="width: 10%; padding: 1.1rem 0.75rem;">Action</th>
              </tr>
            </thead>
            <tbody>
              {assignedCustomers.map((customer) => {
                const pending = hasPendingOrders(customer.id);
                return (
                  <tr>
                    <td style="width: 25%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                      {fullName(customer)}
                      {customer.is_reseller && <span style="font-size: 0.75rem; color: var(--color-brand-muted-black); margin-left: 0.25rem;">(reseller)</span>}
                    </td>
                    <td style="width: 25%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                      {customer.phone_number}<br />
                      {customer.email ?? "No email"}
                    </td>
                    <td style="width: 25%; padding: 1.1rem 0.75rem; vertical-align: middle;">{customer.address}</td>
                    <td style="width: 15%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                      {pending ? (
                        <span style="background-color: var(--color-brand-red); color: white; padding: 0.25rem 0.65rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 700; display: inline-block;">
                          PENDING ORDERS
                        </span>
                      ) : (
                        <span style="color: var(--color-brand-muted-black); font-size: 0.875rem;">
                          No pending orders
                        </span>
                      )}
                    </td>
                    <td style="width: 10%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                      <ViewButton href={`/admin/customers/${customer.id}`} />
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</AdminPageFrame>

<style>
  /* Remove shadows on cards, add matching gray border and border-radius */
  .content-section {
    box-shadow: none !important;
    border: 1px solid #d1d5db !important;
    border-radius: 0.75rem !important;
  }
</style>
