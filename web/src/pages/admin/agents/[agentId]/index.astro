---
import AdminAgentRecordContent from "@/components/admin/AdminAgentRecordContent.astro";
import AdminNotificationsPageLayout from "@/components/admin/AdminNotificationsPageLayout.astro";
import RouteBackButton from "@/components/dashboard/RouteBackButton.astro";
import { formatAdminActionFeedback } from "@/lib/admin-dashboard/actions";
import {
  agentRecordCommissionTotal,
  agentRecordEstimatedInvoiceTotal,
  agentRecordOrderCounts,
  agentRecordPaymentsSubmitted,
  buildAgentAssignedCustomerRows,
  buildAgentPerformanceQuickStats,
  buildAgentPreviousOrderRows,
  buildAgentReceivableSegments,
  buildAgentRecordOrderRows,
  filterAgentAssignedCustomerRows,
  filterAgentPreviousOrderRows,
  filterAgentRecordOrderRows,
  paginateAgentRecords,
  parseAgentRecordFilters,
  parseAgentRecordTab,
  serializeAgentRecordFilters,
} from "@/lib/admin-dashboard/agent-record";
import {
  buildCustomerInvoiceRows,
  buildCustomerPaymentRows,
  buildCustomerSalesRows,
  customerProcessingReceivableTotal,
  filterCustomerInvoiceRows,
  filterCustomerPaymentRows,
  filterCustomerSalesRows,
} from "@/lib/admin-dashboard/customer-record";
import {
  loadAdminAgentDetailsData,
  loadAdminCustomerRecord,
  loadAdminDashboardData,
} from "@/lib/admin-dashboard/data";
import { mergeAdminPaginationQuery, parseAdminPagination } from "@/lib/admin-dashboard/pagination";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import {
  canConvertPromotedCustomerOrderToDistribution,
  formatAgentCode,
  getCustomerOrderDistributionConversionBlockReason,
  orderBalance,
  orderTotal,
} from "@/lib/admin-dashboard/view";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const { agentId } = Astro.params;

if (!agentId) {
  return Astro.redirect("/admin/agents", 302);
}

const [dashboardData, detailData] = await Promise.all([
  loadAdminDashboardData(),
  loadAdminAgentDetailsData(agentId),
]);

if (!detailData) {
  return Astro.redirect("/admin/agents", 302);
}

const agent = detailData.agent;
const feedback = formatAdminActionFeedback(Astro.url);
const agentReturnTo = encodeURIComponent(`/admin/agents/${agent.id}`);
const returnToParam = Astro.url.searchParams.get("returnTo");
const backUrl =
  returnToParam?.startsWith("/admin/") && !returnToParam.startsWith("//")
    ? returnToParam
    : "/admin/agents";
const backLabel = "Back to agents";
const activeTab = parseAgentRecordTab(Astro.url.searchParams.get("tab"));
const orderFilters = parseAgentRecordFilters(Astro.url);
const pagination = parseAdminPagination(Astro.url);
const customerOrders = detailData.customerOrders;
const promotedCustomerId = agent.promoted_from_customer_id ?? null;
const linkedCustomer = promotedCustomerId
  ? await loadAdminCustomerRecord(promotedCustomerId)
  : agent.customer_id
    ? dashboardData.customers.find((customer) => customer.id === agent.customer_id) ?? null
    : null;
const showPreviousOrdersTab = Boolean(agent.promoted_from_customer_id);

const orderCounts = agentRecordOrderCounts(customerOrders, detailData.agentOrders);
const commissionEarned = agentRecordCommissionTotal(customerOrders, detailData.agentOrders);
const paymentsSubmitted = agentRecordPaymentsSubmitted(agent.id, customerOrders, detailData.agentOrders);
const performanceQuickStats = buildAgentPerformanceQuickStats(
  agent.id,
  customerOrders,
  detailData.agentOrders,
  dashboardData.products,
  agentReturnTo,
);
const processingReceivableTotal = customerProcessingReceivableTotal(customerOrders);
const estimatedInvoiceTotal = agentRecordEstimatedInvoiceTotal(
  customerOrders,
  detailData.agentOrders,
);
const receivableSegments = buildAgentReceivableSegments(
  customerOrders,
  detailData.agentOrders,
);

const filteredOrders = filterAgentRecordOrderRows(
  buildAgentRecordOrderRows(customerOrders, detailData.agentOrders, agentReturnTo),
  orderFilters,
);
const paginatedOrders = paginateAgentRecords(
  filteredOrders,
  pagination.page,
  pagination.pageSize,
);
const salesRows = filterCustomerSalesRows(
  buildCustomerSalesRows(customerOrders, agentReturnTo),
  orderFilters,
);
const paginatedSales = paginateAgentRecords(
  salesRows,
  pagination.page,
  pagination.pageSize,
);
const invoiceRows = filterCustomerInvoiceRows(
  buildCustomerInvoiceRows(customerOrders, agentReturnTo),
  orderFilters.search,
);
const paginatedInvoices = paginateAgentRecords(
  invoiceRows,
  pagination.page,
  pagination.pageSize,
);
const paymentRows = filterCustomerPaymentRows(
  buildCustomerPaymentRows(customerOrders, agentReturnTo),
  orderFilters.search,
);
const paginatedPayments = paginateAgentRecords(
  paymentRows,
  pagination.page,
  pagination.pageSize,
);

const assignedCustomerRows = filterAgentAssignedCustomerRows(
  buildAgentAssignedCustomerRows(detailData.assignedCustomers, agentReturnTo),
  orderFilters.search,
);
const paginatedAssignedCustomers = paginateAgentRecords(
  assignedCustomerRows,
  pagination.page,
  pagination.pageSize,
);
const previousOrderRows = filterAgentPreviousOrderRows(
  buildAgentPreviousOrderRows(
    detailData.previousCustomerOrders,
    agentReturnTo,
    {
      getBlockReason: (order) => getCustomerOrderDistributionConversionBlockReason(order, agent.id),
      canConvert: (order) => canConvertPromotedCustomerOrderToDistribution(order, agent.id),
      getBalance: (order) => orderBalance(order),
      getTotalAmount: (order) => orderTotal(order, "final_quantity"),
    },
  ),
  orderFilters.search,
);
const paginatedPreviousOrders = paginateAgentRecords(
  previousOrderRows,
  pagination.page,
  pagination.pageSize,
);

const filterQuery = mergeAdminPaginationQuery(
  serializeAgentRecordFilters(orderFilters),
  pagination,
);
---

<AdminNotificationsPageLayout
  title={`Agent Details - ${agent.display_name} - JEHMARP`}
  description="Admin agent profile, assigned customers, and order history."
  heading={agent.display_name}
  feedback={feedback}
  dashboardData={dashboardData}
  contentMaxWidth="78rem"
  scrollOnParent={true}
>
  <div slot="heading-title" class="agent-record-header">
    <p class="order-detail-eyebrow">Agents / Agent Details</p>
    <div class="order-summary-top">
      <div class="order-summary-top__main">
        <RouteBackButton href={backUrl} label={backLabel} />
        <div class="order-title-copy">
          <h1 class="agent-record-header__title">{agent.display_name}</h1>
          <p>Agent ID: {formatAgentCode(agent.id)}</p>
        </div>
      </div>
    </div>
  </div>

  <AdminAgentRecordContent
    agent={agent}
    linkedCustomer={linkedCustomer}
    activeTab={activeTab}
    filterQuery={filterQuery}
    orderFilters={orderFilters}
    orderRows={paginatedOrders.records}
    ordersPagination={paginatedOrders.pagination}
    salesRows={paginatedSales.records}
    salesPagination={paginatedSales.pagination}
    invoiceRows={paginatedInvoices.records}
    invoicesPagination={paginatedInvoices.pagination}
    paymentRows={paginatedPayments.records}
    paymentsPagination={paginatedPayments.pagination}
    assignedCustomerRows={paginatedAssignedCustomers.records}
    assignedCustomersPagination={paginatedAssignedCustomers.pagination}
    previousOrderRows={paginatedPreviousOrders.records}
    previousOrdersPagination={paginatedPreviousOrders.pagination}
    orderCounts={orderCounts}
    processingReceivableTotal={processingReceivableTotal}
    estimatedInvoiceTotal={estimatedInvoiceTotal}
    receivableSegments={receivableSegments}
    assignedCustomersCount={detailData.assignedCustomers.length}
    commissionEarned={commissionEarned}
    paymentsSubmitted={paymentsSubmitted}
    performanceQuickStats={performanceQuickStats}
    agentReturnTo={agentReturnTo}
    showPreviousOrdersTab={showPreviousOrdersTab}
    hasAgentDistributionOrders={detailData.agentOrders.length > 0}
  />
</AdminNotificationsPageLayout>

<style>
  .agent-record-header {
    min-width: 0;
  }

  .order-detail-eyebrow {
    margin: 0 0 1.25rem;
    color: rgba(17, 24, 39, 0.56);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .order-summary-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .order-summary-top__main {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    min-width: 0;
  }

  .order-summary-top__main :global(.route-back-button) {
    flex-shrink: 0;
  }

  .order-title-copy {
    min-width: 0;
  }

  .agent-record-header__title {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.15;
    font-weight: 700;
    color: #111827;
  }

  .order-title-copy p {
    margin: 0.35rem 0 0;
    color: rgba(17, 24, 39, 0.62);
    font-size: 0.92rem;
  }

  @media (max-width: 720px) {
    .order-summary-top {
      flex-direction: column;
    }
  }
</style>
