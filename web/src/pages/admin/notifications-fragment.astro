---
import AdminNotifications from "@/components/admin/AdminNotifications.astro";
import { loadAdminDashboardData } from "@/lib/admin-dashboard/data";
import { buildAdminNotificationsPageData } from "@/lib/admin-dashboard/notifications";
import {
  parseAdminPagination,
  serializeAdminPagination,
} from "@/lib/admin-dashboard/pagination";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import { setDashboardFragmentResponseHeaders } from "@/lib/dashboard/fragment-response";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

setDashboardFragmentResponseHeaders(Astro);

const pagination = parseAdminPagination(Astro.url);
const paginationQuery = serializeAdminPagination(pagination);
const data = await loadAdminDashboardData();
const notificationsData = buildAdminNotificationsPageData(data, pagination);
---

<AdminNotifications
  data={notificationsData}
  paginationQuery={paginationQuery}
/>
