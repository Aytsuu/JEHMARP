---
import AdminOrderManagement from "@/components/admin/AdminOrderManagement.astro";
import { loadAdminOrderManagementData } from "@/lib/admin-dashboard/data";
import {
  parseAdminOrderFilters,
  serializeAdminOrderFilters,
} from "@/lib/admin-dashboard/order-filters";
import {
  mergeAdminPaginationQuery,
  parseAdminPagination,
} from "@/lib/admin-dashboard/pagination";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import { setDashboardFragmentResponseHeaders } from "@/lib/dashboard/fragment-response";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

setDashboardFragmentResponseHeaders(Astro);

const orderFilters = parseAdminOrderFilters(Astro.url);
const orderPagination = parseAdminPagination(Astro.url);
const orderFilterQuery = mergeAdminPaginationQuery(
  serializeAdminOrderFilters(orderFilters),
  orderPagination,
);
const data = await loadAdminOrderManagementData(orderFilters, orderPagination);
---

<AdminOrderManagement
  data={data}
  activeFilters={orderFilters}
  filterQuery={orderFilterQuery}
/>
