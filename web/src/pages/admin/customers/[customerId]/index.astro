---
import AdminNotificationsPageLayout from "@/components/admin/AdminNotificationsPageLayout.astro";
import ViewButton from "@/components/ViewButton.astro";
import {
  formatAdminActionFeedback,
  handleAdminDashboardAction,
} from "@/lib/admin-dashboard/actions";
import { loadAdminDashboardData } from "@/lib/admin-dashboard/data";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import {
  formatCurrency,
  formatCompactCurrency,
  formatDate,
  fullName,
  orderBalance,
  orderTotal,
} from "@/lib/admin-dashboard/view";
import { autoCapitalize, formatOrderSource } from "@/lib/formatters";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const { customerId } = Astro.params;

if (Astro.request.method === "POST") {
  return handleAdminDashboardAction(
    Astro,
    adminRoute.userId,
    `/admin/customers/${customerId}`,
  );
}

const data = await loadAdminDashboardData();
const customer = data.customers.find((c) => c.id === customerId);

if (!customer) {
  return Astro.redirect("/admin/customers", 302);
}

const customerOrders = data.orders.filter((order) => order.customer_id === customerId);
const pendingOrders = customerOrders.filter((order) => order.order_status !== "closed");
const historicalOrders = customerOrders.filter((order) => order.order_status === "closed");
const assignedAgent = data.agents.find((agent) => agent.id === customer.assigned_agent_id);
const linkedAgent = data.agents.find((agent) => agent.customer_id === customer.id);
const pendingTotalBalance = pendingOrders.reduce((total, order) => total + orderBalance(order), 0);
const today = new Date().toISOString().slice(0, 10);
const feedback = formatAdminActionFeedback(Astro.url);
const customerName = fullName(customer);
const customerReturnTo = encodeURIComponent(`/admin/customers/${customer.id}`);
const returnToParam = Astro.url.searchParams.get("returnTo");
const backUrl =
  returnToParam?.startsWith("/admin/") && !returnToParam.startsWith("//")
    ? returnToParam
    : "/admin/customers";
const backLabel = backUrl.startsWith("/admin/agents/")
  ? "Back to agent record"
  : "Back to customers";
---

<AdminNotificationsPageLayout
  title={`Customer Details - ${customerName} - JEHMARP`}
  description="Admin customer order summary, pending orders, and order history."
  heading={customerName}
  backUrl={backUrl}
  backLabel={backLabel}
  feedback={feedback}
  dashboardData={data}
  contentMaxWidth="72rem"
  fullHeight
>
  <ul slot="heading-meta" class="record-meta" aria-label="Customer details">
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
        ></path>
      </svg>
      <span class="record-meta__text">{customer.phone_number}</span>
    </li>
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
      <span class="record-meta__text">{customer.email ?? "No email"}</span>
    </li>
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
        <line x1="7" y1="7" x2="7.01" y2="7"></line>
      </svg>
      <span class="record-meta__text">
        {customer.is_reseller ? "Reseller customer" : "Retail customer"}
      </span>
    </li>
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span class="record-meta__text">
        {assignedAgent ? assignedAgent.display_name : "No assigned agent"}
      </span>
    </li>
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 21v-2a4 4 0 0 0-4-4h-1"></path>
        <path d="M4 21v-2a4 4 0 0 1 4-4h1"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span class="record-meta__text">
        {linkedAgent ? `Agent profile: ${linkedAgent.display_name}` : "Not an agent"}
      </span>
    </li>
    <li class="record-meta__item record-meta__item--wide">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <span class="record-meta__text">{customer.address}</span>
    </li>
  </ul>

  <div class="customer-record-content">
    <div class="content-section">
      <h3 class="customer-record-content__heading">Orders Summary</h3>
      <div class="orders-summary-grid">
        <div class="detail-field">
          <span class="detail-field-label">Total orders</span>
          <div class="detail-field-value">{customerOrders.length}</div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Pending orders</span>
          <div class="detail-field-value">{pendingOrders.length}</div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Pending balance</span>
          <div class="detail-field-value">{formatCurrency(pendingTotalBalance)}</div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Credit limit</span>
          <div class="detail-field-value">{formatCompactCurrency(customer.credit_limit)}</div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Credit status</span>
          <div class="detail-field-value">
            {customer.credit_limit_exceeded ? "Exceeded" : "Within limit"}
          </div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Historical orders</span>
          <div class="detail-field-value">{historicalOrders.length}</div>
        </div>
      </div>

      <form method="post" class="customer-credit-form">
        <input type="hidden" name="action" value="save-customer" />
        <input type="hidden" name="customerId" value={customer.id} />
        <input type="hidden" name="firstName" value={customer.first_name} />
        <input type="hidden" name="lastName" value={customer.last_name} />
        <input type="hidden" name="phoneNumber" value={customer.phone_number} />
        <input type="hidden" name="email" value={customer.email ?? ""} />
        <input type="hidden" name="address" value={customer.address} />
        <input type="hidden" name="assignedAgentId" value={customer.assigned_agent_id ?? ""} />
        {customer.is_reseller && <input type="hidden" name="isReseller" value="on" />}
        <label>
          <span>Credit limit</span>
          <input name="creditLimit" type="number" min="0" step="1" value={customer.credit_limit} required />
        </label>
        <button type="submit" class="btn-table-manage">Save Credit</button>
      </form>

      <div class="customer-record-actions">
        {linkedAgent ? (
          <a href={`/admin/agents/${linkedAgent.id}`} class="btn-table-manage">View Agent</a>
        ) : (
          <form method="post">
            <input type="hidden" name="action" value="promote-customer-to-agent" />
            <input type="hidden" name="customerId" value={customer.id} />
            <button type="submit" class="btn-table-manage">Promote to Agent</button>
          </form>
        )}
      </div>
    </div>

    <div class="content-section">
      <h3 class="customer-record-content__heading">Pending Orders ({pendingOrders.length})</h3>
      {
        pendingOrders.length === 0 ? (
          <p class="empty-state">No pending orders found for this customer.</p>
        ) : (
          <>
          <div class="pending-payment-summary">
            <strong>Total to be paid</strong>
            <span>{formatCurrency(pendingTotalBalance)}</span>
          </div>
          <form method="post" class="customer-payment-distribution-form">
            <input type="hidden" name="action" value="apply-customer-payment" />
            <input type="hidden" name="customerId" value={customer.id} />
            <label>
              <span>Received payment</span>
              <input name="amount" type="number" min="0.01" step="0.01" max={pendingTotalBalance} required />
            </label>
            <label>
              <span>Payment method</span>
              <select name="paymentMethod" required>
                <option value="">Select method</option>
                <option value="Cash" selected>Cash</option>
                <option value="Check">Check</option>
              </select>
            </label>
            <label>
              <span>Payment terms</span>
              <select name="paymentTerms" required>
                <option value="">Select payment terms</option>
                <option value="Cash on Delivery (COD)" selected>Cash on Delivery (COD)</option>
                <option value="Bank Transfer">Bank Transfer</option>
                <option value="Gcash">Gcash</option>
              </select>
            </label>
            <label>
              <span>Payment date</span>
              <input name="paymentDate" type="date" value={today} required />
            </label>
            <label>
              <span>Reference</span>
              <input name="referenceNumber" />
            </label>
            <label class="customer-payment-distribution-form__notes">
              <span>Notes</span>
              <textarea name="notes" rows="2"></textarea>
            </label>
            <button type="submit" class="btn-table-manage">Distribute Payment</button>
          </form>
          <div class="table-wrap">
            <table style="table-layout: fixed; width: 100%;">
              <thead>
                <tr>
                  <th scope="col" style="width: 17%; padding: 1.1rem 0.75rem;">Order Date</th>
                  <th scope="col" style="width: 17%; padding: 1.1rem 0.75rem;">Source</th>
                  <th scope="col" style="width: 17%; padding: 1.1rem 0.75rem;">Order Status</th>
                  <th scope="col" style="width: 17%; padding: 1.1rem 0.75rem;">Payment Status</th>
                  <th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Balance</th>
                  <th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Action</th>
                </tr>
              </thead>
              <tbody>
                {
                  pendingOrders.map((order) => {
                    const balance = orderBalance(order);
                    return (
                      <tr>
                        <td style="width: 17%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                          {formatDate(order.created_at)}
                        </td>
                        <td style="width: 17%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                          {formatOrderSource(order.source)}
                        </td>
                        <td style="width: 17%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                          {autoCapitalize(order.order_status)}
                        </td>
                        <td style="width: 17%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                          {autoCapitalize(order.payment_status)}
                        </td>
                        <td style="width: 16%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                          {formatCurrency(balance)}
                        </td>
                        <td style="width: 16%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                          <ViewButton
                            href={`/admin/orders/customer/${order.id}?returnTo=${customerReturnTo}`}
                          />
                        </td>
                      </tr>
                    );
                  })
                }
              </tbody>
            </table>
          </div>
          </>
        )
      }
    </div>

    <div class="content-section">
      <h3 class="customer-record-content__heading">
        Historical & Closed Orders ({historicalOrders.length})
      </h3>
      {
        historicalOrders.length === 0 ? (
          <p class="empty-state">No historical or closed orders found for this customer.</p>
        ) : (
          <div class="table-wrap">
            <table style="table-layout: fixed; width: 100%;">
              <thead>
                <tr>
                  <th scope="col" style="width: 17%; padding: 1.1rem 0.75rem;">Order Date</th>
                  <th scope="col" style="width: 17%; padding: 1.1rem 0.75rem;">Source</th>
                  <th scope="col" style="width: 17%; padding: 1.1rem 0.75rem;">Order Status</th>
                  <th scope="col" style="width: 17%; padding: 1.1rem 0.75rem;">Payment Status</th>
                  <th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Total</th>
                  <th scope="col" style="width: 16%; padding: 1.1rem 0.75rem;">Action</th>
                </tr>
              </thead>
              <tbody>
                {
                  historicalOrders.map((order) => {
                    const invoice = order.invoice[0];
                    const total = orderTotal(order, invoice ? "final_quantity" : "partial_quantity");
                    return (
                      <tr>
                        <td style="width: 17%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                          {formatDate(order.created_at)}
                        </td>
                        <td style="width: 17%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                          {formatOrderSource(order.source)}
                        </td>
                        <td style="width: 17%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                          {autoCapitalize(order.order_status)}
                        </td>
                        <td style="width: 17%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                          {autoCapitalize(order.payment_status)}
                        </td>
                        <td style="width: 16%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                          {formatCurrency(total)}
                        </td>
                        <td style="width: 16%; padding: 1.1rem 0.75rem; vertical-align: middle;">
                          <ViewButton
                            href={`/admin/orders/customer/${order.id}?returnTo=${customerReturnTo}`}
                          />
                        </td>
                      </tr>
                    );
                  })
                }
              </tbody>
            </table>
          </div>
        )
      }
    </div>
  </div>
</AdminNotificationsPageLayout>

<style>
  .customer-record-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 100%;
  }

  .customer-record-content__heading {
    margin: 0 0 1.5rem;
  }

  .content-section {
    box-shadow: none !important;
    border: 1px solid #d1d5db !important;
    border-radius: 0.75rem !important;
  }

  .orders-summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .customer-record-actions {
    margin-top: 1rem;
    display: flex;
    justify-content: flex-end;
  }

  .customer-credit-form {
    display: flex;
    align-items: end;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background-color: #f9fafb;
    padding: 0.75rem 1rem;
  }

  .customer-credit-form label {
    display: flex;
    min-width: min(100%, 16rem);
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-brand-muted-black);
  }

  .customer-credit-form input {
    width: 100%;
  }

  .pending-payment-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background-color: #f9fafb;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
  }

  .customer-payment-distribution-form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.75rem;
    align-items: end;
    margin-bottom: 1rem;
  }

  .customer-payment-distribution-form label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-brand-muted-black);
  }

  .customer-payment-distribution-form input,
  .customer-payment-distribution-form textarea {
    width: 100%;
  }

  .customer-payment-distribution-form__notes {
    grid-column: span 2;
  }

  .detail-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background-color: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
  }

  .detail-field-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-brand-muted-black);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .detail-field-value {
    font-size: 1rem;
    color: #111827;
    font-weight: 500;
  }
</style>
