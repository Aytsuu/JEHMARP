---
import AdminCustomerRecordContent from "@/components/admin/AdminCustomerRecordContent.astro";
import AdminNotificationsPageLayout from "@/components/admin/AdminNotificationsPageLayout.astro";
import RouteBackButton from "@/components/dashboard/RouteBackButton.astro";
import {
  formatAdminActionFeedback,
  markAdminRegularCheckNotificationsReadForCustomer,
} from "@/lib/admin-dashboard/actions";
import {
  buildCustomerInvoiceRows,
  buildCustomerPaymentRows,
  buildCustomerReceivableSegments,
  buildCustomerSalesRows,
  customerEstimatedInvoiceTotal,
  customerOrderCounts,
  customerOutstandingCreditBalance,
  customerProcessingReceivableTotal,
  filterCustomerInvoiceRows,
  filterCustomerOrders,
  filterCustomerPaymentRows,
  filterCustomerSalesRows,
  paginateCustomerRecords,
  parseCustomerRecordTab,
} from "@/lib/admin-dashboard/customer-record";
import {
  agentHasDistributionOrders,
  loadAdminCustomerRecord,
  loadAdminDashboardData,
} from "@/lib/admin-dashboard/data";
import {
  parseAdminOrderFilters,
  serializeAdminOrderFilters,
} from "@/lib/admin-dashboard/order-filters";
import {
  mergeAdminPaginationQuery,
  parseAdminPagination,
} from "@/lib/admin-dashboard/pagination";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import { fullName } from "@/lib/admin-dashboard/view";
import { manilaDateInputValue, manilaTimeInputValue } from "@/lib/datetime";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const { customerId } = Astro.params;

let data = await loadAdminDashboardData();
const customer =
  data.customers.find((entry) => entry.id === customerId) ??
  (customerId ? await loadAdminCustomerRecord(customerId) : null);

if (!customer) {
  return Astro.redirect("/admin/customers", 302);
}

if (customerId) {
  await markAdminRegularCheckNotificationsReadForCustomer(
    Astro,
    customerId,
    adminRoute.userId,
    data.orders,
    data.customers,
  );
  data = await loadAdminDashboardData();
}

const activeTab = parseCustomerRecordTab(Astro.url.searchParams.get("tab"));
const orderFilters = parseAdminOrderFilters(Astro.url);
const pagination = parseAdminPagination(Astro.url);
const customerOrders = data.orders.filter(
  (order) => order.customer_id === customerId,
);
const assignedAgent =
  data.agents.find((agent) => agent.id === customer.assigned_agent_id) ?? null;
const linkedAgent = data.agents.find(
  (agent) =>
    agent.customer_id === customer.id ||
    agent.promoted_from_customer_id === customer.id ||
    agent.id === customer.promoted_to_agent_id,
);
const isPromotedCustomer = Boolean(
  customer.promoted_to_agent_id ||
  linkedAgent?.promoted_from_customer_id === customer.id,
);
const promotedAgentId = customer.promoted_to_agent_id ?? linkedAgent?.id ?? null;
const hasAgentDistributionOrders = promotedAgentId
  ? await agentHasDistributionOrders(promotedAgentId)
  : false;
const feedback = formatAdminActionFeedback(Astro.url);
const customerName = fullName(customer);
const customerReturnTo = encodeURIComponent(`/admin/customers/${customer.id}`);
const returnToParam = Astro.url.searchParams.get("returnTo");
const backUrl =
  returnToParam?.startsWith("/admin/") && !returnToParam.startsWith("//")
    ? returnToParam
    : "/admin/customers";
const backLabel = backUrl.startsWith("/admin/agents/")
  ? "Back to agent record"
  : "Back to customers";
const customerEmail = customer.email?.trim() ?? "";
const hasCustomerEmail = customerEmail.length > 0;
const today = manilaDateInputValue();
const todayTime = manilaTimeInputValue();
const orderCounts = customerOrderCounts(customerOrders);
const outstandingCreditBalance =
  customerOutstandingCreditBalance(customerOrders);
const processingReceivableTotal =
  customerProcessingReceivableTotal(customerOrders);
const estimatedInvoiceTotal = customerEstimatedInvoiceTotal(customerOrders);
const receivableSegments = buildCustomerReceivableSegments(customerOrders);
const filteredOrders = filterCustomerOrders(customerOrders, orderFilters);
const paginatedOrders = paginateCustomerRecords(
  filteredOrders,
  pagination.page,
  pagination.pageSize,
);
const salesRows = filterCustomerSalesRows(
  buildCustomerSalesRows(customerOrders, customerReturnTo),
  orderFilters,
);
const paginatedSales = paginateCustomerRecords(
  salesRows,
  pagination.page,
  pagination.pageSize,
);
const invoiceRows = filterCustomerInvoiceRows(
  buildCustomerInvoiceRows(customerOrders, customerReturnTo),
  orderFilters.search,
);
const paginatedInvoices = paginateCustomerRecords(
  invoiceRows,
  pagination.page,
  pagination.pageSize,
);
const paymentRows = filterCustomerPaymentRows(
  buildCustomerPaymentRows(customerOrders, customerReturnTo),
  orderFilters.search,
);
const paginatedPayments = paginateCustomerRecords(
  paymentRows,
  pagination.page,
  pagination.pageSize,
);
const filterQuery = mergeAdminPaginationQuery(
  serializeAdminOrderFilters(orderFilters),
  pagination,
);
const tabQueryBase = filterQuery
  ? `${filterQuery}&tab=${activeTab}`
  : `tab=${activeTab}`;
---

<AdminNotificationsPageLayout
  title={`Customer Details - ${customerName} - JEHMARP`}
  description="Admin customer profile, receivables, and order history."
  heading={customerName}
  feedback={feedback}
  dashboardData={data}
  contentMaxWidth="78rem"
  scrollOnParent={true}
>
  <div slot="heading-title" class="customer-record-header">
    <p class="order-detail-eyebrow">Customers / Customer Details</p>
    <div class="order-summary-top">
      <div class="order-summary-top__main">
        <RouteBackButton href={backUrl} label={backLabel} />
        <div class="order-title-copy">
          <h1 class="customer-record-header__title">{customerName}</h1>
          <p>Tracking Number: {customer.tracking_number}</p>
        </div>
      </div>
    </div>
  </div>

  <AdminCustomerRecordContent
    customer={customer}
    agents={data.agents}
    assignedAgent={assignedAgent}
    linkedAgent={linkedAgent}
    isPromotedCustomer={isPromotedCustomer}
    hasAgentDistributionOrders={hasAgentDistributionOrders}
    activeTab={activeTab}
    tabQueryBase={tabQueryBase}
    filterQuery={filterQuery}
    orderFilters={orderFilters}
    orderRows={paginatedOrders.records}
    ordersPagination={paginatedOrders.pagination}
    salesRows={paginatedSales.records}
    salesPagination={paginatedSales.pagination}
    invoiceRows={paginatedInvoices.records}
    invoicesPagination={paginatedInvoices.pagination}
    paymentRows={paginatedPayments.records}
    paymentsPagination={paginatedPayments.pagination}
    orderCounts={orderCounts}
    outstandingCreditBalance={outstandingCreditBalance}
    processingReceivableTotal={processingReceivableTotal}
    estimatedInvoiceTotal={estimatedInvoiceTotal}
    receivableSegments={receivableSegments}
    customerReturnTo={customerReturnTo}
    customerEmail={customerEmail}
    hasCustomerEmail={hasCustomerEmail}
    today={today}
    todayTime={todayTime}
  />
</AdminNotificationsPageLayout>

<style>
  .customer-record-header {
    min-width: 0;
  }

  .order-detail-eyebrow {
    margin: 0 0 1.25rem;
    color: rgba(17, 24, 39, 0.56);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .order-summary-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .order-summary-top__main {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    min-width: 0;
  }

  .order-summary-top__main :global(.route-back-button) {
    flex-shrink: 0;
  }

  .order-title-copy {
    min-width: 0;
  }

  .customer-record-header__title {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.15;
    font-weight: 700;
    color: #111827;
  }

  .order-title-copy p {
    margin: 0.35rem 0 0;
    color: rgba(17, 24, 39, 0.62);
    font-size: 0.92rem;
  }

  @media (max-width: 720px) {
    .order-summary-top {
      flex-direction: column;
    }
  }
</style>
