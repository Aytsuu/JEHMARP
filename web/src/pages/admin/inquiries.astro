---
import AdminInquiryManagement from "@/components/admin/AdminInquiryManagement.astro";
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import {
  formatAdminActionFeedback,
  getInquiryStatuses,
  markUnreadAdminInquiriesRead,
} from "@/lib/admin-dashboard/actions";
import { loadAdminDashboardData } from "@/lib/admin-dashboard/data";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

await markUnreadAdminInquiriesRead(Astro, adminRoute.userId);

const data = await loadAdminDashboardData();
const feedback = formatAdminActionFeedback(Astro.url);
---

<AdminPageFrame
  title="Admin Inquiries - JEHMARP"
  description="Admin contact inquiry management."
  heading="Contact Inquiry Management"
  intro="Review contact inquiries and update status or internal notes."
  feedback={feedback}
  dashboardData={data}
>
  <AdminInquiryManagement data={data} inquiryStatuses={getInquiryStatuses()} />
</AdminPageFrame>
