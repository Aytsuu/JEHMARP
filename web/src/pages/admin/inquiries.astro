---
import AdminInquiryManagement from "@/components/admin/AdminInquiryManagement.astro";
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import {
  formatAdminActionFeedback,
  getInquiryStatuses,
  markUnreadAdminInquiriesRead,
} from "@/lib/admin-dashboard/actions";
import {
  loadAdminDashboardData,
  loadAdminInquiryManagementData,
} from "@/lib/admin-dashboard/data";
import {
  parseAdminInquiryFilters,
  serializeAdminInquiryFilters,
} from "@/lib/admin-dashboard/inquiry-filters";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

await markUnreadAdminInquiriesRead(Astro, adminRoute.userId);

const inquiryFilters = parseAdminInquiryFilters(Astro.url);
const inquiryFilterQuery = serializeAdminInquiryFilters(inquiryFilters);
const [dashboardData, data] = await Promise.all([
  loadAdminDashboardData(),
  loadAdminInquiryManagementData(inquiryFilters),
]);
const feedback = formatAdminActionFeedback(Astro.url);
---

<AdminPageFrame
  title="Admin Inquiries - JEHMARP"
  description="Admin contact inquiry management."
  heading="Contact Inquiry Management"
  intro="Review contact inquiries and update status or internal notes."
  feedback={feedback}
  dashboardData={dashboardData}
>
  <AdminInquiryManagement
    data={data}
    inquiryStatuses={getInquiryStatuses()}
    activeFilters={inquiryFilters}
    filterQuery={inquiryFilterQuery}
  />
</AdminPageFrame>
