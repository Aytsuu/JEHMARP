---
import AdminInvoiceManagement from "@/components/admin/AdminInvoiceManagement.astro";
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import { formatAdminActionFeedback } from "@/lib/admin-dashboard/actions";
import {
  loadAdminDashboardData,
  loadAdminInvoiceManagementData,
} from "@/lib/admin-dashboard/data";
import {
  parseAdminInvoiceFilters,
  serializeAdminInvoiceFilters,
} from "@/lib/admin-dashboard/invoice-filters";
import {
  mergeAdminPaginationQuery,
  parseAdminPagination,
} from "@/lib/admin-dashboard/pagination";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const invoiceFilters = parseAdminInvoiceFilters(Astro.url);
const invoicePagination = parseAdminPagination(Astro.url);
const invoiceFilterQuery = mergeAdminPaginationQuery(
  serializeAdminInvoiceFilters(invoiceFilters),
  invoicePagination,
);
const [dashboardData, data] = await Promise.all([
  loadAdminDashboardData(),
  loadAdminInvoiceManagementData(invoiceFilters, invoicePagination),
]);
const feedback = formatAdminActionFeedback(Astro.url);
---

<AdminPageFrame
  title="Admin Invoices - JEHMARP"
  description="Admin invoice creation, payment tracking, and balance management."
  heading="Invoice Records"
  intro="Review invoices created from orders, open sales invoice PDFs, and record payments."
  feedback={feedback}
  dashboardData={dashboardData}
>
  <AdminInvoiceManagement
    data={data}
    activeFilters={invoiceFilters}
    filterQuery={invoiceFilterQuery}
  />
</AdminPageFrame>
