---
import AdminContentManagement from "@/components/admin/AdminContentManagement.astro";
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import { formatAdminActionFeedback, getPageStatuses } from "@/lib/admin-dashboard/actions";
import { loadAdminDashboardData } from "@/lib/admin-dashboard/data";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const data = await loadAdminDashboardData();
const feedback = formatAdminActionFeedback(Astro.url);
---

<AdminPageFrame
  title="NMC | Admin Content"
  description="Admin public content management."
  heading="Public Content Management"
  intro="Update JSON content, ordering, and publish status for existing predefined public page sections."
  feedback={feedback}
>
  <AdminContentManagement data={data} pageStatuses={getPageStatuses()} />
</AdminPageFrame>
