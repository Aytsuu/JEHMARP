---
import AdminAgentManagement from "@/components/admin/AdminAgentManagement.astro";
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import { formatAdminActionFeedback } from "@/lib/admin-dashboard/actions";
import {
  loadAdminAgentManagementData,
  loadAdminDashboardData,
} from "@/lib/admin-dashboard/data";
import {
  parseAdminAgentFilters,
  serializeAdminAgentFilters,
} from "@/lib/admin-dashboard/agent-filters";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const agentFilters = parseAdminAgentFilters(Astro.url);
const agentFilterQuery = serializeAdminAgentFilters(agentFilters);
const [dashboardData, data] = await Promise.all([
  loadAdminDashboardData(),
  loadAdminAgentManagementData(agentFilters),
]);
const feedback = formatAdminActionFeedback(Astro.url);
---

<AdminPageFrame
  title="Admin Agents - JEHMARP"
  description="Admin agent profile and account management."
  heading="Agent Management"
  intro="Create agent auth accounts and manage agent profile status."
  feedback={feedback}
  dashboardData={dashboardData}
>
  <AdminAgentManagement
    data={data}
    activeFilters={agentFilters}
    filterQuery={agentFilterQuery}
  />
</AdminPageFrame>
