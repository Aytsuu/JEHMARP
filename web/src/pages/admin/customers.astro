---
import AdminCustomerManagement from "@/components/admin/AdminCustomerManagement.astro";
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import {
  formatAdminActionFeedback,
  handleAdminDashboardAction,
} from "@/lib/admin-dashboard/actions";
import {
  loadAdminCustomerManagementData,
  loadAdminDashboardData,
} from "@/lib/admin-dashboard/data";
import {
  parseAdminCustomerFilters,
  serializeAdminCustomerFilters,
} from "@/lib/admin-dashboard/customer-filters";
import {
  mergeAdminPaginationQuery,
  parseAdminPagination,
} from "@/lib/admin-dashboard/pagination";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

if (Astro.request.method === "POST") {
  return handleAdminDashboardAction(Astro, adminRoute.userId, "/admin/customers");
}

const customerFilters = parseAdminCustomerFilters(Astro.url);
const customerPagination = parseAdminPagination(Astro.url);
const customerFilterQuery = mergeAdminPaginationQuery(
  serializeAdminCustomerFilters(customerFilters),
  customerPagination,
);
const [dashboardData, data] = await Promise.all([
  loadAdminDashboardData(),
  loadAdminCustomerManagementData(customerFilters, customerPagination),
]);
const feedback = formatAdminActionFeedback(Astro.url);
---

<AdminPageFrame
  title="Admin Customers - JEHMARP"
  description="Admin customer record management."
  heading="Customer Management"
  intro="Review customer records and update contact details, reseller status, or optional agent assignment."
  feedback={feedback}
  dashboardData={dashboardData}
>
  <AdminCustomerManagement
    data={data}
    activeFilters={customerFilters}
    filterQuery={customerFilterQuery}
  />
</AdminPageFrame>
