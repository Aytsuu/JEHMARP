---
import AdminOrderManagement from "@/components/admin/AdminOrderManagement.astro";
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import { formatAdminActionFeedback } from "@/lib/admin-dashboard/actions";
import { loadAdminDashboardData } from "@/lib/admin-dashboard/data";
import {
  parseAdminOrderFilters,
  serializeAdminOrderFilters,
} from "@/lib/admin-dashboard/order-filters";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const orderFilters = parseAdminOrderFilters(Astro.url);
const orderFilterQuery = serializeAdminOrderFilters(orderFilters);
const data = await loadAdminDashboardData({
  orderFilters,
});
const feedback = formatAdminActionFeedback(Astro.url);
---

<AdminPageFrame
  title="Admin Orders - JEHMARP"
  description="Admin order review, payment, invoice, and commission management."
  heading="Order Management"
  intro="Review submitted orders, approve or reject, update status, edit commissions, record payments, and manage invoices."
  feedback={feedback}
  dashboardData={data}
>
  <AdminOrderManagement
    data={data}
    activeFilters={orderFilters}
    filterQuery={orderFilterQuery}
  />
</AdminPageFrame>
