---
import AdminOrderManagement from "@/components/admin/AdminOrderManagement.astro";
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import {
  formatAdminActionFeedback,
  handleAdminDashboardAction,
  markUnreadAdminOrdersRead,
} from "@/lib/admin-dashboard/actions";
import {
  loadAdminDashboardData,
  loadAdminOrderManagementData,
} from "@/lib/admin-dashboard/data";
import {
  parseAdminOrderFilters,
  serializeAdminOrderFilters,
} from "@/lib/admin-dashboard/order-filters";
import {
  mergeAdminPaginationQuery,
  parseAdminPagination,
} from "@/lib/admin-dashboard/pagination";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

await markUnreadAdminOrdersRead(Astro, adminRoute.userId);

if (Astro.request.method === "POST") {
  const returnPath = `${Astro.url.pathname}${Astro.url.search}`;
  return handleAdminDashboardAction(Astro, adminRoute.userId, returnPath);
}

const orderFilters = parseAdminOrderFilters(Astro.url);
const orderPagination = parseAdminPagination(Astro.url);
const orderFilterQuery = mergeAdminPaginationQuery(
  serializeAdminOrderFilters(orderFilters),
  orderPagination,
);
const [dashboardData, data] = await Promise.all([
  loadAdminDashboardData(),
  loadAdminOrderManagementData(orderFilters, orderPagination),
]);
const feedback = formatAdminActionFeedback(Astro.url);
---

<AdminPageFrame
  title="Admin Orders - JEHMARP"
  description="Admin order review, payment, invoice, and commission management."
  heading="Order Management"
  intro="Review submitted orders, approve or reject, update status, edit commissions, record payments, and manage invoices."
  feedback={feedback}
  dashboardData={dashboardData}
>
  <AdminOrderManagement
    data={data}
    activeFilters={orderFilters}
    filterQuery={orderFilterQuery}
  />
</AdminPageFrame>
