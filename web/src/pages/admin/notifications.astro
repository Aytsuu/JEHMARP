---
import AdminNotifications from "@/components/admin/AdminNotifications.astro";
import AdminNotificationsPageLayout from "@/components/admin/AdminNotificationsPageLayout.astro";
import { loadAdminDashboardData } from "@/lib/admin-dashboard/data";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const data = await loadAdminDashboardData();
---

<AdminNotificationsPageLayout
  title="Admin Notifications - JEHMARP"
  description="System alerts and pending workflow indicators."
  heading="Notifications"
  intro="Review live actionable alerts regarding orders, inquiries, reseller signups, and unpaid order follow-ups."
  dashboardData={data}
>
  <AdminNotifications data={data} />
</AdminNotificationsPageLayout>
