---
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import {
  formatAdminActionFeedback,
  getAllowedNextOrderStatuses,
  handleAdminDashboardAction,
} from "@/lib/admin-dashboard/actions";
import {
  loadAdminDashboardData,
  loadAdminOrder,
} from "@/lib/admin-dashboard/data";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import {
  formatCurrency,
  formatDate,
  fullName,
  orderBalance,
  orderPaymentTotal,
  orderTotal,
} from "@/lib/admin-dashboard/view";
import {
  buildOrderSlipLayout,
  buildSalesInvoiceLayout,
  getDocumentColumnTemplate,
} from "@/lib/order-documents/layout";
import { autoCapitalize, formatOrderSource } from "@/lib/formatters";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const { orderId } = Astro.params;

if (!orderId) {
  return Astro.redirect("/admin/orders", 302);
}

if (Astro.request.method === "POST") {
  return handleAdminDashboardAction(
    Astro,
    adminRoute.userId,
    `/admin/orders/${orderId}`,
  );
}

const [dashboardData, order] = await Promise.all([
  loadAdminDashboardData(),
  loadAdminOrder(orderId),
]);

if (!order) {
  return Astro.redirect("/admin/orders", 302);
}

const rawFeedback = formatAdminActionFeedback(Astro.url);
const feedback =
  rawFeedback.status === "Order marked as read."
    ? { ...rawFeedback, status: undefined }
    : rawFeedback;

const invoice = order.invoice[0] ?? null;
const hasSalesInvoice = Boolean(invoice);
const hasPayments = order.payment.length > 0;
const canGenerateInvoice = order.order_status === "processing";
const invoiceTotal = orderTotal(order, "final_quantity");
const paidTotal = orderPaymentTotal(order);
const balance = orderBalance(order);
const canCreatePaymentRecord = hasSalesInvoice && balance > 0;
const canEditInvoiceQuantities = hasSalesInvoice && !hasPayments;
const hasCommissionTab = Boolean(order.customer?.assigned_agent ?? order.agent);
const orderCode = `Order-${order.id.slice(0, 6).toUpperCase()}`;
const orderSlipPdfHref = `/admin/orders/${order.id}/order-slip.pdf`;
const salesInvoicePdfHref = `/admin/orders/${order.id}/sales-invoice.pdf`;
const totalCommission = order.customer_order_item.reduce((total, item) => {
  return total + item.agent_commission_amount;
}, 0);
const totalPaidCommissionCoverage = order.customer_order_item.reduce(
  (total, item) => {
    if (!item.agent_commission_paid) {
      return total;
    }

    return total + item.final_quantity * item.unit_price;
  },
  0,
);
const totalAvailableCommissionCoverage = Math.max(
  paidTotal - totalPaidCommissionCoverage,
  0,
);
const orderSlipLayout = buildOrderSlipLayout(order);
const salesInvoiceLayout = buildSalesInvoiceLayout(order);
const orderSlipGridTemplate = getDocumentColumnTemplate(
  orderSlipLayout.columns,
);
const salesInvoiceGridTemplate = getDocumentColumnTemplate(
  salesInvoiceLayout.columns,
);
const nextStatuses = getAllowedNextOrderStatuses(
  order.order_status,
  order.payment_status,
);
const availableStatuses = [order.order_status, ...nextStatuses].filter(
  (value, index, values) => values.indexOf(value) === index,
);
const orderStatusOptionLabel = (status: (typeof availableStatuses)[number]) => {
  if (order.order_status === "closed" && status === "processing") {
    return "Open";
  }

  return autoCapitalize(status);
};

const commissionItemTotal = (quantity: number, unitPrice: number) =>
  quantity * unitPrice;
const commissionCoverageRemaining = (itemId: string) => {
  const paidCoverageExcludingCurrent = order.customer_order_item.reduce(
    (total, item) => {
      if (!item.agent_commission_paid || item.id === itemId) {
        return total;
      }

      return total + commissionItemTotal(item.final_quantity, item.unit_price);
    },
    0,
  );

  return Math.max(paidTotal - paidCoverageExcludingCurrent, 0);
};
const commissionItems = order.customer_order_item.map((item) => {
  const itemTotalAmount = commissionItemTotal(
    item.final_quantity,
    item.unit_price,
  );
  const availableCoverageForItem = commissionCoverageRemaining(item.id);
  const canMarkCommissionPaid =
    hasPayments && itemTotalAmount <= availableCoverageForItem;

  return {
    item,
    itemTotalAmount,
    availableCoverageForItem,
    paidCheckboxDisabled: !item.agent_commission_paid && !canMarkCommissionPaid,
  };
});

const timelineItems = [
  ...order.payment.map((payment) => ({
    id: `payment-${payment.id}`,
    title: `Payment recorded via ${payment.payment_method}`,
    timestamp: payment.created_at,
    meta: `${formatCurrency(payment.amount)}${payment.reference_number ? ` • Ref ${payment.reference_number}` : ""}`,
  })),
  ...order.customer_order_status_history.map((entry) => ({
    id: `status-${entry.id}`,
    title: `Order moved to ${autoCapitalize(entry.to_status)}`,
    timestamp: entry.changed_at,
    meta:
      entry.notes ??
      (entry.from_status
        ? `From ${autoCapitalize(entry.from_status)}`
        : "Status update"),
  })),
  ...(invoice
    ? [
        {
          id: `invoice-${invoice.id}`,
          title: "Invoice created",
          timestamp: invoice.created_at,
          meta: invoice.invoice_number,
        },
      ]
    : []),
  {
    id: `created-${order.id}`,
    title: "Order created",
    timestamp: order.created_at,
    meta: formatOrderSource(order.source),
  },
].sort((left, right) => {
  return (
    new Date(right.timestamp).getTime() - new Date(left.timestamp).getTime()
  );
});
---

<AdminPageFrame
  title={`${orderCode} - JEHMARP`}
  description="Admin order details with order slip, sales invoice, commissions, payment records, and notes."
  heading="Order Details"
  intro={`Review ${orderCode} and manage invoice, commission, payment, and notes.`}
  feedback={feedback}
  dashboardData={dashboardData}
>
  <div class="order-detail-page">
    <aside class="order-detail-sidebar">
      <section class="order-detail-section order-summary-section">
        <p class="order-detail-eyebrow">Order / Order Details</p>

        <div class="order-title-row">
          <a
            href="/admin/orders"
            class="icon-button"
            aria-label="Back to orders"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </a>

          <div class="order-title-copy">
            <h1>{orderCode}</h1>
            <p>{formatOrderSource(order.source)}</p>
          </div>

          <form method="post" class="status-form">
            <input type="hidden" name="action" value="update-order-status" />
            <input type="hidden" name="orderId" value={order.id} />
            <label class="sr-only" for="order-status-select">Order status</label
            >
            <select
              id="order-status-select"
              name="orderStatus"
              class="status-select"
            >
              {
                availableStatuses.map((status) => (
                  <option
                    value={status}
                    selected={status === order.order_status}
                  >
                    {orderStatusOptionLabel(status)}
                  </option>
                ))
              }
            </select>
            <button type="submit" class="status-save-button">Save</button>
          </form>
        </div>

        <div class="detail-stack">
          <div class="detail-group">
            <p class="detail-label">Customer</p>
            <p class="detail-value">
              {
                order.customer
                  ? fullName(order.customer)
                  : "Unassigned customer"
              }
            </p>
          </div>

          <div class="detail-group">
            <p class="detail-label">Address</p>
            <p class="detail-value">
              {order.customer?.address ?? "No address on file"}
            </p>
          </div>

          <div class="detail-group">
            <p class="detail-label">Contact Information</p>
            <div class="detail-lines">
              <p>{order.customer?.phone_number ?? "No contact number"}</p>
              <p>{order.customer?.email ?? "No email address"}</p>
            </div>
          </div>

          <div class="detail-group">
            <p class="detail-label">Agent</p>
            <p class="detail-value">
              {
                order.customer?.assigned_agent?.display_name ??
                  "No assigned agent"
              }
            </p>
          </div>

          <div class="detail-group">
            <p class="detail-label">Contact Information</p>
            <div class="detail-lines">
              <p>
                {order.customer?.assigned_agent?.contact ?? "No contact number"}
              </p>
              <p>
                {order.customer?.assigned_agent?.email ?? "No email address"}
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="order-detail-section activity-section">
        <div class="section-heading">
          <span class="section-heading-line"></span>
          <h2>Activity</h2>
          <span class="section-heading-line"></span>
        </div>

        {
          timelineItems.length === 0 ? (
            <p class="empty-copy">No activity recorded yet.</p>
          ) : (
            <ol class="activity-timeline">
              {timelineItems.map((item) => (
                <li>
                  <span class="activity-dot" aria-hidden="true" />
                  <div class="activity-copy">
                    <p class="activity-title">{item.title}</p>
                    <p class="activity-meta">{item.meta}</p>
                    <time datetime={item.timestamp}>
                      {formatDate(item.timestamp)}
                    </time>
                  </div>
                </li>
              ))}
            </ol>
          )
        }
      </section>
    </aside>

    <section class="order-detail-main">
      <div class="order-tabs" role="tablist" aria-label="Order detail sections">
        <button
          type="button"
          class="order-tab is-active"
          data-order-detail-tab-trigger
          data-tab-target="order-slip"
          role="tab"
          aria-selected="true"
        >
          Order Slip
        </button>
        <button
          type="button"
          class="order-tab"
          data-order-detail-tab-trigger
          data-tab-target="sales-invoice"
          role="tab"
          aria-selected="false"
        >
          Sales Invoice
        </button>
        {
          hasCommissionTab && (
            <button
              type="button"
              class="order-tab"
              data-order-detail-tab-trigger
              data-tab-target="commission"
              role="tab"
              aria-selected="false"
            >
              Commission
            </button>
          )
        }
        <button
          type="button"
          class="order-tab"
          data-order-detail-tab-trigger
          data-tab-target="payment-record"
          role="tab"
          aria-selected="false"
        >
          Payment Record
        </button>
        <button
          type="button"
          class="order-tab"
          data-order-detail-tab-trigger
          data-tab-target="notes"
          role="tab"
          aria-selected="false"
        >
          Notes
        </button>
      </div>

      <div class="order-tab-panels">
        <section
          class="order-tab-panel order-tab-panel--document document-preview--pdf-like document-preview--rounded-sm is-active"
          data-order-detail-tab-panel="order-slip"
          role="tabpanel"
        >
          <header class="pdf-preview-header">
            <div class="pdf-preview-brand">
              {
                orderSlipLayout.brandLines.map((line, index) => (
                  <p
                    class:list={[
                      "pdf-preview-brand-line",
                      index === 0 && "pdf-preview-brand-line--strong",
                    ]}
                  >
                    {line}
                  </p>
                ))
              }
            </div>
            <div class="pdf-preview-logo">LOGO</div>
            <h3 class="pdf-preview-title">{orderSlipLayout.title}</h3>
          </header>

          <div class="pdf-preview-fields pdf-preview-fields--two-column">
            <div class="pdf-preview-field-line">
              <span>{orderSlipLayout.dateLabel}</span>
            </div>
            <div></div>
            <div class="pdf-preview-field-line">
              <span>{orderSlipLayout.sellerLabel}</span>
            </div>
            <div class="pdf-preview-field-line">
              <span>{orderSlipLayout.orderedByLabel}</span>
            </div>
          </div>

          <div
            class="pdf-preview-table"
            style={`--pdf-grid-template:${orderSlipGridTemplate};`}
          >
            <div class="pdf-preview-table__head">
              {
                orderSlipLayout.columns.map((column) => (
                  <span class:list={[column.align && `is-${column.align}`]}>
                    {column.label}
                  </span>
                ))
              }
            </div>
            {
              orderSlipLayout.rows.map((row) => (
                <div class="pdf-preview-table__row">
                  {row.cells.map((cell, cellIndex) => (
                    <span
                      class:list={[
                        orderSlipLayout.columns[cellIndex]?.align &&
                          `is-${orderSlipLayout.columns[cellIndex]?.align}`,
                      ]}
                    >
                      {cell || "\u00A0"}
                    </span>
                  ))}
                </div>
              ))
            }
          </div>

          <div class="pdf-preview-total-row">
            <span>{orderSlipLayout.totalLabel}</span>
          </div>

          <div class="pdf-preview-copy-block">
            <h4>{orderSlipLayout.deliveryHeading}</h4>
            {orderSlipLayout.deliveryLines.map((line) => <p>{line}</p>)}
          </div>

          <div class="pdf-preview-copy-block">
            <h4>{orderSlipLayout.paymentHeading}</h4>
            {orderSlipLayout.paymentLines.map((line) => <p>{line}</p>)}
          </div>

          <p class="pdf-preview-confirmation">
            {orderSlipLayout.confirmationText}
          </p>

          <footer class="pdf-preview-signatures">
            <div class="pdf-preview-signature-block">
              <p class="pdf-preview-signature-heading">
                {orderSlipLayout.buyerSignatureLines[0]}
              </p>
              <p>{orderSlipLayout.buyerSignatureLines[1]}</p>
              <p>{orderSlipLayout.buyerSignatureLines[2]}</p>
              <p>{orderSlipLayout.buyerSignatureLines[3]}</p>
            </div>
            <div class="pdf-preview-signature-block">
              <p class="pdf-preview-signature-heading">
                {orderSlipLayout.sellerSignatureHeading}
              </p>
              <p class="pdf-preview-signature-name">
                {orderSlipLayout.sellerSignatureLines[0]}
              </p>
              <p>{orderSlipLayout.sellerSignatureLines[1]}</p>
              <p>{orderSlipLayout.sellerSignatureLines[2]}</p>
            </div>
          </footer>
          <div class="document-preview-floating-bar">
            <div class="panel-actions">
              <a
                href={orderSlipPdfHref}
                class="document-action"
                target="_blank"
                rel="noreferrer"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true"
                  ><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path
                    d="M21 14v4a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3h4"
                  ></path></svg
                >
                <span>Open PDF</span>
              </a>
            </div>
          </div>
        </section>

        <section
          class:list={[
            "order-tab-panel",
            hasSalesInvoice &&
              "order-tab-panel--document document-preview--pdf-like document-preview--rounded-sm",
          ]}
          data-order-detail-tab-panel="sales-invoice"
          role="tabpanel"
          hidden
        >
          {
            !hasSalesInvoice ? (
              <div class="sales-invoice-empty-state">
                <svg class="sales-invoice-empty-state__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="8" y1="13" x2="16" y2="13"></line>
                  <line x1="8" y1="17" x2="16" y2="17"></line>
                  <line x1="8" y1="9" x2="10" y2="9"></line>
                </svg>
                <p>No sales invoice has been created for this order yet.</p>
                <form method="post">
                  <input type="hidden" name="action" value="save-invoice" />
                  <input type="hidden" name="orderId" value={order.id} />
                  <button
                    type="submit"
                    class="primary-panel-button"
                    disabled={!canGenerateInvoice}
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 5v14"></path>
                      <path d="M5 12h14"></path>
                    </svg>
                    <span>Create Sales Invoice</span>
                  </button>
                </form>
              </div>
            ) : (
              <>
                <header class="pdf-preview-header">
                  <div class="pdf-preview-brand">
                    {salesInvoiceLayout.brandLines.map((line, index) => (
                      <p
                        class:list={[
                          "pdf-preview-brand-line",
                          index === 0 && "pdf-preview-brand-line--strong",
                        ]}
                      >
                        {line}
                      </p>
                    ))}
                  </div>
                  <div class="pdf-preview-logo">LOGO</div>
                  <h3 class="pdf-preview-title">{salesInvoiceLayout.title}</h3>
                </header>

                <div class="pdf-preview-fields pdf-preview-fields--two-column">
                  <div class="pdf-preview-field-line">
                    <span>{salesInvoiceLayout.dateLabel}</span>
                  </div>
                  <div class="pdf-preview-field-line">
                    <span>{salesInvoiceLayout.invoiceNumberLabel}</span>
                  </div>
                  <div class="pdf-preview-field-line">
                    <span>{salesInvoiceLayout.soldToLabel}</span>
                  </div>
                  <div class="pdf-preview-field-line">
                    <span>{salesInvoiceLayout.addressLabel}</span>
                  </div>
                </div>

                <div
                  class="pdf-preview-table"
                  style={`--pdf-grid-template:${salesInvoiceGridTemplate};`}
                >
                  <div class="pdf-preview-table__head">
                    {salesInvoiceLayout.columns.map((column) => (
                      <span class:list={[column.align && `is-${column.align}`]}>
                        {column.label}
                      </span>
                    ))}
                  </div>
                  {order.customer_order_item.map((item, index) => (
                    <div class="pdf-preview-table__row pdf-preview-table__row--editable">
                      <span>
                        {salesInvoiceLayout.rows[index]?.cells[0] ??
                          "Missing product"}
                      </span>
                      <form method="post" class="pdf-preview-quantity-form">
                        <input
                          type="hidden"
                          name="action"
                          value="update-invoice-item-quantity"
                        />
                        <input
                          type="hidden"
                          name="orderItemId"
                          value={item.id}
                        />
                        <input
                          type="number"
                          name="quantity"
                          min="0.001"
                          step="0.001"
                          value={item.final_quantity}
                          disabled={!canEditInvoiceQuantities}
                          required
                        />
                        <button
                          type="submit"
                          disabled={!canEditInvoiceQuantities}
                        >
                          Save
                        </button>
                      </form>
                      <span class="is-right">
                        {salesInvoiceLayout.rows[index]?.cells[2] ?? ""}
                      </span>
                      <span class="is-right">
                        {salesInvoiceLayout.rows[index]?.cells[3] ?? ""}
                      </span>
                    </div>
                  ))}
                </div>

                <div class="pdf-preview-total-row">
                  <span>{salesInvoiceLayout.totalLabel}</span>
                </div>

                <div class="pdf-preview-copy-block">
                  <h4>Delivery Preference</h4>
                  <p>{salesInvoiceLayout.paymentLines[0]}</p>
                  <p>{salesInvoiceLayout.paymentLines[1]}</p>
                </div>

                <div class="pdf-preview-copy-block">
                  <h4>{salesInvoiceLayout.paymentHeading}</h4>
                  <p>{salesInvoiceLayout.paymentLines[2]}</p>
                </div>

                <footer class="pdf-preview-invoice-footer">
                  <div class="pdf-preview-issuer">
                    <p class="pdf-preview-signature-heading">
                      {salesInvoiceLayout.issuerHeading}
                    </p>
                    <p class="pdf-preview-signature-name">
                      {salesInvoiceLayout.issuerName}
                    </p>
                    <p>{salesInvoiceLayout.issuerSubline}</p>
                  </div>
                  <div class="pdf-preview-invoice-summary">
                    <p>Paid: {formatCurrency(paidTotal)}</p>
                    <p>Remaining: {formatCurrency(balance)}</p>
                  </div>
                </footer>

                <div class="document-preview-floating-bar">
                  <div class="panel-actions">
                    <a
                      href={salesInvoicePdfHref}
                      class="document-action"
                      target="_blank"
                      rel="noreferrer"
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <>
                          <path d="M15 3h6v6" />
                          <path d="M10 14 21 3" />
                          <path d="M21 14v4a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3h4" />
                        </>
                      </svg>
                      <span>Open PDF</span>
                    </a>
                  </div>
                </div>
              </>
            )
          }
        </section>

        {
          hasCommissionTab && (
            <section
              class="order-tab-panel"
              data-order-detail-tab-panel="commission"
              role="tabpanel"
              hidden
            >
              <div class="panel-header">
                <div>
                  <h2>Commission</h2>
                  <p>
                    Manage item-level commission values for the assigned agent.
                    Paid commissions require recorded payments that cover each
                    item total.
                  </p>
                </div>
              </div>

              <div class="metrics-grid">
                <div class="metric-card">
                  <span>Total Commission</span>
                  <strong>{formatCurrency(totalCommission)}</strong>
                </div>
                <div class="metric-card">
                  <span>Payment Available For Paid Commissions</span>
                  <strong>
                    {formatCurrency(totalAvailableCommissionCoverage)}
                  </strong>
                </div>
              </div>

              <div class="stack-list">
                {commissionItems.map(
                  ({
                    item,
                    itemTotalAmount,
                    availableCoverageForItem,
                    paidCheckboxDisabled,
                  }) => (
                    <form method="post" class="stack-card">
                      <input
                        type="hidden"
                        name="action"
                        value="update-commission"
                      />
                      <input type="hidden" name="orderItemId" value={item.id} />

                      <div class="stack-card-header">
                        <div>
                          <h3>{item.product?.name ?? "Missing product"}</h3>
                          <p>
                            {formatCurrency(item.unit_price)} x{" "}
                            {item.final_quantity}
                          </p>
                        </div>
                        <span class="pill">
                          {item.agent_commission_paid ? "Paid" : "Unpaid"}
                        </span>
                      </div>

                      <div class="stack-card-grid">
                        <label>
                          <span>Item Total</span>
                          <input
                            type="text"
                            value={formatCurrency(itemTotalAmount)}
                            readonly
                          />
                        </label>
                        <label>
                          <span>Commission</span>
                          <input
                            type="number"
                            name="amount"
                            min="0"
                            step="0.01"
                            value={item.agent_commission_amount}
                          />
                        </label>
                        <label class="checkbox-row">
                          <input
                            type="checkbox"
                            name="isPaid"
                            checked={item.agent_commission_paid}
                            disabled={paidCheckboxDisabled}
                          />
                          <span>Paid</span>
                        </label>
                      </div>

                      {paidCheckboxDisabled && (
                        <p class="commission-coverage-notice">
                          {!hasPayments
                            ? "Record a payment before marking this commission as paid."
                            : `This item total of ${formatCurrency(itemTotalAmount)} exceeds the remaining paid coverage of ${formatCurrency(availableCoverageForItem)}.`}
                        </p>
                      )}

                      <div class="stack-card-actions">
                        <button type="submit" class="primary-panel-button">
                          Save Commission
                        </button>
                      </div>
                    </form>
                  ),
                )}
              </div>
            </section>
          )
        }

        <section
          class="order-tab-panel"
          data-order-detail-tab-panel="payment-record"
          role="tabpanel"
          hidden
        >
          <div class="panel-header">
            <div>
              <h2>Payment Record</h2>
              <p>
                {
                  hasSalesInvoice
                    ? "Track payments made against the invoice and remaining balance."
                    : "Create a sales invoice before recording any payment."
                }
              </p>
            </div>
            <button
              type="button"
              class="primary-panel-button"
              data-toggle-payment-form
              disabled={!canCreatePaymentRecord}
            >
              Create Payment Record
            </button>
          </div>

          <div class="metrics-grid">
            <div class="metric-card">
              <span>Total Paid</span>
              <strong>{formatCurrency(paidTotal)}</strong>
            </div>
            <div class="metric-card">
              <span>Remaining Balance</span>
              <strong>{formatCurrency(balance)}</strong>
            </div>
          </div>

          <form
            method="post"
            class="payment-form"
            data-payment-form
            hidden={!canCreatePaymentRecord}
          >
            <input type="hidden" name="action" value="record-payment" />
            <input type="hidden" name="orderId" value={order.id} />

            <div class="stack-card-grid">
              <label>
                <span>Amount</span>
                <input
                  type="number"
                  name="amount"
                  min="0.01"
                  step="0.01"
                  max={balance > 0 ? balance : undefined}
                  required
                />
              </label>
              <label>
                <span>Method</span>
                <input
                  type="text"
                  name="paymentMethod"
                  placeholder="cash, bank transfer"
                  required
                />
              </label>
              <label>
                <span>Payment Date</span>
                <input
                  type="date"
                  name="paymentDate"
                  value={new Date().toISOString().slice(0, 10)}
                  required
                />
              </label>
              <label>
                <span>Reference</span>
                <input type="text" name="referenceNumber" />
              </label>
            </div>

            <label class="stack-card-notes">
              <span>Notes</span>
              <textarea name="notes" rows="3"></textarea>
            </label>

            <div class="stack-card-actions">
              <button type="submit" class="primary-panel-button"
                >Save Payment Record</button
              >
            </div>
          </form>

          {
            order.payment.length === 0 ? (
              <p class="empty-copy">No payment records yet.</p>
            ) : (
              <div class="stack-list">
                {order.payment.map((payment) => (
                  <article class="stack-card">
                    <div class="stack-card-header">
                      <div>
                        <h3>{payment.payment_method}</h3>
                        <p>{formatDate(payment.payment_date)}</p>
                      </div>
                      <strong>{formatCurrency(payment.amount)}</strong>
                    </div>
                    <div class="payment-meta">
                      <span>
                        {payment.reference_number
                          ? `Reference: ${payment.reference_number}`
                          : "No reference number"}
                      </span>
                      <span>{payment.notes ?? "No notes"}</span>
                    </div>
                  </article>
                ))}
              </div>
            )
          }
        </section>

        <section
          class="order-tab-panel"
          data-order-detail-tab-panel="notes"
          role="tabpanel"
          hidden
        >
          <div class="panel-header">
            <div>
              <h2>Notes</h2>
              <p>Save internal notes for this order.</p>
            </div>
          </div>

          <form method="post" class="notes-form">
            <input type="hidden" name="action" value="update-order-notes" />
            <input type="hidden" name="orderId" value={order.id} />
            <textarea
              name="notes"
              rows="14"
              placeholder="Write internal notes for this order."
              >{order.notes ?? ""}</textarea
            >
            <div class="stack-card-actions">
              <button type="submit" class="primary-panel-button"
                >Save Notes</button
              >
            </div>
          </form>
        </section>
      </div>
    </section>
  </div>
</AdminPageFrame>

<script is:inline>
  const tabTriggers = Array.from(
    document.querySelectorAll("[data-order-detail-tab-trigger]"),
  );
  const tabPanels = Array.from(
    document.querySelectorAll("[data-order-detail-tab-panel]"),
  );

  const setActiveTab = (target) => {
    tabTriggers.forEach((trigger) => {
      const isActive = trigger.dataset.tabTarget === target;
      trigger.classList.toggle("is-active", isActive);
      trigger.setAttribute("aria-selected", isActive ? "true" : "false");
    });

    tabPanels.forEach((panel) => {
      const isActive = panel.dataset.orderDetailTabPanel === target;
      panel.classList.toggle("is-active", isActive);
      panel.hidden = !isActive;
    });
  };

  tabTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const target = trigger.dataset.tabTarget;
      if (target) setActiveTab(target);
    });
  });

  const paymentToggleButton = document.querySelector(
    "[data-toggle-payment-form]",
  );
  const paymentForm = document.querySelector("[data-payment-form]");

  if (paymentToggleButton && paymentForm) {
    paymentToggleButton.addEventListener("click", () => {
      const shouldOpen = paymentForm.hasAttribute("hidden");
      paymentForm.toggleAttribute("hidden", !shouldOpen);
    });
  }
</script>

