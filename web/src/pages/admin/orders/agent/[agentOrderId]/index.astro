---
import AdminAgentOrderDetailContent from "@/components/admin/AdminAgentOrderDetailContent.astro";
import AdminNotificationsPageLayout from "@/components/admin/AdminNotificationsPageLayout.astro";
import OrderDetailNav from "@/components/dashboard/OrderDetailNav.astro";
import RouteBackButton from "@/components/dashboard/RouteBackButton.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import { formatAdminActionFeedback } from "@/lib/admin-dashboard/actions";
import { paginateCustomerRecords } from "@/lib/admin-dashboard/customer-record";
import {
  loadAdminAgentOrder,
  loadAdminDashboardData,
  type AdminOrder,
} from "@/lib/admin-dashboard/data";
import {
  parseAdminOrderFilters,
} from "@/lib/admin-dashboard/order-filters";
import {
  parseAdminPagination,
} from "@/lib/admin-dashboard/pagination";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import {
  agentOrderCommissionTotal,
  agentOrderPaymentStatus,
  agentOrderReceivableTotal,
  agentOrderTotal,
  formatDate,
  fullName,
  orderBalance,
  orderPaymentTotal,
} from "@/lib/admin-dashboard/view";
import {
  buildAttachCustomerProductOptions,
  canAttachCustomerToAgentOrder,
} from "@/lib/agent-order-distribution";
import { autoCapitalize, formatOrderSource } from "@/lib/formatters";
import { manilaDateInputValue, manilaTimeInputValue } from "@/lib/datetime";
import {
  buildOrderDetailNavEntries,
  formatOrderCode,
} from "@/lib/order-detail-nav";
import type { AdminOrderFilters } from "@/lib/admin-dashboard/order-filters";

export const prerender = false;

function getPendingAgentReceivedPayments(order: AdminOrder) {
  return (order.agent_received_payment ?? []).filter(
    (payment) => payment.status === "pending_admin_confirmation",
  );
}

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const { agentOrderId } = Astro.params;

if (!agentOrderId) {
  return Astro.redirect("/admin/orders", 302);
}

const [dashboardData, agentOrder] = await Promise.all([
  loadAdminDashboardData(),
  loadAdminAgentOrder(agentOrderId),
]);

if (!agentOrder) {
  return Astro.redirect("/admin/orders", 302);
}

const feedback = formatAdminActionFeedback(Astro.url);
const agentOrderPaymentState = agentOrderPaymentStatus(agentOrder);
const isCommissionLocked = agentOrderPaymentState === "paid";
const canAttachCustomer = canAttachCustomerToAgentOrder(agentOrder);
const isQuantityEditable =
  agentOrderPaymentState === "unpaid" || agentOrderPaymentState === "partial";
const totalAmount = agentOrderTotal(agentOrder);
const attachCustomerProducts = buildAttachCustomerProductOptions({
  agentOrder,
  products: dashboardData.products,
});
const totalPaid = agentOrder.customer_order.reduce(
  (sum, order) => sum + orderPaymentTotal(order),
  0,
);
const totalCommission = agentOrderCommissionTotal(agentOrder);
const totalReceivable = agentOrderReceivableTotal(agentOrder);
const balanceDue = Math.max(totalReceivable - totalPaid, 0);
const todayDate = manilaDateInputValue();
const todayTime = manilaTimeInputValue();
const agentName = agentOrder.agent?.display_name ?? "Unassigned agent";
const agentOrderCode = formatOrderCode(agentOrder.id);
const fullAgent =
  dashboardData.agents.find((agent) => agent.id === agentOrder.agent?.id) ?? null;
const agentDetailsHref = agentOrder.agent?.id
  ? `/admin/agents/${agentOrder.agent.id}?returnTo=${encodeURIComponent(`/admin/orders/agent/${agentOrder.id}`)}`
  : null;
const agentOrderReturnTo = encodeURIComponent(
  `/admin/orders/agent/${agentOrder.id}`,
);
const returnToParam = Astro.url.searchParams.get("returnTo");
const backUrl =
  returnToParam?.startsWith("/admin/") && !returnToParam.startsWith("//")
    ? returnToParam
    : "/admin/orders";
const backLabel = backUrl.startsWith("/admin/agents/")
  ? "Back to agent record"
  : "Back to orders";
const agentOrderNavigationEntries = buildOrderDetailNavEntries({
  orders: dashboardData.agentOrders,
  currentOrderId: agentOrder.id,
  buildHref: (entry) =>
    `/admin/orders/agent/${entry.id}?returnTo=${encodeURIComponent(backUrl)}`,
});
const isPendingAgentOrderApproval = agentOrder.order_status === "pending_order";
const pendingPaymentConfirmations = agentOrder.customer_order.flatMap((order) => {
  if (!order.invoice[0]) {
    return [];
  }

  const customerName = order.customer ? fullName(order.customer) : "Guest";

  return getPendingAgentReceivedPayments(order).map((payment) => ({
    payment,
    customerName,
    orderId: order.id,
    orderCode: formatOrderCode(order.id),
    dateRequested: payment.created_at,
  }));
});
const pendingPaymentConfirmationTotal = pendingPaymentConfirmations.reduce(
  (sum, { payment }) => sum + payment.amount,
  0,
);
const customerOrderCounts = {
  pending: agentOrder.customer_order.filter(
    (order) => order.order_status === "pending",
  ).length,
  unpaid: agentOrder.customer_order.filter(
    (order) => order.payment_status === "unpaid",
  ).length,
  partial: agentOrder.customer_order.filter(
    (order) => order.payment_status === "partial",
  ).length,
  paid: agentOrder.customer_order.filter(
    (order) => order.payment_status === "paid",
  ).length,
  total: agentOrder.customer_order.length,
};
const orderFilters = parseAdminOrderFilters(Astro.url);
const pagination = parseAdminPagination(Astro.url);

function filterAgentOrderCustomerOrders(
  orders: AdminOrder[],
  filters: AdminOrderFilters,
) {
  const search = filters.search?.trim().toLowerCase() ?? "";

  return orders.filter((order) => {
    if (filters.source && order.source !== filters.source) {
      return false;
    }

    if (filters.orderStatus && order.order_status !== filters.orderStatus) {
      return false;
    }

    if (filters.paymentStatus && order.payment_status !== filters.paymentStatus) {
      return false;
    }

    if (!search) {
      return true;
    }

    const customerName = order.customer ? fullName(order.customer) : "Guest";
    const haystack = [
      formatOrderCode(order.id),
      order.id,
      customerName,
      formatOrderSource(order.source),
      order.order_status,
      order.payment_status,
    ]
      .join(" ")
      .toLowerCase();

    return haystack.includes(search);
  });
}

const filteredCustomerOrders = filterAgentOrderCustomerOrders(
  agentOrder.customer_order,
  orderFilters,
);
const paginatedCustomerOrders = paginateCustomerRecords(
  filteredCustomerOrders,
  pagination.page,
  pagination.pageSize,
);
const pageBasePath = `/admin/orders/agent/${agentOrder.id}`;
---

<AdminNotificationsPageLayout
  title={`${agentOrderCode} - JEHMARP`}
  description="Admin agent distribution order details."
  heading={agentOrderCode}
  feedback={feedback}
  dashboardData={dashboardData}
  contentMaxWidth="78rem"
  scrollOnParent={true}
>
  <div slot="heading-title" class="agent-order-detail-header">
    <p class="order-detail-eyebrow">Order / Distributed Order Details</p>
    <div class="order-summary-top">
      <div class="order-summary-top__main">
        <RouteBackButton href={backUrl} label={backLabel} />
        <div class="order-title-copy">
          <OrderDetailNav
            currentCode={agentOrderCode}
            entries={agentOrderNavigationEntries}
            menuLabel="Other distribution orders"
          />
          <div class="agent-order-detail-header__meta">
            <span>{formatDate(agentOrder.created_at)}</span>
            <StatusBadge
              kind="order"
              status={agentOrder.order_status}
              label={autoCapitalize(agentOrder.order_status)}
            />
            <StatusBadge
              kind="payment"
              status={agentOrderPaymentState}
              label={autoCapitalize(agentOrderPaymentState)}
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <AdminAgentOrderDetailContent
    agentOrder={agentOrder}
    agentOrderReturnTo={agentOrderReturnTo}
    agentDetailsHref={agentDetailsHref}
    agentName={agentName}
    agentId={agentOrder.agent?.id ?? null}
    agentContact={agentOrder.agent?.contact ?? "No contact number"}
    agentEmail={agentOrder.agent?.email ?? "No email address"}
    agentAddress={fullAgent?.address?.trim() || "No address on file"}
    isPendingAgentOrderApproval={isPendingAgentOrderApproval}
    totalPaid={totalPaid}
    totalCommission={totalCommission}
    totalReceivable={totalReceivable}
    grossTotal={totalAmount}
    balanceDue={balanceDue}
    isCommissionLocked={isCommissionLocked}
    isQuantityEditable={isQuantityEditable}
    canAttachCustomer={canAttachCustomer}
    pendingPaymentConfirmations={pendingPaymentConfirmations}
    pendingPaymentConfirmationTotal={pendingPaymentConfirmationTotal}
    customerOrderCounts={customerOrderCounts}
    customerOrderRows={paginatedCustomerOrders.records}
    ordersPagination={paginatedCustomerOrders.pagination}
    orderFilters={orderFilters}
    attachCustomerProducts={attachCustomerProducts}
    todayDate={todayDate}
    todayTime={todayTime}
    pageBasePath={pageBasePath}
  />
</AdminNotificationsPageLayout>

<script>
  import { initAgentOrderDetailPage } from "@/lib/client/agent-order-detail-page";

  function initPage() {
    initAgentOrderDetailPage();
  }

  document.addEventListener("DOMContentLoaded", initPage);
  document.addEventListener("astro:after-swap", initPage);
  if (document.readyState !== "loading") {
    initPage();
  }
</script>

<style>
  .agent-order-detail-header {
    min-width: 0;
  }

  .order-detail-eyebrow {
    margin: 0 0 1.25rem;
    color: rgba(17, 24, 39, 0.56);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .order-summary-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .order-summary-top__main {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    min-width: 0;
  }

  .order-summary-top__main :global(.route-back-button) {
    flex-shrink: 0;
  }

  .order-title-copy {
    min-width: 0;
  }

  .order-title-copy :global(.order-detail-nav__title) {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.15;
    font-weight: 700;
    color: #111827;
    text-transform: none;
    letter-spacing: normal;
  }

  .agent-order-detail-header__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.45rem;
    color: rgba(17, 24, 39, 0.62);
    font-size: 0.9rem;
  }

  @media (max-width: 720px) {
    .order-summary-top {
      flex-direction: column;
    }
  }
</style>
