---
import ActionMenu from "@/components/ActionMenu.astro";
import AdminOrderAgentCard from "@/components/admin/AdminOrderAgentCard.astro";
import AdminNotificationsPageLayout from "@/components/admin/AdminNotificationsPageLayout.astro";
import AgentOrderAttachCustomerSheet from "@/components/agent-order/AgentOrderAttachCustomerSheet.astro";
import AgentOrderDistributionSummaryCard from "@/components/agent/AgentOrderDistributionSummaryCard.astro";
import DashboardTableActionsHeader from "@/components/dashboard/DashboardTableActionsHeader.astro";
import DashboardTableNumberHeader from "@/components/dashboard/DashboardTableNumberHeader.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import ViewButton from "@/components/ViewButton.astro";
import OrderDetailNav from "@/components/dashboard/OrderDetailNav.astro";
import { dashboardTableRowNumber } from "@/lib/admin-dashboard/pagination";
import {
  formatAdminActionFeedback,
  handleAdminDashboardAction,
} from "@/lib/admin-dashboard/actions";
import {
  loadAdminAgentOrder,
  loadAdminDashboardData,
  type AdminOrder,
} from "@/lib/admin-dashboard/data";
import {
  agentOrderCommissionTotal,
  agentOrderPaymentStatus,
  agentOrderReceivableTotal,
  agentOrderTotal,
  defaultProductCommissionAmount,
  formatCurrency,
  formatDate,
  fullName,
  orderBalance,
  orderPaymentTotal,
  orderReceivableTotal,
} from "@/lib/admin-dashboard/view";
import {
  canAttachCustomerToAgentOrder,
  buildAttachCustomerProductOptions,
  formatPendingIndicator,
  formatAgentOrderDistributionStatus,
  getAgentOrderProductDistribution,
  minimumAgentOrderItemQuantity,
  sumPendingCustomerOrderAmount,
} from "@/lib/agent-order-distribution";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import { autoCapitalize, formatOrderSource } from "@/lib/formatters";
import { manilaDateInputValue, manilaTimeInputValue } from "@/lib/datetime";
import {
  buildOrderDetailNavEntries,
  formatOrderCode,
} from "@/lib/order-detail-nav";

export const prerender = false;

function formatAmountValue(value: number) {
  return new Intl.NumberFormat("en-PH", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(value);
}

function getPendingAgentReceivedPayments(order: AdminOrder) {
  return (order.agent_received_payment ?? []).filter(
    (payment) => payment.status === "pending_admin_confirmation",
  );
}

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const { agentOrderId } = Astro.params;

if (!agentOrderId) {
  return Astro.redirect("/admin/orders", 302);
}

if (Astro.request.method === "POST") {
  return handleAdminDashboardAction(
    Astro,
    adminRoute.userId,
    `/admin/orders/agent/${agentOrderId}`,
  );
}

const [dashboardData, agentOrder] = await Promise.all([
  loadAdminDashboardData(),
  loadAdminAgentOrder(agentOrderId),
]);

if (!agentOrder) {
  return Astro.redirect("/admin/orders", 302);
}

const feedback = formatAdminActionFeedback(Astro.url);
const agentOrderPaymentState = agentOrderPaymentStatus(agentOrder);
const isCommissionLocked = agentOrderPaymentState === "paid";
const canAttachCustomer = canAttachCustomerToAgentOrder(agentOrder);
const isQuantityEditable = agentOrderPaymentState === "unpaid" || agentOrderPaymentState === "partial";
const totalAmount = agentOrderTotal(agentOrder);
const pendingCustomerOrderAmount = sumPendingCustomerOrderAmount(agentOrder);
const attachCustomerProducts = buildAttachCustomerProductOptions({
  agentOrder,
  products: dashboardData.products,
});
const customerBalanceById = dashboardData.orders.reduce<Record<string, number>>((balances, order) => {
  if (!order.customer_id) return balances;

  const balance = orderBalance(order);
  if (balance <= 0) return balances;

  return {
    ...balances,
    [order.customer_id]: (balances[order.customer_id] ?? 0) + balance,
  };
}, {});
const attachedCustomerIds = agentOrder.customer_order.flatMap((order) =>
  order.customer_id ? [order.customer_id] : [],
);
const paymentNoticeByCustomerId = dashboardData.orders.reduce<Record<string, "unpaid" | "partial">>((notices, order) => {
  const paymentNotice = order.payment_status === "unpaid" || order.payment_status === "partial"
    ? order.payment_status
    : null;

  if (!order.customer_id || !paymentNotice) {
    return notices;
  }

  return {
    ...notices,
    [order.customer_id]: notices[order.customer_id] === "unpaid"
      ? "unpaid"
      : paymentNotice,
  };
}, {});
const attachCustomerCustomers = dashboardData.customers
  .filter((customer) => !attachedCustomerIds.includes(customer.id))
  .map((customer) => ({
  id: customer.id,
  label: fullName(customer),
  firstName: customer.first_name,
  lastName: customer.last_name,
  phoneNumber: customer.phone_number,
  email: customer.email ?? "",
  address: customer.address,
  balance: customerBalanceById[customer.id] ?? 0,
  creditLimit: customer.credit_limit,
  creditExceeded: customer.credit_limit_exceeded,
  paymentNotice: paymentNoticeByCustomerId[customer.id] ?? null,
}));
const totalPaid = agentOrder.customer_order.reduce(
  (sum, order) => sum + orderPaymentTotal(order),
  0,
);
const totalCommission = agentOrderCommissionTotal(agentOrder);
const totalReceivable = agentOrderReceivableTotal(agentOrder);
const todayDate = manilaDateInputValue();
const todayTime = manilaTimeInputValue();
const agentName = agentOrder.agent?.display_name ?? "Unassigned agent";
const agentOrderCode = formatOrderCode(agentOrder.id);
const agentDetailsHref = agentOrder.agent?.id
  ? `/admin/agents/${agentOrder.agent.id}?returnTo=${encodeURIComponent(`/admin/orders/agent/${agentOrder.id}`)}`
  : null;
const agentOrderReturnTo = encodeURIComponent(
  `/admin/orders/agent/${agentOrder.id}`,
);
const returnToParam = Astro.url.searchParams.get("returnTo");
const backUrl =
  returnToParam?.startsWith("/admin/") && !returnToParam.startsWith("//")
    ? returnToParam
    : "/admin/orders";
const backLabel = backUrl.startsWith("/admin/agents/")
  ? "Back to agent record"
  : "Back to orders";
const agentOrderNavigationEntries = buildOrderDetailNavEntries({
  orders: dashboardData.agentOrders,
  currentOrderId: agentOrder.id,
  buildHref: (entry) =>
    `/admin/orders/agent/${entry.id}?returnTo=${encodeURIComponent(backUrl)}`,
});
const isPendingAgentOrderApproval = agentOrder.order_status === "pending_order";
const pendingPaymentConfirmations = agentOrder.customer_order.flatMap(
  (order) => {
    if (!order.invoice[0]) {
      return [];
    }

    const customerName = order.customer ? fullName(order.customer) : "Guest";

    return getPendingAgentReceivedPayments(order).map((payment) => ({
      payment,
      customerName,
    }));
  },
);
const pendingPaymentConfirmationTotal = pendingPaymentConfirmations.reduce(
  (sum, { payment }) => sum + payment.amount,
  0,
);
---

<AdminNotificationsPageLayout
  title={`${agentOrderCode} - JEHMARP`}
  description="Admin agent order cluster details."
  heading={agentOrderCode}
  backUrl={backUrl}
  backLabel={backLabel}
  feedback={feedback}
  dashboardData={dashboardData}
  contentMaxWidth="72rem"
>
  <OrderDetailNav
    slot="heading-title"
    currentCode={agentOrderCode}
    entries={agentOrderNavigationEntries}
    menuLabel="Other distribution orders"
    titleClass="admin-notifications-page__title"
  />
  <ul slot="heading-meta" class="record-meta" aria-label="Agent order dates">
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <span class="record-meta__text">{formatDate(agentOrder.created_at)}</span>
    </li>
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 7v5l3 2"></path>
      </svg>
      <span class="record-meta__text">Release {formatDate(agentOrder.release_date ?? null)}</span>
    </li>
  </ul>

  <div slot="heading-aside" class="record-heading-badges">
    <StatusBadge
      kind="order"
      status={agentOrder.order_status}
      label={autoCapitalize(agentOrder.order_status)}
    />
    <StatusBadge
      kind="payment"
      status={agentOrderPaymentState}
      label={autoCapitalize(agentOrderPaymentState)}
    />
  </div>

  <div class="agent-order-overview">
    <AdminOrderAgentCard
      agent={agentOrder.agent}
      viewHref={agentDetailsHref}
    />

    {
      !isPendingAgentOrderApproval ? (
        <AgentOrderDistributionSummaryCard
          paid={totalPaid}
          commission={totalCommission}
          grossTotal={totalAmount}
          primaryLabel="Receivable"
          primaryAmount={totalReceivable}
          pendingAcceptanceAmount={pendingCustomerOrderAmount > 0 ? pendingCustomerOrderAmount : null}
          summaryLabel="Agent order receivable summary"
        />
      ) : null
    }
  </div>

  {
    isPendingAgentOrderApproval ? (
      <section class="agent-order-approval-panel" aria-labelledby="agent-order-approval-heading">
        <div class="agent-order-approval-panel__content">
          <span class="agent-order-approval-panel__eyebrow">Admin approval required</span>
          <h2 id="agent-order-approval-heading">Pending Order</h2>
          <p>
            This agent submitted an order for admin approval. Approve it before managing products,
            customer distribution, payment confirmations, or summary totals.
          </p>
        </div>
        <form method="post" class="agent-order-approval-panel__action">
          <input type="hidden" name="action" value="approve-agent-order" />
          <input type="hidden" name="agentOrderId" value={agentOrder.id} />
          <button type="submit">Approve Order</button>
        </form>
      </section>
    ) : (
      <>
  <div class="agent-record-content">
    <div class="record-section">
      <h2 class="section-line-heading">
        <span class="section-line-heading__line" aria-hidden="true"></span>
        <span class="section-line-heading__label">Products</span>
        <span class="section-line-heading__line" aria-hidden="true"></span>
      </h2>
      {
        agentOrder.agent_order_item.length === 0 ? (
          <p class="empty-state">
            No products have been added to this agent order yet.
          </p>
        ) : (
          <div class="order-record-table-wrap">
            <table class="agent-customers-table agent-order-products-table">
              <thead>
                <tr>
                  <DashboardTableNumberHeader />
                  <th scope="col">Product</th>
                  <th scope="col">Quantity</th>
                  <th scope="col">Details</th>
                  <th scope="col">Total</th>
                  <th scope="col">Commission</th>
                </tr>
              </thead>
              <tbody>
                {agentOrder.agent_order_item.map((item, index) => {
                  const unitPrice = item.product?.default_price ?? 0;
                  const defaultCommission = defaultProductCommissionAmount({
                    product: item.product,
                    quantity: item.quantity,
                    unitPrice,
                  });
                  const distribution = getAgentOrderProductDistribution(
                    agentOrder,
                    item.product_id,
                  );
                  const minQuantity = minimumAgentOrderItemQuantity(
                    distribution.approvedDistributedQuantity,
                  );
                  const canEditQuantity = isQuantityEditable;

                  return (
                    <tr>
                      <td class="dashboard-table__number-column">{dashboardTableRowNumber(null, index)}</td>
                      <td>
                        {item.product?.name ?? "Missing product"}
                        <span class="agent-order-products-table__meta">
                          {formatCurrency(unitPrice)} /{" "}
                          {item.product?.unit_label ?? "unit"}
                        </span>
                      </td>
                      <td>
                        {canEditQuantity ? (
                          <form method="post" class="agent-order-quantity-form">
                            <input
                              type="hidden"
                              name="action"
                              value="update-agent-order-item-quantity"
                            />
                            <input
                              type="hidden"
                              name="agentOrderItemId"
                              value={item.id}
                            />
                            <label
                              class="sr-only"
                              for={`agent-order-quantity-${item.id}`}
                            >
                              Quantity for {item.product?.name ?? "item"}
                            </label>
                            <input
                              id={`agent-order-quantity-${item.id}`}
                              type="number"
                              name="quantity"
                              min={minQuantity}
                              step="0.001"
                              value={item.quantity}
                              required
                            />
                            <button type="submit">Save</button>
                          </form>
                        ) : (
                          <span>
                            {item.quantity} {item.product?.unit_label ?? ""}
                          </span>
                        )}
                        {
                          distribution.pendingQuantityIncrease > 0 && (
                            <span class="pending-indicator">
                              {formatPendingIndicator(
                                distribution.pendingQuantityIncrease,
                                (value) => `${value} ${item.product?.unit_label ?? ""}`,
                              )}
                            </span>
                          )
                        }
                        <span class="agent-order-products-table__meta">
                          {formatAgentOrderDistributionStatus({
                            remainingQuantity: distribution.remainingQuantity,
                            unitLabel: item.product?.unit_label ?? "unit",
                          })}
                        </span>
                      </td>
                      <td>{item.add_details ?? "N/A"}</td>
                      <td>{formatCurrency(item.quantity * unitPrice)}</td>
                      <td>
                        <form method="post" class="agent-order-commission-form">
                          <input
                            type="hidden"
                            name="action"
                            value="update-agent-order-commission"
                          />
                          <input
                            type="hidden"
                            name="agentOrderItemId"
                            value={item.id}
                          />
                          <label
                            class="sr-only"
                            for={`agent-order-commission-${item.id}`}
                          >
                            Commission for {item.product?.name ?? "item"}
                          </label>
                          <input
                            id={`agent-order-commission-${item.id}`}
                            type="number"
                            name="amount"
                            min="0"
                            step="0.01"
                            value={item.agent_commission_amount}
                            disabled={isCommissionLocked}
                          />
                          <button type="submit" disabled={isCommissionLocked}>
                            Save
                          </button>
                        </form>
                        <span class="agent-order-products-table__meta">
                          Default {formatCurrency(defaultCommission)}
                          {isCommissionLocked
                            ? " - locked after full payment"
                            : ""}
                        </span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </div>

    <div
      class="record-section"
      id="agent-order-customers"
      data-admin-agent-payment-distribution-section
    >
      <h2 class="section-line-heading">
        <span class="section-line-heading__line" aria-hidden="true"></span>
        <span class="section-line-heading__label">Customers</span>
        <span class="section-line-heading__line" aria-hidden="true"></span>
      </h2>

      <div class="customer-orders-table-toolbar">
        <div class="customer-orders-table-toolbar__summary">
          <span>Payment confirmations</span>
          <strong>{formatCurrency(pendingPaymentConfirmationTotal)}</strong>
        </div>
        <div class="customer-orders-table-toolbar__actions">
          {
            agentOrder.customer_order.length > 0 && (
              <>
                <button
                  type="button"
                  class:list={[
                    "payment-confirmation-trigger",
                    "payment-confirmation-trigger--toolbar",
                    {
                      "payment-confirmation-trigger--empty":
                        pendingPaymentConfirmations.length === 0,
                    },
                  ]}
                  data-open-cell-popover={
                    pendingPaymentConfirmations.length > 0 ? true : undefined
                  }
                  data-popover-title="Payment confirmations"
                  disabled={pendingPaymentConfirmations.length === 0}
                >
                  <span class="payment-confirmation-trigger__label">
                    {pendingPaymentConfirmations.length > 0
                      ? `Review ${pendingPaymentConfirmations.length}`
                      : "None pending"}
                  </span>
                </button>

                <div class="hidden-popover-form-holder">
                  <div class="payment-confirmation-popover">
                    <div class="payment-confirmation-popover__summary">
                      <span>Total amount</span>
                      <strong>
                        {formatCurrency(pendingPaymentConfirmationTotal)}
                      </strong>
                    </div>

                    <div class="payment-confirmation-popover__list">
                      {pendingPaymentConfirmations.map(
                        ({ payment, customerName }) => (
                          <article class="payment-confirmation-item payment-confirmation-item--compact">
                            <span class="payment-confirmation-item__customer">
                              {customerName}
                            </span>
                            <strong class="payment-confirmation-item__amount">
                              {formatCurrency(payment.amount)}
                            </strong>
                            <form
                              method="post"
                              class="payment-confirmation-item__actions"
                            >
                              <input
                                type="hidden"
                                name="action"
                                value="confirm-agent-payment"
                              />
                              <input
                                type="hidden"
                                name="agentPaymentId"
                                value={payment.id}
                              />
                              <button
                                type="submit"
                                class="payment-confirmation-submit"
                              >
                                Confirm
                              </button>
                            </form>
                          </article>
                        ),
                      )}
                    </div>

                    <form
                      method="post"
                      class="payment-confirmation-popover__confirm-all"
                    >
                      <input
                        type="hidden"
                        name="action"
                        value="confirm-agent-payments"
                      />
                      {pendingPaymentConfirmations.map(({ payment }) => (
                        <input
                          type="hidden"
                          name="agentPaymentId"
                          value={payment.id}
                        />
                      ))}
                      <button
                        type="submit"
                        class="payment-confirmation-submit payment-confirmation-submit--all"
                      >
                        Confirm All
                      </button>
                    </form>
                  </div>
                </div>
              </>
            )
          }
          {
            agentOrder.customer_order.length > 0 && (
              <ActionMenu
                id="agent-order-customers-document-menu"
                menuLabel="Document options for selected customer orders"
                triggerLabel="Document"
                triggerClass="customer-orders-table-toolbar__document-menu"
                disabled
                items={[
                  {
                    label: "Sales Invoice",
                    icon: "external-pdf",
                    dataAction: "bulk-sales-invoice-pdf",
                  },
                  {
                    label: "Order Slip",
                    icon: "external-pdf",
                    dataAction: "bulk-order-slip-pdf",
                  },
                ]}
              />
            )
          }
          <button
            type="button"
            class="btn-table-manage customer-orders-table-toolbar__add-customer"
            data-open-create-sheet
            data-sheet-target="#agent-order-attach-customer-sheet"
            disabled={!canAttachCustomer}
            title={canAttachCustomer
              ? undefined
              : "Completed and paid agent orders cannot accept new customers."}
          >
            Add Customer
          </button>
        </div>
      </div>

      {
        agentOrder.customer_order.length === 0 ? (
          <p class="empty-state">No customer orders have been attached yet.</p>
        ) : (
          <>
            <form
              method="post"
              class="admin-agent-payment-distribution-form"
              data-admin-agent-payment-distribution-form
            >
              <input
                type="hidden"
                name="action"
                value="record-admin-agent-payment-distribution"
              />
              <input
                type="hidden"
                name="agentOrderId"
                value={agentOrder.id}
              />
              <div data-selected-payment-order-inputs hidden></div>

              <div class="admin-agent-payment-distribution-form__panel">
                <label>
                  <span>Total received</span>
                  <input
                    type="number"
                    name="amount"
                    min="0.01"
                    step="0.01"
                    required
                  />
                </label>
                <label>
                  <span>Method</span>
                  <select name="paymentMethod" required>
                    <option value="">Select method</option>
                    <option value="Cash">Cash</option>
                    <option value="Check">Check</option>
                  </select>
                </label>
                <label>
                  <span>Payment Terms</span>
                  <select name="paymentTerms" required>
                    <option value="">Select payment terms</option>
                    <option value="Cash on Delivery (COD)">Cash on Delivery (COD)</option>
                    <option value="Bank Transfer">Bank Transfer</option>
                    <option value="Gcash">Gcash</option>
                  </select>
                </label>
                <label>
                  <span>Date</span>
                  <input
                    type="date"
                    name="paymentDate"
                    value={todayDate}
                    required
                  />
                </label>
                <label>
                  <span>Time</span>
                  <input
                    type="time"
                    name="paymentTime"
                    value={todayTime}
                    required
                  />
                </label>
                <label>
                  <span>Reference</span>
                  <input type="text" name="referenceNumber" />
                </label>
                <label class="admin-agent-payment-distribution-form__notes">
                  <span>Notes</span>
                  <textarea name="notes" rows="2"></textarea>
                </label>
                <button type="submit">
                  Record selected payments
                </button>
              </div>
            </form>

            <div class="order-record-table-wrap">
              <table class="agent-customers-table agent-order-customer-orders-table">
                <thead>
                  <tr>
                    <DashboardTableNumberHeader />
                    <th scope="col" class="dashboard-table__select-column">
                      <label class="dashboard-table__select-all">
                        <span class="sr-only">Select all customer orders</span>
                        <input type="checkbox" data-order-select-all />
                      </label>
                    </th>
                    <th scope="col">Date Created</th>
                    <th scope="col">Customer</th>
                    <th scope="col">Source</th>
                    <th scope="col">Order Status</th>
                    <th scope="col">Payment Status</th>
                    <th scope="col">Total amount</th>
                    <th scope="col">Payment Confirmation</th>
                    <DashboardTableActionsHeader wide />
                  </tr>
                </thead>
                <tbody>
                  {agentOrder.customer_order.map((order, index) => {
                    const invoice = order.invoice[0];
                    const orderAmount = orderReceivableTotal(
                      order,
                      invoice ? "final_quantity" : "partial_quantity",
                    );
                    const orderPaid = orderPaymentTotal(order);
                    const isPendingOrder = order.order_status === "pending";
                    const pendingAgentPayments =
                      getPendingAgentReceivedPayments(order);
                    const pendingAgentPaymentTotal = pendingAgentPayments.reduce(
                      (sum, payment) => sum + payment.amount,
                      0,
                    );
                    const remainingPaymentBalance = Math.max(
                      orderAmount - orderPaid - pendingAgentPaymentTotal,
                      0,
                    );
                    const customerName = order.customer
                      ? fullName(order.customer)
                      : "Guest";

                    return (
                      <tr>
                        <td class="dashboard-table__number-column">{dashboardTableRowNumber(null, index)}</td>
                        <td class="dashboard-table__select-column">
                          <label class="dashboard-table__row-select">
                            <span class="sr-only">Select order for {customerName}</span>
                            <input
                              type="checkbox"
                              value={order.id}
                              data-order-row-checkbox
                              data-order-row-type="customer"
                              data-payment-order-checkbox
                              data-payment-order-balance={remainingPaymentBalance}
                            />
                          </label>
                        </td>
                        <td>{formatDate(order.created_at)}</td>
                        <td>{customerName}</td>
                        <td>{formatOrderSource(order.source)}</td>
                        <td>
                          <StatusBadge
                            kind="order"
                            status={order.order_status}
                            label={autoCapitalize(order.order_status)}
                          />
                        </td>
                        <td>
                          <StatusBadge
                            kind="payment"
                            status={order.payment_status}
                            label={autoCapitalize(order.payment_status)}
                          />
                        </td>
                        <td>
                          <span class="amount-ratio">
                            <span class="amount-ratio__paid">
                              {formatCurrency(orderPaid)}
                            </span>
                            <span class="amount-ratio__total">
                              /{formatAmountValue(orderAmount)}
                            </span>
                          </span>
                          {
                            isPendingOrder && (
                              <span class="pending-acceptance-note">
                                Awaiting acceptance
                              </span>
                            )
                          }
                        </td>
                        <td>
                          <div class="payment-confirmation-cell">
                            <button
                              type="button"
                              class:list={[
                                "payment-confirmation-trigger",
                                {
                                  "payment-confirmation-trigger--empty":
                                    pendingAgentPayments.length === 0,
                                },
                              ]}
                              data-open-cell-popover={
                                pendingAgentPayments.length > 0
                                  ? true
                                  : undefined
                              }
                              data-popover-title={`Payment confirmation: ${customerName}`}
                              disabled={pendingAgentPayments.length === 0}
                            >
                              <span class="payment-confirmation-trigger__label">
                                {pendingAgentPayments.length > 0
                                  ? "Review payments"
                                  : "None pending"}
                              </span>
                              {pendingAgentPayments.length > 0 && (
                                <span class="payment-confirmation-trigger__meta">
                                  {formatCurrency(pendingAgentPaymentTotal)}
                                </span>
                              )}
                            </button>

                            <div class="hidden-popover-form-holder">
                              <div class="payment-confirmation-popover">
                                <div class="payment-confirmation-popover__summary">
                                  <span>Awaiting confirmation</span>
                                  <strong>
                                    {formatCurrency(pendingAgentPaymentTotal)}
                                  </strong>
                                </div>

                                <div class="payment-confirmation-popover__list">
                                  {pendingAgentPayments.map((payment) => (
                                    <article class="payment-confirmation-item">
                                      <div class="payment-confirmation-item__content">
                                        <div class="payment-confirmation-item__details">
                                          <span class="payment-confirmation-item__method">
                                            {payment.payment_method}
                                          </span>
                                          <span class="payment-confirmation-item__date">
                                            {formatDate(payment.payment_date)}
                                            {" by "}
                                            {payment.agent?.display_name ??
                                              agentName}
                                          </span>
                                        </div>
                                        <strong class="payment-confirmation-item__amount">
                                          {formatCurrency(payment.amount)}
                                        </strong>
                                      </div>
                                      <p class="payment-confirmation-item__meta">
                                        {payment.reference_number
                                          ? `Reference: ${payment.reference_number}`
                                          : "No reference number"}
                                        {" - "}
                                        {payment.notes ?? "No notes"}
                                      </p>
                                      <form
                                        method="post"
                                        class="payment-confirmation-item__actions"
                                      >
                                        <input
                                          type="hidden"
                                          name="action"
                                          value="confirm-agent-payment"
                                        />
                                        <input
                                          type="hidden"
                                          name="agentPaymentId"
                                          value={payment.id}
                                        />
                                        <button
                                          type="submit"
                                          class="payment-confirmation-submit"
                                        >
                                          Confirm Payment Received
                                        </button>
                                      </form>
                                    </article>
                                  ))}
                                </div>
                              </div>
                            </div>
                          </div>
                        </td>
                        <td class="dashboard-table__actions-column">
                          {
                            isPendingOrder ? (
                              <form
                                method="post"
                                class="order-table-action-form"
                                data-astro-reload
                              >
                                <input type="hidden" name="action" value="update-order-status" />
                                <input type="hidden" name="orderId" value={order.id} />
                                <input type="hidden" name="orderStatus" value="processing" />
                                <button type="submit" class="btn-table-manage">
                                  Accept order
                                </button>
                              </form>
                            ) : (
                              <ViewButton
                                href={`/admin/orders/customer/${order.id}?returnTo=${agentOrderReturnTo}`}
                              />
                            )
                          }
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </>
        )
      }
    </div>
  </div>

  <AgentOrderAttachCustomerSheet
    agentOrderId={agentOrder.id}
    customers={attachCustomerCustomers}
    products={attachCustomerProducts}
    mode="admin"
    canAttachCustomer={canAttachCustomer}
  />
      </>
    )
  }
</AdminNotificationsPageLayout>

