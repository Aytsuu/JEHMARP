                      const defaultCommission = defaultProductCommissionAmount({
                        product: item.product,
                        quantity: item.partial_quantity,
                        unitPrice: item.unit_price,
                      });

                      return (
                        <div
                          class:list={[
                            "commission-row",
                            item.agent_commission_paid && "is-paid",
