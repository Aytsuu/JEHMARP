                        {payment.reference_number
                          ? `Reference: ${payment.reference_number}`
                          : "No reference number"}
                        {" • "}
                        {payment.notes ?? "No notes"}
                      </p>
                    </article>
                  ))}
                </div>
              )
            }
          </div>
        </section>

        <section
          class:list={[
            "order-tab-panel",
            isOrderDetailTabActive("timeline") && "is-active",
          ]}
          data-order-detail-tab-panel="timeline"
          role="tabpanel"
          hidden={!isOrderDetailTabActive("timeline")}
        >
          <div class="order-timeline-panel">
            <div class="order-timeline-panel__header">
              <h3 class="order-timeline-panel__title">Timeline</h3>
            </div>
            <div class="order-timeline-table" role="table">
              <div class="order-timeline-table__head" role="row">
                <span role="columnheader">Event</span>
                <span role="columnheader">Details</span>
                <span role="columnheader">Date</span>
              </div>
              {timelineItems.map((item) => (
                <div class="order-timeline-table__row" role="row">
                  <span role="cell">
                    <strong>{item.title}</strong>
                  </span>
                  <span role="cell">{item.meta}</span>
                  <time role="cell" datetime={item.timestamp}>
                    {formatDateTime(item.timestamp)}
                  </time>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section
          class:list={[
            "order-tab-panel order-tab-panel--notes",
            isOrderDetailTabActive("notes") && "is-active",
          ]}
          data-order-detail-tab-panel="notes"
          role="tabpanel"
          hidden={!isOrderDetailTabActive("notes")}
        >
          <div
            class="order-notes-panel"
            data-order-notes-panel
            data-save-url={`/admin/orders/customer/${order.id}`}
            data-order-id={order.id}
          >
            <div
              class="order-notes-toolbar"
              role="toolbar"
              aria-label="Note formatting"
            >
              <div class="order-notes-toolbar__group">
                <button
                  type="button"
                  class="order-notes-toolbar__button"
                  data-notes-command="undo"
                  aria-label="Undo"
                  title="Undo"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 7H5v4"></path>
                    <path d="M5 11c1.5-3 4.5-5 8-5 4.4 0 8 3.6 8 8s-3.6 8-8 8"
                    ></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="order-notes-toolbar__button"
                  data-notes-command="redo"
                  aria-label="Redo"
                  title="Redo"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M15 7h4v4"></path>
                    <path d="M19 11c-1.5-3-4.5-5-8-5-4.4 0-8 3.6-8 8s3.6 8 8 8"
                    ></path>
                  </svg>
                </button>
              </div>

              <span class="order-notes-toolbar__separator" aria-hidden="true"
              ></span>

              <div class="order-notes-toolbar__group">
                <button
                  type="button"
                  class="order-notes-toolbar__button"
                  data-notes-command="bold"
                  aria-label="Bold"
                  title="Bold"
                >
                  <strong>B</strong>
                </button>
                <button
                  type="button"
                  class="order-notes-toolbar__button"
                  data-notes-command="italic"
                  aria-label="Italic"
                  title="Italic"
                >
                  <em>I</em>
                </button>
                <button
                  type="button"
                  class="order-notes-toolbar__button"
                  data-notes-command="underline"
                  aria-label="Underline"
                  title="Underline"
                >
                  <u>U</u>
                </button>
                <button
                  type="button"
                  class="order-notes-toolbar__button"
                  data-notes-command="strikeThrough"
                  aria-label="Strikethrough"
                  title="Strikethrough"
                >
                  <s>S</s>
                </button>
              </div>

              <span class="order-notes-toolbar__separator" aria-hidden="true"
              ></span>

              <label class="order-notes-toolbar__control">
                <span class="sr-only">Text style</span>
                <select data-notes-format-block aria-label="Text style">
                  <option value="p" selected>Normal</option>
                  <option value="h2">Heading</option>
                  <option value="h3">Subheading</option>
                </select>
              </label>

              <label class="order-notes-toolbar__control">
                <span class="sr-only">Font size</span>
                <select data-notes-font-size aria-label="Font size">
                  <option value="2">Small</option>
                  <option value="3" selected>Normal</option>
                  <option value="5">Large</option>
                  <option value="6">Extra large</option>
                </select>
              </label>

              <label class="order-notes-toolbar__control">
                <span class="sr-only">Font family</span>
                <select data-notes-font-name aria-label="Font family">
                  <option value="inherit" selected>Default</option>
                  <option value="Arial">Arial</option>
                  <option value="Georgia">Georgia</option>
                  <option value="Times New Roman">Times New Roman</option>
                  <option value="Courier New">Courier New</option>
                </select>
              </label>

              <label class="order-notes-toolbar__control">
                <span class="sr-only">Text color</span>
                <select data-notes-fore-color aria-label="Text color">
                  <option value="#111827" selected>Black</option>
                  <option value="#b42318">Red</option>
                  <option value="#027a48">Green</option>
                  <option value="#175cd3">Blue</option>
                  <option value="#b54708">Orange</option>
                  <option value="#6941c6">Purple</option>
                </select>
              </label>

              <label
                class="order-notes-toolbar__control order-notes-toolbar__control--color"
                title="Highlight color"
              >
                <span class="sr-only">Highlight color</span>
                <input
                  type="color"
                  data-notes-hilite-color
                  value="#fff59d"
                  aria-label="Highlight color"
                />
              </label>

              <span class="order-notes-toolbar__separator" aria-hidden="true"
              ></span>

              <div class="order-notes-toolbar__group">
                <button
                  type="button"
                  class="order-notes-toolbar__button"
                  data-notes-command="insertUnorderedList"
                  aria-label="Bullet list"
                  title="Bullet list"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <line x1="9" y1="6" x2="20" y2="6"></line>
                    <line x1="9" y1="12" x2="20" y2="12"></line>
                    <line x1="9" y1="18" x2="20" y2="18"></line>
                    <circle cx="5" cy="6" r="1"></circle>
                    <circle cx="5" cy="12" r="1"></circle>
                    <circle cx="5" cy="18" r="1"></circle>
                  </svg>
                </button>
                <button
                  type="button"
                  class="order-notes-toolbar__button"
                  data-notes-command="insertOrderedList"
                  aria-label="Numbered list"
                  title="Numbered list"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <line x1="10" y1="6" x2="20" y2="6"></line>
                    <line x1="10" y1="12" x2="20" y2="12"></line>
                    <line x1="10" y1="18" x2="20" y2="18"></line>
                    <path d="M4 6h1v4H4z"></path>
                    <path d="M4 16h1v2H4z"></path>
                    <path d="M6 18H4v-2h1.5L4 14h2"></path>
                  </svg>
                </button>
              </div>

              <span class="order-notes-toolbar__separator" aria-hidden="true"
              ></span>

              <div class="order-notes-toolbar__group">
                <button
                  type="button"
                  class="order-notes-toolbar__button"
                  data-notes-command="justifyLeft"
                  aria-label="Align left"
                  title="Align left"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <line x1="4" y1="6" x2="20" y2="6"></line>
                    <line x1="4" y1="12" x2="14" y2="12"></line>
                    <line x1="4" y1="18" x2="18" y2="18"></line>
                  </svg>
                </button>
                <button
                  type="button"
                  class="order-notes-toolbar__button"
                  data-notes-command="justifyCenter"
                  aria-label="Align center"
                  title="Align center"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <line x1="4" y1="6" x2="20" y2="6"></line>
                    <line x1="7" y1="12" x2="17" y2="12"></line>
                    <line x1="5" y1="18" x2="19" y2="18"></line>
                  </svg>
                </button>
                <button
                  type="button"
                  class="order-notes-toolbar__button"
                  data-notes-command="justifyRight"
                  aria-label="Align right"
                  title="Align right"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <line x1="4" y1="6" x2="20" y2="6"></line>
                    <line x1="10" y1="12" x2="20" y2="12"></line>
                    <line x1="6" y1="18" x2="20" y2="18"></line>
                  </svg>
                </button>
              </div>

              <span class="order-notes-toolbar__separator" aria-hidden="true"
              ></span>

              <div class="order-notes-toolbar__group">
                <button
                  type="button"
                  class="order-notes-toolbar__button"
                  data-notes-command="insertHorizontalRule"
                  aria-label="Insert divider"
                  title="Insert divider"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <line x1="4" y1="12" x2="20" y2="12"></line>
                  </svg>
                </button>
                <button
                  type="button"
                  class="order-notes-toolbar__button"
                  data-notes-command="removeFormat"
                  aria-label="Clear formatting"
                  title="Clear formatting"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 7h9"></path>
                    <path d="M9 7 5 19"></path>
                    <path d="m14 16 6-6"></path>
                    <path d="m15 15 5 5"></path>
                    <path d="m20 15-5 5"></path>
                  </svg>
                </button>
              </div>
            </div>

            <div
              class="order-notes-editor"
              contenteditable="true"
              role="textbox"
              aria-multiline="true"
              data-order-notes-editor
              data-placeholder="Write internal notes for this order."
            >
              {
                order.notes &&
                  (/<[a-z][\s\S]*>/i.test(order.notes) ? (
                    <Fragment set:html={order.notes} />
                  ) : (
                    order.notes
                  ))
              }
            </div>
          </div>
        </section>
      </div>
    </section>
  </div>
</AdminPageFrame>

<script is:inline>
  const commissionEditor = document.querySelector("[data-commission-editor]");

  if (commissionEditor instanceof HTMLElement) {
    const saveUrl = commissionEditor.dataset.saveUrl;
    const debounceMs = 500;
    const saveTimers = new WeakMap();

    const formatCommissionCurrency = (value) =>
      new Intl.NumberFormat("en-PH", {
        style: "currency",
        currency: "PHP",
      }).format(value);

    const updatePayabilityNotice = (row) => {
      const notice = row.querySelector(".commission-row__notice");
      const amountInput = row.querySelector(".commission-row__amount");
      const paidInput = row.querySelector(".commission-row__paid");

      if (!(notice instanceof HTMLElement)) {
        return;
      }

      if (!(amountInput instanceof HTMLInputElement)) {
        return;
      }

      if (!(paidInput instanceof HTMLInputElement)) {
        return;
      }

      const itemTotal = Number(row.dataset.itemTotal ?? "0");
      const availableCoverage = Number(row.dataset.availableCoverage ?? "0");
      const hasPaymentsRecorded = row.dataset.hasPayments === "true";
      const amount = Number(amountInput.value);

      notice.classList.remove(
        "commission-row__notice--paid",
        "commission-row__notice--ready",
        "commission-row__notice--blocked",
      );

      if (paidInput.checked && amount > 0) {
        notice.textContent = "Marked as paid.";
        notice.classList.add("commission-row__notice--paid");
        return;
      }

      if (!Number.isFinite(amount) || amount <= 0) {
        notice.textContent = "Set a commission amount before marking as paid.";
        notice.classList.add("commission-row__notice--blocked");
        return;
      }

      if (!hasPaymentsRecorded) {
        notice.textContent = "Record a payment before marking as paid.";
        notice.classList.add("commission-row__notice--blocked");
        return;
      }

      if (itemTotal > availableCoverage) {
        notice.textContent = `Item total exceeds remaining paid coverage (${formatCommissionCurrency(availableCoverage)} available).`;
        notice.classList.add("commission-row__notice--blocked");
        return;
      }

      notice.textContent = "Can be marked as paid.";
      notice.classList.add("commission-row__notice--ready");
    };

    const syncPaidState = (row) => {
      const amountInput = row.querySelector(".commission-row__amount");
      const paidInput = row.querySelector(".commission-row__paid");

      if (!(amountInput instanceof HTMLInputElement)) {
        return;
      }

      if (!(paidInput instanceof HTMLInputElement)) {
        return;
      }

      const amount = Number(amountInput.value);

      if (!Number.isFinite(amount) || amount <= 0) {
        paidInput.checked = false;
      }

      row.classList.toggle(
        "is-paid",
        paidInput.checked && Number(amountInput.value) > 0,
      );
      updatePayabilityNotice(row);
    };

    const syncMarkAllState = () => {
      const markAllCheckbox = commissionEditor.querySelector(
        "[data-commission-mark-all]",
      );
      const markAllLabel = commissionEditor.querySelector(
        ".commission-mark-all",
      );

      if (!(markAllCheckbox instanceof HTMLInputElement)) {
        return;
      }

      const payableRows = Array.from(
        commissionEditor.querySelectorAll("[data-commission-row]"),
      ).filter((row) => {
        const amountInput = row.querySelector(".commission-row__amount");
        return (
          amountInput instanceof HTMLInputElement &&
          Number(amountInput.value) > 0
        );
      });

      const paidCount = payableRows.filter((row) => {
        const paidInput = row.querySelector(".commission-row__paid");
        return paidInput instanceof HTMLInputElement && paidInput.checked;
      }).length;

      const unpaidRows = payableRows.filter((row) => {
        const paidInput = row.querySelector(".commission-row__paid");
        return paidInput instanceof HTMLInputElement && !paidInput.checked;
      });

      const hasPaymentsRecorded =
        commissionEditor.dataset.hasPayments === "true";
      const availableCoverage = Number(
        commissionEditor.dataset.totalAvailableCoverage ?? "0",
      );

      let disabledReason = null;

      if (payableRows.length === 0) {
        disabledReason = "Set commission amounts before marking all as paid.";
      } else if (unpaidRows.length > 0) {
        if (!hasPaymentsRecorded) {
          disabledReason =
            "Record a payment before marking all commissions as paid.";
        } else if (
          unpaidRows.some((row) => {
            const paidInput = row.querySelector(".commission-row__paid");
            return paidInput instanceof HTMLInputElement && paidInput.disabled;
          })
        ) {
          disabledReason = `Recorded payments leave only ${formatCommissionCurrency(availableCoverage)} available for paid commissions.`;
        }
      }

      markAllCheckbox.checked =
        payableRows.length > 0 && paidCount === payableRows.length;
      markAllCheckbox.indeterminate =
        paidCount > 0 && paidCount < payableRows.length;
      markAllCheckbox.disabled = disabledReason !== null;

      if (markAllLabel instanceof HTMLLabelElement) {
        if (disabledReason) {
          markAllLabel.title = disabledReason;
        } else {
          markAllLabel.removeAttribute("title");
        }
      }
    };

    const saveCommissionRow = async (row) => {
      if (!saveUrl) {
        return;
      }

      const amountInput = row.querySelector(".commission-row__amount");
      const paidInput = row.querySelector(".commission-row__paid");
      const errorEl = row.querySelector(".commission-row__error");

      if (!(amountInput instanceof HTMLInputElement)) {
        return;
      }

      if (!(paidInput instanceof HTMLInputElement)) {
        return;
      }

      if (!(errorEl instanceof HTMLElement)) {
        return;
      }

      const formData = new FormData();
      formData.set("action", "update-commission");
      formData.set("orderItemId", row.dataset.orderItemId ?? "");
      formData.set("amount", amountInput.value);

      if (paidInput.checked) {
        formData.set("isPaid", "on");
      }

      try {
        const response = await fetch(saveUrl, {
          method: "POST",
          body: formData,
          credentials: "same-origin",
          headers: {
            Accept: "text/html",
          },
        });

        const resultUrl = new URL(response.url);
        const error = resultUrl.searchParams.get("error");

        if (error) {
          errorEl.textContent = error;
          errorEl.hidden = false;
          return;
        }

        errorEl.hidden = true;
        errorEl.textContent = "";
        syncPaidState(row);
        syncMarkAllState();
      } catch {
        errorEl.textContent = "Unable to save commission.";
        errorEl.hidden = false;
      }
    };

    commissionEditor
      .querySelectorAll("[data-commission-row]")
      .forEach((row) => {
        const amountInput = row.querySelector(".commission-row__amount");
        const paidInput = row.querySelector(".commission-row__paid");

        amountInput?.addEventListener("input", () => {
          updatePayabilityNotice(row);
          const existingTimer = saveTimers.get(row);
          if (existingTimer) {
            clearTimeout(existingTimer);
          }

          saveTimers.set(
            row,
            setTimeout(() => {
              saveCommissionRow(row);
            }, debounceMs),
          );
        });

        paidInput?.addEventListener("change", () => {
          const existingTimer = saveTimers.get(row);
          if (existingTimer) {
            clearTimeout(existingTimer);
          }

          saveCommissionRow(row);
        });
      });

    const markAllCheckbox = commissionEditor.querySelector(
      "[data-commission-mark-all]",
    );

    if (markAllCheckbox instanceof HTMLInputElement) {
      if (markAllCheckbox.dataset.indeterminate === "true") {
        markAllCheckbox.indeterminate = true;
      }

      markAllCheckbox.addEventListener("change", async () => {
        const shouldMarkPaid = markAllCheckbox.checked;
        const rows = Array.from(
          commissionEditor.querySelectorAll("[data-commission-row]"),
        );

        for (const row of rows) {
          const amountInput = row.querySelector(".commission-row__amount");
          const paidInput = row.querySelector(".commission-row__paid");

          if (!(amountInput instanceof HTMLInputElement)) {
            continue;
          }

          if (!(paidInput instanceof HTMLInputElement)) {
            continue;
          }

          if (Number(amountInput.value) <= 0) {
            continue;
          }

          if (shouldMarkPaid && paidInput.disabled) {
            continue;
          }

          if (paidInput.checked === shouldMarkPaid) {
            continue;
          }

          paidInput.checked = shouldMarkPaid;
          await saveCommissionRow(row);
        }

        syncMarkAllState();
      });
    }

    syncMarkAllState();
  }

  const notesPanel = document.querySelector("[data-order-notes-panel]");

  if (notesPanel instanceof HTMLElement) {
    const editor = notesPanel.querySelector("[data-order-notes-editor]");
    const saveUrl = notesPanel.dataset.saveUrl;
    const orderId = notesPanel.dataset.orderId;
    const debounceMs = 500;
    let saveTimer;
    let lastSavedContent = "";

    const normalizeNotesContent = (value) => {
      const trimmed = value.trim();

      if (!trimmed) {
        return "";
      }

      const temporary = document.createElement("div");
      temporary.innerHTML = trimmed;
      const text = temporary.textContent?.replace(/\u00a0/g, " ").trim() ?? "";

      return text ? trimmed : "";
    };

    const getEditorContent = () => {
      if (!(editor instanceof HTMLElement)) {
        return "";
      }

      return normalizeNotesContent(editor.innerHTML);
    };

    const saveOrderNotes = async () => {
      if (!(editor instanceof HTMLElement) || !saveUrl || !orderId) {
        return;
      }

      const content = getEditorContent();

      if (content === lastSavedContent) {
        return;
      }

      const formData = new FormData();
      formData.set("action", "update-order-notes");
      formData.set("orderId", orderId);
      formData.set("notes", content);

      try {
        const response = await fetch(saveUrl, {
          method: "POST",
          body: formData,
          credentials: "same-origin",
          headers: {
            Accept: "text/html",
          },
        });

        const resultUrl = new URL(response.url);
        const error = resultUrl.searchParams.get("error");

        if (error) {
          return;
        }

        lastSavedContent = content;
      } catch {
        // Keep the latest editor content; the next edit will retry.
      }
    };

    if (editor instanceof HTMLElement) {
      lastSavedContent = getEditorContent();

      const scheduleNotesSave = () => {
        clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
          saveOrderNotes();
        }, debounceMs);
      };

      const runNotesCommand = (command, value) => {
        editor.focus();
        document.execCommand(command, false, value);
        scheduleNotesSave();
      };

      const updateToolbarState = () => {
        const selection = document.getSelection();

        if (
          !selection ||
          !selection.anchorNode ||
          !editor.contains(selection.anchorNode)
        ) {
          return;
        }

        notesPanel
          .querySelectorAll("[data-notes-command]")
          .forEach((button) => {
            const command = button.dataset.notesCommand;

            if (!command) {
              return;
            }

            try {
              const isActive = document.queryCommandState(command);
              button.classList.toggle("is-active", isActive);
            } catch {
              button.classList.remove("is-active");
            }
          });
      };

      editor.addEventListener("input", scheduleNotesSave);
      editor.addEventListener("keyup", updateToolbarState);
      editor.addEventListener("mouseup", updateToolbarState);
      document.addEventListener("selectionchange", updateToolbarState);

      notesPanel.querySelectorAll("[data-notes-command]").forEach((button) => {
        button.addEventListener("mousedown", (event) => {
          event.preventDefault();
        });

        button.addEventListener("click", () => {
          const command = button.dataset.notesCommand;

          if (!command) {
            return;
          }

          runNotesCommand(command, button.dataset.notesCommandValue);
          updateToolbarState();
        });
      });

      const fontSizeSelect = notesPanel.querySelector("[data-notes-font-size]");

      if (fontSizeSelect instanceof HTMLSelectElement) {
        fontSizeSelect.addEventListener("mousedown", (event) => {
          event.stopPropagation();
        });

        fontSizeSelect.addEventListener("change", () => {
          runNotesCommand("fontSize", fontSizeSelect.value);
        });
      }

      const formatBlockSelect = notesPanel.querySelector(
        "[data-notes-format-block]",
      );

      if (formatBlockSelect instanceof HTMLSelectElement) {
        formatBlockSelect.addEventListener("mousedown", (event) => {
          event.stopPropagation();
        });

        formatBlockSelect.addEventListener("change", () => {
          runNotesCommand("formatBlock", formatBlockSelect.value);
        });
      }

      const fontNameSelect = notesPanel.querySelector("[data-notes-font-name]");

      if (fontNameSelect instanceof HTMLSelectElement) {
        fontNameSelect.addEventListener("mousedown", (event) => {
          event.stopPropagation();
        });

        fontNameSelect.addEventListener("change", () => {
          if (fontNameSelect.value === "inherit") {
            runNotesCommand("removeFormat");
            return;
          }

          runNotesCommand("fontName", fontNameSelect.value);
        });
      }

      const foreColorSelect = notesPanel.querySelector(
        "[data-notes-fore-color]",
      );

      if (foreColorSelect instanceof HTMLSelectElement) {
        foreColorSelect.addEventListener("mousedown", (event) => {
          event.stopPropagation();
        });

        foreColorSelect.addEventListener("change", () => {
          runNotesCommand("foreColor", foreColorSelect.value);
        });
      }

      const hiliteColorInput = notesPanel.querySelector(
        "[data-notes-hilite-color]",
      );

      if (hiliteColorInput instanceof HTMLInputElement) {
        hiliteColorInput.addEventListener("mousedown", (event) => {
          event.stopPropagation();
        });

        hiliteColorInput.addEventListener("input", () => {
          runNotesCommand("hiliteColor", hiliteColorInput.value);
        });
      }

      editor.addEventListener("keydown", (event) => {
        if (!(event.ctrlKey || event.metaKey)) {
          return;
        }

        const key = event.key.toLowerCase();
        let command;

        if (key === "b") {
          command = "bold";
        } else if (key === "i") {
          command = "italic";
        } else if (key === "u") {
          command = "underline";
        } else if (key === "z") {
          command = event.shiftKey ? "redo" : "undo";
        } else if (key === "y") {
          command = "redo";
        }

        if (!command) {
          return;
        }

        event.preventDefault();
        runNotesCommand(command);
        updateToolbarState();
      });

      updateToolbarState();
    }
  }
