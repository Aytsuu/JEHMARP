                    <input
                      type="checkbox"
                      data-commission-mark-all
                      checked={markAllCommissionPaid}
                      disabled={markAllCommissionPaidDisabled}
                      data-indeterminate={
                        markAllCommissionPaidIndeterminate ? "true" : undefined
                      }
                    />
                    <span>Mark all as paid</span>
                  </label>
                </div>

                <div class="commission-list">
                  {commissionItems.map(
                    ({
                      item,
                      itemTotalAmount,
                      paidCheckboxDisabled,
                      availableCoverageForItem,
                      payabilityNotice,
