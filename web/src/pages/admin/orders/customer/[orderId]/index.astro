              role="tabpanel"
              hidden={!isOrderDetailTabActive("commission")}
            >
              <div class="metrics-grid">
                <div class="metric-card">
                  <span>Total Commission</span>
                  <strong>{formatCurrency(totalCommission)}</strong>
                </div>
                <div class="metric-card">
                  <span>Payment Available For Paid Commissions</span>
                  <strong>
                    {formatCurrency(totalAvailableCommissionCoverage)}
                  </strong>
                </div>
              </div>

              <div
                class="commission-panel"
                data-commission-editor
                data-save-url={`/admin/orders/customer/${order.id}`}
                data-has-payments={hasPayments ? "true" : "false"}
                data-total-available-coverage={totalAvailableCommissionCoverage}
              >
                <div class="commission-panel__header">
                  <h3 class="commission-panel__title">Order Items</h3>
                  <label
                    class="commission-mark-all"
                    title={markAllCommissionPaidDisabledReason ?? undefined}
