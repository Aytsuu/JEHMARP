                          <div class="commission-row__content">
                            <input
                              type="checkbox"
                              class="commission-row__paid"
                              checked={item.agent_commission_paid}
                              disabled={paidCheckboxDisabled}
                              aria-label={`Mark commission paid for ${item.product?.name ?? "item"}`}
                            />
                            <div class="commission-row__details">
                              <span class="commission-row__label">
