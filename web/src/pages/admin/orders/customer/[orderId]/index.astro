---
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import RouteBackButton from "@/components/dashboard/RouteBackButton.astro";
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import {
  formatAdminActionFeedback,
  getAllowedNextOrderStatuses,
  handleAdminDashboardAction,
  markAdminOrderReadIfUnread,
} from "@/lib/admin-dashboard/actions";
import {
  loadAdminDashboardData,
  loadAdminOrder,
} from "@/lib/admin-dashboard/data";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import {
  defaultProductCommissionAmount,
  formatCurrency,
  formatDate,
  formatDateTime,
  fullName,
  orderBalance,
  orderPaymentTotal,
} from "@/lib/admin-dashboard/view";
import {
  buildOrderSlipLayout,
  buildSalesInvoiceLayout,
  getDocumentColumnTemplate,
} from "@/lib/order-documents/layout";
import { autoCapitalize, formatOrderSource } from "@/lib/formatters";
import {
  getOrderStatusBadgeLabel,
  getOrderStatusOptionLabel,
} from "@/lib/order-status-display";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const { orderId } = Astro.params;

if (!orderId) {
  return Astro.redirect("/admin/orders", 302);
}

const orderDetailTabIds = [
  "products",
  "order-slip",
  "sales-invoice",
  "commission",
  "payment-record",
  "timeline",
  "notes",
] as const;
const requestedOrderDetailTab = Astro.url.searchParams.get("tab");

if (Astro.request.method === "POST") {
  return handleAdminDashboardAction(
    Astro,
    adminRoute.userId,
    requestedOrderDetailTab &&
      orderDetailTabIds.includes(
        requestedOrderDetailTab as (typeof orderDetailTabIds)[number],
      )
      ? `/admin/orders/customer/${orderId}?tab=${encodeURIComponent(requestedOrderDetailTab)}`
      : `/admin/orders/customer/${orderId}`,
  );
}

const [dashboardData, order] = await Promise.all([
  loadAdminDashboardData(),
  loadAdminOrder(orderId),
]);

if (!order) {
  return Astro.redirect("/admin/orders", 302);
}

await markAdminOrderReadIfUnread(Astro, orderId, adminRoute.userId);

const rawFeedback = formatAdminActionFeedback(Astro.url);
const feedback =
  rawFeedback.status === "Order marked as read." ||
  rawFeedback.status === "Commission updated." ||
  rawFeedback.status === "Order notes saved." ||
  rawFeedback.status === "Order status updated."
    ? { ...rawFeedback, status: undefined }
    : rawFeedback;

const invoice = order.invoice[0] ?? null;
const hasSalesInvoice = Boolean(invoice);
const hasPayments = order.payment.length > 0;
const agentReceivedPayments = order.agent_received_payment ?? [];
const pendingAgentReceivedPayments = agentReceivedPayments.filter(
  (payment) => payment.status === "pending_admin_confirmation",
);
const pendingAgentReceivedTotal = pendingAgentReceivedPayments.reduce(
  (total, payment) => total + payment.amount,
  0,
);
const canEditOrderProducts = !hasSalesInvoice && !hasPayments;
const canGenerateInvoice = order.order_status === "processing";
const paidTotal = orderPaymentTotal(order);
const balance = orderBalance(order);
const canCreatePaymentRecord = hasSalesInvoice && balance > 0;
type PaymentFormCustomerType = "regular" | "wholesale" | "reseller";
const isResellerCustomer = Boolean(order.customer?.is_reseller);
const paymentCustomerType: PaymentFormCustomerType = (() => {
  if (
    isResellerCustomer ||
    order.customer_order_item.every((item) => item.price_type === "reseller")
  ) {
    return "reseller";
  }

  return "regular";
})();
const paymentOrderTotal = order.customer_order_item.reduce((total, item) => {
  return total + item.final_quantity * item.unit_price;
}, 0);
const canEditInvoiceQuantities = hasSalesInvoice && !hasPayments;
const hasCommissionTab = Boolean(order.customer?.assigned_agent ?? order.agent);
const availableOrderDetailTabs = orderDetailTabIds.filter(
  (tab) => tab !== "commission" || hasCommissionTab,
);
const activeOrderDetailTab =
  requestedOrderDetailTab &&
  availableOrderDetailTabs.includes(
    requestedOrderDetailTab as (typeof availableOrderDetailTabs)[number],
  )
    ? requestedOrderDetailTab
    : "products";
const isOrderDetailTabActive = (tab: string) => tab === activeOrderDetailTab;
const orderCode = `Order-${order.id.slice(0, 6).toUpperCase()}`;
const orderSlipPdfHref = `/admin/orders/customer/${order.id}/order-slip.pdf`;
const salesInvoicePdfHref = `/admin/orders/customer/${order.id}/sales-invoice.pdf`;

function sanitizeAttachmentFileName(value: string) {
  return value
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "") || "file";
}

const orderSlipPdfFileName = `order-slip-${sanitizeAttachmentFileName(fullName(order.customer))}-${order.id.slice(0, 8)}.pdf`;
const salesInvoicePdfFileName = invoice
  ? `sales-invoice-${sanitizeAttachmentFileName(fullName(order.customer))}-${invoice.invoice_number}.pdf`
  : null;
const totalCommission = order.customer_order_item.reduce((total, item) => {
  return total + item.agent_commission_amount;
}, 0);
const totalPaidCommissionCoverage = order.customer_order_item.reduce(
  (total, item) => {
    if (!item.agent_commission_paid) {
      return total;
    }

    return total + item.final_quantity * item.unit_price;
  },
  0,
);
const totalAvailableCommissionCoverage = Math.max(
  paidTotal - totalPaidCommissionCoverage,
  0,
);
const orderSlipLayout = buildOrderSlipLayout(order);
const salesInvoiceLayout = buildSalesInvoiceLayout(order);
const orderSlipGridTemplate = getDocumentColumnTemplate(
  orderSlipLayout.columns,
);
const salesInvoiceGridTemplate = getDocumentColumnTemplate(
  salesInvoiceLayout.columns,
);
const nextStatuses = getAllowedNextOrderStatuses(
  order.order_status,
  order.payment_status,
);
const availableStatuses = [order.order_status, ...nextStatuses].filter(
  (value, index, values) => values.indexOf(value) === index,
);
const canChangeOrderStatus = availableStatuses.length > 1;
const orderStatusBadgeLabel = (status: (typeof availableStatuses)[number]) =>
  getOrderStatusBadgeLabel(status);
const orderStatusOptionLabel = (status: (typeof availableStatuses)[number]) =>
  getOrderStatusOptionLabel(order.order_status, status);

const commissionItemTotal = (quantity: number, unitPrice: number) =>
  quantity * unitPrice;
const commissionCoverageRemaining = (itemId: string) => {
  const paidCoverageExcludingCurrent = order.customer_order_item.reduce(
    (total, item) => {
      if (!item.agent_commission_paid || item.id === itemId) {
        return total;
      }

      return total + commissionItemTotal(item.final_quantity, item.unit_price);
    },
    0,
  );

  return Math.max(paidTotal - paidCoverageExcludingCurrent, 0);
};
const getCommissionPayabilityNotice = (
  item: (typeof order.customer_order_item)[number],
  itemTotalAmount: number,
  availableCoverageForItem: number,
) => {
  if (item.agent_commission_paid) {
    return {
      tone: "paid" as const,
      message: "Marked as paid.",
    };
  }

  if (item.agent_commission_amount <= 0) {
    return {
      tone: "blocked" as const,
      message: "Set a commission amount before marking as paid.",
    };
  }

  if (!hasPayments) {
    return {
      tone: "blocked" as const,
      message: "Record a payment before marking as paid.",
    };
  }

  if (itemTotalAmount > availableCoverageForItem) {
    return {
      tone: "blocked" as const,
      message: `Item total exceeds remaining paid coverage (${formatCurrency(availableCoverageForItem)} available).`,
    };
  }

  return {
    tone: "ready" as const,
    message: "Can be marked as paid.",
  };
};
const commissionItems = order.customer_order_item.map((item) => {
  const itemTotalAmount = commissionItemTotal(
    item.final_quantity,
    item.unit_price,
  );
  const availableCoverageForItem = commissionCoverageRemaining(item.id);
  const canMarkCommissionPaid =
    hasPayments && itemTotalAmount <= availableCoverageForItem;

  return {
    item,
    itemTotalAmount,
    availableCoverageForItem,
    paidCheckboxDisabled: !item.agent_commission_paid && !canMarkCommissionPaid,
    payabilityNotice: getCommissionPayabilityNotice(
      item,
      itemTotalAmount,
      availableCoverageForItem,
    ),
  };
});
const commissionItemsWithAmount = commissionItems.filter(
  ({ item }) => item.agent_commission_amount > 0,
);
const markAllCommissionPaid =
  commissionItemsWithAmount.length > 0 &&
  commissionItemsWithAmount.every(({ item }) => item.agent_commission_paid);
const markAllCommissionPaidIndeterminate =
  commissionItemsWithAmount.some(({ item }) => item.agent_commission_paid) &&
  !markAllCommissionPaid;
const markAllCommissionPaidDisabledReason = (() => {
  if (commissionItemsWithAmount.length === 0) {
    return "Set commission amounts before marking all as paid.";
  }

  const unpaidWithAmount = commissionItemsWithAmount.filter(
    ({ item }) => !item.agent_commission_paid,
  );

  if (unpaidWithAmount.length === 0) {
    return null;
  }

  if (!hasPayments) {
    return "Record a payment before marking all commissions as paid.";
  }

  const cannotMarkAllUnpaid = unpaidWithAmount.some(
    ({ paidCheckboxDisabled }) => paidCheckboxDisabled,
  );

  if (cannotMarkAllUnpaid) {
    return `Recorded payments leave only ${formatCurrency(totalAvailableCommissionCoverage)} available for paid commissions.`;
  }

  return null;
})();
const markAllCommissionPaidDisabled =
  markAllCommissionPaidDisabledReason !== null;

const customerDisplayName = order.customer
  ? fullName(order.customer)
  : "Unassigned customer";
const customerAddress = order.customer?.address ?? "No address on file";
const customerPhone = order.customer?.phone_number ?? "No contact number";
const customerEmail = order.customer?.email ?? "No email address";
const agentDisplayName =
  order.customer?.assigned_agent?.display_name ?? "No assigned agent";
const agentPhone =
  order.customer?.assigned_agent?.contact ?? "No contact number";
const agentEmail = order.customer?.assigned_agent?.email ?? "No email address";
const orderedProductIds = new Set(
  order.customer_order_item.map((item) => item.product_id),
);
const addableProducts = dashboardData.products.filter(
  (product) => product.is_active && !orderedProductIds.has(product.id),
);
const orderProductEditLockReason = hasSalesInvoice
  ? "Order products are locked after a sales invoice has been created."
  : hasPayments
    ? "Order products are locked after a payment record has been created."
    : null;

const timelineItems = [
  ...order.payment.map((payment) => ({
    id: `payment-${payment.id}`,
    title: `Payment recorded via ${payment.payment_method}`,
    timestamp: payment.created_at,
    meta: `${formatCurrency(payment.amount)}${payment.reference_number ? ` • Ref ${payment.reference_number}` : ""}`,
  })),
  ...order.customer_order_status_history.map((entry) => ({
    id: `status-${entry.id}`,
    title: `Order moved to ${autoCapitalize(entry.to_status)}`,
    timestamp: entry.changed_at,
    meta:
      entry.notes ??
      (entry.from_status
        ? `From ${autoCapitalize(entry.from_status)}`
        : "Status update"),
  })),
  ...(invoice
    ? [
        {
          id: `invoice-${invoice.id}`,
          title: "Invoice created",
          timestamp: invoice.created_at,
          meta: invoice.invoice_number,
        },
      ]
    : []),
  {
    id: `created-${order.id}`,
    title: "Order created",
    timestamp: order.created_at,
    meta: formatOrderSource(order.source),
  },
].sort((left, right) => {
  return (
    new Date(right.timestamp).getTime() - new Date(left.timestamp).getTime()
  );
});

const returnToParam = Astro.url.searchParams.get("returnTo");
const backHref =
  returnToParam?.startsWith("/admin/") && !returnToParam.startsWith("//")
    ? returnToParam
    : "/admin/orders";
const backLabel = backHref.startsWith("/admin/customers/")
  ? "Back to customer record"
  : "Back to orders";
---

<AdminPageFrame
  title={`${orderCode} - JEHMARP`}
  description="Admin order details with order slip, sales invoice, commissions, payment records, and notes."
  heading="Order Details"
  intro={`Review ${orderCode} and manage invoice, commission, payment, and notes.`}
  feedback={feedback}
  dashboardData={dashboardData}
>
  <div class="order-detail-page" data-order-detail-page>
    <aside class="order-detail-sidebar">
      <div class="order-sidebar-header">
        <p class="order-detail-eyebrow">Order / Order Details</p>

        <div class="order-summary-top">
          <div class="order-summary-top__main">
            <RouteBackButton href={backHref} label={backLabel} />

            <div class="order-title-copy">
              <h1>{orderCode}</h1>
              <p>{formatOrderSource(order.source)}</p>
            </div>
          </div>

          <div
            class="order-summary-top__status"
            data-order-status-panel
            data-save-url={`/admin/orders/customer/${order.id}`}
          >
            {
              canChangeOrderStatus ? (
                <>
                  <button
                    type="button"
                    class="order-status-trigger"
                    data-order-status-trigger
                    data-open-cell-popover
                    data-popover-title={`Update status: ${orderCode}`}
                    aria-label={`Order status: ${orderStatusBadgeLabel(order.order_status)}. Click to update.`}
                  >
                    <StatusBadge
                      kind="order"
                      status={order.order_status}
                      label={orderStatusBadgeLabel(order.order_status)}
                    />
                  </button>
                  <div class="hidden-popover-form-holder">
                    <form
                      method="post"
                      action={`/admin/orders/customer/${order.id}`}
                      class="order-status-popover-form"
                      data-order-status-form
                    >
                      <input
                        type="hidden"
                        name="action"
                        value="update-order-status"
                      />
                      <input type="hidden" name="orderId" value={order.id} />
                      <label>
                        <span>Status</span>
                        <select name="orderStatus" required>
                          {availableStatuses.map((status) => (
                            <option
                              value={status}
                              selected={status === order.order_status}
                            >
                              {orderStatusOptionLabel(status)}
                            </option>
                          ))}
                        </select>
                      </label>
                    </form>
                  </div>
                </>
              ) : (
                <StatusBadge
                  kind="order"
                  status={order.order_status}
                  label={orderStatusBadgeLabel(order.order_status)}
                />
              )
            }
          </div>
        </div>

        <div class="order-party-cards">
          <article class="order-party-card order-party-card--customer">
            <div class="order-party-card__identity">
              <div class="order-party-card__identity-copy">
                <span class="order-party-card__eyebrow">Customer</span>
                <p class="order-party-card__name">{customerDisplayName}</p>
              </div>
            </div>

            <ul class="order-party-card__meta-list">
              <li
                class:list={[
                  "order-party-card__meta-item",
                  { "is-placeholder": !order.customer?.address },
                ]}
              >
                <span class="order-party-card__meta-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path
                      d="M12 21s-7-4.35-7-10a7 7 0 1 1 14 0c0 5.65-7 10-7 10Z"
                    ></path>
                    <circle cx="12" cy="11" r="2.5"></circle>
                  </svg>
                </span>
                <span class="order-party-card__meta-text"
                  >{customerAddress}</span
                >
              </li>
              <li
                class:list={[
                  "order-party-card__meta-item",
                  { "is-placeholder": !order.customer?.phone_number },
                ]}
              >
                <span class="order-party-card__meta-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path
                      d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.86.3 1.7.54 2.5a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.58-1.11a2 2 0 0 1 2.11-.45c.8.24 1.64.42 2.5.54A2 2 0 0 1 22 16.92Z"
                    ></path>
                  </svg>
                </span>
                {
                  order.customer?.phone_number ? (
                    <a
                      class="order-party-card__meta-link"
                      href={`tel:${order.customer.phone_number}`}
                    >
                      {customerPhone}
                    </a>
                  ) : (
                    <span class="order-party-card__meta-text">
                      {customerPhone}
                    </span>
                  )
                }
              </li>
              <li
                class:list={[
                  "order-party-card__meta-item",
                  { "is-placeholder": !order.customer?.email },
                ]}
              >
                <span class="order-party-card__meta-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path
                      d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"
                    ></path>
                    <path d="m22 6-10 7L2 6"></path>
                  </svg>
                </span>
                {
                  order.customer?.email ? (
                    <a
                      class="order-party-card__meta-link"
                      href={`mailto:${order.customer.email}`}
                    >
                      {customerEmail}
                    </a>
                  ) : (
                    <span class="order-party-card__meta-text">
                      {customerEmail}
                    </span>
                  )
                }
              </li>
            </ul>
          </article>

          <article class="order-party-card order-party-card--agent">
            <div class="order-party-card__identity">
              <div class="order-party-card__identity-copy">
                <span class="order-party-card__eyebrow">Assigned agent</span>
                <p class="order-party-card__name">{agentDisplayName}</p>
              </div>
            </div>

            <ul class="order-party-card__meta-list">
              <li
                class:list={[
                  "order-party-card__meta-item",
                  {
                    "is-placeholder": !order.customer?.assigned_agent?.contact,
                  },
                ]}
              >
                <span class="order-party-card__meta-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path
                      d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.86.3 1.7.54 2.5a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.58-1.11a2 2 0 0 1 2.11-.45c.8.24 1.64.42 2.5.54A2 2 0 0 1 22 16.92Z"
                    ></path>
                  </svg>
                </span>
                {
                  order.customer?.assigned_agent?.contact ? (
                    <a
                      class="order-party-card__meta-link"
                      href={`tel:${order.customer.assigned_agent.contact}`}
                    >
                      {agentPhone}
                    </a>
                  ) : (
                    <span class="order-party-card__meta-text">
                      {agentPhone}
                    </span>
                  )
                }
              </li>
              <li
                class:list={[
                  "order-party-card__meta-item",
                  { "is-placeholder": !order.customer?.assigned_agent?.email },
                ]}
              >
                <span class="order-party-card__meta-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path
                      d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"
                    ></path>
                    <path d="m22 6-10 7L2 6"></path>
                  </svg>
                </span>
                {
                  order.customer?.assigned_agent?.email ? (
                    <a
                      class="order-party-card__meta-link"
                      href={`mailto:${order.customer.assigned_agent.email}`}
                    >
                      {agentEmail}
                    </a>
                  ) : (
                    <span class="order-party-card__meta-text">
                      {agentEmail}
                    </span>
                  )
                }
              </li>
            </ul>
          </article>
        </div>

        <section class="order-attachments" aria-labelledby="order-attachments-title">
          <h2 id="order-attachments-title" class="order-attachments__title">Attachments</h2>
          <ul class="order-attachments__list">
            <li class="order-attachments__item">
              <a
                href={orderSlipPdfHref}
                class="order-attachments__link"
                target="_blank"
                rel="noreferrer"
              >
                {orderSlipPdfFileName}
              </a>
            </li>
            {
              salesInvoicePdfFileName ? (
                <li class="order-attachments__item">
                  <a
                    href={salesInvoicePdfHref}
                    class="order-attachments__link"
                    target="_blank"
                    rel="noreferrer"
                  >
                    {salesInvoicePdfFileName}
                  </a>
                </li>
              ) : null
            }
          </ul>
        </section>
      </div>

    </aside>

    <section class="order-detail-main" data-order-detail-tabs>
      <div class="order-tabs" role="tablist" aria-label="Order detail sections">
        <button
          type="button"
          class:list={[
            "order-tab",
            isOrderDetailTabActive("products") && "is-active",
          ]}
          data-order-detail-tab-trigger
          data-tab-target="products"
          role="tab"
          aria-selected={isOrderDetailTabActive("products") ? "true" : "false"}
        >
          Products
        </button>
        <button
          type="button"
          class:list={[
            "order-tab",
            isOrderDetailTabActive("order-slip") && "is-active",
          ]}
          data-order-detail-tab-trigger
          data-tab-target="order-slip"
          role="tab"
          aria-selected={isOrderDetailTabActive("order-slip") ? "true" : "false"}
        >
          Order Slip
        </button>
        <button
          type="button"
          class:list={[
            "order-tab",
            isOrderDetailTabActive("sales-invoice") && "is-active",
          ]}
          data-order-detail-tab-trigger
          data-tab-target="sales-invoice"
          role="tab"
          aria-selected={isOrderDetailTabActive("sales-invoice") ? "true" : "false"}
        >
          Sales Invoice
        </button>
        {
          hasCommissionTab && (
            <button
              type="button"
              class:list={[
                "order-tab",
                isOrderDetailTabActive("commission") && "is-active",
              ]}
              data-order-detail-tab-trigger
              data-tab-target="commission"
              role="tab"
              aria-selected={isOrderDetailTabActive("commission") ? "true" : "false"}
            >
              Commission
            </button>
          )
        }
        <button
          type="button"
          class:list={[
            "order-tab",
            isOrderDetailTabActive("payment-record") && "is-active",
          ]}
          data-order-detail-tab-trigger
          data-tab-target="payment-record"
          role="tab"
          aria-selected={isOrderDetailTabActive("payment-record") ? "true" : "false"}
        >
          Payment Record
        </button>
        <button
          type="button"
          class:list={[
            "order-tab",
            isOrderDetailTabActive("timeline") && "is-active",
          ]}
          data-order-detail-tab-trigger
          data-tab-target="timeline"
          role="tab"
          aria-selected={isOrderDetailTabActive("timeline") ? "true" : "false"}
        >
          Timeline
        </button>
        <button
          type="button"
          class:list={[
            "order-tab",
            isOrderDetailTabActive("notes") && "is-active",
          ]}
          data-order-detail-tab-trigger
          data-tab-target="notes"
          role="tab"
          aria-selected={isOrderDetailTabActive("notes") ? "true" : "false"}
        >
          Notes
        </button>
      </div>

      <div class="order-tab-panels">
        <section
          class:list={[
            "order-tab-panel",
            isOrderDetailTabActive("products") && "is-active",
          ]}
          data-order-detail-tab-panel="products"
          role="tabpanel"
          hidden={!isOrderDetailTabActive("products")}
        >
          <div class="order-products-panel">
            <div class="order-products-panel__header">
              <div>
                <h3 class="order-products-panel__title">Order Products</h3>
                <p class="order-products-panel__copy">
                  Finalize products and order slip quantities before opening or printing the order slip.
                </p>
              </div>
              {
                orderProductEditLockReason ? (
                  <p class="order-products-panel__lock">
                    {orderProductEditLockReason}
                  </p>
                ) : null
              }
