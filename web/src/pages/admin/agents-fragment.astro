---
import AdminAgentManagement from "@/components/admin/AdminAgentManagement.astro";
import { loadAdminAgentManagementData } from "@/lib/admin-dashboard/data";
import {
  parseAdminAgentFilters,
  serializeAdminAgentFilters,
} from "@/lib/admin-dashboard/agent-filters";
import {
  mergeAdminPaginationQuery,
  parseAdminPagination,
} from "@/lib/admin-dashboard/pagination";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import { setDashboardFragmentResponseHeaders } from "@/lib/dashboard/fragment-response";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

setDashboardFragmentResponseHeaders(Astro);

const agentFilters = parseAdminAgentFilters(Astro.url);
const agentPagination = parseAdminPagination(Astro.url);
const agentFilterQuery = mergeAdminPaginationQuery(
  serializeAdminAgentFilters(agentFilters),
  agentPagination,
);
const data = await loadAdminAgentManagementData(agentFilters, agentPagination);
---

<AdminAgentManagement
  data={data}
  activeFilters={agentFilters}
  filterQuery={agentFilterQuery}
/>
