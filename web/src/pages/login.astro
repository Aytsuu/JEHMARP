---
import PageShell from "@/components/PageShell.astro";
import Layout from "@/layouts/Layout.astro";
import { getLoginErrorMessage, getSignedInUser } from "@/lib/auth";

const user = await getSignedInUser(Astro);

if (user) {
  return Astro.redirect("/dashboard", 302);
}

const errorMessage = getLoginErrorMessage(Astro.url.searchParams.get("error"));
---

<Layout
  title="Login - JEHMARP"
  description="Single authentication entry point for admin and agent access."
>
  <PageShell title="Login">
    <form class="form-section form-grid form-section--login" method="post" action="/api/login">
      {
        errorMessage && (
          <div class="error-message" style="color: var(--color-brand-red); font-weight: 700; font-size: 0.95rem; margin-bottom: 1rem; border-left: 3px solid var(--color-brand-red); padding-left: 0.75rem;">
            {errorMessage}
          </div>
        )
      }
      <div class="field-row">
        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
        />
      </div>
      <div class="field-row">
        <label for="password">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          autocomplete="current-password"
        />
      </div>
      <button type="submit" style="margin-top: 1rem; width: 100%;">Sign in</button>
    </form>
  </PageShell>
</Layout>
