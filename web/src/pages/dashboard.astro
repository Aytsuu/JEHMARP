---
import PageShell from "@/components/PageShell.astro";
import Layout from "@/layouts/Layout.astro";
import {
  getDashboardHeading,
  getDashboardRoleForSignedInUser,
  getSignedInUser,
} from "@/lib/auth";

const user = await getSignedInUser(Astro);

if (!user) {
  return Astro.redirect("/login", 302);
}

const role = await getDashboardRoleForSignedInUser(Astro, user.id);
const heading = getDashboardHeading(role);
---

<Layout
  title={`NMC | ${heading}`}
  description="Mock authenticated dashboard entry page."
>
  <PageShell title={heading}>
    <section class="content-section">
      <p>{heading}</p>
    </section>
  </PageShell>
</Layout>
