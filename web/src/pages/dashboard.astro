---
import PageShell from "@/components/PageShell.astro";
import Layout from "@/layouts/Layout.astro";
import {
  getDashboardRoleForSignedInUser,
  getSignedInUser,
} from "@/lib/auth";

const user = await getSignedInUser(Astro);

if (!user) {
  return Astro.redirect("/login", 302);
}

const role = await getDashboardRoleForSignedInUser(Astro, user.id);

if (role === "admin") {
  return Astro.redirect("/admin", 302);
}

return Astro.redirect("/agent", 302);
---

<Layout
  title="NMC | Dashboard"
  description="Mock authenticated dashboard entry page."
>
  <PageShell>
    <section class="content-section">
      <p>Redirecting to your dashboard.</p>
    </section>
  </PageShell>
</Layout>
