---
import Layout from "@/layouts/Layout.astro";
import {
  getSafeReturnTo,
  getSystemIssueHomePath,
} from "@/lib/system-issue";

const returnTo = getSafeReturnTo(Astro.url.searchParams.get("returnTo"));
const homePath = getSystemIssueHomePath(returnTo);
---

<Layout
  title="System Issue - JEHMARP"
  description="Temporary system issue while loading page data."
>
  <section class="system-issue">
    <div class="system-issue__card">
      <div class="system-issue__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 9v4"></path>
          <path d="M12 17h.01"></path>
          <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
        </svg>
      </div>

      <h1>We could not load this page</h1>
      <p>
        Something went wrong while loading the data for this page. This can happen
        temporarily after a system update or when the database is still catching up.
      </p>
      <p>Please try again in a moment. If the problem continues, contact support.</p>

      <div class="system-issue__actions">
        <a class="system-issue__button system-issue__button--primary" href={returnTo}>
          Try again
        </a>
        <a class="system-issue__button system-issue__button--secondary" href={homePath}>
          Go to dashboard home
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .system-issue {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 12rem);
    padding: 2rem 1rem 4rem;
  }

  .system-issue__card {
    width: min(100%, 34rem);
    padding: 2rem 1.75rem;
    border: 1px solid rgba(17, 24, 39, 0.1);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.92);
    text-align: center;
    box-shadow: 0 18px 40px rgba(17, 24, 39, 0.08);
  }

  .system-issue__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto 1rem;
    border-radius: 999px;
    background: rgba(127, 29, 29, 0.08);
    color: #7f1d1d;
  }

  .system-issue__icon svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .system-issue__card h1 {
    margin: 0 0 0.75rem;
    font-size: 1.5rem;
    color: #111827;
  }

  .system-issue__card p {
    margin: 0 0 0.75rem;
    color: rgba(17, 24, 39, 0.72);
    line-height: 1.6;
  }

  .system-issue__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .system-issue__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    border-radius: 0.65rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    text-transform: none;
    letter-spacing: normal;
  }

  .system-issue__button--primary {
    background: #7f1d1d;
    color: #ffffff;
  }

  .system-issue__button--secondary {
    border: 1px solid rgba(17, 24, 39, 0.14);
    background: #ffffff;
    color: #111827;
  }
</style>
