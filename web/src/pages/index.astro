---
import HomePageSections from "@/components/HomePageSections.astro";
import PageShell from "@/components/PageShell.astro";
import Layout from "@/layouts/Layout.astro";
import { getPublicPageContent } from "@/lib/public-website/content";

const content = await getPublicPageContent(Astro, "home");
const title = content.page?.title ?? "Home";
---

<Layout title={`NMC | ${title}`} description="NMC public home page.">
	<PageShell title={title}>
		<HomePageSections sections={content.sections} />
	</PageShell>
</Layout>
