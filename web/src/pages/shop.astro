---
import PageShell from "@/components/PageShell.astro";
import Layout from "@/layouts/Layout.astro";
import PublicShopPageContent from "@/components/public-website/PublicShopPageContent.astro";
import { listOrderablePublicProducts } from "@/lib/public-website/shop";
import { getPublicEnv } from "@/lib/env";

const products = await listOrderablePublicProducts();
const orderStatus = Astro.url.searchParams.get("order");
const orderEmailSent = Astro.url.searchParams.get("email") === "1";
const orderMessage = Astro.url.searchParams.get("message");
const { turnstileSiteKey } = getPublicEnv();
---

<Layout
  title="Shop - JEHMARP"
  description="Browse active JEHMARP products and submit a guest order."
>
  <PageShell title="Shop">
    <PublicShopPageContent
      products={products}
      orderStatus={orderStatus}
      orderEmailSent={orderEmailSent}
      orderMessage={orderMessage}
      turnstileSiteKey={turnstileSiteKey ?? null}
    />
  </PageShell>
</Layout>
