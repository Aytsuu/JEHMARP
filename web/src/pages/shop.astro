---
import PageShell from "@/components/PageShell.astro";
import Layout from "@/layouts/Layout.astro";
import {
  buildShopUrl,
  listPublicProducts,
  parseShopFilters,
} from "@/lib/public-website/shop";
import { getPublicEnv } from "@/lib/env";

const filters = parseShopFilters(Astro.url);
const { products, pagination } = await listPublicProducts(Astro, filters);
const orderStatus = Astro.url.searchParams.get("order");
const orderReference = Astro.url.searchParams.get("reference");
const orderMessage = Astro.url.searchParams.get("message");
const { turnstileSiteKey } = getPublicEnv();

function getProductImage(name: string): string {
  const normalized = name.toLowerCase();
  if (normalized.includes("pork belly")) return "/images/pork_belly.png";
  if (normalized.includes("chicken breast"))
    return "/images/chicken_breast.png";
  if (normalized.includes("short ribs") || normalized.includes("beef"))
    return "/images/beef_short_ribs.png";
  if (normalized.includes("ground pork")) return "/images/ground_pork.png";
  return "/images/meat_cluster.svg";
}
---

<Layout
  title="Shop - JEHMARP"
  description="Browse active JEHMARP products and submit a guest order."
>
  <PageShell title="Shop">
    <div
      class="shop-header-banner"
      role="img"
      aria-label="Shop fresh local meats banner placeholder"
    >
    </div>
    {
      orderStatus === "submitted" && (
        <section class="message-block" aria-labelledby="order-confirmation">
          <h2 id="order-confirmation">Order submitted</h2>
          <p>Your guest order was submitted for review.</p>
          {orderReference && <p>Reference: {orderReference}</p>}
        </section>
      )
    }

    {
      orderStatus === "error" && (
        <section class="message-block" aria-labelledby="order-error">
          <h2 id="order-error">Order was not submitted</h2>
          <p>{orderMessage ?? "Please check the order form and try again."}</p>
        </section>
      )
    }

    <section class="form-section" aria-labelledby="shop-filters">
      <h2 id="shop-filters">Filter products</h2>
      <form class="form-grid form-grid--filters" method="get" action="/shop">
        <div class="field-row">
          <label for="category">Category</label>
          <select id="category" name="category">
            <option value="">All categories</option>
            <option value="pork" selected={filters.category === "pork"}
              >Pork</option
            >
            <option value="chicken" selected={filters.category === "chicken"}
              >Chicken</option
            >
            <option value="egg" selected={filters.category === "egg"}
              >Egg</option
            >
          </select>
        </div>

        <div class="field-row">
          <label for="stockStatus">Stock status</label>
          <select id="stockStatus" name="stockStatus">
            <option value="">All stock statuses</option>
            <option
              value="in_stock"
              selected={filters.stockStatus === "in_stock"}>In stock</option
            >
            <option value="limited" selected={filters.stockStatus === "limited"}
              >Limited</option
            >
            <option
              value="out_of_stock"
              selected={filters.stockStatus === "out_of_stock"}
              >Out of stock</option
            >
          </select>
        </div>

        <div class="field-row">
          <label for="minPrice"
            >Minimum price (PHP <span id="minPriceVal"
              >{filters.minPrice ?? 0}</span
            >)</label
          >
          <input
            id="minPrice"
            name="minPrice"
            type="range"
            min="0"
            max="1000"
            step="5"
            value={filters.minPrice ?? 0}
          />
        </div>

        <div class="field-row">
          <label for="maxPrice"
            >Maximum price (PHP <span id="maxPriceVal"
              >{filters.maxPrice ?? 1000}</span
            >)</label
          >
          <input
            id="maxPrice"
            name="maxPrice"
            type="range"
            min="0"
            max="1000"
            step="5"
            value={filters.maxPrice ?? 1000}
          />
        </div>

        <div class="field-row">
          <label for="sort">Sort</label>
          <select id="sort" name="sort">
            <option value="name_asc" selected={filters.sort === "name_asc"}
              >Name, A to Z</option
            >
            <option value="name_desc" selected={filters.sort === "name_desc"}
              >Name, Z to A</option
            >
            <option value="price_asc" selected={filters.sort === "price_asc"}
              >Price, low to high</option
            >
            <option value="price_desc" selected={filters.sort === "price_desc"}
              >Price, high to low</option
            >
            <option value="newest" selected={filters.sort === "newest"}
              >Newest</option
            >
          </select>
        </div>

        <div class="button-row">
          <button type="submit">Apply filters</button>
          <a href="/shop" class="btn-secondary">Reset filters</a>
        </div>
      </form>
    </section>

    <section class="shop-products-section" aria-labelledby="product-list">
      <p>
        Showing page {pagination.currentPage} of {pagination.totalPages}. {
          pagination.count
        } product{pagination.count === 1 ? "" : "s"} found.
      </p>

      {
        products.length > 0 ? (
          <ul class="shop-product-grid">
            {products.map((product) => (
              <li>
                <article class="product-card">
                  <div class="product-card__image-container">
                    <img
                      src={getProductImage(product.name)}
                      alt={product.name}
                      class="product-card__image"
                    />
                    {product.stock_status === "out_of_stock" && (
                      <span class="product-card__badge product-card__badge--sold-out">
                        SOLD OUT
                      </span>
                    )}
                    {product.stock_status === "limited" && (
                      <span class="product-card__badge product-card__badge--limited">
                        LIMITED
                      </span>
                    )}
                  </div>
                  <div class="product-card__content">
                    <div class="product-card__price-row">
                      <span>Price from </span>
                      <span class="product-card__price-val">
                        PHP {Number(product.default_price).toFixed(2)}
                      </span>
                      <span class="product-card__unit-label">
                        / {product.unit_label}
                      </span>
                    </div>
                    <h3 class="product-card__title">{product.name}</h3>
                    <div class="product-card__status-row">
                      <span class="product-card__status-text">
                        {product.stock_status === "in_stock" && "In stock"}
                        {product.stock_status === "limited" && "Limited Stock"}
                        {product.stock_status === "out_of_stock" &&
                          "Out of stock"}
                      </span>
                    </div>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        ) : (
          <p>No active products match the selected filters.</p>
        )
      }

      <nav class="shop-pagination" aria-label="Product pagination">
        {
          pagination.previousPage ? (
            <a
              href={buildShopUrl(filters, pagination.previousPage)}
              class="pagination-arrow"
              aria-label="Previous page"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="15 18 9 12 15 6" />
              </svg>
            </a>
          ) : (
            <span class="pagination-arrow pagination-arrow--disabled">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="15 18 9 12 15 6" />
              </svg>
            </span>
          )
        }

        <div class="pagination-dots">
          {
            Array.from({ length: pagination.totalPages }, (_, i) => i + 1).map(
              (p) => {
                const isActive = p === pagination.currentPage;
                return isActive ? (
                  <span
                    class="pagination-indicator pagination-indicator--active"
                    aria-current="page"
                  />
                ) : (
                  <a
                    href={buildShopUrl(filters, p)}
                    class="pagination-indicator"
                    aria-label={`Go to page ${p}`}
                  />
                );
              },
            )
          }
        </div>

        {
          pagination.nextPage ? (
            <a
              href={buildShopUrl(filters, pagination.nextPage)}
              class="pagination-arrow"
              aria-label="Next page"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </a>
          ) : (
            <span class="pagination-arrow pagination-arrow--disabled">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </span>
          )
        }
      </nav>
    </section>

    <section class="shop-guest-order-section" aria-labelledby="guest-order">
      <h2 id="guest-order" class="page-title-brand">ORDER FORM</h2>
      <form class="form-grid" method="post" action="/api/guest-orders">
        <fieldset class="fieldset-block">
          <legend>Customer details</legend>
          <div class="form-grid form-grid--two-column">
            <div class="field-row">
              <label for="firstName">First name</label>
              <input
                id="firstName"
                name="firstName"
                required
                autocomplete="given-name"
              />
            </div>
            <div class="field-row">
              <label for="lastName">Last name</label>
              <input
                id="lastName"
                name="lastName"
                required
                autocomplete="family-name"
              />
            </div>
            <div class="field-row">
              <label for="phoneNumber">Phone number</label>
              <input
                id="phoneNumber"
                name="phoneNumber"
                required
                autocomplete="tel"
              />
            </div>
            <div class="field-row">
              <label for="email">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
              />
            </div>
          </div>
          <div class="field-row">
            <label for="address">Delivery address</label>
            <textarea
              id="address"
              name="address"
              required
              autocomplete="street-address"></textarea>
          </div>
        </fieldset>

        <fieldset class="fieldset-block">
          <legend>Order items</legend>
          {
            products.length > 0 ? (
              <div class="order-items-grid">
                {products.map((product) => (
                  <section
                    class="product-order-item"
                    aria-labelledby={`order-product-${product.id}`}
                  >
                    <h3 id={`order-product-${product.id}`}>{product.name}</h3>
                    <p>
                      {Number(product.default_price).toFixed(2)} per{" "}
                      {product.unit_label}
                    </p>
                    <div class="field-row">
                      <label for={`quantity-${product.id}`}>Quantity</label>
                      <input
                        id={`quantity-${product.id}`}
                        name={`quantity:${product.id}`}
                        type="number"
                        min="0"
                        step="0.001"
                      />
                    </div>
                    <div class="field-row">
                      <label for={`details-${product.id}`}>Item details</label>
                      <input
                        id={`details-${product.id}`}
                        name={`details:${product.id}`}
                      />
                    </div>
                  </section>
                ))}
              </div>
            ) : (
              <p>No active products are available for guest ordering.</p>
            )
          }
        </fieldset>

        <div class="turnstile-container">
          {
            turnstileSiteKey ? (
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} />
            ) : (
              <p class="error-message">
                Guest order verification is not configured.
              </p>
            )
          }
        </div>

        <div class="button-row">
          <button
            type="submit"
            disabled={products.length === 0 || !turnstileSiteKey}
            >Submit order</button
          >
        </div>
      </form>
    </section>

    {
      turnstileSiteKey && (
        <script
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        />
      )
    }
  </PageShell>
</Layout>

<script>
  function initPriceSliders() {
    const minInput = document.getElementById(
      "minPrice",
    ) as HTMLInputElement | null;
    const maxInput = document.getElementById(
      "maxPrice",
    ) as HTMLInputElement | null;
    const minVal = document.getElementById("minPriceVal");
    const maxVal = document.getElementById("maxPriceVal");

    if (minInput && minVal) {
      minInput.addEventListener("input", () => {
        minVal.textContent = minInput.value;
        if (maxInput && Number(maxInput.value) < Number(minInput.value)) {
          maxInput.value = minInput.value;
          if (maxVal) maxVal.textContent = minInput.value;
        }
      });
    }

    if (maxInput && maxVal) {
      maxInput.addEventListener("input", () => {
        maxVal.textContent = maxInput.value;
        if (minInput && Number(minInput.value) > Number(maxInput.value)) {
          minInput.value = maxInput.value;
          if (minVal) minVal.textContent = maxInput.value;
        }
      });
    }
  }

  document.addEventListener("DOMContentLoaded", initPriceSliders);
  document.addEventListener("astro:after-swap", initPriceSliders);

  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initPriceSliders();
  }
</script>
