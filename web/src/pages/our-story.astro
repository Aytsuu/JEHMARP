---
import PageShell from "@/components/PageShell.astro";
import Layout from "@/layouts/Layout.astro";
import PublicOurStoryPageContent from "@/components/public-website/PublicOurStoryPageContent.astro";
import { getPublicPageContent } from "@/lib/public-website/content";

const content = await getPublicPageContent(Astro, "our-story");
const title = content.page?.title ?? "Our Story";
---

<Layout title={`${title} - JEHMARP`} description="JEHMARP public story page.">
  <PageShell title={title}>
    <PublicOurStoryPageContent content={content} />
  </PageShell>
</Layout>
