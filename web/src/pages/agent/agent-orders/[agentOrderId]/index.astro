---
import AgentRecordPageLayout from "@/components/agent/AgentRecordPageLayout.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import ViewButton from "@/components/ViewButton.astro";
import {
  formatAgentActionFeedback,
  handleAgentDashboardAction,
} from "@/lib/agent-dashboard/actions";
import {
  loadAgentDashboardData,
  type AgentOrder,
} from "@/lib/agent-dashboard/data";
import { requireAgentRoute } from "@/lib/agent-dashboard/page";
import {
  agentOrderPaymentStatus,
  agentOrderTotal,
  formatCurrency,
  formatDate,
  fullName,
  orderPaymentTotal,
  orderTotal,
} from "@/lib/agent-dashboard/view";
import { autoCapitalize, formatOrderSource } from "@/lib/formatters";

export const prerender = false;

function formatAmountValue(value: number) {
  return new Intl.NumberFormat("en-PH", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(value);
}

function pendingAgentPaymentTotal(order: AgentOrder) {
  return (order.agent_received_payment ?? []).reduce((sum, payment) => {
    return payment.status === "pending_admin_confirmation"
      ? sum + payment.amount
      : sum;
  }, 0);
}

const agentRoute = await requireAgentRoute(Astro);

if (!agentRoute.ready) {
  return agentRoute.response;
}

const { agentOrderId } = Astro.params;

if (!agentOrderId) {
  return Astro.redirect("/agent/orders", 302);
}

if (Astro.request.method === "POST") {
  return handleAgentDashboardAction(
    Astro,
    agentRoute.userId,
    `/agent/agent-orders/${agentOrderId}`,
  );
}

const data = await loadAgentDashboardData(Astro, agentRoute.userId);
const agentOrder = data.agentOrders.find((order) => order.id === agentOrderId);

if (!agentOrder) {
  return Astro.redirect("/agent/orders", 302);
}

const feedback = formatAgentActionFeedback(Astro.url);
const agentOrderPaymentState = agentOrderPaymentStatus(agentOrder);
const totalAmount = agentOrderTotal(agentOrder);
const totalPaid = agentOrder.customer_order.reduce(
  (sum, order) => sum + orderPaymentTotal(order),
  0,
);
const totalPendingAgentReceived = agentOrder.customer_order.reduce(
  (sum, order) => sum + pendingAgentPaymentTotal(order),
  0,
);
const totalCommission = agentOrder.agent_order_item.reduce(
  (sum, item) => sum + item.agent_commission_amount,
  0,
);
const agentOrderCode = `Order-${agentOrder.id.slice(0, 6).toUpperCase()}`;
const todayDate = new Date().toISOString().slice(0, 10);
---

<AgentRecordPageLayout
  title={`${agentOrderCode} - JEHMARP`}
  description="Agent order cluster details."
  heading={agentOrderCode}
  backUrl="/agent/orders"
  backLabel="Back to orders"
  feedback={feedback}
  dashboardData={data}
  contentMaxWidth="72rem"
  fullHeight
>
  <ul slot="heading-meta" class="record-meta" aria-label="Agent order date">
    <li class="record-meta__item">
      <svg class="record-meta__icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <span class="record-meta__text">{formatDate(agentOrder.created_at)}</span>
    </li>
  </ul>

  <div slot="heading-aside" class="record-heading-badges">
    <StatusBadge
      kind="order"
      status={agentOrder.order_status}
      label={autoCapitalize(agentOrder.order_status)}
    />
    <StatusBadge
      kind="payment"
      status={agentOrderPaymentState}
      label={autoCapitalize(agentOrderPaymentState)}
    />
  </div>

  <div class="agent-record-content">
    <div class="assigned-summary-grid">
      <div class="detail-field">
        <div class="detail-field-value detail-field-value--amount">
          <span class="amount-ratio">
            <span class="amount-ratio__paid">{formatCurrency(totalPaid)}</span>
            <span class="amount-ratio__total"
              >/{formatAmountValue(totalAmount)}</span
            >
          </span>
        </div>
        <span class="detail-field-label">Total amount</span>
      </div>

      <div class="detail-field">
        <div class="detail-field-value">
          {formatCurrency(totalPendingAgentReceived)}
        </div>
        <span class="detail-field-label">Agent received</span>
      </div>

      <div class="detail-field">
        <div class="detail-field-value">{formatCurrency(totalCommission)}</div>
        <span class="detail-field-label">Total commission</span>
      </div>

      <div class="detail-field">
        <div class="detail-field-value">
          {agentOrder.agent_order_item.length}
        </div>
        <span class="detail-field-label">Products</span>
      </div>

      <div class="detail-field">
        <div class="detail-field-value">{agentOrder.customer_order.length}</div>
        <span class="detail-field-label">Customers</span>
      </div>
    </div>

    <div class="record-section">
      <h2 class="section-line-heading">
        <span class="section-line-heading__line" aria-hidden="true"></span>
        <span class="section-line-heading__label">Products</span>
        <span class="section-line-heading__line" aria-hidden="true"></span>
      </h2>
      {
        agentOrder.agent_order_item.length === 0 ? (
          <p class="empty-state">
            No products have been added to this agent order yet.
          </p>
        ) : (
          <div class="order-record-table-wrap">
            <table class="agent-customers-table agent-order-products-table">
              <thead>
                <tr>
                  <th scope="col">Product</th>
                  <th scope="col">Quantity</th>
                  <th scope="col">Details</th>
                  <th scope="col">Total</th>
                  <th scope="col">Commission</th>
                </tr>
              </thead>
              <tbody>
                {agentOrder.agent_order_item.map((item) => {
                  const unitPrice = item.product?.default_price ?? 0;

                  return (
                    <tr>
                      <td>
                        {item.product?.name ?? "Missing product"}
                        <span class="agent-order-products-table__meta">
                          {formatCurrency(unitPrice)} /{" "}
                          {item.product?.unit_label ?? "unit"}
                        </span>
                      </td>
                      <td>
                        {item.quantity} {item.product?.unit_label ?? ""}
                      </td>
                      <td>{item.add_details ?? "N/A"}</td>
                      <td>{formatCurrency(item.quantity * unitPrice)}</td>
                      <td>{formatCurrency(item.agent_commission_amount)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </div>

    <div class="record-section">
      <h2 class="section-line-heading">
        <span class="section-line-heading__line" aria-hidden="true"></span>
        <span class="section-line-heading__label">Customers</span>
        <span class="section-line-heading__line" aria-hidden="true"></span>
      </h2>
      {
        agentOrder.customer_order.length === 0 ? (
          <p class="empty-state">No customer orders have been attached yet.</p>
        ) : (
          <form
            method="post"
            class="agent-payment-bulk-form"
            data-agent-payment-bulk-form
          >
            <input
              type="hidden"
              name="action"
              value="record-agent-payment-distribution"
            />
            <div data-selected-payment-order-inputs hidden></div>

            <div class="agent-payment-bulk-panel">
              <label>
                <span>Total received</span>
                <input
                  type="number"
                  name="amount"
                  min="0.01"
                  step="0.01"
                  required
                />
              </label>
              <label>
                <span>Method</span>
                <select
                  name="paymentMethod"
                  required
                >
                  <option value="">Select method</option>
                  <option value="Cash">Cash</option>
                  <option value="Check">Check</option>
                </select>
              </label>
              <label>
                <span>Payment Terms</span>
                <select name="paymentTerms" required>
                  <option value="">Select payment terms</option>
                  <option value="Cash on Delivery (COD)">Cash on Delivery (COD)</option>
                  <option value="Bank Transfer">Bank Transfer</option>
                  <option value="Gcash">Gcash</option>
                </select>
              </label>
              <label>
                <span>Date</span>
                <input
                  type="date"
                  name="paymentDate"
                  value={todayDate}
                  required
                />
              </label>
              <label>
                <span>Reference</span>
                <input type="text" name="referenceNumber" />
              </label>
              <label class="agent-payment-bulk-panel__notes">
                <span>Notes</span>
                <textarea name="notes" rows="2"></textarea>
              </label>
              <button type="submit">Record selected payments</button>
            </div>

            <div class="order-record-table-wrap">
              <table class="agent-customers-table agent-order-customer-orders-table">
                <thead>
                  <tr>
                    <th scope="col">Select</th>
                    <th scope="col">Customer</th>
                    <th scope="col">Date</th>
                    <th scope="col">Source</th>
                    <th scope="col">Order Status</th>
                    <th scope="col">Payment Status</th>
                    <th scope="col">Total amount</th>
                    <th scope="col">Agent received</th>
                    <th scope="col">Action</th>
                  </tr>
                </thead>
                <tbody>
                  {agentOrder.customer_order.map((order) => {
                    const invoice = order.invoice[0];
                    const orderAmount = orderTotal(
                      order,
                      invoice ? "final_quantity" : "partial_quantity",
                    );
                    const orderPaid = orderPaymentTotal(order);
                    const pendingAgentReceived = pendingAgentPaymentTotal(order);
                    const remainingBalance = Math.max(
                      orderAmount - orderPaid - pendingAgentReceived,
                      0,
                    );
                    const canRecordPayment = remainingBalance > 0;

                    return (
                      <tr>
                        <td>
                          <input
                            type="checkbox"
                            value={order.id}
                            data-payment-order-checkbox
                            disabled={!canRecordPayment}
                            aria-label={`Select ${order.customer ? fullName(order.customer) : "guest order"}`}
                          />
                        </td>
                        <td>
                          {order.customer ? fullName(order.customer) : "Guest"}
                        </td>
                        <td>{formatDate(order.created_at)}</td>
                        <td>{formatOrderSource(order.source)}</td>
                        <td>
                          <StatusBadge
                            kind="order"
                            status={order.order_status}
                            label={autoCapitalize(order.order_status)}
                          />
                        </td>
                        <td>
                          <StatusBadge
                            kind="payment"
                            status={order.payment_status}
                            label={autoCapitalize(order.payment_status)}
                          />
                        </td>
                        <td>
                          <span class="amount-ratio">
                            <span class="amount-ratio__paid">
                              {formatCurrency(orderPaid)}
                            </span>
                            <span class="amount-ratio__total">
                              /{formatAmountValue(orderAmount)}
                            </span>
                          </span>
                        </td>
                        <td>
                          <span class="agent-received-payment">
                            <strong>{formatCurrency(pendingAgentReceived)}</strong>
                            <span>Pending admin confirmation</span>
                          </span>
                        </td>
                        <td>
                          <ViewButton href={`/agent/orders/${order.id}`} />
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </form>
        )
      }
    </div>
  </div>
</AgentRecordPageLayout>

<script>
  const bulkPaymentForm = document.querySelector<HTMLFormElement>(
    "[data-agent-payment-bulk-form]",
  );

  if (bulkPaymentForm) {
    const selectedOrderInputContainer = bulkPaymentForm.querySelector<HTMLElement>(
      "[data-selected-payment-order-inputs]",
    );
    const orderCheckboxes = Array.from(
      bulkPaymentForm.querySelectorAll<HTMLInputElement>(
        "[data-payment-order-checkbox]",
      ),
    );
    const selectedOrderIds: string[] = [];

    const syncSelectedOrderInputs = () => {
      if (!selectedOrderInputContainer) return;

      selectedOrderInputContainer.replaceChildren(
        ...selectedOrderIds.map((orderId) => {
          const input = document.createElement("input");
          input.type = "hidden";
          input.name = "orderId";
          input.value = orderId;
          return input;
        }),
      );
    };

    orderCheckboxes.forEach((checkbox) => {
      checkbox.addEventListener("change", () => {
        const existingIndex = selectedOrderIds.indexOf(checkbox.value);

        if (checkbox.checked && existingIndex === -1) {
          selectedOrderIds.push(checkbox.value);
        }

        if (!checkbox.checked && existingIndex !== -1) {
          selectedOrderIds.splice(existingIndex, 1);
        }

        syncSelectedOrderInputs();
      });
    });
  }
</script>

<style>
  .agent-record-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 100%;
  }

  .record-heading-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.45rem;
  }

  .assigned-summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .detail-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border: 1px solid rgba(17, 24, 39, 0.08);
    border-radius: 1rem;
    background: linear-gradient(135deg, #ffffff 0%, #fff7f7 100%);
    padding: 1rem;
  }

  .detail-field-label {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-brand-muted-black);
    text-transform: none;
    letter-spacing: normal;
  }

  .detail-field-value {
    font-size: 1.35rem;
    line-height: 1.15;
    color: #111827;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .amount-ratio {
    display: inline-flex;
    align-items: baseline;
    gap: 0;
    white-space: nowrap;
  }

  .amount-ratio__paid {
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
  }

  .amount-ratio__total {
    font-size: 0.78em;
    font-weight: 500;
    color: #9ca3af;
  }

  .record-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-line-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    padding: 1.35rem 0;
    font-size: 0.95rem;
    font-weight: 500;
    color: rgba(17, 24, 39, 0.42);
  }

  .section-line-heading__line {
    flex: 1;
    height: 1px;
    background: rgba(17, 24, 39, 0.12);
  }

  .section-line-heading__label {
    flex-shrink: 0;
    white-space: nowrap;
    color: rgba(17, 24, 39, 0.45);
  }

  .order-record-table-wrap {
    overflow-x: auto;
    border: 1px solid #d1d5db;
    border-radius: 0.75rem;
  }

  .order-record-table-wrap .agent-customers-table {
    margin: 0;
    border: 0;
  }

  .agent-customers-table {
    table-layout: fixed;
    width: 100%;
  }

  .agent-customers-table th,
  .agent-customers-table td {
    padding: 1.1rem 0.75rem;
    vertical-align: middle;
  }

  .agent-order-products-table {
    min-width: 760px;
  }

  .agent-order-products-table__meta {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.8rem;
    color: var(--color-brand-muted-black);
  }

  .agent-order-customer-orders-table {
    min-width: 1120px;
  }

  .agent-order-customer-orders-table th:first-child,
  .agent-order-customer-orders-table td:first-child {
    width: 4.5rem;
    text-align: center;
  }

  .agent-order-customer-orders-table .amount-ratio {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .agent-order-customer-orders-table .amount-ratio__total {
    font-size: 0.82em;
  }

  .agent-received-payment {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .agent-received-payment strong {
    color: #111827;
    font-size: 0.95rem;
  }

  .agent-received-payment span {
    color: rgba(17, 24, 39, 0.58);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .agent-payment-bulk-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .agent-payment-bulk-panel {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr)) auto;
    gap: 0.8rem;
    align-items: end;
    padding: 1rem;
    border: 1px solid rgba(17, 24, 39, 0.1);
    border-radius: 0.75rem;
    background: #f9fafb;
  }

  .agent-payment-bulk-panel label {
    display: grid;
    gap: 0.3rem;
  }

  .agent-payment-bulk-panel span {
    color: rgba(17, 24, 39, 0.58);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .agent-payment-bulk-panel input,
  .agent-payment-bulk-panel textarea {
    width: 100%;
    min-width: 0;
    border: 1px solid rgba(17, 24, 39, 0.14);
    border-radius: 0.5rem;
    background: #ffffff;
    color: #111827;
    padding: 0.5rem 0.65rem;
    font: inherit;
    font-size: 0.88rem;
  }

  .agent-payment-bulk-panel textarea {
    resize: vertical;
  }

  .agent-payment-bulk-panel__notes {
    grid-column: span 2;
  }

  .agent-payment-bulk-panel button {
    min-height: 2.55rem;
    border: 0;
    border-radius: 0.5rem;
    background: #111827;
    color: #ffffff;
    padding: 0.45rem 0.75rem;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
  }

  .agent-payment-bulk-panel :disabled,
  .agent-order-customer-orders-table input:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .agent-order-customer-orders-table input[type="checkbox"] {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: #111827;
  }

  @media (max-width: 980px) {
    .agent-payment-bulk-panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .agent-payment-bulk-panel__notes {
      grid-column: span 2;
    }

    .agent-payment-bulk-panel button {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .agent-payment-bulk-panel,
    .agent-payment-bulk-panel__notes,
    .agent-payment-bulk-panel button {
      grid-template-columns: 1fr;
      grid-column: auto;
    }
  }
</style>
