---
import AgentCustomers from "@/components/agent/AgentCustomers.astro";
import AgentRecordPageLayout from "@/components/agent/AgentRecordPageLayout.astro";
import { formatAgentActionFeedback } from "@/lib/agent-dashboard/actions";
import { loadAgentDashboardData } from "@/lib/agent-dashboard/data";
import { requireAgentRoute } from "@/lib/agent-dashboard/page";

export const prerender = false;

const agentRoute = await requireAgentRoute(Astro);

if (!agentRoute.ready) {
  return agentRoute.response;
}

const data = await loadAgentDashboardData(Astro, agentRoute.userId);
const feedback = formatAgentActionFeedback(Astro.url);
---

<AgentRecordPageLayout
  title="Agent Customers - JEHMARP"
  description="Customer records for the signed-in agent."
  heading="Customers"
  intro="Review customer records for your agent profile."
  feedback={feedback}
  dashboardData={data}
>
  <AgentCustomers data={data} />
</AgentRecordPageLayout>
