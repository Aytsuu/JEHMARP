---
import AgentRecordPageLayout from "@/components/agent/AgentRecordPageLayout.astro";
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import OrderPdfLinks from "@/components/OrderPdfLinks.astro";
import {
  formatAgentActionFeedback,
  handleAgentDashboardAction,
} from "@/lib/agent-dashboard/actions";
import { loadAgentDashboardData } from "@/lib/agent-dashboard/data";
import { requireAgentRoute } from "@/lib/agent-dashboard/page";
import {
  formatCurrency,
  formatDate,
  fullName,
  orderTotal,
  orderPaymentTotal,
  orderBalance,
  orderExpectedCommission,
  orderEarnedCommission,
} from "@/lib/agent-dashboard/view";
import { autoCapitalize, formatOrderSource } from "@/lib/formatters";

export const prerender = false;

const agentRoute = await requireAgentRoute(Astro);

if (!agentRoute.ready) {
  return agentRoute.response;
}

const { orderId } = Astro.params;

if (!orderId) {
  return Astro.redirect("/agent/orders", 302);
}

if (Astro.request.method === "POST") {
  return handleAgentDashboardAction(
    Astro,
    agentRoute.userId,
    `/agent/orders/${orderId}`,
  );
}

const data = await loadAgentDashboardData(Astro, agentRoute.userId);
const order = data.orders.find((o) => o.id === orderId);

if (!order) {
  return Astro.redirect("/agent/orders", 302);
}

const feedback = formatAgentActionFeedback(Astro.url);
const agentReceivedPayments = order.agent_received_payment ?? [];
const pendingAgentReceivedPayments = agentReceivedPayments.filter(
  (payment) => payment.status === "pending_admin_confirmation",
);
const pendingAgentReceivedTotal = pendingAgentReceivedPayments.reduce(
  (total, payment) => total + payment.amount,
  0,
);
const remainingRecordableBalance = Math.max(
  orderBalance(order) - pendingAgentReceivedTotal,
  0,
);
const canRecordAgentPayment = remainingRecordableBalance > 0;
const todayDate = new Date().toISOString().slice(0, 10);
---

<AgentRecordPageLayout
  title={`Order Details #${order.id.slice(0, 8)} - JEHMARP`}
  description="Agent order detail view, commissions, and PDFs."
  heading="Order Details"
  intro={`Review order items, details, commissions, and generate invoices/slips for Order #${order.id.slice(0, 8)}.`}
  feedback={feedback}
  dashboardData={data}
  backUrl="/agent/orders"
  backLabel="Back to orders"
>
  <div class="dashboard-detail-stack">
    <div class="content-section">
      <h3>Order Information</h3>
      
      <div class="dashboard-detail-grid dashboard-detail-grid--compact">
        <div class="detail-field">
          <span class="detail-field-label">Customer</span>
          <div class="detail-field-value">
            {order.customer ? fullName(order.customer) : "Guest"}
          </div>
        </div>
        
        <div class="detail-field">
          <span class="detail-field-label">Source</span>
          <div class="detail-field-value">
            {formatOrderSource(order.source)}
          </div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Order Status</span>
          <div class="detail-field-value">
            <StatusBadge kind="order" status={order.order_status} label={autoCapitalize(order.order_status)} />
          </div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Payment Status</span>
          <div class="detail-field-value">
            <StatusBadge kind="payment" status={order.payment_status} label={autoCapitalize(order.payment_status)} />
          </div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Order Total</span>
          <div class="detail-field-value">
            {formatCurrency(orderTotal(order, "partial_quantity"))}
          </div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Invoice Total</span>
          <div class="detail-field-value">
            {formatCurrency(orderTotal(order, "final_quantity"))}
          </div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Paid</span>
          <div class="detail-field-value">
            {formatCurrency(orderPaymentTotal(order))}
          </div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Agent Received</span>
          <div class="detail-field-value">
            {formatCurrency(pendingAgentReceivedTotal)}
          </div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Balance</span>
          <div class="detail-field-value">
            {formatCurrency(orderBalance(order))}
          </div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Expected Commission</span>
          <div class="detail-field-value">
            {formatCurrency(orderExpectedCommission(order))}
          </div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Earned Commission</span>
          <div class="detail-field-value">
            {formatCurrency(orderEarnedCommission(order))}
          </div>
        </div>

        <div class="detail-field">
          <span class="detail-field-label">Approved At</span>
          <div class="detail-field-value">
            {formatDate(order.approved_at)}
          </div>
        </div>
      </div>

      <div class="pdf-links-container">
        <OrderPdfLinks
          orderId={order.id}
          basePath="/agent/orders"
          showSalesInvoice={order.invoice.length > 0}
        />
      </div>
    </div>

    <div class="content-section">
      <h3>Order Items</h3>
      <DashboardTableBoard>
        <table class="dashboard-table">
          <thead>
            <tr>
              <th scope="col">Product</th>
              <th scope="col">Quantity</th>
              <th scope="col">Commission</th>
            </tr>
          </thead>
          <tbody>
            {order.customer_order_item.map((item) => (
              <tr>
                <td>
                  {item.product?.name ?? "Missing product"}<br />
                  <span class="dashboard-table__muted-line">
                    {formatCurrency(item.unit_price)} {item.price_type}
                  </span>
                </td>
                <td>
                  {item.partial_quantity}
                </td>
                <td>{formatCurrency(item.agent_commission_amount)} - {item.agent_commission_paid ? "Paid" : "Unpaid"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </DashboardTableBoard>
    </div>

    <div class="content-section">
      <h3>Payment History</h3>
      <form method="post" class="agent-payment-form">
        <input type="hidden" name="action" value="record-agent-payment" />
        <input type="hidden" name="orderId" value={order.id} />
        <div class="agent-payment-form__grid">
          <label>
            <span>Amount</span>
            <input
              type="number"
              name="amount"
              min="0.01"
              step="0.01"
              max={canRecordAgentPayment ? remainingRecordableBalance : undefined}
              value={canRecordAgentPayment ? remainingRecordableBalance.toFixed(2) : undefined}
              disabled={!canRecordAgentPayment}
              required
            />
          </label>
          <label>
            <span>Method</span>
            <select
              name="paymentMethod"
              disabled={!canRecordAgentPayment}
              required
            >
              <option value="">Select method</option>
              <option value="Cash">Cash</option>
              <option value="Check">Check</option>
            </select>
          </label>
          <label>
            <span>Payment Terms</span>
            <select
              name="paymentTerms"
              disabled={!canRecordAgentPayment}
              required
            >
              <option value="">Select payment terms</option>
              <option value="Cash on Delivery (COD)">Cash on Delivery (COD)</option>
              <option value="Bank Transfer">Bank Transfer</option>
              <option value="Gcash">Gcash</option>
            </select>
          </label>
          <label>
            <span>Date</span>
            <input
              type="date"
              name="paymentDate"
              value={todayDate}
              disabled={!canRecordAgentPayment}
              required
            />
          </label>
          <label>
            <span>Reference</span>
            <input
              type="text"
              name="referenceNumber"
              disabled={!canRecordAgentPayment}
            />
          </label>
        </div>
        <label class="agent-payment-form__notes">
          <span>Notes</span>
          <textarea
            name="notes"
            rows="2"
            disabled={!canRecordAgentPayment}
          ></textarea>
        </label>
        <button type="submit" disabled={!canRecordAgentPayment}>
          Submit for admin confirmation
        </button>
      </form>
      {pendingAgentReceivedPayments.length > 0 && (
        <ul class="compact-list dashboard-payment-list agent-received-list">
          {pendingAgentReceivedPayments.map((payment) => (
            <li>
              <span>
                {payment.payment_method} - {payment.payment_terms} on {formatDate(payment.payment_date)}
                {" - pending admin confirmation"}
              </span>
              <strong>{formatCurrency(payment.amount)}</strong>
            </li>
          ))}
        </ul>
      )}
      {order.payment.length === 0 ? (
        <p class="empty-state">No payments recorded.</p>
      ) : (
        <ul class="compact-list dashboard-payment-list">
          {order.payment.map((payment) => (
            <li>
              <span>{payment.payment_method} - {payment.payment_terms} on {formatDate(payment.payment_date)}</span>
              <strong>{formatCurrency(payment.amount)}</strong>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</AgentRecordPageLayout>

<style>
  .agent-payment-form {
    display: grid;
    gap: 0.85rem;
    margin-bottom: 1rem;
    padding: 1rem;
    border: 1px solid rgba(17, 24, 39, 0.1);
    border-radius: 0.9rem;
    background: #f9fafb;
  }

  .agent-payment-form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .agent-payment-form label {
    display: grid;
    gap: 0.35rem;
  }

  .agent-payment-form span {
    color: rgba(17, 24, 39, 0.58);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .agent-payment-form input,
  .agent-payment-form textarea {
    width: 100%;
    min-width: 0;
    border: 1px solid rgba(17, 24, 39, 0.14);
    border-radius: 0.55rem;
    background: #ffffff;
    color: #111827;
    padding: 0.6rem 0.75rem;
    font: inherit;
  }

  .agent-payment-form textarea {
    resize: vertical;
  }

  .agent-payment-form button {
    justify-self: end;
    min-height: 2.45rem;
    border: 0;
    border-radius: 0.55rem;
    background: #111827;
    color: #ffffff;
    padding: 0.5rem 0.85rem;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
  }

  .agent-payment-form :disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .agent-received-list {
    margin-bottom: 1rem;
  }

  @media (max-width: 720px) {
    .agent-payment-form__grid {
      grid-template-columns: 1fr;
    }

    .agent-payment-form button {
      justify-self: stretch;
    }
  }
</style>
