---
import AgentMultiCustomerOrderDetail from "@/components/agent/AgentMultiCustomerOrderDetail.astro";
import AgentRecordPageLayout from "@/components/agent/AgentRecordPageLayout.astro";
import { formatAgentActionFeedback } from "@/lib/agent-dashboard/actions";
import { loadAgentDashboardData } from "@/lib/agent-dashboard/data";
import { requireAgentRoute } from "@/lib/agent-dashboard/page";
import {
  agentOrderCommissionTotal,
  agentOrderRemittanceTotal,
  agentOrderTotal,
  orderPaymentTotal,
} from "@/lib/agent-dashboard/view";
import {
  buildAttachCustomerProductOptions,
  canAttachCustomerToAgentOrder,
} from "@/lib/agent-order-distribution";
import { manilaDateInputValue, manilaTimeInputValue } from "@/lib/datetime";
import { formatOrderCode } from "@/lib/order-detail-nav";

export const prerender = false;

const orderDetailTabIds = ["products", "customers"] as const;
type OrderDetailTabId = (typeof orderDetailTabIds)[number];

const agentRoute = await requireAgentRoute(Astro);

if (!agentRoute.ready) {
  return agentRoute.response;
}

const { orderId } = Astro.params;

if (!orderId) {
  return Astro.redirect("/agent/orders", 302);
}

const data = await loadAgentDashboardData(Astro, agentRoute.userId);
const agentOrder = data.agentOrders.find((order) => order.id === orderId);

if (!agentOrder) {
  return Astro.redirect("/agent/orders", 302);
}

const feedback = formatAgentActionFeedback(Astro.url);
const canAttachCustomer = canAttachCustomerToAgentOrder(agentOrder);
const totalAmount = agentOrderTotal(agentOrder);
const totalPaid = agentOrder.customer_order.reduce(
  (sum, order) => sum + orderPaymentTotal(order),
  0,
);
const totalCommission = agentOrderCommissionTotal(agentOrder);
const totalRemittance = agentOrderRemittanceTotal(agentOrder);
const remittanceBalance = Math.max(totalRemittance - totalPaid, 0);
const canRecordRemittance = remittanceBalance > 0 && agentOrder.order_status !== "pending_order";
const attachCustomerProducts = buildAttachCustomerProductOptions({
  agentOrder,
  products: data.products,
});
const agentOrderCode = formatOrderCode(agentOrder.id);
const todayDate = manilaDateInputValue();
const todayTime = manilaTimeInputValue();
const productCount = agentOrder.agent_order_item.length;
const customerCount = agentOrder.customer_order.length;
const requestedOrderDetailTab = Astro.url.searchParams.get("tab");

const orderStatusCounts = agentOrder.customer_order.reduce(
  (counts, order) => {
    if (order.order_status === "pending") {
      counts.pending += 1;
      return counts;
    }

    if (order.payment_status === "paid") {
      counts.paid += 1;
      return counts;
    }

    if (order.payment_status === "partial") {
      counts.partial += 1;
      return counts;
    }

    counts.unpaid += 1;
    return counts;
  },
  { pending: 0, unpaid: 0, partial: 0, paid: 0 },
);

function isOrderDetailTabActive(tab: OrderDetailTabId) {
  return (
    requestedOrderDetailTab &&
    orderDetailTabIds.includes(requestedOrderDetailTab as OrderDetailTabId)
  )
    ? requestedOrderDetailTab === tab
    : tab === "products";
}
---

<AgentRecordPageLayout
  title={`${agentOrderCode} - JEHMARP`}
  description="Agent distribution order details."
  heading={agentOrderCode}
  backUrl="/agent/orders"
  backLabel="Back to orders"
  feedback={feedback}
  dashboardData={data}
>
  <AgentMultiCustomerOrderDetail
    agentOrder={agentOrder}
    agentOrderCode={agentOrderCode}
    productCount={productCount}
    customerCount={customerCount}
    paid={totalPaid}
    commission={totalCommission}
    grossTotal={totalAmount}
    receivable={totalRemittance}
    remittanceBalance={remittanceBalance}
    orderStatusCounts={orderStatusCounts}
    canAttachCustomer={canAttachCustomer}
    canRecordRemittance={canRecordRemittance}
    attachCustomerProducts={attachCustomerProducts}
    todayDate={todayDate}
    todayTime={todayTime}
    isOrderDetailTabActive={isOrderDetailTabActive}
  />
</AgentRecordPageLayout>
