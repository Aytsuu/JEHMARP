---
import AgentRecordPageLayout from "@/components/agent/AgentRecordPageLayout.astro";
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import ViewButton from "@/components/ViewButton.astro";
import { formatAgentActionFeedback } from "@/lib/agent-dashboard/actions";
import { loadAgentDashboardData } from "@/lib/agent-dashboard/data";
import { requireAgentRoute } from "@/lib/agent-dashboard/page";
import {
  formatCurrency,
  formatDate,
  fullName,
  orderTotal,
} from "@/lib/agent-dashboard/view";
import { formatOrderSource } from "@/lib/formatters";

export const prerender = false;

const agentRoute = await requireAgentRoute(Astro);

if (!agentRoute.ready) {
  return agentRoute.response;
}

const { customerId } = Astro.params;
const data = await loadAgentDashboardData(Astro, agentRoute.userId);
const customer = data.customers.find((c) => c.id === customerId);

if (!customer) {
  return Astro.redirect("/agent/customers", 302);
}

const customerOrders = data.orders.filter((order) => order.customer_id === customerId);
const pendingOrders = customerOrders.filter((order) => order.order_status !== "closed");
const historicalOrders = customerOrders.filter((order) => order.order_status === "closed");
const feedback = formatAgentActionFeedback(Astro.url);
---

<AgentRecordPageLayout
  title={`Customer Details - ${fullName(customer)} - JEHMARP`}
  description="Agent customer detail record, pending orders, and historical summary."
  heading={`Customer Record: ${fullName(customer)}`}
  intro={`Review detailed profile contact details, reseller attributes, pending workflow orders, and order history.`}
  feedback={feedback}
  dashboardData={data}
  backUrl="/agent/customers"
  backLabel="Back to customers"
>
  <div class="dashboard-detail-stack">
  <div class="dashboard-detail-grid">
    <div class="content-section">
      <h3>Customer Profile</h3>
      <dl class="detail-list">
        <dt>Name</dt>
        <dd>{fullName(customer)}</dd>
        <dt>Phone number</dt>
        <dd>{customer.phone_number}</dd>
        <dt>Email</dt>
        <dd>{customer.email ?? "No email"}</dd>
        <dt>Type</dt>
        <dd>{customer.is_reseller ? "Reseller Customer" : "Retail Customer"}</dd>
        <dt>Billing Address</dt>
        <dd class="detail-list__preline">{customer.address}</dd>
      </dl>
    </div>

    <div class="content-section">
      <h3>Orders Summary</h3>
      <dl class="detail-list">
        <dt>Total orders</dt>
        <dd>{customerOrders.length}</dd>
        <dt>Pending orders</dt>
        <dd>{pendingOrders.length}</dd>
        <dt>Historical orders</dt>
        <dd>{historicalOrders.length}</dd>
      </dl>
    </div>
  </div>

  <div class="content-section">
    <h3>Pending Orders ({pendingOrders.length})</h3>
    {pendingOrders.length === 0 ? (
      <p class="empty-state">No pending orders found for this customer.</p>
    ) : (
      <DashboardTableBoard>
        <table class="dashboard-table">
          <thead>
            <tr>
              <th scope="col">Order Date</th>
              <th scope="col">Source</th>
              <th scope="col">Order Status</th>
              <th scope="col">Payment Status</th>
              <th scope="col">Total</th>
              <th scope="col">Action</th>
            </tr>
          </thead>
          <tbody>
            {pendingOrders.map((order) => {
              const invoice = order.invoice.length > 0;
              const total = orderTotal(order, invoice ? "final_quantity" : "partial_quantity");
              return (
                <tr>
                  <td>{formatDate(order.created_at)}</td>
                  <td>{formatOrderSource(order.source)}</td>
                  <td><StatusBadge kind="order" status={order.order_status} /></td>
                  <td><StatusBadge kind="payment" status={order.payment_status} /></td>
                  <td>{formatCurrency(total)}</td>
                  <td>
                    <ViewButton href={`/agent/orders/${order.id}`} />
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </DashboardTableBoard>
    )}
  </div>

  <div class="content-section">
    <h3>Historical & Closed Orders ({historicalOrders.length})</h3>
    {historicalOrders.length === 0 ? (
      <p class="empty-state">No historical or closed orders found for this customer.</p>
    ) : (
      <DashboardTableBoard>
        <table class="dashboard-table">
          <thead>
            <tr>
              <th scope="col">Order Date</th>
              <th scope="col">Source</th>
              <th scope="col">Order Status</th>
              <th scope="col">Payment Status</th>
              <th scope="col">Total</th>
              <th scope="col">Action</th>
            </tr>
          </thead>
          <tbody>
            {historicalOrders.map((order) => {
              const invoice = order.invoice.length > 0;
              const total = orderTotal(order, invoice ? "final_quantity" : "partial_quantity");
              return (
                <tr>
                  <td>{formatDate(order.created_at)}</td>
                  <td>{formatOrderSource(order.source)}</td>
                  <td><StatusBadge kind="order" status={order.order_status} /></td>
                  <td><StatusBadge kind="payment" status={order.payment_status} /></td>
                  <td>{formatCurrency(total)}</td>
                  <td>
                    <ViewButton href={`/agent/orders/${order.id}`} />
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </DashboardTableBoard>
    )}
  </div>
  </div>
</AgentRecordPageLayout>
