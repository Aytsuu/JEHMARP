---
import AgentAccountProfile from "@/components/agent/AgentAccountProfile.astro";
import AgentRecordPageLayout from "@/components/agent/AgentRecordPageLayout.astro";
import AgentProfileMenu from "@/components/agent/AgentProfileMenu.astro";
import { formatAgentActionFeedback } from "@/lib/agent-dashboard/actions";
import { loadAgentDashboardData } from "@/lib/agent-dashboard/data";
import { requireAgentRoute } from "@/lib/agent-dashboard/page";

export const prerender = false;

const agentRoute = await requireAgentRoute(Astro);

if (!agentRoute.ready) {
  return agentRoute.response;
}

const data = await loadAgentDashboardData(Astro, agentRoute.userId);
const feedback = formatAgentActionFeedback(Astro.url);
---

<AgentRecordPageLayout
  title="Agent Profile - JEHMARP"
  description="Manage earnings and account access."
  heading="Profile"
  feedback={feedback}
  dashboardData={data}
>
  <div class="agent-profile-page">
    <AgentAccountProfile agent={data.agent} />
    <AgentProfileMenu />
  </div>
</AgentRecordPageLayout>

<style>
  .agent-profile-page {
    display: grid;
    gap: 0.85rem;
    width: 100%;
    max-width: 40rem;
    min-width: 0;
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .agent-profile-page {
      gap: 1rem;
    }
  }

  @media (min-width: 768px) {
    .agent-profile-page {
      gap: 1.05rem;
    }
  }

  @media (min-width: 1024px) {
    .agent-profile-page {
      gap: 1.15rem;
    }
  }
</style>
