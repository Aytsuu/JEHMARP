---
import type { NavigationItem } from "@/config/navigation";
import {
  getDashboardRouteStatuses,
  getPageStatusLabel,
} from "@/lib/page-availability";
import Sheet from "@/components/ui/Sheet.astro";
import "@/styles/global.css";

type Props = {
  title: string;
  description: string;
  navLabel: string;
  navItems: readonly NavigationItem[];
  sidebarUnreadBadges?: Record<
    string,
    | {
        count: number;
      }
    | {
        ids: readonly string[];
        storageKey: string;
      }
  >;
};

const { title, description, navLabel, sidebarUnreadBadges = {} } = Astro.props;
const isAdmin = Astro.url.pathname.startsWith("/admin");
const routeStatuses = getDashboardRouteStatuses();

type GroupedNavItem = {
  label: string;
  href: string;
  icon: string;
  isAction?: boolean;
};

type CategoryGroup = {
  title: string;
  items: GroupedNavItem[];
};

const categories: CategoryGroup[] = isAdmin
  ? [
      {
        title: "Core Operations",
        items: [
          {
            label: "Dashboard",
            href: "/admin",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>`,
          },
          {
            label: "Products",
            href: "/admin/products",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>`,
          },
          {
            label: "Orders",
            href: "/admin/orders",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>`,
          },
          {
            label: "Invoices",
            href: "/admin/invoices",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>`,
          },
        ],
      },
      {
        title: "Users & Relations",
        items: [
          {
            label: "Customers",
            href: "/admin/customers",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
          },
          {
            label: "Agents",
            href: "/admin/agents",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>`,
          },
          {
            label: "Reseller Requests",
            href: "/admin/reseller-applications",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>`,
          },
        ],
      },
      {
        title: "Management & Logs",
        items: [
          {
            label: "Inquiries",
            href: "/admin/inquiries",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>`,
          },
          {
            label: "Activity",
            href: "/admin/activity",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`,
          },
          {
            label: "Notifications",
            href: "/admin/notifications",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>`,
          },
          {
            label: "Content",
            href: "/admin/content",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4z"></path></svg>`,
          },
          {
            label: "Settings",
            href: "/admin/settings",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>`,
          },
          {
            label: "Logout",
            href: "/api/logout",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>`,
            isAction: true,
          },
        ],
      },
    ]
  : [
      {
        title: "My Sales",
        items: [
          {
            label: "Dashboard",
            href: "/agent",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>`,
          },
          {
            label: "Customers",
            href: "/agent/customers",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
          },
          {
            label: "Orders",
            href: "/agent/orders",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>`,
          },
        ],
      },
      {
        title: "Finances & Alerts",
        items: [
          {
            label: "Earnings",
            href: "/agent/earnings",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>`,
          },
          {
            label: "Payments",
            href: "/agent/payments",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>`,
          },
          {
            label: "Notifications",
            href: "/agent/notifications",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>`,
          },
          {
            label: "Settings",
            href: "/agent/settings",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>`,
          },
          {
            label: "Logout",
            href: "/api/logout",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>`,
            isAction: true,
          },
        ],
      },
    ];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="dashboard-body">
    <div class="dashboard-frame">
      <aside
        class="dashboard-sidebar"
        aria-labelledby="dashboard-sidebar-title"
      >
        <a class="dashboard-sidebar__brand" href="/">
          <span class="site-nav__brand-mark" aria-hidden="true">Logo</span>
          <span>JEHMARP</span>
        </a>
        <nav class="dashboard-sidebar__nav" aria-label={navLabel}>
          <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            {
              categories.map((group) => (
                <div
                  class="sidebar-category-group"
                  style="display: flex; flex-direction: column; gap: 0.5rem;"
                >
                  <span
                    class="sidebar-category-title"
                    style="font-size: 0.725rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-brand-muted-black); opacity: 0.7; padding-left: 0.5rem;"
                  >
                    {group.title}
                  </span>
                  <ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.25rem;">
                    {group.items.map((item) => {
                      const isCurrent =
                        Astro.url.pathname === item.href ||
                        (item.href !== "/admin" &&
                          item.href !== "/agent" &&
                          Astro.url.pathname.startsWith(item.href));
                      const unreadBadge = sidebarUnreadBadges[item.href];
                      const routeStatus = routeStatuses[item.href];
                      const showRouteStatus =
                        routeStatus && routeStatus.status !== "ready";
                      const routeStatusLabel = routeStatus
                        ? getPageStatusLabel(routeStatus.status)
                        : "";
                      const routeStatusIcon = routeStatus?.status === "maintenance"
                        ? `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.66 5.66l-6.36 6.36a2 2 0 0 0 2.83 2.83l6.36-6.36a4 4 0 0 0 5.66-5.66l-2.12 2.12-2.83-2.83 2.12-2.12z"></path></svg>`
                        : `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>`;
                      return (
                        <li>
                          {item.isAction ? (
                            <form
                              class="dashboard-sidebar__logout-form"
                              method="post"
                              action={item.href}
                              style="margin: 0; padding: 0;"
                            >
                              <button type="submit">
                                <span class="dashboard-sidebar__nav-link-content">
                                  <span
                                    class="nav-icon-wrapper"
                                    style="display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;"
                                    set:html={item.icon}
                                  />
                                  <span>{item.label}</span>
                                </span>
                              </button>
                            </form>
                          ) : (
                            <a href={item.href} class={isCurrent ? "active" : ""}>
                              <span class="dashboard-sidebar__nav-link-content">
                                <span
                                  class="nav-icon-wrapper"
                                  style="display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;"
                                  set:html={item.icon}
                                />
                                <span>{item.label}</span>
                              </span>
                              {
                                showRouteStatus && (
                                  <span
                                    class={`dashboard-sidebar__status dashboard-sidebar__status--${routeStatus.status}`}
                                    aria-label={`${item.label} status: ${routeStatusLabel}`}
                                    title={`${item.label}: ${routeStatusLabel}`}
                                    set:html={routeStatusIcon}
                                  />
                                )
                              }
                              {
                                unreadBadge &&
                                  ("count" in unreadBadge
                                    ? unreadBadge.count > 0
                                    : unreadBadge.ids.length > 0) && (
                                  <span
                                    class="dashboard-sidebar__nav-badge"
                                    data-sidebar-unread-badge={
                                      "count" in unreadBadge ? undefined : true
                                    }
                                    data-storage-key={
                                      "count" in unreadBadge
                                        ? undefined
                                        : unreadBadge.storageKey
                                    }
                                    data-unread-ids={
                                      "count" in unreadBadge
                                        ? undefined
                                        : JSON.stringify(unreadBadge.ids)
                                    }
                                    aria-label={`${item.label} unread count`}
                                  >
                                    {"count" in unreadBadge
                                      ? unreadBadge.count
                                      : unreadBadge.ids.length}
                                  </span>
                                )
                              }
                            </a>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))
            }
          </div>
        </nav>
      </aside>
      <main class="dashboard-main">
        <slot />
      </main>
    </div>

    <!-- Drawer Sheet Component -->
    <Sheet header="Manage" content="" />

    <div class="cell-popover" id="cell-popover" aria-hidden="true">
      <div class="cell-popover__card">
        <header class="cell-popover__header">
          <h3 class="cell-popover__title">Edit</h3>
          <button
            type="button"
            class="cell-popover__close"
            data-close-cell-popover
            aria-label="Close popover"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line
                x1="6"
                y1="6"
                x2="18"
                y2="18"></line></svg
            >
          </button>
        </header>
        <div class="cell-popover__body" data-cell-popover-body></div>
      </div>
    </div>

    <script>
      function initSidebarUnreadBadges() {
        const badges = document.querySelectorAll<HTMLElement>(
          "[data-sidebar-unread-badge]",
        );

        badges.forEach((badge) => {
          const storageKey = badge.dataset.storageKey;
          const rawIds = badge.dataset.unreadIds;
          if (!storageKey || !rawIds) return;

          let notificationIds: string[];
          let readIds: string[];

          try {
            const parsedIds = JSON.parse(rawIds);
            notificationIds = Array.isArray(parsedIds)
              ? parsedIds.filter((value): value is string => typeof value === "string")
              : [];
          } catch {
            notificationIds = [];
          }

          try {
            const parsedReadIds = JSON.parse(localStorage.getItem(storageKey) || "[]");
            readIds = Array.isArray(parsedReadIds)
              ? parsedReadIds.filter((value): value is string => typeof value === "string")
              : [];
          } catch {
            readIds = [];
          }

          const unreadCount = notificationIds.filter((id) => !readIds.includes(id)).length;
          badge.textContent = String(unreadCount);
          badge.hidden = unreadCount < 1;
        });

        (
          window as Window & { updateSidebarUnreadBadges?: () => void }
        ).updateSidebarUnreadBadges = initSidebarUnreadBadges;
      }

      function initDrawerSheets() {
        const drawer = document.querySelector<HTMLElement>("#drawer-sheet");
        const drawerBody =
          drawer?.querySelector<HTMLElement>("[data-drawer-body]");
        const closeButtons = document.querySelectorAll("[data-close-drawer]");
        const openButtons = document.querySelectorAll("[data-open-sheet]");

        if (!drawer || !drawerBody) return;

        let currentFormParent: HTMLElement | null = null;
        let currentForm: HTMLFormElement | null = null;
        const rootElement = document.documentElement;
        const bodyElement = document.body;

        function syncScrollLock(isOpen: boolean) {
          rootElement.classList.toggle("sheet-open", isOpen);
          bodyElement.classList.toggle("sheet-open", isOpen);
        }

        function closeDrawer(targetDrawer?: HTMLElement | null) {
          const drawerToClose = targetDrawer ?? document.querySelector<HTMLElement>(".drawer-sheet--open");
          if (!drawerToClose) return;

          drawerToClose.classList.remove("drawer-sheet--open");
          drawerToClose.setAttribute("aria-hidden", "true");

          if (drawer && drawerBody && drawerToClose === drawer) {
            if (currentForm && currentFormParent) {
              currentFormParent.appendChild(currentForm);
            }
            currentForm = null;
            currentFormParent = null;
          }

          if (!document.querySelector(".drawer-sheet--open")) {
            syncScrollLock(false);
          }
        }

        function openDrawer(targetDrawer: HTMLElement) {
          targetDrawer.classList.add("drawer-sheet--open");
          targetDrawer.setAttribute("aria-hidden", "false");
          syncScrollLock(true);
        }

        // Handle Edit/Manage row buttons
        openButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            // Close any open drawer first
            closeDrawer();

            const parentTd = btn.closest("td");
            if (!parentTd) return;

            const holder = parentTd.querySelector<HTMLElement>(
              ".hidden-form-holder",
            );
            const form = holder?.querySelector<HTMLFormElement>("form");
            if (!holder || !form) return;

            currentFormParent = holder;
            currentForm = form;

            // Move the form element to the drawer content
            drawerBody.appendChild(form);

            // Dynamically set title based on the row context
            const row = btn.closest("tr");
            const rowTitle =
              row?.querySelector("strong")?.textContent ||
              row?.querySelector("td")?.textContent ||
              "Manage";
            const drawerTitle = drawer.querySelector(".drawer-sheet__title");
            if (drawerTitle) {
              drawerTitle.textContent = `Manage: ${rowTitle.trim().split("\n")[0]}`;
            }

            openDrawer(drawer);
          });
        });

        // Handle Create form panel buttons
        const openCreateButtons = document.querySelectorAll(
          "[data-open-create-sheet]",
        );
        openCreateButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            closeDrawer();

            const targetSelector = btn.getAttribute("data-sheet-target");
            const targetDrawer = targetSelector
              ? document.querySelector<HTMLElement>(targetSelector)
              : null;

            if (targetDrawer) {
              const targetTitle = btn.getAttribute("data-sheet-title");
              const titleElement = targetDrawer.querySelector<HTMLElement>("[data-sheet-title]");
              if (targetTitle && titleElement) {
                titleElement.textContent = targetTitle;
              }
              openDrawer(targetDrawer);
              return;
            }

            const parentPanel = btn.closest(".admin-panel");
            const holder = parentPanel?.querySelector<HTMLElement>(
              ".hidden-create-form-holder",
            );
            const form = holder?.querySelector<HTMLFormElement>("form");
            if (!holder || !form || !drawer || !drawerBody) return;

            currentFormParent = holder;
            currentForm = form;
            drawerBody.appendChild(form);

            const drawerTitle = drawer.querySelector(".drawer-sheet__title");
            if (drawerTitle) {
              drawerTitle.textContent = btn.textContent?.trim() || "Create";
            }

            openDrawer(drawer);
          });
        });

        closeButtons?.forEach((btn) => {
          btn.addEventListener("click", () => {
            closeDrawer(btn.closest<HTMLElement>(".drawer-sheet"));
          });
        });

        // Close on escape key
        document.addEventListener("keydown", (e) => {
          if (
            e.key === "Escape" &&
            document.querySelector(".drawer-sheet--open")
          ) {
            closeDrawer();
          }
        });
      }

      function initCellPopovers() {
        const popover = document.querySelector<HTMLElement>("#cell-popover");
        const popoverCard = popover?.querySelector<HTMLElement>(".cell-popover__card");
        const popoverBody = popover?.querySelector<HTMLElement>("[data-cell-popover-body]");
        const popoverTitle = popover?.querySelector<HTMLElement>(".cell-popover__title");
        const closePopoverButton = popover?.querySelector<HTMLElement>("[data-close-cell-popover]");
        const triggerButtons = document.querySelectorAll<HTMLElement>("[data-open-cell-popover]");

        if (!popover || !popoverCard || !popoverBody || !popoverTitle) return;

        const activePopover = popover;
        const activePopoverCard = popoverCard;
        const activePopoverBody = popoverBody;
        const activePopoverTitle = popoverTitle;

        let currentHolder: HTMLElement | null = null;
        let currentContent: HTMLElement | null = null;
        let currentTrigger: HTMLElement | null = null;

        function positionPopover(trigger: HTMLElement) {
          const rect = trigger.getBoundingClientRect();
          const margin = 12;
          const viewportWidth = window.innerWidth;
          const viewportHeight = window.innerHeight;
          const cardRect = activePopoverCard.getBoundingClientRect();

          let left = rect.left;
          let top = rect.bottom + 8;

          if (left + cardRect.width + margin > viewportWidth) {
            left = viewportWidth - cardRect.width - margin;
          }

          if (left < margin) {
            left = margin;
          }

          if (top + cardRect.height + margin > viewportHeight) {
            top = rect.top - cardRect.height - 8;
          }

          if (top < margin) {
            top = margin;
          }

          activePopoverCard.style.left = `${left}px`;
          activePopoverCard.style.top = `${top}px`;
        }

        function closePopover() {
          if (currentContent && currentHolder) {
            currentHolder.appendChild(currentContent);
          }

          activePopover.classList.remove("cell-popover--open");
          activePopover.setAttribute("aria-hidden", "true");
          activePopoverBody.innerHTML = "";
          currentHolder = null;
          currentContent = null;
          currentTrigger = null;
        }

        triggerButtons.forEach((button) => {
          button.addEventListener("click", (event) => {
            event.preventDefault();
            event.stopPropagation();

            const holder = button.parentElement?.querySelector<HTMLElement>(
              ".hidden-popover-form-holder",
            );
            const content = holder?.firstElementChild as HTMLElement | null;

            if (!holder || !content) return;

            if (currentContent) {
              closePopover();
            }

            currentHolder = holder;
            currentContent = content;
            currentTrigger = button;

            activePopoverTitle.textContent = button.dataset.popoverTitle || "Edit";
            activePopoverBody.appendChild(content);
            activePopover.classList.add("cell-popover--open");
            activePopover.setAttribute("aria-hidden", "false");
            positionPopover(button);
          });
        });

        closePopoverButton?.addEventListener("click", closePopover);

        document.addEventListener("click", (event) => {
          const target = event.target as Node;
          if (!activePopover.classList.contains("cell-popover--open")) return;
          if (activePopoverCard.contains(target)) return;
          if (currentTrigger?.contains(target)) return;
          closePopover();
        });

        window.addEventListener("resize", () => {
          if (currentTrigger && activePopover.classList.contains("cell-popover--open")) {
            positionPopover(currentTrigger);
          }
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && activePopover.classList.contains("cell-popover--open")) {
            closePopover();
          }
        });
      }

      function initInteractiveTables() {
        const interactiveTables = document.querySelectorAll<HTMLElement>(
          "[data-interactive-table]",
        );
        interactiveTables.forEach((container) => {
          const tableGeneration = String(
            Number(container.dataset.interactiveTableGeneration || "0") + 1,
          );
          container.dataset.interactiveTableGeneration = tableGeneration;
          const searchInput = container.querySelector<HTMLInputElement>(
            "[data-search-input]",
          );
          const statusSelect = container.querySelector<HTMLSelectElement>(
            "[data-status-select]",
          );
          const limitSelect = container.querySelector<HTMLSelectElement>(
            "[data-limit-select]",
          );
          const prevBtn = container.querySelector<HTMLButtonElement>(
            "[data-pagination-prev]",
          );
          const nextBtn = container.querySelector<HTMLButtonElement>(
            "[data-pagination-next]",
          );
          const numbersContainer = container.querySelector<HTMLElement>(
            "[data-pagination-numbers]",
          );
          const tbody =
            container.querySelector<HTMLTableSectionElement>("tbody");
          if (!tbody) return;

          const allRows = Array.from(
            tbody.querySelectorAll<HTMLTableRowElement>("tr"),
          ).filter(
            (row) =>
              !row.classList.contains("empty-row") && row.querySelector("td"),
          );
          let filteredRows = [...allRows];
          let currentPage = 1;
          let limit = parseInt(limitSelect?.value || "10", 10);

          function isCurrentGeneration() {
            return container.dataset.interactiveTableGeneration === tableGeneration;
          }

          function updateTable() {
            if (!isCurrentGeneration()) return;

            const query = searchInput?.value.toLowerCase().trim() || "";
            const statusQuery = statusSelect?.value || "";

            // Filter rows
            filteredRows = allRows.filter((row) => {
              // Text Search filter (check text content of the row)
              const textMatch =
                query === "" || row.textContent?.toLowerCase().includes(query);

              // Status filter
              const rowStatus = row.dataset.status || "";
              const statusMatch =
                statusQuery === "" ||
                rowStatus.toLowerCase() === statusQuery.toLowerCase();

              return textMatch && statusMatch;
            });

            const totalRows = filteredRows.length;
            const totalPages = Math.ceil(totalRows / limit) || 1;

            if (currentPage > totalPages) {
              currentPage = totalPages;
            }

            const start = (currentPage - 1) * limit;
            const end = start + limit;

            // Update page info display
            const pageInfo = container.querySelector("[data-page-info]");
            if (pageInfo) {
              pageInfo.textContent = `Showing ${currentPage} of ${totalPages} pages`;
            }

            // Hide/Show rows
            allRows.forEach((row) => {
              row.style.display = "none";
            });

            filteredRows.slice(start, end).forEach((row) => {
              row.style.display = "";
            });

            // Update pagination controls
            if (prevBtn) prevBtn.disabled = currentPage === 1;
            if (nextBtn) nextBtn.disabled = currentPage === totalPages;

            // Generate numbered page buttons
            if (numbersContainer) {
              numbersContainer.innerHTML = "";
              for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.textContent = String(i);
                btn.className = i === currentPage ? "btn-active-page" : "";
                btn.style.padding = "0.25rem 0.65rem";
                btn.style.minWidth = "2rem";
                btn.style.border = "none";
                btn.style.borderRadius = "0.25rem";
                btn.style.cursor = "pointer";
                btn.addEventListener("click", () => {
                  currentPage = i;
                  updateTable();
                });
                numbersContainer.appendChild(btn);
              }
            }
          }

          searchInput?.addEventListener("input", () => {
            if (!isCurrentGeneration()) return;
            currentPage = 1;
            updateTable();
          });

          statusSelect?.addEventListener("change", () => {
            if (!isCurrentGeneration()) return;
            currentPage = 1;
            updateTable();
          });

          limitSelect?.addEventListener("change", () => {
            if (!isCurrentGeneration()) return;
            limit = parseInt(limitSelect.value, 10);
            currentPage = 1;
            updateTable();
          });

          prevBtn?.addEventListener("click", () => {
            if (!isCurrentGeneration()) return;
            if (currentPage > 1) {
              currentPage--;
              updateTable();
            }
          });

          nextBtn?.addEventListener("click", () => {
            if (!isCurrentGeneration()) return;
            const totalPages = Math.ceil(filteredRows.length / limit) || 1;
            if (currentPage < totalPages) {
              currentPage++;
              updateTable();
            }
          });

          // Initial update
          updateTable();
        });
      }

      function initFormSubmissionState() {
        const body = document.body;
        if (body.dataset.formSubmissionStateInitialized === "true") return;
        body.dataset.formSubmissionStateInitialized = "true";

        document.addEventListener("submit", (event) => {
          const form = event.target;
          if (!(form instanceof HTMLFormElement)) return;
          if ((form.getAttribute("method") || "get").toLowerCase() !== "post") return;
          if (form.dataset.skipSubmitState === "true") return;

          if (form.dataset.isSubmitting === "true") {
            event.preventDefault();
            return;
          }

          form.dataset.isSubmitting = "true";

          const submitButtons = Array.from(
            form.querySelectorAll<HTMLButtonElement>('button[type="submit"]'),
          );
          const submitter = event.submitter instanceof HTMLButtonElement
            ? event.submitter
            : null;

          submitButtons.forEach((button) => {
            button.disabled = true;
          });

          if (submitter) {
            submitter.classList.add("form-submit-button--loading");
            submitter.setAttribute("aria-busy", "true");
          }
        }, true);
      }

      function initDashboardFeatures() {
        initSidebarUnreadBadges();
        initDrawerSheets();
        initCellPopovers();
        initInteractiveTables();
        initFormSubmissionState();
      }

      document.addEventListener("DOMContentLoaded", initDashboardFeatures);
      document.addEventListener("astro:after-swap", initDashboardFeatures);
      document.addEventListener(
        "dashboard:interactive-table-updated",
        initInteractiveTables,
      );
      if (
        document.readyState === "complete" ||
        document.readyState === "interactive"
      ) {
        initDashboardFeatures();
      }
    </script>
  </body>
</html>
