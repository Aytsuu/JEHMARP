---
import type { NavigationItem } from "@/config/navigation";
import AgentMobileChrome from "@/components/agent/AgentMobileChrome.astro";
import DashboardSidebar from "@/components/dashboard/DashboardSidebar.astro";
import type { DashboardSidebarUnreadBadge } from "@/lib/dashboard/sidebar-navigation";
import Sheet from "@/components/ui/Sheet.astro";
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";

type Props = {
  title: string;
  description: string;
  navLabel: string;
  navItems: readonly NavigationItem[];
  sidebarUnreadBadges?: Record<string, DashboardSidebarUnreadBadge>;
};

const { title, description, navLabel, sidebarUnreadBadges = {} } = Astro.props;
const isAgentDashboard = navLabel === "Agent operations";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
    />
    <ClientRouter fallback="swap" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      try {
        if (localStorage.getItem("dashboard-sidebar-collapsed") === "true") {
          document.documentElement.classList.add("dashboard-sidebar-collapsed");
        }
      } catch {}
    </script>
    <style is:global>
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
      }

      ::view-transition-old(dashboard-main),
      ::view-transition-new(dashboard-main) {
        animation-duration: 0.16s;
        animation-timing-function: ease-out;
      }

      @media (max-width: 47.99rem) {
        .dashboard-body--agent ::view-transition-old(dashboard-main),
        .dashboard-body--agent ::view-transition-new(dashboard-main),
        .dashboard-body--agent ::view-transition-group(dashboard-main),
        .dashboard-body--agent ::view-transition-old(root),
        .dashboard-body--agent ::view-transition-new(root),
        .dashboard-body--agent ::view-transition-group(root) {
          animation: none !important;
        }

        .agent-mobile-header,
        .agent-mobile-nav {
          view-transition-name: none;
        }
      }

      html.agent-mobile-nav-lock,
      html.agent-mobile-nav-lock body {
        overflow: hidden;
      }
    </style>
  </head>
  <body class:list={["dashboard-body", isAgentDashboard && "dashboard-body--agent"]}>
    <script is:inline>
      if (location.pathname.startsWith("/agent")) {
        document.body.classList.add("dashboard-body--agent");
      }
    </script>
    {
      isAgentDashboard && (
        <AgentMobileChrome
          currentPath={Astro.url.pathname}
          sidebarUnreadBadges={sidebarUnreadBadges}
        />
      )
    }
    <div class="dashboard-frame">
      <DashboardSidebar navLabel={navLabel} sidebarUnreadBadges={sidebarUnreadBadges} />
      <main class="dashboard-main">
        <div
          class="dashboard-route-skeleton"
          data-dashboard-route-skeleton
          hidden
          aria-hidden="true"
          aria-busy="true"
          aria-label="Loading page"
        >
          <div class="dashboard-route-skeleton__panel">
            <span class="table-skeleton-block table-skeleton-block--short dashboard-route-skeleton__title"></span>
            <span class="table-skeleton-block dashboard-route-skeleton__intro"></span>
            <div class="dashboard-route-skeleton__cards" aria-hidden="true">
              <span class="dashboard-route-skeleton__card"></span>
              <span class="dashboard-route-skeleton__card"></span>
              <span class="dashboard-route-skeleton__card"></span>
              <span class="dashboard-route-skeleton__card"></span>
            </div>
            <span class="table-skeleton-block table-skeleton-block--wide dashboard-route-skeleton__block"></span>
            <span class="table-skeleton-block dashboard-route-skeleton__block"></span>
            <span class="table-skeleton-block table-skeleton-block--short dashboard-route-skeleton__block"></span>
          </div>
        </div>
        {
          isAgentDashboard ? (
            <div class="dashboard-main__content dashboard-main__content--agent">
              <slot />
            </div>
          ) : (
            <div
              class="dashboard-main__content"
              transition:name="dashboard-main"
              transition:animate="fade"
            >
              <slot />
            </div>
          )
        }
      </main>
    </div>

    <!-- Drawer Sheet Component -->
    <Sheet header="Manage" content="" />

    <div class="cell-popover" id="cell-popover" aria-hidden="true">
      <div class="cell-popover__card">
        <header class="cell-popover__header">
          <h3 class="cell-popover__title">Edit</h3>
          <button
            type="button"
            class="dashboard-modal__close"
            data-close-cell-popover
            aria-label="Close popover"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </header>
        <div class="cell-popover__body" data-cell-popover-body></div>
      </div>
    </div>

    <script is:inline>
      window.readDashboardFragmentResponse = async function readDashboardFragmentResponse(response) {
        if (response.status === 503) {
          const redirectUrl = response.headers.get("X-System-Issue-Redirect") || "/system-issue";
          window.location.assign(redirectUrl);
          throw new DOMException("Aborted", "AbortError");
        }

        if (!response.ok) {
          throw new Error("Request failed with " + response.status + ".");
        }

        return response.text();
      };
    </script>

    <script>
      import { initDashboardCellPopovers } from "@/lib/client/dashboard-cell-popover";
      import { initDashboardModals } from "@/lib/client/dashboard-modal";
      import { initDashboardSheets } from "@/lib/client/dashboard-sheet";
      import { initDashboardNavNavigation } from "@/lib/client/dashboard-nav";
      import { initAgentMobileNavigation } from "@/lib/client/agent-mobile-route";
      import { initDashboardRouteLoading } from "@/lib/client/dashboard-route-loading";
      import { initDashboardSidebarUnreadBadges } from "@/lib/client/dashboard-sidebar-badges";
      import { initDashboardSidebarCollapse } from "@/lib/client/dashboard-sidebar";
      import { initOrderDetailTabs } from "@/lib/client/order-detail-tabs";
      import { initOrderPaymentFormToggle } from "@/lib/client/order-payment-form";
      import { initOrderStatusAutoSave } from "@/lib/client/order-status-auto-save";
      import { initTableActionMenus } from "@/lib/client/table-action-menu";

      function initSidebarUnreadBadges() {
        initDashboardSidebarUnreadBadges();
      }

      const boardAlignmentObservers = new WeakMap<HTMLElement, ResizeObserver>();

      function isSidebarLayoutAnimationActive() {
        return document.documentElement.classList.contains(
          "dashboard-sidebar-animating",
        );
      }

      function syncDashboardTableBoardColumns(board: HTMLElement) {
        const table = board.querySelector("table");
        const thead = table?.querySelector("thead");
        const tbody = table?.querySelector("tbody");
        if (!table || !thead || !tbody) return;

        table.querySelectorAll<HTMLTableCellElement>("th, td").forEach((cell) => {
          cell.style.removeProperty("width");
        });

        const headerRow = thead.querySelector("tr");
        const tableWidth = headerRow?.getBoundingClientRect().width ?? table.scrollWidth;
        board.style.setProperty(
          "--dashboard-table-sync-width",
          `${Math.ceil(tableWidth)}px`,
        );
      }

      function syncDashboardTableBoards(root: ParentNode = document) {
        root.querySelectorAll<HTMLElement>(".dashboard-table-board").forEach(
          (board) => {
            syncDashboardTableBoardColumns(board);
          },
        );
      }

      function initDashboardTableBoardAlignment(root: ParentNode = document) {
        root.querySelectorAll<HTMLElement>(".dashboard-table-board").forEach(
          (board) => {
            syncDashboardTableBoardColumns(board);

            if (boardAlignmentObservers.has(board)) return;

            const observer = new ResizeObserver(() => {
              if (isSidebarLayoutAnimationActive()) return;
              syncDashboardTableBoardColumns(board);
            });
            observer.observe(board);
            const tbody = board.querySelector("tbody");
            if (tbody) observer.observe(tbody);
            boardAlignmentObservers.set(board, observer);
          },
        );
      }

      function initInteractiveTables() {
        const interactiveTables = document.querySelectorAll<HTMLElement>(
          "[data-interactive-table]",
        );
        interactiveTables.forEach((container) => {
          if (container.dataset.serverPagination === "true") {
            return;
          }

          const tableGeneration = String(
            Number(container.dataset.interactiveTableGeneration || "0") + 1,
          );
          container.dataset.interactiveTableGeneration = tableGeneration;
          const searchInput = container.querySelector<HTMLInputElement>(
            "[data-search-input]",
          );
          const statusSelect = container.querySelector<HTMLSelectElement>(
            "[data-status-select]",
          );
          const limitSelect = container.querySelector<HTMLSelectElement>(
            "[data-limit-select]",
          );
          const prevBtn = container.querySelector<HTMLButtonElement>(
            "[data-pagination-prev]",
          );
          const nextBtn = container.querySelector<HTMLButtonElement>(
            "[data-pagination-next]",
          );
          const numbersContainer = container.querySelector<HTMLElement>(
            "[data-pagination-numbers]",
          );
          const cardsContainer = container.querySelector<HTMLElement>(
            "[data-interactive-cards]",
          );
          const tbody =
            container.querySelector<HTMLTableSectionElement>("tbody");

          let allRows: HTMLElement[];
          if (cardsContainer) {
            allRows = Array.from(
              cardsContainer.querySelectorAll<HTMLElement>("[data-interactive-row]"),
            );
          } else if (tbody) {
            allRows = Array.from(
              tbody.querySelectorAll<HTMLTableRowElement>("tr"),
            ).filter(
              (row) =>
                !row.classList.contains("empty-row") && row.querySelector("td"),
            );
          } else {
            return;
          }
          let filteredRows = [...allRows];
          let currentPage = 1;
          let limit = parseInt(limitSelect?.value || "10", 10);

          function isCurrentGeneration() {
            return container.dataset.interactiveTableGeneration === tableGeneration;
          }

          function updateTable() {
            if (!isCurrentGeneration()) return;

            const query = searchInput?.value.toLowerCase().trim() || "";
            const statusQuery = statusSelect?.value || "";

            // Filter rows
            filteredRows = allRows.filter((row) => {
              // Text Search filter (check text content of the row)
              const textMatch =
                query === "" || row.textContent?.toLowerCase().includes(query);

              // Status filter
              const rowStatus = row.dataset.status || "";
              const statusMatch =
                statusQuery === "" ||
                rowStatus.toLowerCase() === statusQuery.toLowerCase();

              return textMatch && statusMatch;
            });

            const totalRows = filteredRows.length;
            const totalPages = Math.ceil(totalRows / limit) || 1;

            if (currentPage > totalPages) {
              currentPage = totalPages;
            }

            const start = (currentPage - 1) * limit;
            const end = start + limit;

            // Update page info display
            const pageInfo = container.querySelector("[data-page-info]");
            if (pageInfo) {
              pageInfo.textContent = `${currentPage} of ${totalPages} pages`;
            }

            // Hide/Show rows
            allRows.forEach((row) => {
              row.style.display = "none";
            });

            filteredRows.slice(start, end).forEach((row) => {
              row.style.display = "";
            });

            // Update pagination controls
            if (prevBtn) prevBtn.disabled = currentPage === 1;
            if (nextBtn) nextBtn.disabled = currentPage === totalPages;

            // Generate numbered page buttons
            if (numbersContainer) {
              numbersContainer.innerHTML = "";
              for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.textContent = String(i);
                btn.className = i === currentPage
                  ? "table-pagination__page-button btn-active-page"
                  : "table-pagination__page-button";
                btn.addEventListener("click", () => {
                  currentPage = i;
                  updateTable();
                });
                numbersContainer.appendChild(btn);
              }
            }

            window.requestAnimationFrame(() => {
              container
                .querySelectorAll<HTMLElement>(".dashboard-table-board")
                .forEach((board) => {
                  syncDashboardTableBoardColumns(board);
                });
            });

            container.dispatchEvent(
              new CustomEvent("dashboard:interactive-table-page-changed", {
                bubbles: true,
              }),
            );
          }

          searchInput?.addEventListener("input", () => {
            if (!isCurrentGeneration()) return;
            currentPage = 1;
            updateTable();
          });

          statusSelect?.addEventListener("change", () => {
            if (!isCurrentGeneration()) return;
            currentPage = 1;
            updateTable();
          });

          limitSelect?.addEventListener("change", () => {
            if (!isCurrentGeneration()) return;
            limit = parseInt(limitSelect.value, 10);
            currentPage = 1;
            updateTable();
          });

          prevBtn?.addEventListener("click", () => {
            if (!isCurrentGeneration()) return;
            if (currentPage > 1) {
              currentPage--;
              updateTable();
            }
          });

          nextBtn?.addEventListener("click", () => {
            if (!isCurrentGeneration()) return;
            const totalPages = Math.ceil(filteredRows.length / limit) || 1;
            if (currentPage < totalPages) {
              currentPage++;
              updateTable();
            }
          });

          // Initial update
          updateTable();
        });
      }

      function initDigitsOnlyInputs() {
        document.querySelectorAll<HTMLInputElement>("[data-digits-only]").forEach((input) => {
          if (input.dataset.digitsOnlyInitialized === "true") return;
          input.dataset.digitsOnlyInitialized = "true";

          const allowedKeys = new Set([
            "Backspace",
            "Delete",
            "Tab",
            "ArrowLeft",
            "ArrowRight",
            "Home",
            "End",
          ]);

          input.addEventListener("keydown", (event) => {
            if (allowedKeys.has(event.key) || event.ctrlKey || event.metaKey) return;
            if (!/^\d$/.test(event.key)) event.preventDefault();
          });

          input.addEventListener("input", () => {
            const digitsOnly = input.value.replace(/\D/g, "");
            if (input.value !== digitsOnly) input.value = digitsOnly;
          });
        });
      }

      function clearDashboardFragmentCaches() {
        try {
          Object.keys(sessionStorage)
            .filter((key) => key.startsWith("dashboard-fragment-cache:"))
            .forEach((key) => {
              sessionStorage.removeItem(key);
            });
        } catch {
          // sessionStorage can be unavailable in strict browser privacy modes.
        }
      }

      function initFormSubmissionState() {
        const dashboardWindow = window as Window & {
          dashboardFormSubmissionStateInitialized?: boolean;
        };
        if (dashboardWindow.dashboardFormSubmissionStateInitialized) return;
        dashboardWindow.dashboardFormSubmissionStateInitialized = true;

        document.addEventListener("submit", (event) => {
          const form = event.target;
          if (!(form instanceof HTMLFormElement)) return;
          if ((form.getAttribute("method") || "get").toLowerCase() !== "post") return;
          if (form.dataset.skipSubmitState === "true") return;

          if (form.dataset.isSubmitting === "true") {
            event.preventDefault();
            return;
          }

          form.dataset.isSubmitting = "true";
          clearDashboardFragmentCaches();

          const submitButtons = Array.from(
            form.querySelectorAll<HTMLButtonElement>('button[type="submit"]'),
          );
          const submitter = event.submitter instanceof HTMLButtonElement
            ? event.submitter
            : null;

          const buttonsToDisable = new Set(submitButtons);
          if (submitter) buttonsToDisable.add(submitter);

          buttonsToDisable.forEach((button) => {
            button.disabled = true;
          });

          if (submitter) {
            submitter.classList.add("form-submit-button--loading");
            submitter.setAttribute("aria-busy", "true");
          }
        }, true);
      }

      function initDashboardPostFormReloadOptOut() {
        document.querySelectorAll<HTMLFormElement>("form").forEach((form) => {
          if ((form.getAttribute("method") || "get").toLowerCase() !== "post") {
            return;
          }

          if (form.dataset.astroClientSubmit === "true") return;

          form.setAttribute("data-astro-reload", "");
        });
      }

      function initDashboardFeatures() {
        initDashboardPostFormReloadOptOut();
        initDashboardSidebarCollapse();
        initAgentMobileNavigation();
        initDashboardNavNavigation();
        initDashboardRouteLoading();
        initDashboardModals();
        initSidebarUnreadBadges();
        initDashboardSheets();
        initDashboardCellPopovers();
        initDashboardTableBoardAlignment();
        initInteractiveTables();
        initDigitsOnlyInputs();
        initFormSubmissionState();
        initOrderDetailTabs();
        initOrderPaymentFormToggle();
        initOrderStatusAutoSave();
        initTableActionMenus();
      }

      document.addEventListener("DOMContentLoaded", initDashboardFeatures);
      document.addEventListener("astro:after-swap", initDashboardFeatures);
      document.addEventListener("astro:page-load", initDashboardFeatures);
      document.addEventListener(
        "dashboard:interactive-table-updated",
        () => {
          initInteractiveTables();
          initDashboardTableBoardAlignment();
        },
      );
      window.addEventListener("resize", () => {
        if (isSidebarLayoutAnimationActive()) return;
        syncDashboardTableBoards();
      });
      window.addEventListener("dashboard:sidebar-transition-end", () => {
        syncDashboardTableBoards();
      });
      if (
        document.readyState === "complete" ||
        document.readyState === "interactive"
      ) {
        initDashboardFeatures();
      }
    </script>
  </body>
</html>
