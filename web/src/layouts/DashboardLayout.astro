---
import type { NavigationItem } from "@/config/navigation";
import "@/styles/global.css";

type Props = {
  title: string;
  description: string;
  navLabel: string;
  navItems: readonly NavigationItem[];
};

const { title, description, navLabel, navItems } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="dashboard-body">
    <div class="dashboard-frame">
      <aside
        class="dashboard-sidebar"
        aria-labelledby="dashboard-sidebar-title"
      >
        <a class="dashboard-sidebar__brand" href="/">
          <span class="site-nav__brand-mark" aria-hidden="true">Logo</span>
          <span>JEHMARP</span>
        </a>
        <nav class="dashboard-sidebar__nav" aria-label={navLabel}>
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <form
          class="dashboard-sidebar__logout-form"
          method="post"
          action="/api/logout"
        >
          <button type="submit">Logout</button>
        </form>
      </aside>
      <main class="dashboard-main">
        <slot />
      </main>
    </div>

    <!-- Drawer Sheet Component -->
    <div class="drawer-sheet" id="drawer-sheet" aria-hidden="true">
      <div class="drawer-sheet__backdrop" data-close-drawer></div>
      <div class="drawer-sheet__content">
        <header class="drawer-sheet__header">
          <h3 class="drawer-sheet__title">Manage</h3>
          <button type="button" class="drawer-sheet__close" data-close-drawer aria-label="Close panel">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </header>
        <div class="drawer-sheet__body" data-drawer-body></div>
      </div>
    </div>

    <script>
      function initDrawerSheets() {
        const drawer = document.querySelector<HTMLElement>("#drawer-sheet");
        const drawerBody = drawer?.querySelector<HTMLElement>("[data-drawer-body]");
        const closeButtons = drawer?.querySelectorAll("[data-close-drawer]");
        const openButtons = document.querySelectorAll("[data-open-sheet]");

        if (!drawer || !drawerBody) return;

        let currentFormParent: HTMLElement | null = null;
        let currentForm: HTMLFormElement | null = null;

        function closeDrawer() {
          if (!drawer || !drawerBody) return;
          drawer.classList.remove("drawer-sheet--open");
          drawer.setAttribute("aria-hidden", "true");

          // Move the form back to its placeholder
          if (currentForm && currentFormParent) {
            currentFormParent.appendChild(currentForm);
          }
          currentForm = null;
          currentFormParent = null;
        }

        // Handle Edit/Manage row buttons
        openButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            // Close any open drawer first
            if (currentForm) {
              closeDrawer();
            }

            const parentTd = btn.closest("td");
            if (!parentTd) return;

            const holder = parentTd.querySelector<HTMLElement>(".hidden-form-holder");
            const form = holder?.querySelector<HTMLFormElement>("form");
            if (!holder || !form) return;

            currentFormParent = holder;
            currentForm = form;

            // Move the form element to the drawer content
            drawerBody.appendChild(form);

            // Dynamically set title based on the row context
            const row = btn.closest("tr");
            const rowTitle = row?.querySelector("strong")?.textContent || row?.querySelector("td")?.textContent || "Manage";
            const drawerTitle = drawer.querySelector(".drawer-sheet__title");
            if (drawerTitle) {
              drawerTitle.textContent = `Manage: ${rowTitle.trim().split("\n")[0]}`;
            }

            drawer.classList.add("drawer-sheet--open");
            drawer.setAttribute("aria-hidden", "false");
          });
        });

        // Handle Create form panel buttons
        const openCreateButtons = document.querySelectorAll("[data-open-create-sheet]");
        openCreateButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            // Close any open drawer first
            if (currentForm) {
              closeDrawer();
            }

            const parentPanel = btn.closest(".admin-panel");
            const holder = parentPanel?.querySelector<HTMLElement>(".hidden-create-form-holder");
            const form = holder?.querySelector<HTMLFormElement>("form");
            if (!holder || !form) return;

            currentFormParent = holder;
            currentForm = form;

            // Move the form element to the drawer content
            drawerBody.appendChild(form);

            // Set drawer title to the button label
            const drawerTitle = drawer.querySelector(".drawer-sheet__title");
            if (drawerTitle) {
              drawerTitle.textContent = btn.textContent?.trim() || "Create";
            }

            drawer.classList.add("drawer-sheet--open");
            drawer.setAttribute("aria-hidden", "false");
          });
        });

        closeButtons?.forEach((btn) => {
          btn.addEventListener("click", closeDrawer);
        });

        // Close on escape key
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && drawer.classList.contains("drawer-sheet--open")) {
            closeDrawer();
          }
        });
      }

      document.addEventListener("DOMContentLoaded", initDrawerSheets);
      document.addEventListener("astro:after-swap", initDrawerSheets);
      if (document.readyState === "complete" || document.readyState === "interactive") {
        initDrawerSheets();
      }
    </script>
  </body>
</html>
